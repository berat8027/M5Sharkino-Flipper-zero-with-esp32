// ─── Flipper Log Dosyası Görüntüleyici ───────────────────────────
// /flipper/dolphin/ veya /log/ dizinindeki metin .log dosyalarını gösterir
static void flipper_log_viewer_run() {
    if (!g_sdInited) { dispBannerErr("SD yok"); return; }

    // Log dizinlerini tara
    String logDirs[] = {"/flipper/dolphin", "/log"};
    OptionList fileOpts;

    for (int d = 0; d < 2; d++) {
        if (!SD.exists(logDirs[d].c_str())) continue;
        File root = SD.open(logDirs[d].c_str());
        if (!root) continue;
        while (true) {
            File entry = root.openNextFile();
            if (!entry) break;
            String name = String(entry.name());
            entry.close();
            if (name.endsWith(".log") || name.endsWith(".txt")) {
                String capPath = logDirs[d] + "/" + name;
                String capName = name;
                fileOpts.push_back({capName, [capPath, capName]() {
                    File lf = SD.open(capPath.c_str(), FILE_READ);
                    if (!lf) { dispBannerErr("Log ac hata"); return; }
                    // Satırları sayfalı göster
                    String lines[5];
                    uint8_t lineCount = 0;
                    uint32_t totalLines = 0;
                    // İlk önce toplam satırı say (max 500)
                    while (lf.available() && totalLines < 500) {
                        lf.readStringUntil('\n');
                        totalLines++;
                    }
                    lf.seek(0);

                    uint32_t lineIdx = 0;
                    while (lf.available()) {
                        for (uint8_t i = 0; i < 5; i++) lines[i] = "";
                        lineCount = 0;
                        for (uint8_t i = 0; i < 5 && lf.available(); i++) {
                            String ln = lf.readStringUntil('\n');
                            ln.trim();
                            lines[i] = ln.substring(0, 21);
                            lineCount++;
                            lineIdx++;
                        }
                        dispClear();
                        dispStatusBar(capName.substring(0, 14));
                        for (uint8_t i = 0; i < lineCount; i++)
                            dispText(0, 13 + i * 10, lines[i]);
                        dispText(0, 54, String(lineIdx) + "/" + String(totalLines) + " [BTN]=ileri");
                        dispCommit();

                        // Buton veya long press bekle
                        uint32_t t0 = millis();
                        bool advance = false;
                        while (millis() - t0 < 5000) {
                            if (readButtonLong()) { lf.close(); return; }
                            if (readButton()) { advance = true; break; }
                            delay(50);
                        }
                        if (!advance) break;
                    }
                    lf.close();
                    dispBannerOK("Log sonu");
                }});
            }
        }
        root.close();
    }

    if (fileOpts.empty()) { dispBannerWarn("Log dosyasi yok"); return; }
    fileOpts.push_back({"Back", [](){}});
    int sel = loopOptions(fileOpts, "Log Dosyalari");
    if (sel >= 0 && sel < (int)fileOpts.size()) fileOpts[sel].action();
}

// ─── Flipper SD Kart Özet Bilgisi ────────────────────────────────
// Flipper Zero tarzı SD içerik özeti
static void flipper_sd_info_run() {
    if (!g_sdInited) { dispBannerErr("SD yok"); return; }

    // Dizin başına dosya say
    auto countDir = [](const char* path) -> uint32_t {
        uint32_t cnt = 0;
        File d = SD.open(path);
        if (!d) return 0;
        while (true) {
            File e = d.openNextFile();
            if (!e) break;
            cnt++;
            e.close();
        }
        d.close();
        return cnt;
    };

    uint32_t subCnt  = countDir("/flipper/subghz");
    uint32_t irCnt   = countDir("/flipper/ir");
    uint32_t nfcCnt  = countDir("/flipper/nfc");
    uint32_t rfidCnt = countDir("/flipper/lfrfid");
    uint32_t ibtnCnt = countDir("/flipper/ibutton");
    uint32_t appCnt  = countDir("/flipper/apps");

    uint64_t tot  = SD.totalBytes();
    uint64_t used = SD.usedBytes();
    uint8_t  pct  = (uint8_t)((used * 100ULL) / (tot ? tot : 1));

    // Sayfa 1: depolama
    dispClear();
    dispStatusBar("Flipper SD Bilgi");
    dispText(0, 13, "Sub-GHz: " + String(subCnt) + " dosya");
    dispText(0, 23, "IR:      " + String(irCnt)   + " dosya");
    dispText(0, 33, "NFC:     " + String(nfcCnt)  + " dosya");
    dispText(0, 43, "LFRFID:  " + String(rfidCnt) + " dosya");
    dispText(0, 53, "[BTN]=sonraki");
    dispCommit();
    while (!readButton()) { potApplyBrightness(); delay(50); }

    // Sayfa 2: diğer + boyut
    dispClear();
    dispStatusBar("Flipper SD Bilgi");
    dispText(0, 13, "iButton: " + String(ibtnCnt) + " dosya");
    dispText(0, 23, "Apps:    " + String(appCnt)  + " dosya");
    dispText(0, 33, "SD:      " + String((uint32_t)(tot / (1024*1024))) + " MB");
    dispText(0, 43, "Dolu:    " + String(pct) + "%");
    dispText(0, 53, "[BTN]=kapat");
    dispCommit();
    while (!readButton()) { potApplyBrightness(); delay(50); }
}

// ─── .sub Dosyasını Oynat ────────────────────────────────────────
static void flipper_replay_sub(const FlipperSubFile& sub) {
    if (!sub.valid) { dispBannerErr("Gecersiz .sub"); return; }
    if (!cc1101_ensureInit()) return;

    float freqMhz = sub.freqHz / 1000000.0f;
    g_cc1101Freq = freqMhz;

    // Preset'e göre modülasyon seç
    if (sub.preset.indexOf("Ook") >= 0 || sub.protocol == "ASK/OOK") {
        cc1101_setModulation(CC_MOD_ASKOOK);
    } else if (sub.preset.indexOf("2FSK") >= 0) {
        cc1101_setModulation(CC_MOD_2FSK);
    } else if (sub.preset.indexOf("GFSK") >= 0) {
        cc1101_setModulation(CC_MOD_GFSK);
    } else {
        cc1101_setModulation(CC_MOD_ASKOOK);
    }

    cc1101_setFrequency(freqMhz);

    dispClear();
    dispStatusBar(".sub Replay");
    dispText(0, 14, "Freq: " + String(freqMhz, 3) + " MHz");
    dispText(0, 26, "Mod:  " + sub.protocol);
    dispText(0, 38, "Pulses: " + String(sub.pulses.size()));
    dispText(0, 50, "Gonderiliyor...");
    dispCommit();

    // TX moda gec
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SFTX);
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32);  // infinite packet, async serial
    cc1101_writeReg(CC1101_IOCFG0,   0x0B);  // GDO0 = serial TX data

    cc1101_strobe(CC1101_STX);
    pinMode(4 /*PIN_CC1101_GDO0*/, OUTPUT);

    for (const auto& p : sub.pulses) {
        digitalWrite(PIN_CC1101_GDO0, p.level ? HIGH : LOW);
        delayMicroseconds(p.dur);
    }
    digitalWrite(PIN_CC1101_GDO0, LOW);

    cc1101_strobe(CC1101_SIDLE);
    cc1101_writeReg(CC1101_IOCFG0, 0x0C);  // GDO0 varsayılanına döndür

    buzzRFReplay();
    dispBannerOK(".sub OK  " + String(sub.pulses.size()) + " pulse");
}

// ─── Mevcut Yakalamayı .sub Olarak Kaydet ────────────────────────
static void flipper_save_sub(const std::vector<RFPulse>& pulses, float freqMhz,
                              const String& filename, const String& preset = "FuriHalSubGhzPresetOok650Async") {
    if (!g_sdInited) { dispBannerErr("SD yok"); return; }
    if (pulses.empty()) { dispBannerErr("Pulse yok"); return; }

    // SD'de /flipper/subghz/ dizini oluştur
    if (!SD.exists("/flipper"))        SD.mkdir("/flipper");
    if (!SD.exists("/flipper/subghz")) SD.mkdir("/flipper/subghz");

    String path = "/flipper/subghz/" + filename;
    if (!path.endsWith(".sub")) path += ".sub";

    File f = SD.open(path.c_str(), FILE_WRITE);
    if (!f) { dispBannerErr("Yaz hata: " + path); return; }

    f.println("Filetype: Flipper SubGhz Key File");
    f.println("Version: 1");
    f.println("Frequency: " + String((uint32_t)(freqMhz * 1000000.0f)));
    f.println("Preset: " + preset);
    f.println("Protocol: RAW");

    // RAW_Data satırı — birden fazla satıra bölünür (max 512 karakter/satır)
    String rawLine = "RAW_Data:";
    uint16_t lineLen = 9;
    for (const auto& p : pulses) {
        long v = p.level ? (long)p.dur : -(long)p.dur;
        String tok = " " + String(v);
        if (lineLen + tok.length() > 500) {
            f.println(rawLine);
            rawLine = "RAW_Data:";
            lineLen = 9;
        }
        rawLine += tok;
        lineLen += tok.length();
    }
    if (lineLen > 9) f.println(rawLine);

    f.close();
    logPush("[FLP] .sub saved: " + path);
    dispBannerOK(".sub kaydedildi");
}

// ─── .ir Dosya Ayrıştırıcı ───────────────────────────────────────
static FlipperIRFile flipper_parse_ir(const String& path) {
    FlipperIRFile result;
    result.valid = false;

    File f = SD.open(path.c_str(), FILE_READ);
    if (!f) { dispBannerErr(".ir ac: " + path); return result; }

    bool isFlipperIR = false;
    FlipperIRSignal current;
    bool inSignal = false;

    while (f.available()) {
        String line = f.readStringUntil('\n');
        line.trim();

        // Ayırıcı: yeni sinyal başlangıcı
        if (line == "#" || line == "---") {
            if (inSignal && current.name.length() > 0) {
                result.signals.push_back(current);
            }
            current = FlipperIRSignal();
            inSignal = false;
            continue;
        }

        int colon = line.indexOf(':');
        if (colon < 0) continue;
        String key = line.substring(0, colon);
        String val = line.substring(colon + 1);
        key.trim(); val.trim();

        if (key == "Filetype" && val.indexOf("IR") >= 0) {
            isFlipperIR = true;
        } else if (key == "name") {
            inSignal = true;
            current.name = val;
        } else if (key == "type") {
            current.type = val;
        } else if (key == "protocol") {
            current.protocol = val;
        } else if (key == "address") {
            // "0x01 0x00 0x00 0x00" → uint32
            current.address = strtoul(val.c_str(), nullptr, 16);
        } else if (key == "command") {
            current.command = strtoul(val.c_str(), nullptr, 16);
        } else if (key == "data" || key == "raw_data") {
            // Boşlukla ayrılmış uint32 değerleri (µs)
            int s = 0;
            val += " ";
            for (int i = 0; i <= (int)val.length(); i++) {
                if (i == (int)val.length() || val[i] == ' ') {
                    if (i > s) {
                        String tok = val.substring(s, i);
                        tok.trim();
                        if (tok.length() > 0)
                            current.rawData.push_back((uint32_t)tok.toInt());
                    }
                    s = i + 1;
                }
            }
        }
    }
    // Son sinyal
    if (inSignal && current.name.length() > 0)
        result.signals.push_back(current);

    f.close();
    result.valid = isFlipperIR && !result.signals.empty();
    return result;
}

// ─── .nfc Dosya Ayrıştırıcı ──────────────────────────────────────
static FlipperNFCFile flipper_parse_nfc(const String& path) {
    FlipperNFCFile result;
    memset(&result, 0, sizeof(result));
    result.valid = false;

    File f = SD.open(path.c_str(), FILE_READ);
    if (!f) { dispBannerErr(".nfc ac: " + path); return result; }

    bool isFlipperNFC = false;

    while (f.available()) {
        String line = f.readStringUntil('\n');
        line.trim();
        if (line.isEmpty()) continue;

        int colon = line.indexOf(':');
        if (colon < 0) continue;
        String key = line.substring(0, colon);
        String val = line.substring(colon + 1);
        key.trim(); val.trim();

        if (key == "Filetype" && val.indexOf("NFC") >= 0) {
            isFlipperNFC = true;
        } else if (key == "Device type") {
            result.deviceType = val;
            result.isMifare = (val.indexOf("Mifare") >= 0 || val.indexOf("MIFARE") >= 0);
        } else if (key == "UID") {
            result.uid = val;
        } else if (key == "ATQA") {
            result.atqa = val;
        } else if (key == "SAK") {
            result.sak = (uint8_t)strtoul(val.c_str(), nullptr, 16);
        } else if (key.startsWith("Block ") && result.isMifare) {
            // "Block 0: 04 AB CD EF ..." → blockData[n]
            int blkNum = key.substring(6).toInt();
            if (blkNum >= 0 && blkNum < 64) {
                uint8_t byteIdx = 0;
                int s = 0;
                val += " ";
                for (int i = 0; i <= (int)val.length() && byteIdx < 16; i++) {
                    if (i == (int)val.length() || val[i] == ' ') {
                        if (i > s) {
                            String tok = val.substring(s, i);
                            tok.trim();
                            if (tok.length() > 0)
                                result.blockData[blkNum][byteIdx++] = (uint8_t)strtoul(tok.c_str(), nullptr, 16);
                        }
                        s = i + 1;
                    }
                }
                if (blkNum + 1 > result.blockCount) result.blockCount = blkNum + 1;
            }
        } else if (key.startsWith("Page ") && !result.isMifare) {
            // "Page 0: 04 AB CD EF" → pageData[n]
            int pgNum = key.substring(5).toInt();
            if (pgNum >= 0 && pgNum < 135) {
                uint8_t byteIdx = 0;
                int s = 0;
                val += " ";
                for (int i = 0; i <= (int)val.length() && byteIdx < 4; i++) {
                    if (i == (int)val.length() || val[i] == ' ') {
                        if (i > s) {
                            String tok = val.substring(s, i);
                            tok.trim();
                            if (tok.length() > 0)
                                result.pageData[pgNum][byteIdx++] = (uint8_t)strtoul(tok.c_str(), nullptr, 16);
                        }
                        s = i + 1;
                    }
                }
                if (pgNum + 1 > result.pageCount) result.pageCount = pgNum + 1;
            }
        }
    }
    f.close();
    result.valid = isFlipperNFC && result.uid.length() > 0;
    return result;
}

// ─── Mevcut RFID dump'ını .nfc Olarak Kaydet ─────────────────────
// g_sectorDump ve g_lastUID mevcut global değişkenlerini kullanır
static void flipper_save_nfc(const String& uid, const String& tagType) {
    if (!g_sdInited) { dispBannerErr("SD yok"); return; }

    if (!SD.exists("/flipper"))     SD.mkdir("/flipper");
    if (!SD.exists("/flipper/nfc")) SD.mkdir("/flipper/nfc");

    String safeName = uid;
    safeName.replace(":", "_");
    String path = "/flipper/nfc/" + safeName + ".nfc";

    File f = SD.open(path.c_str(), FILE_WRITE);
    if (!f) { dispBannerErr("Yaz hata"); return; }

    f.println("Filetype: Flipper NFC device");
    f.println("Version: 4");

    // Tip belirle
    if (tagType.indexOf("1K") >= 0 || tagType.indexOf("Mifare") >= 0)
        f.println("Device type: Mifare Classic 1K");
    else if (tagType.indexOf("NTAG") >= 0)
        f.println("Device type: NTAG215");
    else
        f.println("Device type: " + tagType);

    f.println("UID: " + uid);
    f.println("ATQA: 00 04");  // Mifare Classic varsayılan
    f.println("SAK: 08");

    // Eğer dump varsa blokları yaz
    if (g_hasDump) {
        f.println("Data format version: 2");
        for (uint8_t b = 0; b < MIFARE_1K_BLOCKS; b++) {
            String blockLine = "Block " + String(b) + ":";
            for (uint8_t j = 0; j < MIFARE_BLOCK_SIZE; j++) {
                char hex[4];
                snprintf(hex, sizeof(hex), " %02X", g_sectorDump[b][j]);
                blockLine += hex;
            }
            f.println(blockLine);
        }
    }

    f.close();
    logPush("[FLP] .nfc saved: " + path);
    dispBannerOK(".nfc kaydedildi");
}

// ─── Flipper Dosya Menüsü ─────────────────────────────────────────
// SD'deki /flipper/ dizinini tarar, uzantıya göre ayrıştırıp çalıştırır
// ─── Genel Flipper Dosya Listesi Yardımcısı ───────────────────────
// Verilen dizindeki belirtilen uzantılı dosyaları OptionList'e ekler
static void flipper_list_files(const String& dir, const String& ext, OptionList& out) {
    if (!SD.exists(dir.c_str())) { SD.mkdir(dir.c_str()); return; }
    File root = SD.open(dir.c_str());
    if (!root) return;
    while (true) {
        File entry = root.openNextFile();
        if (!entry) break;
        String name = String(entry.name());
        uint32_t sz = entry.size();
        entry.close();
        if (name.endsWith(ext)) {
            String capPath = dir + "/" + name;
            String capName = name;
            // Dosya adını truncate et ve boyutu göster
            String label = capName;
            if (label.length() > 15) label = label.substring(0, 14) + "~";
            label += " " + String(sz / 1024) + "K";
            out.push_back({label, [capPath, capName]() {
                // Action lambda boş — çağıran kod fullPath kullanır
                (void)capPath; (void)capName;
            }});
        }
    }
    root.close();
}

// ─── Genişletilmiş Flipper Dosya Tarayıcısı ──────────────────────
// .sub, .ir, .nfc, .rfid (LFRFID), .ibtn (iButton) destekler
static void flipper_file_browser_run() {
    if (!g_sdInited) { dispBannerErr("SD yok"); return; }
    flipper_sd_init_dirs();  // Dizinlerin var olduğundan emin ol

    // Tip seçimi
    OptionList typeOpts = {
        {"Sub-GHz (.sub)",   [](){}},
        {"Infrared (.ir)",   [](){}},
        {"NFC (.nfc)",       [](){}},
        {"LFRFID (.rfid)",   [](){}},
        {"iButton (.ibtn)",  [](){}},
        {"Back",             [](){}},
    };
    int typesel = loopOptions(typeOpts, "Flipper Dosya");
    if (typesel < 0 || typesel >= 5) return;

    String ext, dir, title;
    if (typesel == 0) { ext = ".sub";  dir = "/flipper/subghz";  title = "Sub-GHz"; }
    if (typesel == 1) { ext = ".ir";   dir = "/flipper/ir";      title = "Infrared"; }
    if (typesel == 2) { ext = ".nfc";  dir = "/flipper/nfc";     title = "NFC"; }
    if (typesel == 3) { ext = ".rfid"; dir = "/flipper/lfrfid";  title = "LFRFID"; }
    if (typesel == 4) { ext = ".ibtn"; dir = "/flipper/ibutton"; title = "iButton"; }

    // Dosyaları tara
    if (!SD.exists(dir.c_str())) { SD.mkdir(dir.c_str()); }
    File rootDir = SD.open(dir.c_str());
    if (!rootDir) { dispBannerErr("Dizin hata"); return; }

    OptionList fileOpts;
    while (true) {
        File entry = rootDir.openNextFile();
        if (!entry) break;
        String name = String(entry.name());
        entry.close();
        if (!name.endsWith(ext)) continue;
        String capName = name;
        String capDir  = dir;
        String capExt  = ext;
        int    capType = typesel;
        fileOpts.push_back({name.substring(0, 17), [capName, capDir, capType]() {
            String fullPath = capDir + "/" + capName;

            // ── Sub-GHz: çoklu sinyal desteği ──────────────────────
            if (capType == 0) {
                FlipperSubFile sub = flipper_parse_sub(fullPath);
                if (!sub.valid) { dispBannerErr("Parse hata"); return; }
                dispClear();
                dispStatusBar(".sub: " + capName.substring(0, 12));
                dispText(0, 14, "Freq: " + String(sub.freqHz / 1e6f, 3) + "MHz");
                dispText(0, 24, "Mod:  " + sub.protocol.substring(0, 18));
                if (sub.multiSignal && sub.signals.size() > 1) {
                    dispText(0, 34, "Sinyal: " + String(sub.signals.size()) + " adet");
                    dispText(0, 44, "[BTN]=sec [LONG]=ilk oynat");
                } else {
                    dispText(0, 34, "Pulse: " + String(sub.pulses.size()));
                    dispText(0, 44, "[BTN]=oynat [LONG]=gec");
                }
                dispCommit();
                delay(800);

                if (sub.multiSignal && sub.signals.size() > 1) {
                    bool longPressed = readButtonLong();
                    if (longPressed) {
                        // İlk sinyali doğrudan oynat
                        FlipperSubFile first = sub;
                        first.pulses = sub.signals[0].pulses;
                        first.multiSignal = false;
                        flipper_replay_sub(first);
                    } else {
                        // Sinyal listesini göster, seçim yap
                        OptionList sigSel;
                        for (size_t si = 0; si < sub.signals.size(); si++) {
                            String sname = sub.signals[si].name.length() > 0
                                           ? sub.signals[si].name
                                           : "Sinyal " + String(si + 1);
                            sname += " (" + String(sub.signals[si].pulses.size()) + "p)";
                            FlipperSubSignal capSig = sub.signals[si];
                            FlipperSubFile  capSub  = sub;
                            sigSel.push_back({sname.substring(0, 18), [capSig, capSub]() {
                                FlipperSubFile s = capSub;
                                s.pulses = capSig.pulses;
                                s.multiSignal = false;
                                flipper_replay_sub(s);
                            }});
                        }
                        sigSel.push_back({"Back", [](){}});
                        int ss = loopOptions(sigSel, "Sinyal Sec");
                        if (ss >= 0 && ss < (int)sigSel.size()) sigSel[ss].action();
                    }
                } else {
                    if (readButton()) flipper_replay_sub(sub);
                }

            // ── Infrared ────────────────────────────────────────────
            } else if (capType == 1) {
                FlipperIRFile ir = flipper_parse_ir(fullPath);
                if (!ir.valid) { dispBannerErr("IR parse hata"); return; }
                OptionList sigOpts;
                for (auto& sig : ir.signals) {
                    String slabel = sig.name + " [" + sig.protocol.substring(0, 6) + "]";
                    sigOpts.push_back({slabel.substring(0, 18), [sig]() {
                        dispClear();
                        dispStatusBar(".ir: " + sig.name.substring(0, 12));
                        dispText(0, 14, "Proto: " + sig.protocol);
                        if (sig.type == "parsed") {
                            char buf[32];
                            snprintf(buf, sizeof(buf), "Addr: 0x%04lX", (unsigned long)sig.address);
                            dispText(0, 26, String(buf));
                            snprintf(buf, sizeof(buf), "Cmd:  0x%04lX", (unsigned long)sig.command);
                            dispText(0, 38, String(buf));
                        } else {
                            dispText(0, 26, "RAW: " + String(sig.rawData.size()) + " orn");
                        }
                        dispText(0, 50, "IR TX: 38kHz LED gerek");
                        dispCommit();
                        delay(2500);
                    }});
                }
                sigOpts.push_back({"Back", [](){}});
                int ss = loopOptions(sigOpts, ".ir: " + capName.substring(0, 10));
                if (ss >= 0 && ss < (int)sigOpts.size()) sigOpts[ss].action();

            // ── NFC ─────────────────────────────────────────────────
            } else if (capType == 2) {
                FlipperNFCFile nfc = flipper_parse_nfc(fullPath);
                if (!nfc.valid) { dispBannerErr("NFC parse hata"); return; }
                OptionList nfcOpts = {
                    {"Bilgi Goster",  [nfc]() {
                        dispClear();
                        dispStatusBar(".nfc Bilgi");
                        dispText(0, 13, "Tip:  " + nfc.deviceType.substring(0, 18));
                        dispText(0, 23, "UID:  " + nfc.uid.substring(0, 18));
                        char atqaSak[20];
                        snprintf(atqaSak, sizeof(atqaSak), "ATQA:%s SAK:%02X", nfc.atqa.c_str(), nfc.sak);
                        dispText(0, 33, String(atqaSak));
                        dispText(0, 43, "Blok: " + String(nfc.blockCount));
                        dispText(0, 53, "[BTN]=kapat");
                        dispCommit();
                        while (!readButton()) { potApplyBrightness(); delay(50); }
                    }},
                    {"Blok Goruntule", [nfc]() {
                        // Her seferinde 4 blok göster
                        uint8_t bStart = 0;
                        while (bStart < nfc.blockCount) {
                            dispClear();
                            dispStatusBar("NFC Blok " + String(bStart));
                            for (uint8_t b = bStart; b < min((uint8_t)(bStart+4), (uint8_t)nfc.blockCount); b++) {
                                char line[30];
                                snprintf(line, sizeof(line), "%02d: %02X %02X %02X %02X %02X %02X %02X %02X",
                                    b,
                                    nfc.blockData[b][0], nfc.blockData[b][1],
                                    nfc.blockData[b][2], nfc.blockData[b][3],
                                    nfc.blockData[b][4], nfc.blockData[b][5],
                                    nfc.blockData[b][6], nfc.blockData[b][7]);
                                dispText(0, 13 + (b - bStart) * 10, String(line));
                            }
                            dispText(0, 54, "[BTN]=sonraki [LONG]=cik");
                            dispCommit();
                            if (readButtonLong()) break;
                            while (!readButton()) {
                                if (readButtonLong()) goto nfc_done;
                                delay(50);
                            }
                            bStart += 4;
                        }
                        nfc_done:;
                        dispBannerOK("NFC blok sonu");
                    }},
                    {"Emulasyon (PN532)", [nfc]() {
                        dispBannerWarn("PN532 modulu gereklidir");
                    }},
                    {"Back", [](){}},
                };
                int ns = loopOptions(nfcOpts, ".nfc: " + capName.substring(0, 10));
                if (ns >= 0 && ns < (int)nfcOpts.size()) nfcOpts[ns].action();

            // ── LFRFID (.rfid) ──────────────────────────────────────
            } else if (capType == 3) {
                FlipperRFIDFile rfid = flipper_parse_rfid(fullPath);
                if (!rfid.valid) { dispBannerErr("RFID parse hata"); return; }
                OptionList rfidOpts = {
                    {"Bilgi Goster",  [rfid]() { flipper_show_rfid_info(rfid); }},
                    {"Hex Dump",      [rfid]() {
                        dispClear();
                        dispStatusBar("RFID Hex");
                        dispText(0, 14, "Tip: " + rfid.keyType);
                        String hexLine = "";
                        for (uint8_t i = 0; i < rfid.byteCount; i++) {
                            char h[4]; snprintf(h, sizeof(h), "%02X ", rfid.rawBytes[i]);
                            hexLine += String(h);
                        }
                        dispText(0, 28, hexLine.substring(0, 21));
                        // EM4100 formatı: byte[0]=version, byte[1-4]=data
                        if (rfid.keyType == "EM4100" && rfid.byteCount >= 5) {
                            char uid[20];
                            snprintf(uid, sizeof(uid), "ID:%02X%02X%02X%02X%02X",
                                rfid.rawBytes[0], rfid.rawBytes[1], rfid.rawBytes[2],
                                rfid.rawBytes[3], rfid.rawBytes[4]);
                            dispText(0, 40, String(uid));
                        }
                        dispText(0, 54, "[BTN]=kapat");
                        dispCommit();
                        while (!readButton()) { potApplyBrightness(); delay(50); }
                    }},
                    {"Back", [](){}},
                };
                int rs = loopOptions(rfidOpts, "RFID: " + capName.substring(0, 10));
                if (rs >= 0 && rs < (int)rfidOpts.size()) rfidOpts[rs].action();

            // ── iButton (.ibtn) ─────────────────────────────────────
            } else if (capType == 4) {
                FlipperiButtonFile ibtn = flipper_parse_ibtn(fullPath);
                if (!ibtn.valid) { dispBannerErr("iBTN parse hata"); return; }
                OptionList ibtnOpts = {
                    {"Bilgi Goster",  [ibtn]() { flipper_show_ibtn_info(ibtn); }},
                    {"Hex Dump",      [ibtn]() {
                        dispClear();
                        dispStatusBar("iButton Hex");
                        dispText(0, 14, "Tip: " + ibtn.keyType);
                        String hexLine = "";
                        for (uint8_t i = 0; i < ibtn.byteCount; i++) {
                            char h[4]; snprintf(h, sizeof(h), "%02X ", ibtn.rawBytes[i]);
                            hexLine += String(h);
                        }
                        dispText(0, 28, hexLine.substring(0, 21));
                        if (hexLine.length() > 21)
                            dispText(0, 38, hexLine.substring(21, 42));
                        dispText(0, 54, "[BTN]=kapat");
                        dispCommit();
                        while (!readButton()) { potApplyBrightness(); delay(50); }
                    }},
                    {"Back", [](){}},
                };
                int is = loopOptions(ibtnOpts, "iBTN: " + capName.substring(0, 10));
                if (is >= 0 && is < (int)ibtnOpts.size()) ibtnOpts[is].action();
            }
        }});
    }
    rootDir.close();

    if (fileOpts.empty()) {
        dispBannerWarn("Dosya yok: " + title);
        return;
    }
    fileOpts.push_back({"Back", [](){}});
    while (!g_returnToMenu) {
        int sel = loopOptions(fileOpts, title + " Dosyalar");
        if (sel < 0 || sel == (int)fileOpts.size() - 1) break;
        if (sel >= 0 && sel < (int)fileOpts.size()) fileOpts[sel].action();
    }
}

