            else            dispText(0, 42, (d.serviceUUIDs.isEmpty() ? "No services" : "SVC: " + d.serviceUUIDs.substring(0,18)));
            dispText(0, 54, "[BTN] actions [LONG]back");
            dispCommit();
            if (readButtonLong()) break;
            if (!readButton()) { delay(30); continue; }

            OptionList acts = {
                {"GATT Connect", [](){}},
                {"Spoof this MAC", [](){}},
                {"Back", [](){}},
            };
            int act = loopOptions(acts, "BLE Actions");
            if (act < 0 || act == 2) break;
            if (act == 0) {
                pScan->clearResults();
                BLEDevice::deinit(true); delay(300); delete cb;
                ble_gatt_scan_run();
                BLEDevice::init("M5Sharkino"); cb = new BLEScanCB();
                pScan = BLEDevice::getScan();
                pScan->setAdvertisedDeviceCallbacks(cb, false);
                pScan->setActiveScan(true);
            } else if (act == 1) {
                dispClear(); dispStatusBar("BLE MAC Spoof");
