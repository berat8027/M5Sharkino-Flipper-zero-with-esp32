static bool initRFID() {
    // SPI.begin() is now handled globally in setup() // CS'i manuel yönet
    g_spiInited = true;
    delay(10);
    rfid.PCD_Init();
    delay(10);
    uint8_t ver = rfid.PCD_ReadRegister(MFRC522::VersionReg);
    bool ok = (ver != 0x00 && ver != 0xFF);
    if (ok) rfid.PCD_SetAntennaGain(rfid.RxGain_max);
    return ok;
}

// ─── Splash helpers ───────────────────────────────────────

// ═══════════════════════════════════════════════════════════
//  SPLASH — Flipper Zero tarzı giriş ekranı
//  Faz 1: Karanlık ekran + Flipper ikonunun piksel piksel çizilmesi
//  Faz 2: Sol panel ikon sabit, sağda type-writer boot log
//  Faz 3: Tam ekran "M5Sharkino" + wipe-out animasyonu
// ═══════════════════════════════════════════════════════════

// ── Flipper Zero tarzı şimşek/araç ikonu — 40x40 piksel ──
// Gerçek Flipper'ın hacky tool ikonunu taklit ediyor:
// Dış çerçeve yuvarlak dikdörtgen, içinde sinyal dalgaları + anten
static void drawFlipperIcon(int ox, int oy, uint16_t col) {
    // Dış gövde (kart/cihaz şekli, yuvarlak köşe)
    display.drawRoundRect(ox,    oy+6,  40, 26, 4, col);
    // Anten (sol üst köşeden çıkan ince çizgi + top)
    display.drawLine(ox+6,  oy+6,  ox+6,  oy,   col);
    display.drawLine(ox+5,  oy,    ox+7,  oy,    col);
    display.fillCircle(ox+6, oy-1, 1, col);
    // Ekran alanı (küçük kutu içinde)
    display.drawRect(ox+3, oy+9, 22, 14, col);
    // Ekranda sinyal dalgaları (3 yay, Flipper'ın wifi logosu gibi)
    display.drawCircleHelper(ox+14, oy+22, 4,  0b0001|0b0010, col);
    display.drawCircleHelper(ox+14, oy+22, 7,  0b0001|0b0010, col);
    display.drawCircleHelper(ox+14, oy+22, 10, 0b0001|0b0010, col);
    display.fillCircle(ox+14, oy+22, 1, col);
    // Sağ taraf: 3 LED noktası
    display.fillCircle(ox+31, oy+13, 2, col);
    display.fillCircle(ox+31, oy+21, 2, col);
    display.fillCircle(ox+31, oy+29, 2, col);
    // Alt: button/joystick ipucu
    display.fillRoundRect(ox+8, oy+27, 10, 3, 1, col);
}

// Tek karakter type-writer etkisi (splash için)
static void splashTypeLine(int x, int y, const char* text, int delayMs) {
    for (int i = 0; text[i] != '\0'; i++) {
        display.setTextColor(SSD1306_WHITE);
        display.setTextSize(1);
        display.setCursor(x + i*6, y);
        display.print(text[i]);
        dispCommit();
        delay(delayMs);
    }
}

// Faz 1 — Karanlık ekranda Flipper ikonu piksel piksel beliriyor
static void splashPhase1() {
    // Önce tamamen siyah, birkaç frame bekle
    dispClear();
    dispCommit();
    delay(120);

    // İkon sol-ortada çizilecek: (8, 10)
    const int ox = 8, oy = 10;

    // Adım adım çiz — her çağrıda bir parça ekle, kümülatif
    // 1) Dış çerçeve
    dispClear();
    display.drawRoundRect(ox, oy+6, 40, 26, 4, SSD1306_WHITE);
    dispCommit(); delay(80);

    // 2) Anten
    display.drawLine(ox+6, oy+6, ox+6, oy,  SSD1306_WHITE);
    display.drawLine(ox+5, oy,   ox+7, oy,   SSD1306_WHITE);
    display.fillCircle(ox+6, oy-1, 1, SSD1306_WHITE);
    dispCommit(); delay(70);

    // 3) İç ekran kutusu
    display.drawRect(ox+3, oy+9, 22, 14, SSD1306_WHITE);
    dispCommit(); delay(70);

    // 4) Sinyal dalgaları — dıştan içe
    display.drawCircleHelper(ox+14, oy+22, 10, 0b0001|0b0010, SSD1306_WHITE);
    dispCommit(); delay(55);
    display.drawCircleHelper(ox+14, oy+22, 7,  0b0001|0b0010, SSD1306_WHITE);
    dispCommit(); delay(55);
    display.drawCircleHelper(ox+14, oy+22, 4,  0b0001|0b0010, SSD1306_WHITE);
    dispCommit(); delay(55);
    display.fillCircle(ox+14, oy+22, 1, SSD1306_WHITE);
    dispCommit(); delay(50);

    // 5) LED noktaları — birer birer yak
    display.fillCircle(ox+31, oy+13, 2, SSD1306_WHITE);
    dispCommit(); delay(60);
    display.fillCircle(ox+31, oy+21, 2, SSD1306_WHITE);
    dispCommit(); delay(60);
    display.fillCircle(ox+31, oy+29, 2, SSD1306_WHITE);
    dispCommit(); delay(60);

    // 6) Alt buton
    display.fillRoundRect(ox+8, oy+27, 10, 3, 1, SSD1306_WHITE);
    dispCommit(); delay(80);

    // Kısa bekleme — ikon tamamlandı
    delay(200);
}

// Faz 2 — Flipper tarzı: sol ikon sabit, sağda type-writer boot log
static void splashPhase2() {
    const int ox = 8, oy = 10;

    // Temel ekranı oluştur (ikon sabit kalsın)
    dispClear();
    drawFlipperIcon(ox, oy, SSD1306_WHITE);
    // Dikey ayırıcı çizgi
    display.drawFastVLine(54, 0, OLED_H - 8, SSD1306_WHITE);
    // Alt yatay çizgi
    display.drawFastHLine(0, OLED_H - 8, OLED_W, SSD1306_WHITE);
    // Sol alt: cihaz adı küçük
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(2, OLED_H - 6);
    display.print("M5Sharkino");
    dispCommit();
    delay(100);

    // Sağ panel — Flipper tarzı boot log (her satır > + type-writer)
    struct BootLine { const char* text; bool ok; };
    static const BootLine lines[] = {
        { "ESP32-S3",   true  },
        { "16MB Flash", true  },
        { "PSRAM 8MB",  true  },
        { "WiFi",       true  },
        { "BLE",        true  },
        { "RFID",       true  },
    };
    static constexpr uint8_t BOOT_LINE_COUNT = 6;

    int lineY = 2;
    for (int i = 0; i < BOOT_LINE_COUNT; i++) {
        if (lineY > OLED_H - 16) break;
        // ">" prompt
        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(57, lineY);
        display.print(">");
        dispCommit();
        delay(35);
        // Text type-writer
        for (int c = 0; lines[i].text[c] != '\0'; c++) {
            display.setCursor(63 + c*6, lineY);
            display.print(lines[i].text[c]);
            dispCommit();
            delay(22);
        }
        // "[OK]" veya "[--]" sonucu
        delay(30);
        const char* result = lines[i].ok ? " OK" : "ERR";
        // Sağa hizalı OK
        int rx = OLED_W - 19;
        display.setCursor(rx, lineY);
        display.print(result);
        dispCommit();
        lineY += 9;
    }
    delay(350);
}

// Faz 3 — Tam ekran title card + wipe animasyonu
static void splashPhase3() {
    // Tam ekran title card — Flipper Zero gibi sade ve vurucu
    dispClear();
    // Dış çerçeve
    display.drawRoundRect(0, 0, OLED_W, OLED_H, 3, SSD1306_WHITE);
    // Üst beyaz şerit
    display.fillRect(1, 1, OLED_W - 2, 12, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK); display.setTextSize(1);
    display.setCursor(8, 3); display.print("M5Sharkino  by Beroxx");
    display.setTextColor(SSD1306_WHITE);
    // Büyük başlık
    display.setTextSize(2);
    display.setCursor(4, 18);
    display.print("M5Sharki");
    display.setCursor(4, 35);
    display.print("  noCC");
    // Alt ince bilgi
    display.setTextSize(1);
    display.drawFastHLine(1, 51, OLED_W - 2, SSD1306_WHITE);
    display.setCursor(4, 54);
    display.print("ESP32-S3 N16R8  v2.0");
    dispCommit();
    delay(900);

    // Wipe: sol'dan sağa kayan siyah bant (Flipper tarzı yatay wipe)
    for (int x = 0; x <= OLED_W; x += 6) {
        display.fillRect(0, 0, x, OLED_H, SSD1306_BLACK);
        dispCommit();
        delay(12);
    }
    dispClear(); dispCommit();
}

static void showSplash() {
    // ── Faz 0: 2 invert flash — Flipper'ın ayırt edici boot sinyali ──
    display.invertDisplay(true);  delay(60);
    display.invertDisplay(false); delay(60);
    display.invertDisplay(true);  delay(40);
    display.invertDisplay(false); delay(80);

    // ── Boot Dolphin Animasyonu — L1_Sleep yunus uyanisi ─────────────
    {
        // L1_Sleep: 2 passive + 4 active frame = 6 toplam, 5fps
        // Sadece passive kismi oyna (2 frame x 2 dongu = kisa uyanis efekti)
        uint8_t bootOrder[6];
        for (uint8_t i = 0; i < L1_Sleep_128x64_STEPS; i++)
            bootOrder[i] = pgm_read_byte(&L1_Sleep_128x64_ORDER[i]);
        for (uint8_t rep = 0; rep < 3; rep++) {
            for (uint8_t i = 0; i < L1_Sleep_128x64_PASSIVE; i++) {
                const uint8_t* bmp = (const uint8_t*)pgm_read_ptr(
                    &L1_Sleep_128x64_FRAMES[bootOrder[i]]);
                dispClear();
                display.drawBitmap(0, 0, bmp, L1_Sleep_128x64_W,
                                   L1_Sleep_128x64_H, SSD1306_WHITE);
                dispCommit();
                delay(200);  // 5fps
            }
        }
        // Active kisim (yunus yukseliyor)
        for (uint8_t i = L1_Sleep_128x64_PASSIVE; i < L1_Sleep_128x64_STEPS; i++) {
            const uint8_t* bmp = (const uint8_t*)pgm_read_ptr(
                &L1_Sleep_128x64_FRAMES[bootOrder[i]]);
            dispClear();
            display.drawBitmap(0, 0, bmp, L1_Sleep_128x64_W,
                               L1_Sleep_128x64_H, SSD1306_WHITE);
            dispCommit();
            delay(200);
        }
    }

    // ── Faz 1: Köşe çerçeve + Flipper ikonu ──────────────────────────
    flipperCornerFrame(4);
    splashPhase1();
    buzzBootFlipper();  // Flipper Zero autentik boot jingle

    // ── Faz 2: Boot log type-writer (sağ panel) ──────────────────────
    splashPhase2();

    // ── Faz 3: Tam ekran title + wipe ────────────────────────────────
    splashPhase3();
}

