static void rfidTagsSave() {
    prefs.begin("rfidtags", false);
    prefs.putUChar("count", (uint8_t)min((int)g_savedTags.size(), 20));
    for (uint8_t i = 0; i < g_savedTags.size() && i < 20; i++) {
        String key = "t" + String(i);
        prefs.putBytes(key.c_str(), &g_savedTags[i], sizeof(SavedTag));
    }
    prefs.end();
}

static void rfidTagsLoad() {
    prefs.begin("rfidtags", true);
    uint8_t cnt = prefs.getUChar("count", 0);
    g_savedTags.clear();
    for (uint8_t i = 0; i < cnt && i < 20; i++) {
        String key = "t" + String(i);
        SavedTag t;
        memset(&t, 0, sizeof(t));
        if (prefs.getBytes(key.c_str(), &t, sizeof(SavedTag)) == sizeof(SavedTag))
            g_savedTags.push_back(t);
    }
    prefs.end();
}

