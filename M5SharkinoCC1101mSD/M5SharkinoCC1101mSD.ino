// Klima durum yapısı
static struct {
    bool    power   = false;
    float   temp    = 24.0f;   // Celsius
    uint8_t modeIdx = 1;       // Cool
    uint8_t fanIdx  = 0;       // Auto
    uint8_t swingIdx= 0;       // Off
    bool    turbo   = false;
    bool    quiet   = false;
    bool    econo   = false;
    bool    light   = true;
    bool    clean   = false;
    bool    beep    = true;
} g_acState;

// IRac nesnesini lazım olduğunda yarat — heap'te tutma
static IRac* g_irAc = nullptr;

static void ir_ac_send(decode_type_t proto) {
    ir_init();
    if (!g_irAc) {
        g_irAc = new IRac(PIN_IR_TX);
    }
    stdAc::state_t st;
    st.protocol = proto;
    st.model    = -1;  // Otomatik model
    st.power    = g_acState.power;
    st.mode     = AC_MODES[g_acState.modeIdx];
    st.degrees  = g_acState.temp;
    st.celsius  = true;
    st.fanspeed = AC_FANS[g_acState.fanIdx];
    st.swingv   = AC_SWINGV[g_acState.swingIdx];
    st.swingh   = AC_SWINGH[g_acState.swingIdx];
    st.turbo    = g_acState.turbo;
    st.quiet    = g_acState.quiet;
    st.econo    = g_acState.econo;
    st.light    = g_acState.light;
    st.clean    = g_acState.clean;
    st.beep     = g_acState.beep;
    st.sleep    = -1;
    st.clock    = -1;
    g_irAc->sendAc(st, nullptr);
}

// Klima kontrol ekranı çiz
static void ir_ac_draw(const char* brand, decode_type_t proto) {
    dispClear();
    dispStatusBar("AC Kontrol");
    char line[22];
    snprintf(line, sizeof(line), "%s", brand);
    dispText(0, 10, String(line));
    snprintf(line, sizeof(line), "GUC:%s  Mod:%s",
        g_acState.power ? "AC" : "KP",
        AC_MODE_NAMES[g_acState.modeIdx]);
    dispText(0, 20, String(line));
    snprintf(line, sizeof(line), "Sicak:%.0f C  Fan:%s",
        g_acState.temp,
        AC_FAN_NAMES[g_acState.fanIdx]);
    dispText(0, 30, String(line));
    snprintf(line, sizeof(line), "Swing:%s T:%s Q:%s",
        AC_SWING_NAMES[g_acState.swingIdx],
        g_acState.turbo ? "Y" : "N",
        g_acState.quiet ? "Y" : "N");
    dispText(0, 40, String(line));
    dispText(0, 54, "BTN=GONDER J=NAVIGATE");
    dispCommit();
}

// Tek marka için klima kontrol menüsü
static void ir_ac_control_run(const char* brand, decode_type_t proto) {
    // Ayar menüsü: önce seçenekler
    OptionList acOpts = {
        {"Guc Toggle",   [brand, proto]() {
            g_acState.power = !g_acState.power;
            ir_ac_send(proto);
            buzzOK();
            dispBannerOK(g_acState.power ? "AC ACILDI" : "AC KAPANDI");
        }},
        {"Sicaklik Ayar", [brand, proto]() {
            while (true) {
                dispClear();
                dispStatusBar("Sicaklik");
                char buf[24];
                snprintf(buf, sizeof(buf), "Sicaklik: %.0f C", g_acState.temp);
                dispText(0, 20, String(buf));
                dispText(0, 32, "J-UP=+1  J-DN=-1");
                dispText(0, 44, "J-RT=+5  J-LF=-5");
                dispText(0, 56, "[BTN]=tamam");
                dispCommit();
                JoyDir d = readJoystick();
                if (d == JoyDir::UP)    { g_acState.temp += 1; if (g_acState.temp > 32) g_acState.temp = 32; }
                if (d == JoyDir::DOWN)  { g_acState.temp -= 1; if (g_acState.temp < 16) g_acState.temp = 16; }
                if (d == JoyDir::RIGHT) { g_acState.temp += 5; if (g_acState.temp > 32) g_acState.temp = 32; }
                if (d == JoyDir::LEFT)  { g_acState.temp -= 5; if (g_acState.temp < 16) g_acState.temp = 16; }
                if (readButton()) break;
                delay(150);
            }
            ir_ac_send(proto);
            buzzOK();
            char buf[24]; snprintf(buf, sizeof(buf), "Sicak: %.0f C TX!", g_acState.temp);
            dispBannerOK(String(buf));
        }},
        {"Mod Sec", [brand, proto]() {
            OptionList mOpts;
            for (uint8_t i = 0; i < 5; i++) {
                uint8_t mi = i;
                mOpts.push_back({String(AC_MODE_NAMES[i]), [mi, brand, proto]() {
                    g_acState.modeIdx = mi;
                    ir_ac_send(proto);
                    buzzOK();
                    dispBannerOK(String("Mod: ") + AC_MODE_NAMES[mi]);
                }});
            }
            mOpts.push_back({"Back", [](){}});
            int ms = loopOptions(mOpts, "AC Mod");
            if (ms >= 0 && ms < (int)mOpts.size()) mOpts[ms].action();
        }},
        {"Fan Hiz", [brand, proto]() {
            OptionList fOpts;
            for (uint8_t i = 0; i < 6; i++) {
                uint8_t fi = i;
                fOpts.push_back({String(AC_FAN_NAMES[i]), [fi, brand, proto]() {
                    g_acState.fanIdx = fi;
                    ir_ac_send(proto);
                    buzzOK();
                    dispBannerOK(String("Fan: ") + AC_FAN_NAMES[fi]);
                }});
            }
            fOpts.push_back({"Back", [](){}});
            int fs = loopOptions(fOpts, "Fan Hiz");
            if (fs >= 0 && fs < (int)fOpts.size()) fOpts[fs].action();
        }},
        {"Swing Sec", [brand, proto]() {
            OptionList swOpts;
            for (uint8_t i = 0; i < 4; i++) {
                uint8_t si = i;
                swOpts.push_back({String(AC_SWING_NAMES[i]), [si, brand, proto]() {
                    g_acState.swingIdx = si;
                    ir_ac_send(proto);
                    buzzOK();
                    dispBannerOK(String("Swing: ") + AC_SWING_NAMES[si]);
                }});
            }
            swOpts.push_back({"Back", [](){}});
            int ss = loopOptions(swOpts, "Swing");
            if (ss >= 0 && ss < (int)swOpts.size()) swOpts[ss].action();
        }},
        {"Turbo Toggle", [brand, proto]() {
            g_acState.turbo = !g_acState.turbo;
            ir_ac_send(proto);
            buzzOK();
            dispBannerOK(g_acState.turbo ? "Turbo ON" : "Turbo OFF");
        }},
        {"Sessiz Toggle", [brand, proto]() {
            g_acState.quiet = !g_acState.quiet;
            ir_ac_send(proto);
            buzzOK();
            dispBannerOK(g_acState.quiet ? "Quiet ON" : "Quiet OFF");
        }},
        {"Ekonomi Toggle", [brand, proto]() {
            g_acState.econo = !g_acState.econo;
            ir_ac_send(proto);
            buzzOK();
            dispBannerOK(g_acState.econo ? "Econo ON" : "Econo OFF");
        }},
        {"Durum Goster", [brand, proto]() {
            ir_ac_draw(brand, proto);
            waitButton(5000);
        }},
        {"Simdi Gonder", [brand, proto]() {
            ir_ac_send(proto);
            buzzOK();
            dispBannerOK("AC Sinyali TX!");
        }},
