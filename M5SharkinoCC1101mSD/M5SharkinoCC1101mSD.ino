// Level aralığı: L1=level 1-3, L2=level 4-7, L3=level 8+
// extAnimFirst()/extAnimLast() ile kademelendirme yapılır
static uint8_t extAnimFirst() {
    if (g_level >= 8) return 8;   // L3
    if (g_level >= 4) return 5;   // L2
    return 0;                      // L1
}
static uint8_t extAnimLast() {
    if (g_level >= 8) return 10;  // L3: index 8-10
    if (g_level >= 4) return 7;   // L2: index 5-7
    return 4;                      // L1: index 0-4
}



// ── Tek bir unique bitmap'i ekrana çiz ──────────────────────
// Animasyonlar 128x64 olmayabilir (51, 50, 54 yükseklik de var)
// OLED alt-ortalı göster, üst bar için 12px boşluk bırak
static void fzDrawAnimBitmap(uint8_t animIdx, uint8_t frameIdx) {
    FzAnimDef def;
    memcpy_P(&def, &FZ_ANIMS[animIdx], sizeof(FzAnimDef));

    if (frameIdx >= def.unique) frameIdx = 0;
    const uint8_t* ptr = (const uint8_t*)pgm_read_ptr(&def.frames[frameIdx]);

    // Y: 128x64 → y=0, daha kısa → alta yasla (y = 64 - h)
    int16_t yOff = (int16_t)(64 - def.h);
    if (yOff < 12) yOff = 0;  // status bar ile çakışıyorsa üstten başla

    display.drawBitmap(0, yOff, ptr, def.w, def.h, SSD1306_WHITE);
}

// ── Status bar overlay ───────────────────────────────────────
static void fzIdleStatusBar() {
    display.fillRect(0, 0, OLED_W, 11, SSD1306_BLACK);
    display.drawBitmap(1, 1, FZ_Battery_26x8,
                       FZ_Battery_26x8_W, FZ_Battery_26x8_H, SSD1306_WHITE);
    dispDrawBatteryFill(display, 1, 1, 100);
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);
    display.setCursor(29, 2);
    display.print('L'); display.print(g_level);
    if (g_cfg.bleEnabled) {
        display.drawBitmap(102, 1, FZ_Bluetooth_Idle_5x8,
                           FZ_Bluetooth_Idle_5x8_W, FZ_Bluetooth_Idle_5x8_H, SSD1306_WHITE);
    }
    String timeStr;
    if (g_ntpSynced) {
        struct tm ti;
        if (getLocalTime(&ti, 0)) {
            char buf[6]; strftime(buf, sizeof(buf), "%H:%M", &ti);
            timeStr = String(buf);
        }
    }
    if (timeStr.isEmpty()) {
        uint32_t sec = millis() / 1000;
        char buf[6];
        snprintf(buf, sizeof(buf), "%02lu:%02lu",
                 (unsigned long)(sec/3600),
                 (unsigned long)((sec%3600)/60));
        timeStr = String(buf);
    }
    display.setCursor(OLED_W - 31, 2);
    display.print(timeStr);
}

// ── Level'a göre uygun animasyon seç (rastgele) ─────────────
static uint8_t fzPickAnim() {
    // g_level'e göre hangi L seviyesini kullan
    uint8_t targetLevel = 1;
    if      (g_level >= 20) targetLevel = 3;
    else if (g_level >= 10) targetLevel = 2;

    // Uygun animasyonların indexlerini bul
    uint8_t candidates[FZ_ANIM_COUNT];
    uint8_t count = 0;
    for (uint8_t i = 0; i < FZ_ANIM_COUNT; i++) {
        FzAnimDef def;
        memcpy_P(&def, &FZ_ANIMS[i], sizeof(FzAnimDef));
        if (def.level == targetLevel) {
            candidates[count++] = i;
        }
    }
    if (count == 0) return 0;  // fallback
    return candidates[random(count)];
}

// ── Ana idle ekranı — gerçek Flipper frames_order state machine ─
// frames_order dizisi hem passive hem active playback sırasını tanımlar:
//   index 0..passive-1        → passive bölge
//   index passive..steps-1    → active bölge (active_cycles kez tekrar)
static void showIdleScreen() {
    uint8_t  animIdx    = fzPickAnim();
    FzAnimDef def;
    memcpy_P(&def, &FZ_ANIMS[animIdx], sizeof(FzAnimDef));

    // frames_order'ı RAM'e kopyala (max 46 step - Leaving_sad)
    uint8_t order[64];
    uint8_t steps = min((uint8_t)def.steps, (uint8_t)64);
    for (uint8_t i = 0; i < steps; i++)
        order[i] = pgm_read_byte(&def.order[i]);

    uint32_t frameMs  = 1000UL / def.fps;   // ms per frame
    uint32_t lastMs   = millis();

    // State
    enum class DS : uint8_t { PASSIVE, ACTIVE };
    DS       state       = DS::PASSIVE;
    uint8_t  stepIdx     = 0;               // 0..passive-1 or passive..steps-1
    uint8_t  cyclesDone  = 0;
    uint8_t  passiveLoops = 0;

    while (true) {
        potApplyBrightness();

        uint32_t now = millis();
        if (now - lastMs >= frameMs) {
            lastMs = now;
            dispClear();

            // Hangi unique bitmap?
            uint8_t bitmapIdx = order[stepIdx];
            fzDrawAnimBitmap(animIdx, bitmapIdx);
            fzIdleStatusBar();
            dispCommit();

            // Sonraki adım
            stepIdx++;
            if (state == DS::PASSIVE) {
                if (stepIdx >= def.passive) {
                    stepIdx = 0;
                    if (++passiveLoops >= 7) {    // ~7 döngü sonra active
                        passiveLoops = 0;
                        stepIdx      = def.passive;
                        state        = DS::ACTIVE;
                    }
                }
            } else {
                if (stepIdx >= steps) {
                    if (++cyclesDone >= def.cycles) {
                        // Active bitti → yeni animasyon seç
                        animIdx = fzPickAnim();
                        memcpy_P(&def, &FZ_ANIMS[animIdx], sizeof(FzAnimDef));
                        frameMs = 1000UL / def.fps;
                        steps   = min((uint8_t)def.steps, (uint8_t)64);
                        for (uint8_t i = 0; i < steps; i++)
                            order[i] = pgm_read_byte(&def.order[i]);
                        cyclesDone  = 0;
                        passiveLoops = 0;
                        stepIdx     = 0;
                        state       = DS::PASSIVE;
                    } else {
                        stepIdx = def.passive;  // active'i tekrar oynat
                    }
                }
            }
        }

        if (readButton() || readButtonLong()) break;
        if (readJoystick() != JoyDir::NONE)   break;
        delay(20);
    }
}



