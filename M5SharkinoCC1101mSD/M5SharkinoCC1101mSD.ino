static void bleHIDKey(uint8_t mod, uint8_t key) {
    if (!g_hidInput || !g_hidConn) return;
    uint8_t rep[8] = {mod,0,key,0,0,0,0,0};
    g_hidInput->setValue(rep, 8);
    g_hidInput->notify();
    delay(12);
    uint8_t rel[8] = {0};
    g_hidInput->setValue(rel, 8);
    g_hidInput->notify();
    delay(12);
}

// ASCII to HID TR-QWERTY layout [mod, keycode]
static uint8_t ASCII_HID[128][2];

static void buildAsciiHid() {
    memset(ASCII_HID, 0, sizeof(ASCII_HID));
    // Whitespace
    ASCII_HID[' '][0]=0; ASCII_HID[' '][1]=0x2C;
    ASCII_HID['\n'][0]=0; ASCII_HID['\n'][1]=0x28;
    ASCII_HID['\t'][0]=0; ASCII_HID['\t'][1]=0x2B;
    
    // Lowercase (a-z) -> i is special in TR QWERTY
    for (char c = 'a'; c <= 'z'; c++) {
        if (c == 'i') {
            ASCII_HID['i'][0]=0; ASCII_HID['i'][1]=0x34; // i tusu
        } else {
            ASCII_HID[(int)c][0]=0; ASCII_HID[(int)c][1]=0x04 + (c - 'a');
        }
    }
    
    // Uppercase (A-Z) -> I is special in TR QWERTY
    for (char c = 'A'; c <= 'Z'; c++) {
        if (c == 'I') {
            ASCII_HID['I'][0]=2; ASCII_HID['I'][1]=0x0C; // Shift + ı = I
        } else {
            ASCII_HID[(int)c][0]=2; ASCII_HID[(int)c][1]=0x04 + (c - 'A');
        }
    }
    
    // Digits
    ASCII_HID['1'][0]=0; ASCII_HID['1'][1]=0x1E;
    ASCII_HID['2'][0]=0; ASCII_HID['2'][1]=0x1F;
    ASCII_HID['3'][0]=0; ASCII_HID['3'][1]=0x20;
    ASCII_HID['4'][0]=0; ASCII_HID['4'][1]=0x21;
    ASCII_HID['5'][0]=0; ASCII_HID['5'][1]=0x22;
    ASCII_HID['6'][0]=0; ASCII_HID['6'][1]=0x23;
    ASCII_HID['7'][0]=0; ASCII_HID['7'][1]=0x24;
    ASCII_HID['8'][0]=0; ASCII_HID['8'][1]=0x25;
    ASCII_HID['9'][0]=0; ASCII_HID['9'][1]=0x26;
    ASCII_HID['0'][0]=0; ASCII_HID['0'][1]=0x27;

    // Punctuation (TR QWERTY)
    // Windows TR klavyede AltGr yerine Ctrl+Alt (0x05) kullanilir.
    ASCII_HID['!'][0]=2;    ASCII_HID['!'][1]=0x1E; // Shift + 1
    ASCII_HID['"'][0]=0;    ASCII_HID['"'][1]=0x35; // Unshifted 0x35
    ASCII_HID['#'][0]=0x05; ASCII_HID['#'][1]=0x20; // AltGr + 3
    ASCII_HID['$'][0]=0x05; ASCII_HID['$'][1]=0x21; // AltGr + 4
    ASCII_HID['%'][0]=2;    ASCII_HID['%'][1]=0x22; // Shift + 5
    ASCII_HID['&'][0]=2;    ASCII_HID['&'][1]=0x23; // Shift + 6
    ASCII_HID['\''][0]=2;   ASCII_HID['\''][1]=0x1F;// Shift + 2
    ASCII_HID['('][0]=2;    ASCII_HID['('][1]=0x25; // Shift + 8
    ASCII_HID[')'][0]=2;    ASCII_HID[')'][1]=0x26; // Shift + 9
    ASCII_HID['*'][0]=0;    ASCII_HID['*'][1]=0x2D; // * (Unshifted 0x2D)
    ASCII_HID['+'][0]=2;    ASCII_HID['+'][1]=0x21; // Shift + 4
    ASCII_HID[','][0]=0;    ASCII_HID[','][1]=0x31; // , (Unshifted 0x31)
    ASCII_HID['-'][0]=0;    ASCII_HID['-'][1]=0x2E; // - (Unshifted 0x2E)
    ASCII_HID['.'][0]=0;    ASCII_HID['.'][1]=0x38; // . (Unshifted 0x38)
    ASCII_HID['/'][0]=2;    ASCII_HID['/'][1]=0x24; // Shift + 7
    ASCII_HID[':'][0]=2;    ASCII_HID[':'][1]=0x38; // Shift + . (0x38)
    ASCII_HID[';'][0]=2;    ASCII_HID[';'][1]=0x31; // Shift + , (0x31)
    ASCII_HID['<'][0]=0;    ASCII_HID['<'][1]=0x64; // < (Unshifted 0x64)
    ASCII_HID['>'][0]=2;    ASCII_HID['>'][1]=0x64; // Shift + <
    ASCII_HID['='][0]=2;    ASCII_HID['='][1]=0x27; // Shift + 0
    ASCII_HID['?'][0]=2;    ASCII_HID['?'][1]=0x2D; // Shift + * (0x2D)
    ASCII_HID['@'][0]=0x05; ASCII_HID['@'][1]=0x14; // AltGr + Q
    ASCII_HID['['][0]=0x05; ASCII_HID['['][1]=0x25; // AltGr + 8
    ASCII_HID['\\'][0]=0x05;ASCII_HID['\\'][1]=0x2D;// AltGr + * (0x2D)
    ASCII_HID[']'][0]=0x05; ASCII_HID[']'][1]=0x26; // AltGr + 9
    ASCII_HID['^'][0]=2;    ASCII_HID['^'][1]=0x20; // Shift + 3
    ASCII_HID['_'][0]=2;    ASCII_HID['_'][1]=0x2E; // Shift + - (0x2E)
    ASCII_HID['`'][0]=0x05; ASCII_HID['`'][1]=0x31; // AltGr + , (0x31)
    ASCII_HID['{'][0]=0x05; ASCII_HID['{'][1]=0x24; // AltGr + 7
    ASCII_HID['|'][0]=0x05; ASCII_HID['|'][1]=0x2E; // AltGr + - (0x2E)
    ASCII_HID['}'][0]=0x05; ASCII_HID['}'][1]=0x27; // AltGr + 0
    ASCII_HID['~'][0]=0x05; ASCII_HID['~'][1]=0x30; // AltGr + u
}

static void bleHIDType(const char* str) {
    for (int i = 0; str[i]; i++) {
        uint8_t c = (uint8_t)str[i];
        if (c < 128) bleHIDKey(ASCII_HID[c][0], ASCII_HID[c][1]);
        delay(8);
    }
}

