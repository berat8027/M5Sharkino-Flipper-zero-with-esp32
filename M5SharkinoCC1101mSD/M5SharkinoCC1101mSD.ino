    const char* ns = (sel == 0) ? "esphacker" : "rfidtags";
    prefs.begin(ns, true);

    static const char* esphacker_keys[] = {"wifiEn","bleEn","rfidEn","bright","serLog","invert","pinEn","deauthB","dwell","apSSID","apPass"};
    static const char* rfidtags_keys[]  = {"count"};
    const char** keys = (sel == 0) ? esphacker_keys : rfidtags_keys;
    uint8_t keyCount  = (sel == 0) ? 11 : 1;

    OptionList kv;
    for (uint8_t i = 0; i < keyCount; i++) {
