// ── Pasaport ana sayfası çiz (Flipper Zero stil) ─────────
// Sol %40: dolphin animasyonu (64×36 → 48×27 ölçekli)
// Sağ %60: seviye, rank, XP bar, cihaz adı
static void passportDrawPage1(const String& devName, uint8_t animFrame) {
    dispClear();

    // ── Status bar ──────────────────────────────────────
    display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK); display.setTextSize(1);
    display.setCursor(28, 2); display.print("Hacker Passport");
    display.setTextColor(SSD1306_WHITE);

    // ── Sol: Dolphin animasyonu (48×27, sol alt köşe) ───
    // Level'a göre hangi frame seti — L1/L2/L3
    const uint8_t* framePtr = EXT_L1_LAPTOP_F0;
    if      (g_level >= 20) framePtr = (animFrame % 2 == 0) ? EXT_L3_FREEDOM_F0 : EXT_L3_FREEDOM_F1;
    else if (g_level >= 10) framePtr = (animFrame % 2 == 0) ? EXT_L2_HACKPC_F0   : EXT_L2_HACKPC_F1;
    else                    framePtr = (animFrame % 2 == 0) ? EXT_L1_LAPTOP_F0   : EXT_L1_LAPTOP_F1;

    // 64×36 px frame'i 48×27 olarak ölçekleyerek çiz (her 4/3 piksel bir piksel)
    // Basit nearest-neighbor: src piksel (sx,sy) → dst piksel (dx,dy)
    // dst 48×27, sol=0, üst=13
    for (int dy = 0; dy < 27; dy++) {
        int sy = (dy * ANI_H) / 27;
        for (int dx = 0; dx < 48; dx++) {
            int sx = (dx * ANI_W) / 48;
            int byteIdx = sy * 8 + (sx / 8);
            int bitIdx  = 7 - (sx % 8);
            uint8_t b = pgm_read_byte(framePtr + byteIdx);
            if (b & (1 << bitIdx))
                display.drawPixel(dx, 13 + dy, SSD1306_WHITE);
        }
    }

    // ── Sağ panel (x=50..127) ───────────────────────────
    uint8_t pct = xpLevelPct();
    uint32_t toNext = (g_level < XP_MAX_LEVEL)
        ? (xpForLevel(g_level + 1) - g_xp) : 0;

    // Cihaz adı (max 10 karakter sığar)
    display.setTextSize(1); display.setTextColor(SSD1306_WHITE);
    String nameDisp = devName.length() > 10 ? devName.substring(0, 10) : devName;
    display.setCursor(51, 13);
    display.print(nameDisp);

    // Seviye + rank
    display.setCursor(51, 23);
    display.print("Lv." + String(g_level));
    display.setCursor(51, 32);
    String rank = xpRankName(g_level);
    if (rank.length() > 9) rank = rank.substring(0, 9);
    display.print(rank);

    // XP bar (78px genişlik, sağ panel altı)
    display.drawRect(50, 43, 78, 5, SSD1306_WHITE);
    uint8_t barW = map(pct, 0, 100, 0, 76);
    if (barW > 0) display.fillRect(51, 44, barW, 3, SSD1306_WHITE);

    // XP sayı
    display.setCursor(51, 50);
    display.print(String(g_xp) + "xp");
    if (g_level < XP_MAX_LEVEL) {
        String nxt = "-" + String(toNext);
        display.setCursor(OLED_W - nxt.length()*6, 50);
        display.print(nxt);
    }

    // Gezinme hint
    display.setCursor(0, 57);
    display.print("Joy:page  Btn:exit");

    dispCommit();
}

