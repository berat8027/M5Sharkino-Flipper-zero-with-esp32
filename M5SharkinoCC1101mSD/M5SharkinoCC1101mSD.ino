static void wifi_probe_sniffer_run() {
    g_probeList.clear();
    g_sniffPkts = g_sniffBeacon = g_sniffProbe = g_sniffData = g_sniffMgmt = g_sniffCtrl = 0;

    wifiInitForRawTx();
    esp_wifi_set_promiscuous_rx_cb(promiscCallback);

    uint8_t ch = 1;
    uint32_t lastSwitch = millis();
    uint32_t lastDraw   = 0;

    while (!readButtonLong()) {
        if (millis() - lastSwitch > g_cfg.scanDwellMs) {
            ch = (ch % 13) + 1;
            esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);
            lastSwitch = millis();
        }
        if (millis() - lastDraw > 250) {
            lastDraw = millis();
            dispClear();
            dispStatusBar("Probe Sniffer");
            dispText(0, 12, "Pkts: " + String(g_sniffPkts));
            dispText(0, 22, "Probes: " + String(g_sniffProbe));
            dispText(0, 32, "Beacons: " + String(g_sniffBeacon));
            dispText(0, 42, "Devs: " + String(g_probeList.size()));
            dispText(0, 52, "Ch:" + String(ch) + " [LONG]done");
            dispCommit();
        }
        delay(20);
    }
    esp_wifi_set_promiscuous(false);
    esp_wifi_set_promiscuous_rx_cb(nullptr);

    // Log all probe requests
    for (auto& p : g_probeList) {
        logPush("[PROBE] " + p.mac + " -> " + (p.ssid.isEmpty() ? "[wildcard]" : p.ssid) +
                " (" + String(p.count) + "x)");
    }

    // Show results
    if (g_probeList.empty()) { dispBanner("No probes captured"); WiFi.mode(WIFI_OFF); return; }
    g_xpWifiCnt++;
    xpAdd(XP_PER_PROBE_SNIFF);

    OptionList items;
    for (auto& p : g_probeList) {
        String label = p.mac.substring(9) + " " + (p.ssid.isEmpty() ? "*" : p.ssid);
        items.push_back({label, [](){}});
    }
    items.push_back({"Back", [](){}});
    loopOptions(items, "Probes (" + String(g_probeList.size()) + ")");
    WiFi.mode(WIFI_OFF);
}

