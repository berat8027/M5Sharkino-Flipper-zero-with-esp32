        // Bulut + aşağı ok, 16x16
        display.drawCircleHelper(x+6, y+5, 3, 0b0001|0b0010, col);
        display.drawCircleHelper(x+10,y+6, 4, 0b0001|0b0010, col);
        display.drawCircleHelper(x+3, y+7, 2, 0b0001|0b0010, col);
        display.drawFastHLine(x+2, y+8, 12, col);
        display.fillTriangle(x+5,y+11, x+11,y+11, x+8,y+15, col);
        display.drawLine(x+8, y+8, x+8, y+11, col);
    }
    void runMenu() override {
        ota_run();
        backToMenu();
    }
};

// ═══════════════════════════════════════════════════════════
//  MAIN MENU — M5Shark tarzı yeniden tasarım
//  Giriş ekranı YOK. Doğrudan ana menü açılır.
//  Üst bar: cihaz durumu (WiFi/BLE/RFID LED gösterge)
//  Orta:    büyük seçilen ikon (32x32) + 2 komşu (16x16)
//  Alt:     modül adı (büyük) + kısa açıklama
//  Navigasyon: L/R = modül değiştir, BTN = gir, LONG = (ana menüde yok)
// ═══════════════════════════════════════════════════════════

class MainMenu {
public:
    MainMenu() {
        items.push_back(new WiFiMenu());
        items.push_back(new BLEMenu());
        items.push_back(new CC1101Menu());
        items.push_back(new RFIDMenu());
        items.push_back(new AnalogLabMenu());
        items.push_back(new NetAnalMenu());
        items.push_back(new CryptoMenu());
        items.push_back(new GamesMenu());
        items.push_back(new ToolsMenu());
        items.push_back(new ConfigMenu());
        items.push_back(new InfoMenu());
        items.push_back(new OTAMenuItem());
    }
    ~MainMenu() { for (auto* m : items) delete m; }

    void run() {
        static int  sel      = 0;
        static bool animDone = false;
        int total = (int)items.size();

        // İlk girişte kısa slide-in animasyonu
        if (!animDone) {
            animDone = true;
            slideInAnim(sel);
        }

        while (true) {
            render(sel);
            JoyDir d = readJoystick();

            int prevSel = sel;
            if (d == JoyDir::RIGHT) sel = (sel + 1) % total;
            if (d == JoyDir::LEFT)  sel = (sel - 1 + total) % total;

            // Geçiş animasyonu
            if (sel != prevSel) {
                slideTransition(prevSel, sel);
            }

            if (readButton()) {
                if (!pinLockCheck()) continue;
                // Seçim flash efekti
                selectFlash(sel);
                g_returnToMenu = false;
                items[sel]->runMenu();
                g_returnToMenu = false;
                // Menüye dönüşte tekrar render
                render(sel);
            }
            delay(8);
        }
    }

private:
    std::vector<MenuItem*> items;

    // ── Durum çubuğu (üst 12px) ──────────────────────────
    void drawStatusBar() {
        // Siyah arka plan üstüne ince beyaz çizgi
        display.drawFastHLine(0, 11, OLED_W, SSD1306_WHITE);

        // Sol: Flipper Zero tarzı şimşek/F ikonu (8x9 px)
        // Üst-sağ köşeden sol-alta inen şimşek
        display.drawLine(6, 1,  3, 5,  SSD1306_WHITE);
        display.drawLine(3, 5,  6, 5,  SSD1306_WHITE);
        display.drawLine(6, 5,  2, 10, SSD1306_WHITE);
        display.drawLine(2, 10, 5, 6,  SSD1306_WHITE);
        display.drawLine(5, 6,  3, 6,  SSD1306_WHITE);

        // Merkez: "M5Sharkino"
        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(14, 2);
        display.print("M5Sharkino");

        // Sağ: Durum göstergeleri (WiFi W, BLE B, RFID R)
        // Her biri: dolu=aktif, boş çerçeve=kapalı
        uint8_t ix = OLED_W - 28;
        // W
        if (g_cfg.wifiEnabled) {
            display.fillRect(ix, 1, 7, 9, SSD1306_WHITE);
            display.setTextColor(SSD1306_BLACK);
        } else {
            display.drawRect(ix, 1, 7, 9, SSD1306_WHITE);
            display.setTextColor(SSD1306_WHITE);
        }
        display.setCursor(ix+1, 2); display.print("W");
        display.setTextColor(SSD1306_WHITE);
        ix += 9;
        // B
        if (g_cfg.bleEnabled) {
            display.fillRect(ix, 1, 7, 9, SSD1306_WHITE);
            display.setTextColor(SSD1306_BLACK);
        } else {
            display.drawRect(ix, 1, 7, 9, SSD1306_WHITE);
            display.setTextColor(SSD1306_WHITE);
        }
        display.setCursor(ix+1, 2); display.print("B");
        display.setTextColor(SSD1306_WHITE);
        ix += 9;
        // R
        if (g_cfg.rfidEnabled) {
            display.fillRect(ix, 1, 7, 9, SSD1306_WHITE);
            display.setTextColor(SSD1306_BLACK);
        } else {
            display.drawRect(ix, 1, 7, 9, SSD1306_WHITE);
            display.setTextColor(SSD1306_WHITE);
        }
        display.setCursor(ix+1, 2); display.print("R");
        display.setTextColor(SSD1306_WHITE);
    }

    // ── Ikon alanı (y:13 – y:46, 34px yüksek) ───────────
    // Seçili: merkez 32x32 beyaz dolgu + siyah ikon
    // Sol/sağ: 16x16 çerçeve + harf
    void drawIconArea(int sel) {
        int total = (int)items.size();

        // Sol komşu (varsa)
        int leftIdx = (sel - 1 + total) % total;
        if (leftIdx != sel) {
            int lx = 4, ly = 21;
            display.drawRoundRect(lx, ly, 16, 16, 2, SSD1306_WHITE);
            // drawIconSmall ile gerçek ikonu çiz
            items[leftIdx]->drawIconSmall(lx, ly, SSD1306_WHITE);
            // Küçük sol ok
            display.drawLine(lx - 1, ly+7, lx+3, ly+4, SSD1306_WHITE);
            display.drawLine(lx - 1, ly+7, lx+3, ly+10, SSD1306_WHITE);
        }

        // Sağ komşu (varsa)
        int rightIdx = (sel + 1) % total;
        if (rightIdx != sel) {
            int rx = OLED_W - 20, ry = 21;
            display.drawRoundRect(rx, ry, 16, 16, 2, SSD1306_WHITE);
            // drawIconSmall ile gerçek ikonu çiz
            items[rightIdx]->drawIconSmall(rx, ry, SSD1306_WHITE);
            // Küçük sağ ok
            int arx = OLED_W - 2;
            display.drawLine(arx, ry+7, arx-4, ry+4, SSD1306_WHITE);
            display.drawLine(arx, ry+7, arx-4, ry+10, SSD1306_WHITE);
        }

        // Merkez seçili ikon — 32x32, y=13
        int sx = (OLED_W - 32) / 2;
        int sy = 13;
        // Beyaz dolgu kutu
        display.fillRoundRect(sx - 2, sy - 1, 36, 34, 3, SSD1306_WHITE);
        // Siyah ikon (inversed)
        items[sel]->drawIconInv(sx, sy);
    }

    // ── Alt bilgi çubuğu (y:48 – y:63) ─────────────────
    // Modül adı büyük + altında sayfa göstergesi (nokta dizisi)
    void drawBottomBar(int sel) {
        int total = (int)items.size();

        // İnce ayırıcı çizgi
        display.drawFastHLine(0, 47, OLED_W, SSD1306_WHITE);

        // Modül adı — sola hizalı, text size 1
        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);
        String nm = items[sel]->getName();
        display.setCursor(2, 50);
        display.print(nm);

        // Sağda: sayfa numarası n/total
        String pg = String(sel + 1) + "/" + String(total);
        display.setCursor(OLED_W - (int)pg.length() * 6 - 2, 50);
        display.print(pg);

        // Nokta indikatörleri — alt satır (y=59)
        int dotTotal = min(total, 11);
        int dotStart = max(0, min(sel - 5, total - dotTotal));
        int dotStep  = 10;
        int dotY     = 59;
        int totalW   = dotTotal * dotStep - 2;
        int dotX     = (OLED_W - totalW) / 2;
        for (int i = 0; i < dotTotal; i++) {
            int realIdx = dotStart + i;
            int dx = dotX + i * dotStep;
            if (realIdx == sel) {
                // Seçili: dolu dikdörtgen
                display.fillRect(dx, dotY, 6, 4, SSD1306_WHITE);
            } else {
                // Diğer: çerçeve
                display.drawRect(dx, dotY, 4, 4, SSD1306_WHITE);
            }
        }
    }

    // ── Ana render ────────────────────────────────────────
    void render(int sel) {
        potApplyBrightness();
        dispClear();
        drawStatusBar();
        drawIconArea(sel);
        drawBottomBar(sel);
        dispCommit();
    }

    // ── Geçiş animasyonu: x-ekseni kayma ─────────────────
    void slideTransition(int from, int to) {
        // Yön belirle
        int total = (int)items.size();
        bool goRight = ((to - from + total) % total == 1) ||
                       ((to - from + total) % total <= total / 2 && to > from);
        // Kısaca: 3 frame kayma
        for (int step = 1; step <= 3; step++) {
            potApplyBrightness();
            dispClear();
            drawStatusBar();
            drawBottomBar(to);
            // Ikon alanı - kademeli kayma (sadece ikon bölgesi)
            int sx = (OLED_W - 32) / 2;
            int sy = 13;
            int offset = goRight ? (3 - step) * 14 : -(3 - step) * 14;
            display.fillRoundRect(sx - 2 + offset, sy - 1, 36, 34, 3, SSD1306_WHITE);
            items[to]->drawIconInv(sx + offset, sy);
            dispCommit();
            delay(20);
        }
        // Final frame
        render(to);
    }

    // ── Seçim flash efekti ────────────────────────────────
    void selectFlash(int sel) {
        for (int i = 0; i < 2; i++) {
            dispClear();
            int sx = (OLED_W - 32) / 2;
            int sy = 13;
            // Sadece ikon kutusunu flaşla
            display.fillRoundRect(sx - 4, sy - 3, 40, 38, 4, SSD1306_WHITE);
            items[sel]->drawIconInv(sx, sy);
            dispCommit();
            delay(45);
            render(sel);
            delay(30);
        }
    }

    // ── İlk açılış slide-in animasyonu ───────────────────
    void slideInAnim(int sel) {
        for (int y = -40; y <= 0; y += 8) {
            dispClear();
            drawStatusBar();
            // İkon yukarıdan aşağı iner
            int sx = (OLED_W - 32) / 2;
            display.fillRoundRect(sx - 2, 13 + y, 36, 34, 3, SSD1306_WHITE);
            items[sel]->drawIconInv(sx, 13 + y);
            drawBottomBar(sel);
            dispCommit();
            delay(18);
        }
    }
};

