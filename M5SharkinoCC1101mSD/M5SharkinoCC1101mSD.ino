static void tools_adc_wave_run() {
    OptionList pins = {
        {"JOY_X (pin 1)", [](){}},
        {"JOY_Y (pin 2)", [](){}},
        {"POT   (pin 3)", [](){}},
        {"Back",          [](){}},
    };
    int psel = loopOptions(pins, "ADC Waveform");
    if (psel < 0 || psel == 3) return;
    uint8_t pin = (psel == 0) ? PIN_JOY_X : (psel == 1) ? PIN_JOY_Y : PIN_POT;

    uint16_t hist[ADC_HISTORY_LEN] = {0};
    uint8_t  hi = 0;
    uint16_t mn = 4095, mx = 0;

    while (!readButton()) {
        uint16_t v = analogRead(pin);
        hist[hi % ADC_HISTORY_LEN] = v;
        hi++;
        if (v < mn) mn = v;
        if (v > mx) mx = v;

        dispClear(); dispStatusBar("ADC pin " + String(pin));
        dispText(0, 12, "Val:" + String(v) + " Min:" + String(mn));
        dispText(0, 22, "Max:" + String(mx) + " Rng:" + String(mx-mn));
        // Waveform in bottom 32px
        display.drawRect(0, 30, OLED_W, 30, SSD1306_WHITE);
        uint16_t range = max((uint16_t)1, (uint16_t)(mx - mn));
        for (uint8_t i = 1; i < ADC_HISTORY_LEN && i < hi; i++) {
            uint16_t v0 = hist[(hi - i - 1 + ADC_HISTORY_LEN) % ADC_HISTORY_LEN];
            uint16_t v1 = hist[(hi - i     + ADC_HISTORY_LEN) % ADC_HISTORY_LEN];
            uint8_t y0 = 59 - map(v0, mn, mn+range, 0, 28);
            uint8_t y1 = 59 - map(v1, mn, mn+range, 0, 28);
            uint8_t x0 = OLED_W - i;
            uint8_t x1 = OLED_W - i + 1;
            if (x0 > 1 && x1 < OLED_W-1)
                display.drawLine(x0, y0, x1, y1, SSD1306_WHITE);
        }
        dispText(0, 56, "[BTN] back");
        dispCommit();
        delay(25);
    }
}

// ─── SPI Cihaz Durumu (Güvenli Kontrol) ───────────────────
// Her CS pinini LOW çekip MISO/MOSI üzerinden probe eder.
// Yanlış sonuç vermemek için sadece bilinen CS pinlerini
// dener ve init state'e bakar — ham SPI tarama YAPMAZ.
static void tools_spi_devices_run() {
    struct SPIDevice {
        const char* name;
        uint8_t     csPin;
        bool        (*checkFn)();  // nullptr ise sadece CS probe
    };

    // Sadece bu projedeki bilinen SPI cihazları
    // CC1101: version register 0x31 → beklenen 0x14
    auto checkCC1101 = []() -> bool {
        if (!g_cc1101Inited) return false;
        // Zaten init olduysa çalışıyor demektir
        // Ek doğrulama: version register'ı oku
        digitalWrite(PIN_CC1101_SS, LOW);
        delayMicroseconds(10);
        SPI.transfer(0x31 | 0xC0); // PARTNUM status register
        uint8_t ver = SPI.transfer(0x00);
        digitalWrite(PIN_CC1101_SS, HIGH);
        // CC1101 version = 0x14, bazı klonlarda 0x04 veya 0x05
        return (ver != 0x00 && ver != 0xFF); // Herhangi bir cevap = CC1101 var
    };

    // MFRC522: version register 0x37 → 0x91 veya 0x92
    auto checkRFID = []() -> bool {
        // CS LOW → byte gönder → cevap kontrol
        digitalWrite(PIN_RFID_SS, LOW);
        delayMicroseconds(10);
        SPI.transfer(0x37 << 1 | 0x80); // VersionReg read
        uint8_t ver = SPI.transfer(0x00);
        digitalWrite(PIN_RFID_SS, HIGH);
        return (ver == 0x91 || ver == 0x92 || ver == 0x88);
    };

    // SD: CMD0 (GO_IDLE_STATE) → 0x01 beklenir
    auto checkSD = []() -> bool {
        return g_sdInited; // SD.begin() sonucunu kullan — probe risksiz
    };

    dispClear(); dispStatusBar("SPI Cihazlar");
    dispText(0, 12, "Kontrol ediliyor...");
    dispCommit();
    delay(300);

    // SPI bus'ı güvenli hale getir — tüm CS HIGH
    digitalWrite(PIN_CC1101_SS, HIGH);
    digitalWrite(PIN_RFID_SS,   HIGH);
    digitalWrite(PIN_SD_CS,     HIGH);
    delay(10);

    // Sonuçları topla
    struct Result {
        const char* name;
        uint8_t     csPin;
        bool        ok;
        String      detail;
    };
    std::vector<Result> results;

    // CC1101 kontrolü
    {
        bool ok = checkCC1101();
        String det = "";
        if (ok) {
            // Frekans bilgisini ekle
            det = String(g_cc1101Freq, 2) + "MHz";
        }
        results.push_back({"CC1101", PIN_CC1101_SS, ok, det});
    }
    // Tüm CS tekrar HIGH
    digitalWrite(PIN_CC1101_SS, HIGH);
    delay(5);

    // RFID kontrolü
    {
        bool ok = checkRFID();
        results.push_back({"MFRC522", PIN_RFID_SS, ok, ok ? "MIFARE" : ""});
    }
    digitalWrite(PIN_RFID_SS, HIGH);
    delay(5);

    // SD kontrolü (probe yok, init durumuna bak)
    {
        bool ok = checkSD();
        String det = "";
        if (ok) {
            uint64_t sz = SD.cardSize() / (1024ULL * 1024ULL);
            det = String((uint32_t)sz) + "MB";
        }
        results.push_back({"SD Card", PIN_SD_CS, ok, det});
    }

    // I2C cihazları (OLED — bilinen adres)
    // Wire.begin zaten yapıldı, sadece 0x3C'yi kontrol et
    {
        Wire.beginTransmission(0x3C);
        bool ok = (Wire.endTransmission() == 0);
        results.push_back({"OLED SSD1306", 0x3C, ok, ok ? "I2C 0x3C" : ""});
    }

    // Ekrana yaz
    dispClear(); dispStatusBar("SPI/I2C Cihazlar");

    uint8_t yPos = 10;
    uint8_t found = 0;
    for (auto& r : results) {
        if (yPos > 54) break;
        String line = String(r.ok ? "[+] " : "[-] ") + r.name;
        if (r.ok && r.detail.length() > 0) {
            // CS pin bilgisi
            if (String(r.name) != "OLED SSD1306")
                line += " CS:" + String(r.csPin);
            line += " " + r.detail;
        } else if (!r.ok) {
            if (String(r.name) != "OLED SSD1306")
                line += " CS:" + String(r.csPin);
        }
        dispText(0, yPos, line);
        yPos += 10;
        if (r.ok) found++;
    }

    // SPI bus bilgisi
    yPos += 2;
    if (yPos < 54) {
        dispText(0, yPos, "SCK:" + String(PIN_SPI_SCK)
                        + " MOSI:" + String(PIN_SPI_MOSI)
                        + " MISO:" + String(PIN_SPI_MISO));
    }
    dispText(0, 56, String(found) + "/" + String(results.size())
                  + " aktif  [BTN] cik");
    dispCommit();

    logPush("[SPI_DEV] found=" + String(found) + "/" + String(results.size()));
    while (!readButton()) {
        if (readButtonLong()) break;
        delay(30);
    }
}

static void tools_i2c_scan_run() {
    dispProgress("I2C Scan", "Scanning 1..127", 10);
    std::vector<uint8_t> found;
    for (uint8_t a = 1; a < 127; a++) {
        Wire.beginTransmission(a);
        if (Wire.endTransmission() == 0) {
            found.push_back(a);
            logPush("[I2C] 0x" + String(a, HEX));
        }
    }
    dispClear(); dispStatusBar("I2C Scan");
    dispText(0, 12, "Found: " + String(found.size()));
    for (uint8_t i = 0; i < found.size() && i < 5; i++) {
        char buf[18]; sprintf(buf, "0x%02X", found[i]);
        // Known device names
        const char* name = "?";
        switch (found[i]) {
            case 0x3C: name="SSD1306/SH1106"; break;
            case 0x3D: name="SSD1306"; break;
            case 0x68: name="MPU6050/DS3231"; break;
            case 0x76: name="BMP280/BME280"; break;
            case 0x77: name="BMP280/BME680"; break;
            case 0x48: name="ADS1115"; break;
            case 0x57: name="AT24Cxx EEPROM"; break;
        }
        dispText(0, 22 + i*8, String(buf) + " " + name);
    }
    dispText(0, 56, "[BTN] back");
    dispCommit();
    while (!readButton()) delay(50);
}

static void tools_sysinfo_run() {
    OptionList pages = {
        {"CPU / Memory",  [](){}},
        {"Flash / SDK",   [](){}},
        {"Chip Info",     [](){}},
        {"Back",          [](){}},
    };
    int sel = loopOptions(pages, "System Info");
    if (sel < 0 || sel == 3) return;

    dispClear();
    switch (sel) {
        case 0:
            dispStatusBar("CPU / Memory");
            dispText(0, 12, "CPU: " + String(ESP.getCpuFreqMHz()) + "MHz");
            dispText(0, 22, "Cores: 2 (Xtensa LX7)");
            dispText(0, 32, "Free heap: " + String(ESP.getFreeHeap()/1024) + "KB");
            dispText(0, 42, "Min free: " + String(ESP.getMinFreeHeap()/1024) + "KB");
            dispText(0, 52, "PSRAM: " + String(ESP.getPsramSize()/1024) + "KB");
            break;
        case 1:
            dispStatusBar("Flash / SDK");
            dispText(0, 12, "Flash: " + String(ESP.getFlashChipSize()/1048576) + "MB");
            dispText(0, 22, "Flash spd: " + String(ESP.getFlashChipSpeed()/1000000) + "MHz");
            dispText(0, 32, "Sketch: " + String(ESP.getSketchSize()/1024) + "KB");
            dispText(0, 42, "Free: " + String(ESP.getFreeSketchSpace()/1024) + "KB");
            dispText(0, 52, String(ESP.getSdkVersion()).substring(0,22));
            break;
        case 2:
            dispStatusBar("Chip Info");
            dispText(0, 12, "Model: ESP32-S3");
            dispText(0, 22, "Rev: " + String(ESP.getChipRevision()));
            dispText(0, 32, "MAC: " + WiFi.macAddress());
