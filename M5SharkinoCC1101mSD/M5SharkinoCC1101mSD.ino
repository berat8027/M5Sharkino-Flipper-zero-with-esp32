// ─── İÇ MENÜ: Games - Tetris ─────────────────────────────

static void game_tetris_run() {
    static constexpr uint8_t TW = 10;  // oyun alanı genişliği (blok)
    static constexpr uint8_t TH = 8;   // oyun alanı yüksekliği (blok)
    static constexpr uint8_t BS = 6;   // blok boyutu (piksel)

    uint8_t board[TH][TW] = {};

    // 7 Tetromino (SRS: I, O, T, S, Z, J, L — 2x4 pivotlar)
    static const int8_t PIECES[7][4][2] = {
        {{0,0},{1,0},{2,0},{3,0}}, // I
        {{0,0},{1,0},{0,1},{1,1}}, // O
        {{1,0},{0,1},{1,1},{2,1}}, // T
        {{1,0},{2,0},{0,1},{1,1}}, // S
        {{0,0},{1,0},{1,1},{2,1}}, // Z
        {{0,0},{0,1},{1,1},{2,1}}, // J
        {{2,0},{0,1},{1,1},{2,1}}, // L
    };

    uint8_t curPiece = random(7);
    int8_t  px = 3, py = 0;
    uint32_t score = 0, dropInterval = 600;
    uint32_t lastDrop = millis();

    auto drawBoard = [&]() {
        dispClear(); dispStatusBar("Tetris Scr:" + String(score));
        // Alan çerçevesi
        display.drawRect(0, 11, TW*BS+2, TH*BS+2, SSD1306_WHITE);
        // Tahta
        for (uint8_t r = 0; r < TH; r++)
            for (uint8_t c = 0; c < TW; c++)
                if (board[r][c]) display.fillRect(1+c*BS, 12+r*BS, BS-1, BS-1, SSD1306_WHITE);
        // Mevcut parça
        for (int b = 0; b < 4; b++) {
            int8_t bx = px + PIECES[curPiece][b][0];
            int8_t by = py + PIECES[curPiece][b][1];
            if (bx >= 0 && bx < TW && by >= 0 && by < TH)
                display.fillRect(1+bx*BS, 12+by*BS, BS-1, BS-1, SSD1306_WHITE);
        }
        // Sağda bilgi
        dispText(TW*BS+6, 14, "Nxt:");
        uint8_t np = (curPiece + 1) % 7;
        for (int b = 0; b < 4; b++) {
            uint8_t nx = TW*BS+8 + PIECES[np][b][0]*5;
            uint8_t ny = 24 + PIECES[np][b][1]*5;
            display.fillRect(nx, ny, 4, 4, SSD1306_WHITE);
        }
        dispText(TW*BS+4, 44, String(dropInterval > 200 ? "Slow" : "Fast"));
        dispCommit();
    };

    auto canMove = [&](int8_t dx, int8_t dy, uint8_t piece) -> bool {
        for (int b = 0; b < 4; b++) {
            int8_t nx = px + dx + PIECES[piece][b][0];
            int8_t ny = py + dy + PIECES[piece][b][1];
            if (nx < 0 || nx >= TW || ny >= TH) return false;
            if (ny >= 0 && board[ny][nx]) return false;
        }
        return true;
    };

    auto lockPiece = [&]() {
        for (int b = 0; b < 4; b++) {
            int8_t bx = px + PIECES[curPiece][b][0];
            int8_t by = py + PIECES[curPiece][b][1];
            if (by >= 0 && by < TH && bx >= 0 && bx < TW) board[by][bx] = 1;
        }
        // Clear full lines
        for (uint8_t r = 0; r < TH; r++) {
            bool full = true;
            for (uint8_t c = 0; c < TW; c++) if (!board[r][c]) { full = false; break; }
            if (full) {
                score += 100;
                for (uint8_t rr = r; rr > 0; rr--) memcpy(board[rr], board[rr-1], TW);
                memset(board[0], 0, TW);
            }
        }
        curPiece = random(7); px = 3; py = 0;
        if (dropInterval > 200) dropInterval -= 20;
    };

    while (true) {
        potApplyBrightness();
        JoyDir d = readJoystick();
        if (d == JoyDir::LEFT  && canMove(-1, 0, curPiece)) px--;
        if (d == JoyDir::RIGHT && canMove( 1, 0, curPiece)) px++;
        if (d == JoyDir::DOWN  && canMove( 0, 1, curPiece)) { py++; lastDrop = millis(); }
        if (readButtonLong()) break;
        if (readButton()) {
            // Rotate (basit CW: transpose + yatay flip — sadece bazı parçalar için)
            // TODO: gerçek SRS rotation (kısa tutmak için skip)
        }

        // Auto drop
        if (millis() - lastDrop > dropInterval) {
            if (canMove(0, 1, curPiece)) { py++; }
            else {
                lockPiece();
                // Game over check
                for (uint8_t c = 0; c < TW; c++) {
                    if (board[0][c]) { xpAdd(XP_PER_GAME_PLAY); dispBannerErr("Game Over! " + String(score)); return; }
                }
            }
            lastDrop = millis();
        }
        drawBoard();
        delay(25);
    }
    if (score > 0) { g_xpGameCnt++; xpAdd(XP_PER_GAME_WIN); }
    dispBannerOK("Score: " + String(score));
}

// ─── İÇ MENÜ: Games - Flappy Bird (Flipper tarzı) ────────

static void game_flappy_run() {
    int16_t birdY = 32;
    int16_t birdVY = 0;
    int16_t pipeX = 128, pipeGapY = 20;
    uint32_t score = 0;
    uint32_t lastFrame = millis();
    bool died = false;

    while (!died) {
        potApplyBrightness();
        uint32_t now = millis();
        if (now - lastFrame < 30) { delay(5); continue; }
        lastFrame = now;

        // Physics
        birdVY += 2; // gravity
        if (birdVY > 12) birdVY = 12;
        birdY += birdVY / 2;

        // Flap
        JoyDir d = readJoystick();
        if (d == JoyDir::UP || readButton()) { birdVY = -8; }
        if (readButtonLong()) break;

        // Pipe
        pipeX -= 3;
        if (pipeX < -8) {
            pipeX = 128;
            pipeGapY = random(8, OLED_H - 8 - 16);
            score++;
        }

        // Collision
        if (birdY < 12 || birdY > OLED_H - 3) died = true;
        if (pipeX < 20 && pipeX > 4) {
            if (birdY < pipeGapY + 12 || birdY > pipeGapY + 12 + 16) died = true;
        }

        // Draw
        dispClear(); dispStatusBar("Flappy Scr:" + String(score));
        // Bird (small square)
        display.fillRect(10, birdY - 2, 5, 5, SSD1306_WHITE);
        // Pipe top
        display.fillRect(pipeX, 12, 8, pipeGapY, SSD1306_WHITE);
        // Pipe bottom
        display.fillRect(pipeX, pipeGapY + 12 + 16, 8, OLED_H - pipeGapY - 28, SSD1306_WHITE);
        // Ground
        display.drawFastHLine(0, OLED_H - 1, OLED_W, SSD1306_WHITE);
        dispText(96, 14, String(score));
        dispCommit();
    }
    xpAdd(XP_PER_GAME_PLAY);
    dispBannerErr("Dead! Score:" + String(score));
}

// ─── Breakout (Arkanoid) ─────────────────────────────────
static void game_breakout_run() {
    static constexpr uint8_t ROWS  = 3;
    static constexpr uint8_t COLS  = 8;
    static constexpr uint8_t BW    = 14;
    static constexpr uint8_t BH    = 5;
    static constexpr uint8_t PAD_W = 20;
    static constexpr uint8_t PAD_H = 3;
    static constexpr uint8_t PAD_Y = OLED_H - 5;

    uint8_t bricks[ROWS][COLS];
    for (uint8_t r=0; r<ROWS; r++)
        for (uint8_t c=0; c<COLS; c++)
            bricks[r][c] = 1;

    int16_t padX = 54;
    int16_t ballX = 64, ballY = 40;
    int8_t  bdx = 2, bdy = -2;
    uint32_t score = 0;
    uint8_t  lives = 3;

    while (lives > 0) {
        potApplyBrightness();
        JoyDir d = readJoystick();
        if (d == JoyDir::LEFT  && padX > 0)             padX -= 4;
        if (d == JoyDir::RIGHT && padX < OLED_W-PAD_W)  padX += 4;
        if (readButtonLong()) break;

        ballX += bdx; ballY += bdy;
        if (ballX <= 1 || ballX >= OLED_W-2) bdx = -bdx;
        if (ballY <= 12) bdy = abs(bdy);
        if (ballY >= PAD_Y - 2 && ballX >= padX && ballX <= padX+PAD_W) {
            bdy = -abs(bdy);
            int8_t spin = (ballX - (padX + PAD_W/2)) / 4;
            bdx = constrain(bdx + spin, -4, 4);
            if (bdx == 0) bdx = 1;
        }
        if (ballY > OLED_H) {
            lives--;
            ballX = padX+PAD_W/2; ballY = 40; bdx=2; bdy=-2;
            if (lives>0) { dispBannerWarn("Life! "+String(lives)+" left",600); }
            continue;
        }
        bool allClear = true;
        for (uint8_t r=0; r<ROWS; r++) {
            for (uint8_t c=0; c<COLS; c++) {
                if (!bricks[r][c]) continue;
                allClear = false;
                uint8_t bx = c*(BW+2)+2, by = 13+r*(BH+2);
                if (ballX>=bx && ballX<=bx+BW && ballY>=by && ballY<=by+BH) {
                    bricks[r][c]=0; bdy=-bdy; score+=10;
                }
            }
        }
        if (allClear) { g_xpGameCnt++; xpAdd(XP_PER_GAME_WIN); dispBannerOK("WIN! "+String(score),2000); return; }
        dispClear();
        display.drawFastHLine(0,11,OLED_W,SSD1306_WHITE);
        dispText(2,2,"Scr:"+String(score));
        for (uint8_t l=0;l<lives;l++) display.fillCircle(110+l*6,5,2,SSD1306_WHITE);
        for (uint8_t r=0;r<ROWS;r++)
            for (uint8_t c=0;c<COLS;c++)
                if (bricks[r][c]) display.fillRect(c*(BW+2)+2,13+r*(BH+2),BW,BH,SSD1306_WHITE);
        display.fillRect(padX,PAD_Y,PAD_W,PAD_H,SSD1306_WHITE);
        display.fillCircle(ballX,ballY,2,SSD1306_WHITE);
        dispText(0,56,"Joy:move Pot:speed");
        dispCommit();
        uint16_t spd = map(analogRead(PIN_POT),0,4095,5,30);
        delay(spd);
    }
    if (lives==0) { xpAdd(XP_PER_GAME_PLAY); dispBannerErr("GAME OVER! "+String(score)); }
    else          { g_xpGameCnt++; xpAdd(XP_PER_GAME_WIN); dispBannerOK("Score: "+String(score)); }
}

// ─── Memory (Simon Says) ─────────────────────────────────
static void game_memory_run() {
    dispClear(); dispStatusBar("Memory Game");
    dispText(0,14,"Watch sequence");
    dispText(0,26,"Repeat: BTN_A/B/C/D");
    dispText(0,42,"Joy BTN = start");
    dispCommit();
    while (!readButton()) delay(50);

    uint8_t seq[32];
    uint8_t seqLen = 0;
    uint32_t score = 0;

    auto flashPanel = [&](uint8_t n, uint32_t ms) {
        const char* labels[] = {"A","B","C","D"};
        uint8_t xs[] = {2,34,66,98};
        dispClear(); dispStatusBar("Memory");
        for (uint8_t i=0;i<4;i++) {
            if (i==n) display.fillRect(xs[i],18,28,28,SSD1306_WHITE);
            else      display.drawRect(xs[i],18,28,28,SSD1306_WHITE);
            display.setTextColor(i==n?SSD1306_BLACK:SSD1306_WHITE);
            display.setTextSize(2);
            display.setCursor(xs[i]+8,26); display.print(labels[i]);
            display.setTextColor(SSD1306_WHITE); display.setTextSize(1);
        }
        dispText(40,52,"Seq:"+String(seqLen));
        dispCommit(); delay(ms);
        dispClear(); dispStatusBar("Memory");
        for (uint8_t i=0;i<4;i++) {
            display.drawRect(xs[i],18,28,28,SSD1306_WHITE);
            display.setTextSize(2); display.setTextColor(SSD1306_WHITE);
            display.setCursor(xs[i]+8,26); display.print(labels[i]);
            display.setTextSize(1);
        }
        dispText(40,52,"Seq:"+String(seqLen)); dispCommit(); delay(200);
    };

    while (true) {
        seq[seqLen++] = random(4);
        if (seqLen>31) { g_xpGameCnt++; xpAdd(XP_PER_GAME_WIN); dispBannerOK("MASTER! "+String(score)+"pts"); return; }
        delay(400);
        for (uint8_t i=0;i<seqLen;i++)
            flashPanel(seq[i], max((uint32_t)150,(uint32_t)(700-seqLen*30)));
        for (uint8_t i=0;i<seqLen;i++) {
            uint32_t t=millis();
            int8_t pressed=-1;
            while (pressed<0 && millis()-t<4000) {
                if (readBtnA()) pressed=0;
                if (readBtnB()) pressed=1;
                if (readBtnC()) pressed=2;
                if (readBtnD()) pressed=3;
                if (readButtonLong()) { dispBannerWarn("Quit"); return; }
                delay(10);
            }
            if (pressed<0) { xpAdd(XP_PER_GAME_PLAY); dispBannerErr("Timeout! "+String(score)); return; }
            flashPanel(pressed,200);
            if (pressed!=seq[i]) { xpAdd(XP_PER_GAME_PLAY); dispBannerErr("Wrong! "+String(score)); delay(800); return; }
            score++;
        }
        dispBannerOK("Correct! +"+String(seqLen),400);
    }
}

// ─── Maze (procedural DFS) ───────────────────────────────
static void game_maze_run() {
    static constexpr uint8_t MW=21, MH=9, CS=6;
    uint8_t walls[MH][MW];
    memset(walls,1,sizeof(walls));
    uint8_t stackX[MW*MH], stackY[MW*MH];
    uint8_t sp=0;
    walls[1][1]=0; stackX[sp]=1; stackY[sp]=1; sp++;
    while (sp>0) {
        uint8_t cx=stackX[sp-1], cy=stackY[sp-1];
        int8_t dx[]={0,0,2,-2}, dy[]={2,-2,0,0};
        for (int i=3;i>0;i--) {
            int j=random(i+1);
            int8_t tx=dx[i],ty=dy[i];
            dx[i]=dx[j];dy[i]=dy[j];dx[j]=tx;dy[j]=ty;
        }
        bool pushed=false;
        for (int i=0;i<4;i++) {
            int8_t nx=cx+dx[i],ny=cy+dy[i];
            if (nx>=1&&nx<MW-1&&ny>=1&&ny<MH-1&&walls[ny][nx]) {
                walls[(cy+ny)/2][(cx+nx)/2]=0; walls[ny][nx]=0;
                stackX[sp]=nx;stackY[sp]=ny;sp++;pushed=true;break;
            }
        }
        if (!pushed) sp--;
    }
    walls[MH-2][MW-2]=0;
    uint8_t px=1,py=1;
    uint32_t steps=0,t0=millis();
    while (true) {
        potApplyBrightness();
        JoyDir d=readJoystick();
        uint8_t npx=px,npy=py;
        if (d==JoyDir::UP    && py>0    && !walls[py-1][px]) npy--;
        if (d==JoyDir::DOWN  && py<MH-1 && !walls[py+1][px]) npy++;
        if (d==JoyDir::LEFT  && px>0    && !walls[py][px-1]) npx--;
        if (d==JoyDir::RIGHT && px<MW-1 && !walls[py][px+1]) npx++;
        if (npx!=px||npy!=py) { px=npx;py=npy;steps++; }
        if (readButtonLong()) { dispBannerWarn("Quit"); return; }
        if (px==MW-2&&py==MH-2) {
            uint32_t secs=(millis()-t0)/1000;
            g_xpGameCnt++; xpAdd(XP_PER_GAME_WIN);
            dispBannerOK("SOLVED! "+String(steps)+"s "+String(secs)+"s",2000);
            return;
        }
        dispClear();
        display.drawFastHLine(0,11,OLED_W,SSD1306_WHITE);
        dispText(2,2,"Steps:"+String(steps));
        for (uint8_t r=0;r<MH;r++)
            for (uint8_t c=0;c<MW;c++)
                if (walls[r][c]) display.fillRect(c*CS,12+r*CS,CS,CS,SSD1306_WHITE);
        display.fillCircle(px*CS+CS/2,12+py*CS+CS/2,CS/2-1,SSD1306_WHITE);
        display.drawRect((MW-2)*CS,12+(MH-2)*CS,CS,CS,SSD1306_WHITE);
        dispCommit();
        delay(map(analogRead(PIN_POT),0,4095,20,150));
    }
}

// ╔══════════════════════════════════════════════════════════════════╗
// ║  FLIPPER COMPATIBILITY PACK — M5Sharkino v3 Extension           ║
// ║  1. Flipper dosya formatları: .sub / .ir / .nfc parse & save    ║
// ║  2. Plugin/App sistemi: SD'den .fap script yükle & çalıştır     ║
// ║  3. BLE UART servisi + BLE Proximity (RSSI tabanlı)             ║
// ╚══════════════════════════════════════════════════════════════════╝

// ════════════════════════════════════════════════════════════════════
//  BÖLÜM 1 — FLIPPER DOSYA FORMATLARI
//  Flipper Zero'nun .sub (Sub-GHz), .ir (Infrared), .nfc dosyalarını
//  SD karttan okuyup çalıştırır; ve mevcut yakalamaları bu formatta
//  SD'ye kaydeder.
//
//  Referans: https://github.com/flipperdevices/flipperzero-firmware
//  Dosya formatı spec: flipper_format (text key-value)
// ════════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════════
//  FLIPPER SD — EK DOSYA FORMATLARI
//  .rfid (LFRFID), .ibtn (iButton), çoklu sinyal .sub, log görüntüleyici
// ════════════════════════════════════════════════════════════════════


// ─── M5FAP Script Ayrıştırıcı ─────────────────────────────────────
static std::vector<FAPLine> fap_parse(const String& path) {
    std::vector<FAPLine> lines;
    File f = SD.open(path.c_str(), FILE_READ);
    if (!f) { dispBannerErr(".fap ac: " + path); return lines; }

    while (f.available()) {
        String line = f.readStringUntil('\n');
        line.trim();
        if (line.isEmpty() || line.startsWith("#")) continue;

        int sp = line.indexOf(' ');
        String cmd = (sp > 0) ? line.substring(0, sp) : line;
        String arg = (sp > 0) ? line.substring(sp + 1) : "";
        cmd.trim(); arg.trim();
        cmd.toUpperCase();

        FAPLine fl;
        fl.arg = arg;
        if      (cmd == "TITLE")      fl.cmd = FAPCmd::TITLE;
        else if (cmd == "PRINT")      fl.cmd = FAPCmd::PRINT;
        else if (cmd == "DELAY")      fl.cmd = FAPCmd::DELAY_MS;
        else if (cmd == "RF_SEND")    fl.cmd = FAPCmd::RF_SEND;
        else if (cmd == "BLE_ADV")    fl.cmd = FAPCmd::BLE_ADV;
        else if (cmd == "RFID_READ")  fl.cmd = FAPCmd::RFID_READ;
        else if (cmd == "WIFI_SCAN")  fl.cmd = FAPCmd::WIFI_SCAN;
        else if (cmd == "INPUT_WAIT") fl.cmd = FAPCmd::INPUT_WAIT;
        else if (cmd == "BANNER_OK")  fl.cmd = FAPCmd::BANNER_OK;
        else if (cmd == "BANNER_ERR") fl.cmd = FAPCmd::BANNER_ERR;
        else if (cmd == "LOOP_START") fl.cmd = FAPCmd::LOOP_START;
        else if (cmd == "LOOP_END")   fl.cmd = FAPCmd::LOOP_END;
        else if (cmd == "SUB_LOAD")   fl.cmd = FAPCmd::SUB_LOAD;
        else if (cmd == "NFC_SAVE")   fl.cmd = FAPCmd::NFC_SAVE;
        else if (cmd == "RFID_SAVE")  fl.cmd = FAPCmd::RFID_SAVE;
        else if (cmd == "IBTN_SAVE")  fl.cmd = FAPCmd::IBTN_SAVE;
        else if (cmd == "SD_INFO")    fl.cmd = FAPCmd::SD_INFO;
        else if (cmd == "LOG_WRITE")  fl.cmd = FAPCmd::LOG_WRITE;
        else if (cmd == "RFID_WAIT")  fl.cmd = FAPCmd::RFID_WAIT;
        else if (cmd == "VIBRATE")    fl.cmd = FAPCmd::VIBRATE;
        else                          fl.cmd = FAPCmd::UNKNOWN;

        lines.push_back(fl);
    }
    f.close();
    return lines;
}

// ─── M5FAP Script Çalıştırıcı ─────────────────────────────────────
static void fap_run(const std::vector<FAPLine>& script, const String& title) {
    if (script.empty()) { dispBannerErr("Bos script"); return; }

    String appTitle = title;
    int loopStart   = -1;   // LOOP_START satır indeksi
    int loopCount   = 0;    // Kalan tekrar sayısı (0=sonsuz)
    int loopIter    = 0;    // Mevcut iterasyon
    int dispY       = 14;   // PRINT için y konumu

    dispClear();
    dispStatusBar(appTitle);
    dispCommit();

    size_t i = 0;
    while (i < script.size()) {
        if (readButtonLong()) {
            dispBannerWarn("FAP durduruldu");
            return;
        }

        const FAPLine& fl = script[i];

        switch (fl.cmd) {
            case FAPCmd::TITLE:
                appTitle = fl.arg;
                dispClear();
                dispStatusBar(appTitle);
                dispCommit();
                dispY = 14;
                break;

            case FAPCmd::PRINT:
                dispText(0, dispY, fl.arg);
                dispCommit();
                dispY += 10;
                if (dispY > 54) dispY = 14;
                break;

            case FAPCmd::DELAY_MS:
                delay((uint32_t)fl.arg.toInt());
                break;

            case FAPCmd::BANNER_OK:
                dispBannerOK(fl.arg);
                break;

            case FAPCmd::BANNER_ERR:
                dispBannerErr(fl.arg);
                break;

            case FAPCmd::INPUT_WAIT:
                dispText(0, 50, "[BTN] devam");
                dispCommit();
                while (!readButton()) {
                    if (readButtonLong()) return;
                    delay(50);
                }
                break;

            case FAPCmd::WIFI_SCAN: {
                dispClear(); dispStatusBar("WiFi Scan");
                dispText(0, 24, "Taraniyor...");
                dispCommit();
                int n = WiFi.scanNetworks();
                dispClear(); dispStatusBar("WiFi Scan");
                dispText(0, 24, "Bulunan: " + String(n) + " AP");
                dispCommit();
                delay(800);
                break;
            }

            case FAPCmd::BLE_ADV: {
                // Kısa BLE advertisement
                BLEDevice::init(fl.arg.c_str());
                BLEAdvertising* adv = BLEDevice::getAdvertising();
                BLEAdvertisementData d;
                d.setName(fl.arg);
                adv->setAdvertisementData(d);
                adv->start();
                delay(1500);
                adv->stop();
                BLEDevice::deinit(true); delay(300);
                break;
            }

            case FAPCmd::RFID_READ: {
                dispClear(); dispStatusBar("RFID Oku");
                dispText(0, 24, "Kart bek...");
                dispCommit();
                // 3 saniyelik kısa bekle
                uint32_t t0 = millis();
                bool got = false;
                while (millis() - t0 < 3000) {
                    rfid.PCD_StopCrypto1();
                    if (rfid.PICC_IsNewCardPresent() && rfid.PICC_ReadCardSerial()) {
                        String uid = uidToHex(rfid.uid);
                        dispClear(); dispStatusBar("RFID OK");
                        dispText(0, 24, "UID: " + uid);
                        dispCommit();
                        delay(1200);
                        got = true; break;
                    }
                    delay(100);
                }
                if (!got) { dispBannerWarn("Kart yok"); }
                break;
            }

            case FAPCmd::SUB_LOAD: {
                FlipperSubFile sub = flipper_parse_sub(fl.arg);
                if (sub.valid) flipper_replay_sub(sub);
                else dispBannerErr(".sub yukle hata");
                break;
            }

            case FAPCmd::RF_SEND: {
                // Arg: "433.92 ASK 450 -900 450 -900 ..."
                // İlk token=freq, ikinci=mod, kalan=pulse çiftleri
                int s1 = fl.arg.indexOf(' ');
                int s2 = (s1 > 0) ? fl.arg.indexOf(' ', s1 + 1) : -1;
                if (s1 > 0 && s2 > 0) {
                    float freq = fl.arg.substring(0, s1).toFloat();
                    String mod = fl.arg.substring(s1 + 1, s2);
                    String pulsePart = fl.arg.substring(s2 + 1);
                    std::vector<RFPulse> pulses;
                    int ps = 0; pulsePart += " ";
                    for (int pi = 0; pi <= (int)pulsePart.length(); pi++) {
                        if (pi == (int)pulsePart.length() || pulsePart[pi] == ' ') {
                            if (pi > ps) {
                                long v = pulsePart.substring(ps, pi).toInt();
                                if (v != 0) pulses.push_back({(uint16_t)abs(v), v > 0});
                            }
                            ps = pi + 1;
                        }
                    }
                    if (!pulses.empty()) {
                        FlipperSubFile fake;
                        fake.freqHz = freq * 1e6f;
                        fake.protocol = mod;
                        fake.preset = (mod == "ASK") ? "FuriHalSubGhzPresetOok650Async" : "FuriHalSubGhzPreset2FSKDev476Async";
                        fake.pulses = pulses;
                        fake.valid = true;
                        flipper_replay_sub(fake);
                    }
                }
                break;
            }

            case FAPCmd::LOOP_START:
                loopStart = (int)i;
                loopCount = (int)fl.arg.toInt();
                loopIter  = 0;
                break;

            case FAPCmd::LOOP_END:
                if (loopStart >= 0) {
                    loopIter++;
                    bool infinite = (loopCount == 0);
                    if (infinite || loopIter < loopCount) {
                        i = (size_t)loopStart;  // loop başına dön
                        continue;
                    } else {
                        loopStart = -1;
                    }
                }
                break;

            // ── Yeni SD/Flipper komutları ──────────────────────────
            case FAPCmd::NFC_SAVE:
                if (g_hasUID) {
                    String kt = fl.arg.length() > 0 ? fl.arg : "Mifare Classic 1K";
                    flipper_save_nfc(uidToHex(g_lastUID), kt);
                } else {
                    dispBannerErr("NFC: once RFID_WAIT");
                }
                break;

            case FAPCmd::RFID_SAVE:
                if (g_hasUID) {
                    String kt = fl.arg.length() > 0 ? fl.arg : "EM4100";
                    flipper_save_rfid(uidToHex(g_lastUID), kt);
                } else {
                    dispBannerErr("RFID: once RFID_WAIT");
                }
                break;

            case FAPCmd::IBTN_SAVE:
                if (g_hasUID) {
                    String kt = fl.arg.length() > 0 ? fl.arg : "DS1990A";
                    flipper_save_ibtn(uidToHex(g_lastUID), kt);
                } else {
                    dispBannerErr("iBTN: once RFID_WAIT");
                }
                break;

            case FAPCmd::SD_INFO: {
                if (g_sdInited) {
                    uint64_t tot = SD.totalBytes(), used = SD.usedBytes();
                    uint8_t pct = (uint8_t)((used * 100ULL) / (tot ? tot : 1));
                    String info = "SD:" + String((uint32_t)(tot/(1024*1024))) + "MB " + String(pct) + "%dolu";
                    dispText(0, dispY, info);
                    dispCommit();
                    dispY += 10; if (dispY > 54) dispY = 14;
                } else {
                    dispBannerErr("SD takili degil");
                }
                break;
            }

            case FAPCmd::LOG_WRITE:
                sdLog("[FAP] " + fl.arg);
                logPush("[FAP] LOG: " + fl.arg);
                break;

            case FAPCmd::RFID_WAIT: {
                uint32_t waitMs = fl.arg.length() > 0 ? (uint32_t)fl.arg.toInt() : 5000;
                dispClear(); dispStatusBar("RFID Bekle");
                dispText(0, 24, "Kart bekleniyor...");
                dispText(0, 38, String(waitMs / 1000) + "s");
                dispText(0, 50, "[LONG]=iptal");
                dispCommit();
                uint32_t t0 = millis();
                bool got = false;
                while (millis() - t0 < waitMs) {
                    if (readButtonLong()) break;
                    rfid.PCD_StopCrypto1();
                    if (rfid.PICC_IsNewCardPresent() && rfid.PICC_ReadCardSerial()) {
                        g_lastUID = rfid.uid;
                        g_hasUID  = true;
                        got = true;
                        String uid = uidToHex(rfid.uid);
                        dispClear(); dispStatusBar("RFID OK");
                        dispText(0, 24, "UID: " + uid);
                        dispText(0, 38, "Kaydedildi");
                        dispCommit();
                        delay(800);
                        break;
                    }
                    delay(100);
                }
                if (!got && !g_hasUID) dispBannerWarn("RFID: Kart bulunamadi");
                break;
            }

            case FAPCmd::VIBRATE: {
                uint32_t dur = fl.arg.length() > 0 ? (uint32_t)fl.arg.toInt() : 100;
                tone(PIN_BUZZER, 1000, dur);
                delay(dur + 10);
                break;
            }

            case FAPCmd::UNKNOWN:
            default:
                logPush("[FAP] Bilinmeyen komut: " + fl.arg);
                break;
        }
        i++;
    }
    dispBannerOK("FAP tamamlandi");
}

// ─── Plugin / App Browser ─────────────────────────────────────────
static void flipper_app_browser_run() {
    if (!g_sdInited) { dispBannerErr("SD yok"); return; }

    String appDir = "/flipper/apps";
    if (!SD.exists(appDir.c_str())) {
        SD.mkdir("/flipper");
        SD.mkdir("/flipper/apps");

        // Örnek .fap dosyası oluştur
        File ex = SD.open("/flipper/apps/ornek.fap", FILE_WRITE);
        if (ex) {
            ex.println("# M5Sharkino FAP - Ornek Uygulama");
            ex.println("TITLE Ornek App");
            ex.println("PRINT Merhaba M5Sharkino!");
            ex.println("DELAY 1000");
            ex.println("WIFI_SCAN");
            ex.println("BANNER_OK Tamamlandi");
            ex.close();
        }
        dispBannerWarn("ornek.fap olusturuldu");
    }

    File root = SD.open(appDir.c_str());
    if (!root) { dispBannerErr("App dizin hata"); return; }

    OptionList appOpts;
    while (true) {
        File entry = root.openNextFile();
        if (!entry) break;
        String name = String(entry.name());
        entry.close();
        if (name.endsWith(".fap")) {
            String capName = name;
            String capDir  = appDir;
            appOpts.push_back({name, [capName, capDir]() {
                String path = capDir + "/" + capName;
                auto script = fap_parse(path);
                if (!script.empty()) fap_run(script, capName);
                else dispBannerErr("Parse hata");
            }});
        }
    }
    root.close();

    if (appOpts.empty()) { dispBannerWarn("App bulunamadi"); return; }
    appOpts.push_back({"Back", [](){}});

    while (!g_returnToMenu) {
        int sel = loopOptions(appOpts, "Flipper Apps");
        if (sel < 0 || sel == (int)appOpts.size() - 1) break;
        if (sel >= 0 && sel < (int)appOpts.size()) appOpts[sel].action();
    }
}

// ════════════════════════════════════════════════════════════════════
//  BÖLÜM 3 — BLE UART SERVİSİ + BLE PROXIMITY
//
//  3A. BLE UART (Nordic UART Service — NUS)
//      UUID'ler Flipper'ın BLE UART moduyla aynı:
//      Service: 6E400001-B5A3-F393-E0A9-E50E24DCCA9E
//      TX Char: 6E400003-B5A3-F393-E0A9-E50E24DCCA9E (notify)
//      RX Char: 6E400002-B5A3-F393-E0A9-E50E24DCCA9E (write)
//
//  3B. BLE Proximity (Flipper'ın "Bluetooth Remote" + alarm özelliği)
//      Periyodik BLE scan yapar, tanımlı MAC adresi kaybolursa uyarır.
// ════════════════════════════════════════════════════════════════════

// ─── NUS UUID sabitleri ───────────────────────────────────────────
#define NUS_SERVICE_UUID    "6E400001-B5A3-F393-E0A9-E50E24DCCA9E"
#define NUS_RX_UUID         "6E400002-B5A3-F393-E0A9-E50E24DCCA9E"
#define NUS_TX_UUID         "6E400003-B5A3-F393-E0A9-E50E24DCCA9E"

// ─── BLE UART global durum ────────────────────────────────────────
static BLEServer*            g_nusServer      = nullptr;
static BLECharacteristic*    g_nusTxChar      = nullptr;
static BLECharacteristic*    g_nusRxChar      = nullptr;
static bool                  g_nusInited      = false;
static bool                  g_nusConnected   = false;
static String                g_nusRxBuffer    = "";
static bool                  g_nusRxReady     = false;

// ─── BLE UART sunucu callback'i ──────────────────────────────────
class NUSServerCallbacks : public BLEServerCallbacks {
    void onConnect(BLEServer* s) override {
        g_nusConnected = true;
        buzzOK();
        logPush("[NUS] Baglandi");
    }
    void onDisconnect(BLEServer* s) override {
        g_nusConnected = false;
        logPush("[NUS] Kesildi");
        // Yeniden reklam ver
        s->getAdvertising()->start();
    }
};

// ─── BLE UART RX karakter callback'i ─────────────────────────────
class NUSRxCallbacks : public BLECharacteristicCallbacks {
    void onWrite(BLECharacteristic* pChar) override {
        String val = String(pChar->getValue().c_str());
        if (val.length() > 0) {
            g_nusRxBuffer = val;
            g_nusRxReady  = true;
            logPush("[NUS] RX: " + g_nusRxBuffer);
        }
    }
};

// ─── BLE UART Başlat ─────────────────────────────────────────────
static bool ble_uart_init(const String& deviceName) {
    if (g_nusInited) return true;

    // Mevcut BLE'yi temizle
    if (BLEDevice::getInitialized()) BLEDevice::deinit(true); delay(300);
    delay(100);

    BLEDevice::init(deviceName.c_str());
    g_nusServer = BLEDevice::createServer();
    g_nusServer->setCallbacks(new NUSServerCallbacks());

    BLEService* nusService = g_nusServer->createService(NUS_SERVICE_UUID);

    // TX karakteristiği — notify (cihazdan telefona)
    g_nusTxChar = nusService->createCharacteristic(
        NUS_TX_UUID,
        BLECharacteristic::PROPERTY_NOTIFY
    );
    g_nusTxChar->addDescriptor(new BLE2902());

    // RX karakteristiği — write (telefondan cihaza)
    g_nusRxChar = nusService->createCharacteristic(
        NUS_RX_UUID,
        BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR
    );
    g_nusRxChar->setCallbacks(new NUSRxCallbacks());

    nusService->start();

    BLEAdvertising* adv = BLEDevice::getAdvertising();
    adv->addServiceUUID(NUS_SERVICE_UUID);
    adv->setScanResponse(true);
    adv->start();

    g_nusInited    = true;
    g_nusConnected = false;
    logPush("[NUS] Basladi: " + deviceName);
    return true;
}

// ─── BLE UART Durdur ─────────────────────────────────────────────
static void ble_uart_deinit() {
    if (!g_nusInited) return;
    BLEDevice::getAdvertising()->stop();
    if (g_nusServer) g_nusServer->disconnect(0);
    BLEDevice::deinit(true); delay(300);
    g_nusServer    = nullptr;
    g_nusTxChar    = nullptr;
    g_nusRxChar    = nullptr;
    g_nusInited    = false;
    g_nusConnected = false;
    logPush("[NUS] Durduruldu");
}

// ─── BLE UART Veri Gönder ────────────────────────────────────────
static void ble_uart_send(const String& msg) {
    if (!g_nusInited || !g_nusConnected || !g_nusTxChar) return;
    // NUS 20 byte chunk sınırı
    uint16_t len = msg.length();
    uint16_t offset = 0;
    while (offset < len) {
        uint16_t chunk = min((uint16_t)20, (uint16_t)(len - offset));
        g_nusTxChar->setValue((uint8_t*)(msg.c_str() + offset), chunk);
        g_nusTxChar->notify();
        offset += chunk;
        delay(20);  // BLE buffer için küçük gecikme
    }
}

// ─── BLE UART Terminal (interaktif) ──────────────────────────────
// Telefon uygulamasından (nRF Toolbox, Serial Bluetooth Terminal, vb.)
// bağlanarak iki yönlü UART bağlantısı kurar.
// Flipper Zero'nun "BLE UART Bridge" özelliğine eşdeğer.
static void ble_uart_terminal_run() {
    ble_uart_init("M5Sharkino-UART");

    dispClear();
    dispStatusBar("BLE UART");
    dispText(0, 14, "Bekliyor...");
    dispText(0, 26, "nRF Toolbox / Serial");
    dispText(0, 38, "BT Terminal app ile");
    dispText(0, 50, "baglan  [LONG]=cik");
    dispCommit();

    // Periyodik sistem bilgisi gönder (bağlandıktan sonra)
    uint32_t lastHb = 0;
    uint8_t  cmdBuf[64];
    uint8_t  cmdLen = 0;

    while (!readButtonLong()) {
        // Bağlantı durumu
        dispClear();
        dispStatusBar("BLE UART");
        dispText(0, 14, g_nusConnected ? "BAGLI" : "Bekliyor...");

        if (g_nusConnected) {
            // Heartbeat: her 5 saniyede bir heap bilgisi gönder
            if (millis() - lastHb > 5000) {
                lastHb = millis();
                String hb = "M5Sharkino> heap=" + String(ESP.getFreeHeap()/1024) + "K\r\n";
                ble_uart_send(hb);
            }

            // Gelen komutları işle
            if (g_nusRxReady) {
                g_nusRxReady = false;
                String rx = g_nusRxBuffer;
                rx.trim();

                // Basit komut yorumlayıcı
                String response;
                if (rx == "help" || rx == "?") {
                    response = "Komutlar: heap, scan, rfid, time, reboot\r\n";
                } else if (rx == "heap") {
                    response = "Heap: " + String(ESP.getFreeHeap()) + " byte\r\n";
                } else if (rx == "scan") {
                    int n = WiFi.scanNetworks(false, true);
                    response = "WiFi: " + String(n) + " AP bulundu\r\n";
                } else if (rx == "rfid") {
                    response = "RFID: " + (g_hasUID ? uidToHex(g_lastUID) : "yok") + "\r\n";
                } else if (rx == "time") {
                    response = "Uptime: " + String(millis() / 1000) + "s\r\n";
                } else if (rx == "reboot") {
                    response = "Yeniden baslatiliyor...\r\n";
                    ble_uart_send(response);
                    delay(500);
                    ESP.restart();
                } else if (rx.startsWith("say ")) {
                    response = rx.substring(4) + "\r\n";
                } else {
                    response = "Bilinmeyen: " + rx + " (help yazin)\r\n";
                }
                ble_uart_send(response);
                logPush("[NUS] CMD: " + rx);

                dispText(0, 26, "CMD: " + rx.substring(0, 18));
                dispText(0, 38, "RSP: " + response.substring(0, 18));
            } else {
                dispText(0, 26, "RX: bekliyor");
            }
            dispText(0, 50, "[LONG]=cik");
        } else {
            dispText(0, 26, "NUS UUID aktif");
            dispText(0, 38, "BT Terminal ile baglan");
            dispText(0, 50, "[LONG]=cik");
        }
        dispCommit();
        delay(200);
    }

    ble_uart_deinit();
    dispBannerOK("BLE UART kapatildi");
}

// ─── BLE Proximity (Yakınlık Dedektörü) ──────────────────────────
// Flipper Zero'nun Bluetooth Remote / Lost device finder özelliğine
// eşdeğer. Belirli bir BLE cihazını (MAC veya isim) takip eder;
// sinyal zayıflarsa veya kaybolursa alarm verir.

struct ProximityTarget {
    String  mac;           // Hedef MAC adresi (boşsa isim kullan)
    String  name;          // Hedef cihaz adı (kısmi eşleme)
    int8_t  rssiThreshold; // Bu değerin altına düşünce uyar (dBm)
    bool    alertOnLoss;   // Cihaz kaybolunca uyar
};

static ProximityTarget g_proximityTarget = {"", "", -75, true};
static bool            g_proximityActive = false;

class ProximityAdvertisedCB : public BLEAdvertisedDeviceCallbacks {
public:
    bool     found    = false;
    int8_t   rssi     = -100;
    String   foundMAC = "";
    String   foundName= "";

    void onResult(BLEAdvertisedDevice dev) override {
        String devMAC  = String(dev.getAddress().toString().c_str());
        String devName = dev.haveName() ? String(dev.getName().c_str()) : "";
        int8_t devRSSI = (int8_t)dev.getRSSI();

        devMAC.toUpperCase();

        bool macMatch  = g_proximityTarget.mac.length()  > 0 &&
                         devMAC.indexOf(g_proximityTarget.mac) >= 0;
        bool nameMatch = g_proximityTarget.name.length() > 0 &&
                         devName.indexOf(g_proximityTarget.name) >= 0;

        if (macMatch || nameMatch) {
            found     = true;
            rssi      = devRSSI;
            foundMAC  = devMAC;
            foundName = devName;
        }
    }
};

static void ble_proximity_run() {
    // Hedef konfigürasyonu
    OptionList targetOpts = {
        {"MAC ile Takip",  [](){}},
        {"Isim ile Takip", [](){}},
        {"RSSI Esigi Ayarla", [](){}},
        {"Back",           [](){}},
    };
    int tsel = loopOptions(targetOpts, "Proximity Hedef");
    if (tsel < 0 || tsel == 3) return;

    if (tsel == 0) {
        // MAC girişi
        dispClear(); dispStatusBar("MAC Gir");
        dispText(0, 14, "Seri port'tan girin:");
        dispText(0, 26, "AA:BB:CC:DD:EE:FF");
        dispText(0, 50, "[BTN]=devam");
        dispCommit();
        Serial.println("[PROXIMITY] MAC adresini girin (AA:BB:CC:DD:EE:FF):");
        uint32_t t = millis();
        while (!readButton() && millis() - t < 30000) {
            if (Serial.available()) {
                g_proximityTarget.mac = Serial.readStringUntil('\n');
                g_proximityTarget.mac.trim();
                g_proximityTarget.mac.toUpperCase();
                break;
            }
            delay(50);
        }
        dispText(0, 38, "MAC: " + g_proximityTarget.mac);
        dispCommit();
        delay(1000);
    } else if (tsel == 1) {
        // Cihaz adı (önce tarama yap, listeden seç)
        dispClear(); dispStatusBar("BLE Tara");
        dispText(0, 24, "Cihazlar taranıyor...");
        dispCommit();

        BLEDevice::init("");
        BLEScan* scan = BLEDevice::getScan();
        scan->setActiveScan(true);
        BLEScanResults* results = scan->start(4, false);

        OptionList devOpts;
        for (int k = 0; k < results->getCount(); k++) {
            BLEAdvertisedDevice dev = results->getDevice(k);
            if (dev.haveName()) {
                String nm = String(dev.getName().c_str());
                devOpts.push_back({nm, [nm]() { g_proximityTarget.name = nm; }});
            }
        }
        scan->clearResults();
        BLEDevice::deinit(true); delay(300);

        if (devOpts.empty()) { dispBannerWarn("Isimli cihaz yok"); return; }
        devOpts.push_back({"Back", [](){}});
        int dsel = loopOptions(devOpts, "Hedef Sec");
        if (dsel >= 0 && dsel < (int)devOpts.size()) devOpts[dsel].action();
    } else if (tsel == 2) {
        // RSSI eşiği
        OptionList rssiOpts = {
            {"-55 dBm (Cok yakin)", [](){g_proximityTarget.rssiThreshold = -55;}},
            {"-65 dBm (Yakin)",     [](){g_proximityTarget.rssiThreshold = -65;}},
            {"-75 dBm (Orta)",      [](){g_proximityTarget.rssiThreshold = -75;}},
            {"-85 dBm (Uzak)",      [](){g_proximityTarget.rssiThreshold = -85;}},
            {"Back",                [](){}},
        };
        int rsel = loopOptions(rssiOpts, "RSSI Esigi");
        if (rsel >= 0 && rsel < 4) rssiOpts[rsel].action();
    }

    if (g_proximityTarget.mac.isEmpty() && g_proximityTarget.name.isEmpty()) {
        dispBannerErr("Hedef tanimsiz");
        return;
    }

    // Takip döngüsü
    dispClear();
    dispStatusBar("BLE Proximity");
    dispText(0, 14, "Hedef: " + (g_proximityTarget.mac.length() > 0
                                  ? g_proximityTarget.mac
                                  : g_proximityTarget.name));
    dispText(0, 26, "Esik: " + String(g_proximityTarget.rssiThreshold) + " dBm");
    dispText(0, 38, "Izleniyor...");
    dispText(0, 50, "[LONG]=dur");
    dispCommit();
    delay(1000);

    g_proximityActive = true;
    uint8_t lostCount = 0;       // Ardışık kayıp sayısı
    bool    wasFound  = false;

    while (!readButtonLong()) {
        BLEDevice::init("");
        BLEScan* scan = BLEDevice::getScan();

        ProximityAdvertisedCB proxCB;
        scan->setAdvertisedDeviceCallbacks(&proxCB, false);
        scan->setActiveScan(false);
        scan->start(2, false);  // 2 saniyelik tarama
        scan->clearResults();
        BLEDevice::deinit(true); delay(300);

        dispClear();
        dispStatusBar("BLE Proximity");

        if (proxCB.found) {
            lostCount = 0;
            wasFound  = true;
            bool near = (proxCB.rssi >= g_proximityTarget.rssiThreshold);

            dispText(0, 14, "BULUNDU: " + proxCB.foundMAC.substring(0, 17));
            dispText(0, 26, "RSSI: " + String(proxCB.rssi) + " dBm");
            dispText(0, 38, near ? ">>> YAKIN <<<" : "Uzak");
            dispText(0, 50, "[LONG]=dur");

            // Yaklaşma sesi
            if (near) {
                tone(PIN_BUZZER, 2000, 50);
                delay(100);
                tone(PIN_BUZZER, 2500, 50);
            }
        } else {
            lostCount++;
            dispText(0, 14, "Hedef: " + (g_proximityTarget.mac.length() > 0
                                          ? g_proximityTarget.mac.substring(0, 17)
                                          : g_proximityTarget.name));
            dispText(0, 26, "BULUNAMADI");
            dispText(0, 38, "Kayip: " + String(lostCount) + "x");
            dispText(0, 50, "[LONG]=dur");

            // 3 ardışık kayıptan sonra alarm
            if (wasFound && lostCount >= 3 && g_proximityTarget.alertOnLoss) {
                buzzErr();
                dispBannerErr("HEDEF KAYBOLDU!");
                wasFound  = false;
                lostCount = 0;
            }
        }
        dispCommit();
        delay(500);
    }

    g_proximityActive = false;
    dispBannerOK("Proximity durduruldu");
}

