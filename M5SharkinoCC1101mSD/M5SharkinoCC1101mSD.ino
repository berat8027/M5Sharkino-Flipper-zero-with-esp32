static void cfg_sta_connect_run() {
    if (strlen(g_cfg.staSSID) == 0) {
        dispBannerErr("Set STA SSID first!");
        return;
    }
    if (g_staConnected) {
        // Zaten bağlı — kes
        OptionList opts = {{"Disconnect", [](){}}, {"Keep conn.", [](){}}, {"Back", [](){}}};
        int sel = loopOptions(opts, "STA: " + g_staIP.substring(0,15));
        if (sel == 0) { wifiSTADisconnect(); dispBannerOK("Disconnected"); }
        return;
    }
    dispBannerWarn("Connecting...", 400);
    if (wifiSTAConnect(12000)) {
        dispBannerOK("IP: " + g_staIP);
    } else {
        dispBannerErr("Connect failed!");
    }
}

static void cfg_sta_scan_connect_run() {
    // WiFi tara, listeden seç, bağlan
    dispProgress("WiFi Scan", "Scanning...", 20);
    wifiScanAll(true);
    WiFi.scanDelete();
    if (g_scanResults.empty()) { dispBannerWarn("No APs found"); return; }

    OptionList opts;
    for (auto& ap : g_scanResults) {
        String label = ap.ssid.substring(0,14) + " " + String(ap.rssi) + "dB";
        if (ap.encType != WIFI_AUTH_OPEN) label += "*";
        opts.push_back({label, [](){}});
    }
    opts.push_back({"Back", [](){}});
    int sel = loopOptions(opts, "Select AP");
    if (sel < 0 || sel == (int)opts.size()-1) return;

    strncpy(g_cfg.staSSID, g_scanResults[sel].ssid.c_str(), 32);

    // Şifre gerekiyor mu?
    if (g_scanResults[sel].encType != WIFI_AUTH_OPEN) {
        char buf[65] = "";
        if (!charPicker(buf, 64, "Password")) return;
        strncpy(g_cfg.staPass, buf, 64);
    } else {
        memset(g_cfg.staPass, 0, sizeof(g_cfg.staPass));
    }
    cfg_save();

    dispBannerWarn("Connecting...", 400);
    if (wifiSTAConnect(12000)) {
        dispBannerOK("IP: " + g_staIP);
    } else {
        dispBannerErr("Connect failed!");
    }
}

static void cfg_factory_run() {
    dispClear(); dispStatusBar("Factory Reset");
    dispText(0, 18, "CLEARS ALL settings");
    dispText(0, 30, "Are you sure?");
    dispText(0, 44, "[BTN] confirm");
    dispText(0, 54, "[LONG] cancel");
    dispCommit();
    if (readButtonLong()) { dispBanner("Cancelled"); return; }
    while (!readButton()) delay(50);
    prefs.begin("esphacker", false);
    prefs.clear();
    prefs.end();
    dispBanner("Reset! Rebooting...");
    delay(1000);
    ESP.restart();
}

class ConfigMenu : public MenuItem {
public:
    String getName() override { return "Config"; }
    void drawConfigShape(int x, int y, uint16_t col) {
        int cx = x+16, cy = y+16;
        // Outer gear teeth (8 teeth)
        for (int t = 0; t < 8; t++) {
            float ang = t * 3.14159f * 2 / 8;
            int tx1 = cx + (int)(10 * cos(ang));
            int ty1 = cy + (int)(10 * sin(ang));
            int tx2 = cx + (int)(13 * cos(ang));
            int ty2 = cy + (int)(13 * sin(ang));
            display.drawLine(tx1, ty1, tx2, ty2, col);
            display.drawLine(tx1+1, ty1, tx2+1, ty2, col);
        }
        // Gear body ring
        display.drawCircle(cx, cy, 10, col);
        display.drawCircle(cx, cy,  9, col);
        // Inner hole
        display.drawCircle(cx, cy,  4, col);
        display.fillCircle(cx, cy,  3, col);
        // Three sliders below (like config lines)
        display.drawLine(x+4, y+27, x+28, y+27, col);
        display.drawLine(x+4, y+30, x+28, y+30, col);
        // Slider knobs
        display.fillRect(x+8,  y+25, 4, 4, col);
        display.fillRect(x+18, y+28, 4, 4, col);
    }
    void drawIcon(int x, int y) override    { drawConfigShape(x, y, SSD1306_WHITE); }
    void drawIconInv(int x, int y) override { drawConfigShape(x, y, SSD1306_BLACK); }
    void drawIconSmall(int x, int y, uint16_t col) override {
        // Dişli: dış dişler + halka + delik, 16x16
        int cx = x+8, cy = y+7;
        for (int t = 0; t < 6; t++) {
            float a = t * 3.14159f * 2 / 6;
            display.drawLine(cx+(int)(5*cos(a)), cy+(int)(5*sin(a)),
                             cx+(int)(7*cos(a)), cy+(int)(7*sin(a)), col);
        }
        display.drawCircle(cx, cy, 5, col);
        display.fillCircle(cx, cy, 2, col);
        display.drawFastHLine(x+2, y+13, 12, col);
        display.drawFastHLine(x+2, y+15, 12, col);
        display.fillRect(x+4,  y+12, 2, 2, col);
        display.fillRect(x+9,  y+14, 2, 2, col);
    }
    void runMenu() override {
        while (!g_returnToMenu) {
            OptionList opts = {
                {"WiFi " + String(g_cfg.wifiEnabled?"[ON]":"[OFF]"),
                    []() { cfg_toggle_run(g_cfg.wifiEnabled, "WiFi"); }},
                {"BLE  " + String(g_cfg.bleEnabled?"[ON]":"[OFF]"),
                    []() { cfg_toggle_run(g_cfg.bleEnabled, "BLE"); }},
                {"RFID " + String(g_cfg.rfidEnabled?"[ON]":"[OFF]"),
                    []() { cfg_toggle_run(g_cfg.rfidEnabled, "RFID"); }},
                {"Serial " + String(g_cfg.serialLog?"[ON]":"[OFF]"),
                    []() { cfg_toggle_run(g_cfg.serialLog, "Serial"); }},
                {"Brightness",     []() { cfg_brightness_run(); }},
                {"Invert Disp " + String(g_cfg.displayInvert?"[ON]":"[OFF]"),
                    []() { cfg_invert_run(); }},
                {"AP SSID",        []() { cfg_ap_ssid_run(); }},
                {"AP Password",    []() { cfg_ap_pass_run(); }},
                // ─── WiFi STA (client) ────────────────────
                {(g_staConnected ? "STA [" + g_staIP.substring(0,10) + "]" : "STA Connect"),
                    []() { cfg_sta_connect_run(); }},
                {"STA Scan+Join",  []() { cfg_sta_scan_connect_run(); }},
                {"STA SSID: " + (strlen(g_cfg.staSSID) > 0 ? String(g_cfg.staSSID).substring(0,8) : "(none)"),
                    []() { cfg_sta_ssid_run(); }},
                {"STA Pass",       []() { cfg_sta_pass_run(); }},
                {"NTP " + String(g_cfg.ntpEnabled?"[ON]":"[OFF]"),
                    []() { cfg_toggle_run(g_cfg.ntpEnabled, "NTP"); cfg_save(); }},
                // ─────────────────────────────────────────
                {"Deauth Burst",   []() { cfg_deauth_burst_run(); }},
                {"Scan Dwell",     []() { cfg_dwell_run(); }},
                {"PIN Lock " + String(g_cfg.pinLockEnable?"[ON]":"[OFF]"),
                    []() { cfg_pin_setup_run(); }},
                {"Factory Reset",  []() { cfg_factory_run(); }},
                {"Restart",        []() { dispBanner("Rebooting...",600); ESP.restart(); }},
                {"Back",           []() { backToMenu(); }},
            };
            int sel = loopOptions(opts, "Config");
            if (sel < 0) { backToMenu(); break; }
            if (sel >= 0 && sel < (int)opts.size()) opts[sel].action();
        }
    }
};

