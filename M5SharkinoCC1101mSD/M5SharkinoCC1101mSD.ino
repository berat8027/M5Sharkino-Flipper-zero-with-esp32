static void tools_serial_shell_run() {
    dispClear(); dispStatusBar("Serial Shell");
    dispText(0, 12, "Connect USB serial");
    dispText(0, 22, "Baud: 115200");
    dispText(0, 32, "Commands:");
    dispText(0, 42, "  sysinfo, log,");
    dispText(0, 52, "  reboot, help");
    dispCommit();

    while (!readButton()) {
        if (!Serial.available()) { delay(50); continue; }
        String cmd = Serial.readStringUntil('\n');
        cmd.trim();
        if (cmd == "help") {
            Serial.println("Commands: sysinfo, log, reboot, heap, mac, scan");
        } else if (cmd == "sysinfo") {
            Serial.printf("CPU: %dMHz  Free: %dKB  Flash: %dMB\n",
                ESP.getCpuFreqMHz(), ESP.getFreeHeap()/1024, ESP.getFlashChipSize()/1048576);
        } else if (cmd == "log") {
            uint16_t start = (g_logHead >= g_logCount) ? g_logHead - g_logCount : 0;
            for (uint8_t i = 0; i < g_logCount; i++) {
                Serial.println(g_log[(start + i) % LOG_MAX_LINES]);
            }
        } else if (cmd == "reboot") {
            Serial.println("Rebooting...");
            delay(200); ESP.restart();
        } else if (cmd == "heap") {
            Serial.printf("Free: %d  Min: %d\n", ESP.getFreeHeap(), ESP.getMinFreeHeap());
        } else if (cmd == "mac") {
            Serial.println("WiFi MAC: " + WiFi.macAddress());
        } else if (cmd == "scan") {
            Serial.println("Scanning WiFi...");
            wifiScanAll(false);
            for (auto& ap : g_scanResults)
                Serial.println(ap.ssid + " " + ap.bssid + " ch" + String(ap.channel));
            WiFi.mode(WIFI_OFF);
        } else if (cmd.length() > 0) {
            Serial.println("Unknown: " + cmd + " (try 'help')");
        }

        // Mirror incoming to display
        dispClear(); dispStatusBar("Serial Shell");
        dispText(0, 20, ">" + cmd.substring(0, 20));
        dispText(0, 34, "[BTN] exit");
        dispCommit();
    }
}

static void tools_log_viewer_run() {
    if (g_logCount == 0) { dispBanner("Log is empty"); return; }
    int page = (int)g_logCount - 1;
    while (!readButton()) {
        dispClear(); dispStatusBar("Log (" + String(g_logCount) + ")");
        uint16_t start = (g_logHead >= g_logCount) ? g_logHead - g_logCount : 0;
        String entry = g_log[(start + page) % LOG_MAX_LINES];
        dispText(0, 12, String(page + 1) + "/" + String(g_logCount));
        dispText(0, 22, entry.substring(0, 20));
        dispText(0, 32, entry.substring(20, 40));
        dispText(0, 44, entry.substring(40, 60));
        dispText(0, 56, "Joy:scroll [BTN]");
        dispCommit();
        JoyDir d = readJoystick();
        if (d == JoyDir::UP   && page > 0)               page--;
        if (d == JoyDir::DOWN && page < g_logCount - 1)  page++;
        delay(50);
    }
}

static void tools_stats_dashboard_run() {
    while (!readButton()) {
        potApplyBrightness();   // pot anında parlaklık kontrolü
        uint16_t rawX = analogRead(PIN_JOY_X);
        uint16_t rawY = analogRead(PIN_JOY_Y);
        uint16_t rawP = analogRead(PIN_POT);
        uint32_t heap = ESP.getFreeHeap();

        dispClear(); dispStatusBar("Dashboard");
        // Heap bar
        uint8_t heapPct = map(heap, 0, 300000, 0, 100);
        dispText(0, 12, "Heap: " + String(heap/1024) + "KB");
        display.drawRect(60, 12, 64, 7, SSD1306_WHITE);
        display.fillRect(60, 12, map(heapPct,0,100,0,64), 7, SSD1306_WHITE);
        // ADC bars
        dispText(0, 22, "JX:");
        display.drawRect(20, 22, 50, 6, SSD1306_WHITE);
        display.fillRect(20, 22, map(rawX,0,4095,0,50), 6, SSD1306_WHITE);
        dispText(74, 22, String(rawX));

        dispText(0, 32, "JY:");
        display.drawRect(20, 32, 50, 6, SSD1306_WHITE);
        display.fillRect(20, 32, map(rawY,0,4095,0,50), 6, SSD1306_WHITE);
        dispText(74, 32, String(rawY));

        dispText(0, 42, "PT:");
        display.drawRect(20, 42, 50, 6, SSD1306_WHITE);
        display.fillRect(20, 42, map(rawP,0,4095,0,50), 6, SSD1306_WHITE);
        dispText(74, 42, String(rawP));

        dispText(0, 52, "WiFi:" + String(g_scanResults.size()) + " BLE:" + String(g_bleResults.size()));
        dispCommit();
        delay(100);
    }
}

