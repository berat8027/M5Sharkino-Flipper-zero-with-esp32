// ── Blocking animasyon göster (sys event) ────────────────
// type: 0=NoDb 1=SdBad 2=SdOk 3=Url 4=NewMail
// Ekranın altında slide-up + 2s göster + slide-down
static void showBlockingAnim(uint8_t type) {
    if (type >= 5) return;
    const uint8_t* bmp = (const uint8_t*)pgm_read_ptr(&BLOCK_FRAMES[type]);

    // Slide up (y: 64 → 50)
    for (int y = 64; y >= 50; y -= 2) {
        // Mevcut ekranı koru, alt banner'ı çiz
        display.fillRect(0, y, OLED_W, BLOCK_H + 2, SSD1306_BLACK);
        drawBlockFrame128(y, bmp, SSD1306_WHITE);
        dispCommit();
        delay(12);
    }
    // 2 saniye göster
    delay(2000);
    // Slide down
    for (int y = 50; y <= 64; y += 2) {
        display.fillRect(0, y, OLED_W, BLOCK_H + 2, SSD1306_BLACK);
        if (y < 64) drawBlockFrame128(y, bmp, SSD1306_WHITE);
        dispCommit();
        delay(12);
    }
}

