  input[type=file]{color:#0f0;margin:10px 0;display:block;width:100%}
  input[type=submit]{background:#0f0;color:#111;border:none;padding:12px 30px;
    font-size:16px;font-family:monospace;cursor:pointer;border-radius:4px;margin-top:12px}
  input[type=submit]:hover{background:#0a0}
