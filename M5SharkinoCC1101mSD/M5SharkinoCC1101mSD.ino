// ─── Flipper Zero tarzı PIN Lock ekranı ──────────────────
// 4 haneli PIN girişi: joystick UP/DOWN rakam seçer,
// BTN onaylar — Flipper Zero'nun tam PIN UI davranışı.
// Görsel: Flipper status bar + kilit ikonu + 4 büyük slot +
//         altında rakam spinner + hint bar.
static bool pinLockCheck() {
    if (!g_cfg.pinLockEnable) return true;

    char entered[5] = "";
    uint8_t pos = 0;
    static const char DIGITS[] = "0123456789";
    uint8_t digitIdx[4] = {0, 0, 0, 0};  // her slot için ayrı rakam

    // ── Flipper tarzı PIN ekranı render ──────────────────
    auto drawPinScreen = [&](bool showCurrent) {
        dispClear();

        // Status bar — kilit simgesi ile
        display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        // Kilit ikonu (8x8) status bar soluna
        drawBitmap8(2, 1, FLIPPER_ICO8_LOCK, SSD1306_BLACK);
        // "PIN Lock" başlık ortada
        display.setCursor(36, 2);
        display.print("PIN Lock");
        display.setTextColor(SSD1306_WHITE);

        // ── Orta alan: 4 slot + büyük rakam gösterimi ────
        // Her slot: 22x22 px yuvarlak kutu, 4 slot yan yana
        // Toplam genişlik: 4*22 + 3*4(boşluk) = 100px — merkez: (128-100)/2=14
        const int SLOT_W   = 22;
        const int SLOT_GAP = 4;
        const int SLOTS_X  = (OLED_W - (4 * SLOT_W + 3 * SLOT_GAP)) / 2;  // 11
        const int SLOTS_Y  = 14;

        for (uint8_t i = 0; i < 4; i++) {
            int sx = SLOTS_X + i * (SLOT_W + SLOT_GAP);
            bool isCurrent = (i == pos);
            bool isFilled  = (i < pos);

            if (isCurrent) {
                // Aktif slot: beyaz dolgu + siyah rakam (Flipper seçili stil)
                display.fillRoundRect(sx, SLOTS_Y, SLOT_W, SLOT_W, 3, SSD1306_WHITE);
                display.setTextColor(SSD1306_BLACK);
                display.setTextSize(2);
                // Rakamı ortala: 12px geniş @ textSize=2
                int rx = sx + (SLOT_W - 12) / 2;
                display.setCursor(rx, SLOTS_Y + 3);
                if (showCurrent) {
                    display.print(DIGITS[digitIdx[i]]);
                } else {
                    display.print(DIGITS[digitIdx[i]]);
                }
                display.setTextColor(SSD1306_WHITE);
                // Seçili göstergesi: alt üçgen ok (Flipper tarzı)
                display.fillTriangle(sx + SLOT_W/2 - 3, SLOTS_Y + SLOT_W + 2,
                                     sx + SLOT_W/2 + 3, SLOTS_Y + SLOT_W + 2,
                                     sx + SLOT_W/2,     SLOTS_Y + SLOT_W + 5,
                                     SSD1306_WHITE);
            } else if (isFilled) {
                // Dolu slot: çerçeve + yıldız (*) — Flipper PIN stili
                display.drawRoundRect(sx, SLOTS_Y, SLOT_W, SLOT_W, 3, SSD1306_WHITE);
                display.setTextSize(2);
                display.setTextColor(SSD1306_WHITE);
                display.setCursor(sx + 5, SLOTS_Y + 3);
                display.print("*");
            } else {
                // Boş slot: sadece çerçeve + alt çizgi (Flipper underscore stili)
                display.drawRoundRect(sx, SLOTS_Y, SLOT_W, SLOT_W, 3, SSD1306_WHITE);
                // Alt çizgi — "bekliyor" göstergesi
                display.drawFastHLine(sx + 4, SLOTS_Y + SLOT_W - 4, SLOT_W - 8, SSD1306_WHITE);
            }
        }

        // ── Rakam spinner: yukarı/aşağı hint ────────────────
        if (pos < 4) {
            int sx = SLOTS_X + pos * (SLOT_W + SLOT_GAP);
            // Yukarı ok (önceki rakam)
            uint8_t prevD = (digitIdx[pos] + 9) % 10;
            display.setTextColor(SSD1306_WHITE);
            display.setTextSize(1);
            display.setCursor(sx + 8, SLOTS_Y - 8);
            // küçük üçgen yukarı
            display.fillTriangle(sx + SLOT_W/2 - 3, SLOTS_Y - 2,
                                 sx + SLOT_W/2 + 3, SLOTS_Y - 2,
                                 sx + SLOT_W/2,     SLOTS_Y - 6,
                                 SSD1306_WHITE);
        }

        // ── Alt hint bar — Flipper tarzı solid beyaz ─────────
        display.fillRect(0, 54, OLED_W, 10, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        // Sol: geri ok + "Cancel"
        display.fillTriangle(2, 56, 2, 62, 0, 59, SSD1306_BLACK);
        display.setCursor(5,  56);
        display.print("Cancel");
        // Sağ: "OK" + ok
        display.setCursor(88, 56);
        display.print("OK");
        display.fillTriangle(OLED_W-4, 56, OLED_W-4, 62, OLED_W-2, 59, SSD1306_BLACK);
        display.setTextColor(SSD1306_WHITE);

        dispCommit();
    };

    // ── İlk çizim — giriş animasyonu (yukarıdan iner) ────
    for (int16_t yo = -64; yo <= 0; yo += 8) {
        dispClear();
        display.fillRect(0, 0 + yo, OLED_W, 11, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        drawBitmap8(2, 1 + yo, FLIPPER_ICO8_LOCK, SSD1306_BLACK);
        display.setCursor(36, 2 + yo);
        display.print("PIN Lock");
        display.setTextColor(SSD1306_WHITE);
        dispCommit();
        delay(10);
    }

    // ── PIN giriş döngüsü ─────────────────────────────────
    while (pos < 4) {
        drawPinScreen(true);

        JoyDir d = readJoystick();
        if (d == JoyDir::UP) {
            digitIdx[pos] = (digitIdx[pos] + 1) % 10;
            buzzNav();
        }
        if (d == JoyDir::DOWN) {
            digitIdx[pos] = (digitIdx[pos] + 9) % 10;
            buzzNav();
        }
        if (readButton()) {
            entered[pos] = DIGITS[digitIdx[pos]];
            pos++;
            entered[pos] = '\0';
            if (pos < 4) buzzNav();
            else         buzzSelect();
        }
        if (readButtonLong()) {
            // İptal — kısa çıkış animasyonu
            for (int16_t yo = 0; yo <= 64; yo += 8) {
                dispClear();
                display.fillRect(0, 0 + yo, OLED_W, OLED_H, SSD1306_BLACK);
                dispCommit();
                delay(8);
            }
            buzzErr();
            return false;
        }
        delay(40);
    }

    // ── PIN doğrulama ─────────────────────────────────────
    if (strcmp(entered, g_cfg.pinCode) == 0) {
        // Doğru: yeşil flash (invert) + OK banner
        display.invertDisplay(true);  delay(80);
        display.invertDisplay(false); delay(50);
        display.invertDisplay(true);  delay(80);
        display.invertDisplay(false);
        dispBannerOK("PIN OK!");
        return true;
    } else {
        // Yanlış: kırmızı hata — tüm ekran hızlı blink + Error banner
        for (uint8_t f = 0; f < 3; f++) {
            display.invertDisplay(true);  delay(60);
            display.invertDisplay(false); delay(40);
        }
        dispBannerErr("Wrong PIN!");
        return false;
    }
}

static void cfg_brightness_run() {
    uint8_t val = g_cfg.brightness;
    while (!readButton()) {
        JoyDir d = readJoystick();
        if (d == JoyDir::RIGHT && val < 100) val = min(100, (int)val + 5);
        if (d == JoyDir::LEFT  && val > 5)   val = max(5,   (int)val - 5);
        g_cfg.brightness = val;
        display.ssd1306_command(SSD1306_SETCONTRAST);
        display.ssd1306_command(map(val, 0, 100, 5, 255));
        uint8_t barW = map(val, 0, 100, 0, OLED_W - 4);
