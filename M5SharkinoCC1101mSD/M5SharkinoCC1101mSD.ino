// ─── WiFi animasyonu: Flipper Zero WiFi_Scanning_PortraitAnim ──
// 5 kare, merkez noktadan genişleyen WiFi yayları
// Flipper: assets/icons/WiFi/WiFi_Scanning_PortraitAnim
static void animDrawWifiFrame(uint8_t frame, int16_t cx, int16_t cy) {
    // Merkez nokta (always visible)
    display.fillCircle(cx, cy + 8, 2, SSD1306_WHITE);
    // Kare bazlı yay sayısı
    uint8_t arcs = (frame % 5) + 1;
    // İç yay (r=7)
    if (arcs >= 1) {
        for (int a = -45; a <= 45; a += 3) {
            float rad = (a - 90) * 3.14159f / 180.0f;
            int px = cx + (int)(7 * cosf(rad));
            int py = cy + 8 + (int)(7 * sinf(rad));
            display.drawPixel(px, py, SSD1306_WHITE);
        }
    }
    // Orta yay (r=13)
    if (arcs >= 2) {
        for (int a = -50; a <= 50; a += 3) {
            float rad = (a - 90) * 3.14159f / 180.0f;
            int px = cx + (int)(13 * cosf(rad));
            int py = cy + 8 + (int)(13 * sinf(rad));
            display.drawPixel(px, py, SSD1306_WHITE);
        }
    }
    // Dış yay (r=19)
    if (arcs >= 3) {
        for (int a = -55; a <= 55; a += 2) {
            float rad = (a - 90) * 3.14159f / 180.0f;
            int px = cx + (int)(19 * cosf(rad));
            int py = cy + 8 + (int)(19 * sinf(rad));
            display.drawPixel(px, py, SSD1306_WHITE);
        }
    }
}

// WiFi tarama animasyon ekranı — non-blocking progress ile
// WiFi.scanNetworks() blocking çağrısından önce bir kez gösterilir
static void animWifiScanning() {
    for (uint8_t frame = 0; frame < 15; frame++) {
        dispClear();
        // Üst status bar
        display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        display.setCursor(30, 2);
        display.print("WiFi Scan");
        display.setTextColor(SSD1306_WHITE);
        // WiFi animasyonu — sol orta
        animDrawWifiFrame(frame, 30, 18);
        // Sağ taraf: durum yazısı (Flipper font)
        drawFlipperStr(60, 20, "Taranıyor", SSD1306_WHITE);
        // Nokta animasyonu
        uint8_t dots = frame % 4;
        String dotStr = "";
        for (uint8_t d = 0; d < dots; d++) dotStr += ".";
        drawFlipperStr(60, 30, dotStr, SSD1306_WHITE);
        // Alt progress bar
        uint8_t pct = (frame * 100) / 15;
        display.drawRect(2, 52, OLED_W-4, 6, SSD1306_WHITE);
        if (pct > 0) display.fillRect(3, 53, (OLED_W-6) * pct / 100, 4, SSD1306_WHITE);
        dispCommit();
        delay(60);
    }
}

// ─── BLE animasyonu: Flipper Zero BLE_Pairing / BLE_Scanning ──
// Flipper: assets/icons/Bluetooth/BLE_Pairing_* animasyonları
// Merkezi BT logo + pulsiyon halkaları
static void animDrawBLEFrame(uint8_t frame, int16_t cx, int16_t cy) {
    // BT sembolü (merkez)
    // Dikey çizgi
    display.drawFastVLine(cx, cy - 9, 18, SSD1306_WHITE);
    // BT sağ üst çizgi
    display.drawLine(cx, cy - 9, cx + 6, cy - 4, SSD1306_WHITE);
    display.drawLine(cx + 6, cy - 4, cx, cy + 2, SSD1306_WHITE);
    // BT sağ alt çizgi
    display.drawLine(cx, cy + 2, cx + 6, cy + 7, SSD1306_WHITE);
    display.drawLine(cx + 6, cy + 7, cx, cy + 9, SSD1306_WHITE);
    // BT sol çizgiler
    display.drawLine(cx, cy - 4, cx - 4, cy - 7, SSD1306_WHITE);
    display.drawLine(cx, cy + 7, cx - 4, cy + 10, SSD1306_WHITE);

    // Pulsing ring animation
    uint8_t phase = frame % 8;
    // İç halka (r=14+phase*2)
    if (phase < 4) {
        uint8_t r = 14 + phase * 3;
        if (r < 25) {
            uint8_t alpha = 4 - phase;
            for (int a = 0; a < 360; a += 8) {
                float rad = a * 3.14159f / 180.0f;
                int px = cx + (int)(r * cosf(rad));
                int py = cy + (int)(r * sinf(rad));
                if (px >= 0 && px < OLED_W && py >= 0 && py < OLED_H)
                    display.drawPixel(px, py, SSD1306_WHITE);
            }
        }
    }
    // Dış halka (frame-4)
    if (phase >= 4) {
        uint8_t r = 14 + (phase - 4) * 3;
        if (r < 25) {
            for (int a = 0; a < 360; a += 12) {
                float rad = a * 3.14159f / 180.0f;
                int px = cx + (int)(r * cosf(rad));
                int py = cy + (int)(r * sinf(rad));
                if (px >= 0 && px < OLED_W && py >= 0 && py < OLED_H)
                    display.drawPixel(px, py, SSD1306_WHITE);
            }
        }
    }
}

