// ── Donanım Kalibrasyonu alt menüsü ─────────────────────
static void settings_hardware_menu() {
    while (true) {
        prefs.begin("settings2", true);
        uint16_t joyLo  = prefs.getUShort("joyLo", 1300);
        uint16_t joyHi  = prefs.getUShort("joyHi", 2800);
        uint8_t  btnSpd = prefs.getUChar("btnSpd", 50);   // debounce ms
        uint8_t  btnA   = prefs.getUChar("btnARole", 0);
        prefs.end();
        const char* btnARoles[] = {"WiFi Scan","BLE Scan","RFID Read","Dashboard"};

        OptionList opts = {
            // Joystick Deadzone
            {"Joy Lo=" + String(joyLo) + " Hi=" + String(joyHi),
                [joyLo, joyHi]() {
                    uint16_t lo = joyLo, hi = joyHi;
                    while (!readButton()) {
                        JoyDir d = readJoystick();
                        if (d == JoyDir::UP   && lo < 2000) lo += 50;
                        if (d == JoyDir::DOWN && lo > 500)  lo -= 50;
                        if (d == JoyDir::RIGHT&& hi < 3800) hi += 50;
                        if (d == JoyDir::LEFT && hi > 2000) hi -= 50;
                        dispClear(); dispStatusBar("Joy Deadzone");
                        dispText(0,14,"Lo thresh: " + String(lo));
                        dispText(0,24,"Hi thresh: " + String(hi));
                        dispText(0,36,"U/D: Lo   L/R: Hi");
                        // Anlık joystick değerleri göster
                        uint16_t rx = analogRead(PIN_JOY_X);
                        uint16_t ry = analogRead(PIN_JOY_Y);
                        dispText(0,48,"X:"+String(rx)+" Y:"+String(ry));
                        dispText(0,56,"BTN: save");
                        dispCommit(); delay(60);
                    }
                    prefs.begin("settings2", false);
                    prefs.putUShort("joyLo", lo);
                    prefs.putUShort("joyHi", hi);
                    prefs.end();
                    dispBannerOK("Joy: "+String(lo)+"/"+String(hi));
                }},
            // Joystick Merkez Kalibrasyonu (bırakıldığında merkez oku)
            {"Joy Center Cal",
                []() {
                    dispClear(); dispStatusBar("Joy Center Cal");
                    dispText(0,14,"Joystick'i birakip");
                    dispText(0,24,"merkeze getirin.");
                    dispText(0,34,"3 sn sonra okur...");
                    dispCommit(); delay(3000);
                    uint32_t sx=0, sy=0;
                    for (int i=0; i<20; i++) { sx+=analogRead(PIN_JOY_X); sy+=analogRead(PIN_JOY_Y); delay(20); }
                    uint16_t cx = sx/20, cy2 = sy/20;
                    prefs.begin("settings2", false);
                    prefs.putUShort("joyCX", cx);
                    prefs.putUShort("joyCY", cy2);
                    prefs.end();
                    dispBannerOK("Center: X="+String(cx)+" Y="+String(cy2));
                }},
            // Buton Debounce Hızı
            {"Btn Debounce " + String(btnSpd) + "ms",
                [btnSpd]() {
                    uint8_t v = btnSpd;
                    while (!readButton()) {
                        JoyDir d = readJoystick();
                        if (d == JoyDir::UP   && v < 200) v += 5;
                        if (d == JoyDir::DOWN && v > 10)  v -= 5;
                        dispClear(); dispStatusBar("Btn Debounce");
                        dispText(0,20,"Debounce: " + String(v) + " ms");
                        dispText(0,32,"Lower = more sensitive");
                        dispText(0,44,"Higher = less bounce");
                        dispText(0,54,"U/D: adj  BTN:save");
                        dispCommit(); delay(60);
                    }
                    prefs.begin("settings2", false);
                    prefs.putUChar("btnSpd", v);
                    prefs.end();
                    dispBannerOK("Debounce: " + String(v) + "ms");
                }},
            // BTN_A Rolü
            {"BTN_A: " + String(btnARoles[btnA % 4]),
                [btnA]() {
                    OptionList roles = {
                        {"Quick WiFi Scan", [](){}},
                        {"Quick BLE Scan",  [](){}},
                        {"Quick RFID Read", [](){}},
                        {"Stats Dashboard", [](){}},
                        {"Back",            [](){}},
                    };
                    int sel = loopOptions(roles, "BTN_A Function");
                    if (sel < 0 || sel == 4) return;
                    prefs.begin("settings2", false);
                    prefs.putUChar("btnARole", (uint8_t)sel);
                    prefs.end();
                    dispBannerOK("BTN_A: " + roles[sel].label);
                }},
            // BTN_B Rolü
            {"BTN_B Role",
                []() {
                    prefs.begin("settings2", false);
                    uint8_t cur = prefs.getUChar("btnBRole", 0);
                    prefs.end();
                    OptionList roles = {
                        {"Log Viewer",     [](){}},
                        {"Quick BLE Scan", [](){}},
                        {"WiFi Scan",      [](){}},
                        {"Serial Shell",   [](){}},
                        {"Back",           [](){}},
                    };
                    int sel = loopOptions(roles, "BTN_B Function");
                    if (sel < 0 || sel == 4) return;
                    prefs.begin("settings2", false);
                    prefs.putUChar("btnBRole", (uint8_t)sel);
                    prefs.end();
                    dispBannerOK("BTN_B: " + roles[sel].label);
                }},
            // Potansiyometre Kalibrasyonu
            {"Pot Calibrate",
                []() {
                    dispClear(); dispStatusBar("Pot Calibrate");
                    dispText(0,14,"Pot'u tamamen sola");
                    dispText(0,24,"sonra saga cevirin.");
                    dispText(0,34,"BTN: bitti");
                    dispCommit();
                    uint16_t potMin=4095, potMax=0;
                    while (!readButton()) {
                        uint16_t v = analogRead(PIN_POT);
                        if (v < potMin) potMin = v;
                        if (v > potMax) potMax = v;
                        dispClear(); dispStatusBar("Pot Calibrate");
                        dispText(0,14,"Simdiki: " + String(v));
                        dispText(0,24,"Min: " + String(potMin));
                        dispText(0,34,"Max: " + String(potMax));
                        // Bar göstergesi
                        uint8_t bw = map(v, potMin>0?potMin:0, potMax<4095?potMax:4095, 0, OLED_W-4);
                        display.drawRect(2,44,OLED_W-4,8,SSD1306_WHITE);
                        display.fillRect(2,44,bw,8,SSD1306_WHITE);
                        dispText(0,56,"BTN: done");
                        dispCommit(); delay(50);
                    }
                    prefs.begin("settings2", false);
                    prefs.putUShort("potMin", potMin);
                    prefs.putUShort("potMax", potMax);
                    prefs.end();
                    dispBannerOK("Pot: "+String(potMin)+"-"+String(potMax));
                }},
            // Pot Eşik Testi (anlık okuma)
            {"Pot Live Test",
                []() {
                    prefs.begin("settings2", true);
                    uint16_t pMin = prefs.getUShort("potMin", 0);
                    uint16_t pMax = prefs.getUShort("potMax", 4095);
                    prefs.end();
                    dispClear(); dispStatusBar("Pot Live Test");
                    dispText(0,54,"BTN: cik");
                    while (!readButton()) {
                        uint16_t v = analogRead(PIN_POT);
                        uint8_t  pct = map(v, pMin, pMax, 0, 100);
                        dispClear(); dispStatusBar("Pot Live Test");
                        dispText(0,14,"Raw: " + String(v));
                        dispText(0,24,"Pct: " + String(pct) + "%");
                        dispText(0,34,"Min:"+String(pMin)+" Max:"+String(pMax));
                        display.drawRect(2,44,OLED_W-4,8,SSD1306_WHITE);
                        display.fillRect(2,44,map(pct,0,100,0,OLED_W-4),8,SSD1306_WHITE);
                        dispText(0,56,"BTN: exit");
                        dispCommit(); delay(60);
                    }
                }},
            // CPU Frekansı
            {"CPU Freq",
                []() {
                    OptionList freqs = {
                        {"80 MHz  (eco)",  []() { setCpuFrequencyMhz(80);  dispBannerOK("CPU: 80MHz"); }},
                        {"160 MHz (mid)",  []() { setCpuFrequencyMhz(160); dispBannerOK("CPU: 160MHz"); }},
                        {"240 MHz (max)",  []() { setCpuFrequencyMhz(240); dispBannerOK("CPU: 240MHz"); }},
                        {"Back",           [](){}},
                    };
                    int sel = loopOptions(freqs, "CPU Frequency");
                    if (sel >= 0 && sel < 3) freqs[sel].action();
                }},
            // Güç Tasarruf Modu
            {"Power Save",
                []() {
                    prefs.begin("settings2", false);
                    bool ps = prefs.getBool("pwrSave", false);
                    ps = !ps;
                    prefs.putBool("pwrSave", ps);
                    prefs.end();
                    if (ps) setCpuFrequencyMhz(80);
                    else    setCpuFrequencyMhz(240);
                    dispBannerOK(String("Power Save: ") + (ps?"ON (80MHz)":"OFF (240MHz)"));
                }},
            {"Back", [](){}},
        };
        int sel = loopOptions(opts, "Hardware");
        if (sel < 0 || sel == (int)opts.size()-1) return;
        opts[sel].action();
    }
}

// ── Güvenlik alt menüsü ──────────────────────────────────
static void settings_security_menu() {
    while (true) {
        prefs.begin("settings2", true);
        bool stealthMode  = prefs.getBool("stealth",  false);
        bool logEncrypt   = prefs.getBool("logEnc",   false);
        bool autoWipeEn   = prefs.getBool("autoWipe", false);
        uint8_t wipeAfter = prefs.getUChar("wipeTries", 5);
        prefs.end();

        OptionList opts = {
            // PIN Kilidi (mevcut cfg_pin_setup_run kullan)
            {"PIN Lock " + String(g_cfg.pinLockEnable?"[ON]":"[OFF]"),
                []() { cfg_pin_setup_run(); }},
            // PIN'i değiştir
            {"Change PIN",
                []() {
                    if (g_cfg.pinLockEnable) {
                        if (!pinLockCheck()) return;
                    }
                    char buf[8] = "";
                    if (pinEnterNew("New PIN", buf)) {
                        strncpy(g_cfg.pinCode, buf, 7);
                        g_cfg.pinLockEnable = true;
                        cfg_save();
                        dispBannerOK("PIN changed!");
                    }
                }},
            // Gizli Mod — SSID'leri gizle, BLE adını maskele
            {"Stealth Mode " + String(stealthMode?"[ON]":"[OFF]"),
                [stealthMode]() {
                    bool v = !stealthMode;
                    prefs.begin("settings2", false);
                    prefs.putBool("stealth", v);
                    prefs.end();
                    dispBannerOK(String("Stealth: ") + (v?"ON":"OFF"));
                }},
            // Log Şifreleme (XOR basit)
            {"Log Encrypt " + String(logEncrypt?"[ON]":"[OFF]"),
                [logEncrypt]() {
                    bool v = !logEncrypt;
                    prefs.begin("settings2", false);
                    prefs.putBool("logEnc", v);
                    prefs.end();
                    dispBannerOK(String("Log Enc: ") + (v?"ON":"OFF"));
                }},
            // Log Temizle
            {"Clear Logs",
                []() {
                    dispClear(); dispStatusBar("Clear Logs");
                    dispText(0,22,"Tum loglar silinecek.");
                    dispText(0,36,"[BTN] evet  [LONG] hayir");
                    dispCommit();
                    bool confirmed = false;
                    uint32_t t = millis();
                    while (millis()-t < 5000) {
                        if (readButton())     { confirmed = true; break; }
                        if (readButtonLong()) { break; }
                        delay(20);
                    }
                    if (confirmed) {
                        g_logHead = 0; g_logCount = 0;
                        for (uint8_t i=0; i<LOG_MAX_LINES; i++) g_log[i] = "";
                        dispBannerOK("Logs cleared");
                    } else {
                        dispBannerWarn("Cancelled");
                    }
                }},
            // Otomatik Veri Silme (yanlış PIN)
            {"Auto Wipe " + String(autoWipeEn?"[ON]":"[OFF]"),
                [autoWipeEn]() {
                    bool v = !autoWipeEn;
                    prefs.begin("settings2", false);
                    prefs.putBool("autoWipe", v);
                    prefs.end();
                    dispBannerOK(String("Auto Wipe: ") + (v?"ON":"OFF"));
                }},
            // Yanlış PIN Deneme Limiti
            {"Wipe After " + String(wipeAfter) + " tries",
                [wipeAfter]() {
                    uint8_t v = wipeAfter;
                    while (!readButton()) {
                        JoyDir d = readJoystick();
                        if (d == JoyDir::UP   && v < 20) v++;
                        if (d == JoyDir::DOWN && v > 1)  v--;
                        dispClear(); dispStatusBar("Wipe Threshold");
                        dispText(0,20,"Wrong tries: " + String(v));
                        dispText(0,32,"Then factory reset!");
                        dispText(0,54,"U/D: adj  BTN:save");
                        dispCommit(); delay(80);
                    }
                    prefs.begin("settings2", false);
                    prefs.putUChar("wipeTries", v);
                    prefs.end();
                    dispBannerOK("Wipe at: " + String(v));
                }},
            // Cihaz Adı
            {"Device Name",
                []() {
                    prefs.begin("settings2", false);
                    String nm = prefs.getString("devName", "M5Sharkino");
                    prefs.end();
                    char buf[24];
                    strncpy(buf, nm.c_str(), 23); buf[23] = '\0';
                    if (charPicker(buf, 23, "Device Name")) {
                        prefs.begin("settings2", false);
                        prefs.putString("devName", String(buf));
                        prefs.end();
                        dispBannerOK("Name: " + String(buf));
                    }
                }},
            // Factory Reset
            {"Factory Reset",
                []() { cfg_factory_run(); }},
            {"Back", [](){}},
        };
        int sel = loopOptions(opts, "Security");
        if (sel < 0 || sel == (int)opts.size()-1) return;
        opts[sel].action();
    }
}

