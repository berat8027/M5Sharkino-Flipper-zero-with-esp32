// Simple hash: djb2
static uint32_t djb2Hash(const char* str) {
    uint32_t h = 5381;
    while (*str) h = ((h << 5) + h) + (uint8_t)*str++;
    return h;
}

static void crypto_hash_run() {
    static const char* SAMPLES[] = {
        "admin", "password", "123456", "qwerty", "M5Sharkino",
        "root", "toor", "letmein", "welcome", "test"
    };
    static constexpr uint8_t SAMPLE_COUNT = 10;

    OptionList list;
    for (uint8_t i = 0; i < SAMPLE_COUNT; i++) {
        uint32_t h = djb2Hash(SAMPLES[i]);
        char label[28]; sprintf(label, "%s: %08X", SAMPLES[i], h);
        list.push_back({label, [](){}});
    }
    list.push_back({"Back", [](){}});
    loopOptions(list, "DJB2 Hash");
}

// Caesar cipher with pot = shift amount
static void crypto_caesar_run() {
    static const char PLAIN[] = "ATTACK AT DAWN";
    while (!readButton()) {
        potApplyBrightness();
        uint8_t shift = map(analogRead(PIN_POT), 0, 4095, 0, 25);
        String cipher = "";
        for (uint8_t i = 0; PLAIN[i]; i++) {
            char c = PLAIN[i];
            if (c >= 'A' && c <= 'Z') c = 'A' + (c - 'A' + shift) % 26;
            cipher += c;
        }
        dispClear(); dispStatusBar("Caesar Cipher");
        dispText(0, 12, "Plain:  " + String(PLAIN));
        dispText(0, 24, "Shift:  " + String(shift));
        dispText(0, 36, "Cipher: " + cipher);
        dispText(0, 50, "Pot: change shift");
        dispText(0, 58, "[BTN] back");
        dispCommit();
        delay(60);
    }
}

// Password strength meter
static void crypto_pwstrength_run() {
    static char pw[33] = "password123";
    charPicker(pw, 32, "Enter Password");

    uint8_t score = 0;
    bool hasUpper=false, hasLower=false, hasDigit=false, hasSymbol=false;
    for (uint8_t i = 0; pw[i]; i++) {
        char c = pw[i];
        if (c>='A'&&c<='Z') hasUpper=true;
        if (c>='a'&&c<='z') hasLower=true;
        if (c>='0'&&c<='9') hasDigit=true;
        if (!isalnum(c))    hasSymbol=true;
    }
    uint8_t len = strlen(pw);
    if (len >= 8)  score += 20;
    if (len >= 12) score += 20;
    if (len >= 16) score += 10;
    if (hasUpper)  score += 15;
    if (hasLower)  score += 15;
    if (hasDigit)  score += 10;
    if (hasSymbol) score += 10;

    const char* grade = score >= 80 ? "STRONG" : score >= 50 ? "MEDIUM" : "WEAK";
    dispClear(); dispStatusBar("PW Strength");
    dispText(0, 12, "PW: " + String(pw).substring(0,18));
    dispText(0, 22, "Len: " + String(len));
    dispText(0, 32, "Score: " + String(score) + "/100");
    dispText(0, 42, "Grade: " + String(grade));
    display.drawRect(0, 52, OLED_W, 8, SSD1306_WHITE);
    display.fillRect(0, 52, map(score,0,100,0,OLED_W), 8, SSD1306_WHITE);
    dispCommit();
    while (!readButton()) { potApplyBrightness(); delay(50); }
}

