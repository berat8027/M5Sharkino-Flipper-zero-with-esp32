// ═══════════════════════════════════════════════════════════
//  MODULE: OTA Update
// ═══════════════════════════════════════════════════════════

static const char OTA_SSID[]   = "OTA Update";
static const char OTA_PASS[]   = "ESP32-S3 OTA";
static const char OTA_IP[]     = "192.168.4.1";

static WebServer* g_otaServer  = nullptr;
static bool       g_otaPending = false;  // firmware staged, waiting user confirm
static size_t     g_otaSize    = 0;
static uint8_t*   g_otaBuf     = nullptr; // PSRAM buffer for staged firmware

static const char OTA_HTML[] PROGMEM = R"rawhtml(
<!DOCTYPE html>
