            }
            dispBannerOK("All OUT pins HIGH");
        }},
        {"Back",         []() { backToMenu(); }},
    };

    // Pin Control seçilince özel liste açılır
    int sel = 0;
    while (!g_returnToMenu) {
        int scroll = 0;
        if (sel < scroll) scroll = sel;
        if (sel >= scroll + 4) scroll = sel - 3;
        gpio_app_render_list(sel, scroll);

        // Input
        JoyDir d = readJoystick();
        if (d == JoyDir::UP   && sel > 0)                        { sel--; buzzNav(); }
        if (d == JoyDir::DOWN && sel < GPIO_APP_PIN_CNT - 1)     { sel++; buzzNav(); }
        if (readButton())     { buzzSelect(); gpio_app_edit_pin(sel); }
        if (readButtonLong()) { backToMenu(); break; }
        delay(8);
    }
}

