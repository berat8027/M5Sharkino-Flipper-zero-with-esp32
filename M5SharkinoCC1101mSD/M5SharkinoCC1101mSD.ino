static void xp_profile_run() {
    String devName = passportGetName();
    uint8_t page = 0;        // 0=pasaport, 1=stats, 2=advanced
    uint8_t animFrame = 0;
    uint32_t lastAnim = millis();

    // Giriş animasyonu — üstten süzülme
    for (int16_t yo = -64; yo <= 0; yo += 10) {
        dispClear();
        display.fillRect(0, yo, OLED_W, 11, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK); display.setTextSize(1);
        display.setCursor(28, yo + 2); display.print("Hacker Passport");
        display.setTextColor(SSD1306_WHITE);
        dispCommit();
        delay(12);
    }

    while (true) {
        potApplyBrightness();

        // Dolphin frame güncelle (her 500ms)
        if (millis() - lastAnim > 500) {
            lastAnim = millis();
            animFrame++;
        }

        if      (page == 0) passportDrawPage1(devName, animFrame);
        else if (page == 1) passportDrawPage2();
        else                passportDrawPage3();

        JoyDir d = readJoystick();
        if (d == JoyDir::RIGHT || d == JoyDir::DOWN) {
            page = (page + 1) % 3;
            buzzNav();
            delay(150);
        }
        if (d == JoyDir::LEFT || d == JoyDir::UP) {
            page = (page + 2) % 3;
            buzzNav();
            delay(150);
        }
        if (readButton() || readButtonLong()) {
            buzzSelect();
            break;
        }
        delay(40);
    }
}

