// ─── Tools extended menu ─────────────────────────────────
// ════════════════════════════════════════════════════════════════════
//  MODULE: UNIVERSAL IR (Infrared) — NEC / Sony / Samsung / RC5 / RAW
//  TX: GPIO4  (IR LED, NPN transistör + 100Ω direnç)
//  RX: GPIO5  (TSOP38238 / VS1838B 38kHz demodülatör)
//
//  Özellikler (Flipper Zero + daha fazlası):
//   • IR Capture (RAW)       — herhangi cihazdan sinyal yakala
//   • IR Send (Protocol)     — NEC/Sony/Samsung/RC5 adres+komut gönder
//   • IR Send (RAW)          — yakalanan sinyali geri oynat
//   • IR Library Spam        — TV kapatma, ses artırma, kanal değiştirme
//   • Flipper .ir dosya çal  — SD'deki .ir dosyalarını gerçekten TX et
//   • IR Brute Force         — belirli protokolde tüm komutları tara
//   • Multi-protocol decode  — gelen sinyalin protokolünü göster
//   • SD Kaydet / Yükle      — yakalanan sinyalleri /ir/ klasörüne kaydet
// ════════════════════════════════════════════════════════════════════

// ─── Global IR nesneleri ─────────────────────────────────────────────
static IRsend   g_irSend(PIN_IR_TX);
static IRrecv   g_irRecv(PIN_IR_RX, 1024, 15, true);
static bool     g_irInited    = false;
static bool     g_irRecvOn    = false;

// Son yakalanan raw sinyal
static std::vector<uint16_t> g_irLastRaw;
static decode_type_t          g_irLastProto  = decode_type_t::UNKNOWN;
static uint64_t               g_irLastValue  = 0;
static uint16_t               g_irLastBits   = 0;
static uint32_t               g_irLastAddr   = 0;
static uint32_t               g_irLastCmd    = 0;

// ─── Init / Deinit ───────────────────────────────────────────────────
static void ir_init() {
    if (!g_irInited) {
        g_irSend.begin();
        g_irInited = true;
    }
}

static void ir_recv_start() {
    if (!g_irRecvOn) {
        g_irRecv.enableIRIn();
        g_irRecvOn = true;
    }
}

static void ir_recv_stop() {
    if (g_irRecvOn) {
        g_irRecv.disableIRIn();
        g_irRecvOn = false;
    }
}

// ─── Protocol adından decode_type_t al ───────────────────────────────
static decode_type_t ir_proto_from_name(const String& name) {
    if (name == "NEC")    return decode_type_t::NEC;
    if (name == "SONY")   return decode_type_t::SONY;
    if (name == "SAMSUNG")return decode_type_t::SAMSUNG;
    if (name == "RC5")    return decode_type_t::RC5;
    if (name == "RC6")    return decode_type_t::RC6;
    if (name == "JVC")    return decode_type_t::JVC;
    if (name == "LG")     return decode_type_t::LG;
    if (name == "SHARP")  return decode_type_t::SHARP;
    if (name == "PANASONIC") return decode_type_t::PANASONIC;
    if (name == "MITSUBISHI") return decode_type_t::MITSUBISHI;
    if (name == "WHYNTER")   return decode_type_t::WHYNTER;
    return decode_type_t::UNKNOWN;
}

// ─── Protocol adı al ────────────────────────────────────────────────
static String ir_proto_name(decode_type_t t) {
    return String(typeToString(t, false).c_str());
}

// ─── IR Sinyal yakala (RAW) ──────────────────────────────────────────
static void ir_capture_run() {
    ir_recv_start();
    // Flipper Zero IR ogrenme ekrani -- InfraredLearnShort ikonu
    dispClear();
    dispStatusBar("IR Capture");
    // Ikon alt tarafa, metin ust tarafa
    int16_t irX = (OLED_W - FZI_IRLearn_W) / 2;
    display.drawBitmap(irX, OLED_H - FZI_IRLearn_H - 1,
        FZI_IRLearn, FZI_IRLearn_W, FZI_IRLearn_H, SSD1306_WHITE);
    dispText(0, 14, "Kumandaya bas...");
    dispText(0, 24, "38kHz IR alici");
    dispText(0, 54, "[BTN]=iptal");
    dispCommit();

    decode_results results;
    uint32_t timeout = millis() + 30000;
    bool got = false;

    while (millis() < timeout && !readButton()) {
        if (g_irRecv.decode(&results)) {
            got = true;
            // Bilgileri kaydet
            g_irLastProto = results.decode_type;
            g_irLastValue = results.value;
            g_irLastBits  = results.bits;
            g_irLastAddr  = 0;
            g_irLastCmd   = 0;

            // RAW veriyi kopyala
            g_irLastRaw.clear();
            for (uint16_t i = 1; i < results.rawlen; i++) {
                uint16_t dur = results.rawbuf[i] * kRawTick;
                if (dur > 50) g_irLastRaw.push_back(dur);
            }

            // NEC/Samsung gibi protokollerde adres+komut çıkar
            if (results.decode_type == decode_type_t::NEC) {
                g_irLastAddr = (results.value >> 16) & 0xFFFF;
                g_irLastCmd  = results.value & 0xFFFF;
            } else if (results.decode_type == decode_type_t::SAMSUNG) {
                g_irLastAddr = (results.value >> 16) & 0xFFFF;
                g_irLastCmd  = results.value & 0xFFFF;
            } else if (results.decode_type == decode_type_t::RC5 ||
                       results.decode_type == decode_type_t::RC6) {
                g_irLastAddr = (results.value >> 6) & 0x1F;
                g_irLastCmd  = results.value & 0x3F;
            } else if (results.decode_type == decode_type_t::SONY) {
                g_irLastCmd  = results.value & 0x7F;
                g_irLastAddr = (results.value >> 7) & 0x1F;
            }

            g_irRecv.resume();
            break;
        }
        delay(50);
    }

    ir_recv_stop();

    if (!got) {
        dispBannerWarn("Sinyal alınamadı");
        return;
    }

    // Sonucu göster
    buzzOK();
    g_xpIrCnt++;
    xpAdd(XP_PER_IR_CAP);
    dispClear();
    dispStatusBar("IR Yakalandı!");
    String protoStr = ir_proto_name(g_irLastProto);
    dispText(0, 14, "Proto: " + protoStr);
    char buf[32];
    snprintf(buf, sizeof(buf), "Val: 0x%llX", (unsigned long long)g_irLastValue);
    dispText(0, 24, String(buf));
    snprintf(buf, sizeof(buf), "Bits: %d", g_irLastBits);
    dispText(0, 34, String(buf));
    dispText(0, 44, "RAW: " + String(g_irLastRaw.size()) + " örnek");
    dispText(0, 54, "[BTN]=devam");
    dispCommit();
    waitButton(5000);
}

// ─── Son yakalanan sinyali gönder (RAW replay) ───────────────────────
static void ir_replay_run() {
    if (g_irLastRaw.empty()) {
        dispBannerErr("Önce IR yakala");
        return;
    }
    ir_init();
    dispClear();
    dispStatusBar("IR Replay");
    dispText(0, 14, "Gönderiliyor...");
    dispText(0, 26, "Proto: " + ir_proto_name(g_irLastProto));
    dispText(0, 38, "RAW: " + String(g_irLastRaw.size()) + " örnek");
    dispText(0, 50, "TX GPIO" + String(PIN_IR_TX));
    dispCommit();

    // Önce protokol bazlı göndermeyi dene, yoksa RAW
    bool sent = false;
    if (g_irLastProto == decode_type_t::NEC && g_irLastValue != 0) {
        g_irSend.sendNEC(g_irLastValue, g_irLastBits);
        sent = true;
    } else if (g_irLastProto == decode_type_t::SAMSUNG && g_irLastValue != 0) {
        g_irSend.sendSAMSUNG(g_irLastValue, g_irLastBits);
        sent = true;
    } else if (g_irLastProto == decode_type_t::SONY && g_irLastValue != 0) {
        g_irSend.sendSony(g_irLastValue, g_irLastBits, 3);
        sent = true;
    } else if (g_irLastProto == decode_type_t::RC5 && g_irLastValue != 0) {
        g_irSend.sendRC5(g_irLastValue, g_irLastBits);
        sent = true;
    } else if (g_irLastProto == decode_type_t::RC6 && g_irLastValue != 0) {
        g_irSend.sendRC6(g_irLastValue, g_irLastBits);
        sent = true;
    }

    if (!sent) {
        // RAW gönder
        uint16_t rawArr[g_irLastRaw.size()];
        for (size_t i = 0; i < g_irLastRaw.size(); i++) rawArr[i] = g_irLastRaw[i];
        g_irSend.sendRaw(rawArr, g_irLastRaw.size(), 38);
    }

    buzzOK();
    g_xpIrSendCnt++;
    xpAdd(XP_PER_IR_SEND);
    dispBannerOK("IR Gönderildi!");
}

// ─── Manuel protokol bazlı gönder ───────────────────────────────────
static void ir_send_manual_run() {
    ir_init();

    // Protokol seç
    OptionList protoOpts = {
        {"NEC",       [](){}},
        {"SONY",      [](){}},
        {"SAMSUNG",   [](){}},
        {"RC5",       [](){}},
        {"RC6",       [](){}},
        {"JVC",       [](){}},
        {"LG",        [](){}},
        {"SHARP",     [](){}},
        {"PANASONIC", [](){}},
        {"Back",      [](){}},
    };
    int psel = loopOptions(protoOpts, "Protokol Sec");
    if (psel < 0 || psel >= 9) return;

    String protocols[] = {"NEC","SONY","SAMSUNG","RC5","RC6","JVC","LG","SHARP","PANASONIC"};
    String chosenProto = protocols[psel];
    decode_type_t protoType = ir_proto_from_name(chosenProto);

    // Adres gir (joystick ile 0-0xFFFF)
    dispClear();
    dispStatusBar("IR Adres Gir");
    dispText(0, 14, "Protokol: " + chosenProto);
    dispText(0, 26, "Adres (hex 0-FFFF):");
    dispText(0, 38, "J-UP/DN: digit++/--");
    dispText(0, 50, "[BTN]=tamam");
    dispCommit();

    uint16_t addr = 0x0000;
    uint16_t cmd  = 0x0000;

    // Basit hex giriş — joystick ile
    auto hexInput = [](const String& prompt, uint16_t& val) {
        uint8_t nibbleIdx = 0;  // 0-3 (MSN to LSN)
        while (true) {
            dispClear();
            dispStatusBar("IR Gir");
            dispText(0, 14, prompt);
            char buf[8];
            snprintf(buf, sizeof(buf), "0x%04X", val);
            dispText(16, 28, String(buf));
            // Kursor alt çizgisi
            display.drawFastHLine(16 + 2 + nibbleIdx * 6, 38, 6, SSD1306_WHITE);
            dispText(0, 50, "J=digit  [BTN]=OK");
            dispCommit();
            JoyDir d = readJoystick();
            if (d == JoyDir::UP) {
                uint16_t nibbleMask = 0xF000 >> (nibbleIdx * 4);
                uint16_t nibbleVal  = (val & nibbleMask) >> ((3 - nibbleIdx) * 4);
                nibbleVal = (nibbleVal + 1) & 0xF;
                val = (val & ~nibbleMask) | (nibbleVal << ((3 - nibbleIdx) * 4));
            } else if (d == JoyDir::DOWN) {
                uint16_t nibbleMask = 0xF000 >> (nibbleIdx * 4);
                uint16_t nibbleVal  = (val & nibbleMask) >> ((3 - nibbleIdx) * 4);
                nibbleVal = (nibbleVal - 1) & 0xF;
                val = (val & ~nibbleMask) | (nibbleVal << ((3 - nibbleIdx) * 4));
            } else if (d == JoyDir::RIGHT) {
                nibbleIdx = (nibbleIdx + 1) & 3;
            } else if (d == JoyDir::LEFT) {
                nibbleIdx = (nibbleIdx - 1) & 3;
            }
            if (readButton()) break;
            delay(120);
        }
    };

    hexInput("ADRES gir:", addr);
    hexInput("KOMUT gir:", cmd);

    // Gönder
    dispClear();
    dispStatusBar("IR Gönder");
    char buf[48];
    snprintf(buf, sizeof(buf), "%s Addr:0x%04X", chosenProto.c_str(), addr);
    dispText(0, 14, String(buf));
    snprintf(buf, sizeof(buf), "Cmd: 0x%04X", cmd);
    dispText(0, 26, String(buf));
    dispText(0, 38, "Gönderiliyor...");
    dispCommit();

    uint64_t payload = ((uint64_t)addr << 16) | cmd;
    switch (protoType) {
        case decode_type_t::NEC:       g_irSend.sendNEC(payload, 32); break;
        case decode_type_t::SONY:      g_irSend.sendSony(payload, 20, 3); break;
        case decode_type_t::SAMSUNG:   g_irSend.sendSAMSUNG(payload, 32); break;
        case decode_type_t::RC5:       g_irSend.sendRC5(payload, 12); break;
        case decode_type_t::RC6:       g_irSend.sendRC6(payload, 20); break;
        case decode_type_t::JVC:       g_irSend.sendJVC(payload, 16); break;
        case decode_type_t::LG:        g_irSend.sendLG(payload, 28); break;
        case decode_type_t::SHARP:     g_irSend.sendSharpRaw(payload, 15); break;
        case decode_type_t::PANASONIC: g_irSend.sendPanasonic(addr, cmd); break;
        default:                       g_irSend.sendNEC(payload, 32); break;
    }

    buzzOK();
    g_xpIrSendCnt++;
    xpAdd(XP_PER_IR_SPAM);
    dispBannerOK("IR Gönderildi!");
}

