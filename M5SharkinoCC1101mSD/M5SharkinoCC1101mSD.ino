// ═══════════════════════════════════════════════════════════════════
//  FLIPPER ZERO STYLE GRID KEYBOARD
//  Layout: 128x64 OLED, 3 tuş satırı + input bar + mod göstergesi
//
//  Kontroller:
//   Joystick L/R  → Grid'de yatay karakter seçimi
//   Joystick U/D  → Satır değiştir
//   BTN (kısa)    → Seçili karakteri ekle  (en sol + LEFT = Backspace)
//   BTN (uzun)    → Onayla ve çık (true döner)
//   PIN_BTN_A     → Mod: küçük → büyük → sayı/sembol → küçük
//   PIN_BTN_B     → Backspace
//   PIN_BTN_D     → İptal (false döner)
// ═══════════════════════════════════════════════════════════════════

// Klavye satırları — 3 mod:
//   0 = küçük harf  1 = büyük harf  2 = sayı+sembol
static const char KB_ROW0_LOWER[] = "qwertyuiop";
static const char KB_ROW1_LOWER[] = "asdfghjkl ";  // sondaki = SPACE
static const char KB_ROW2_LOWER[] = "zxcvbnm.,!";

static const char KB_ROW0_UPPER[] = "QWERTYUIOP";
static const char KB_ROW1_UPPER[] = "ASDFGHJKL ";
static const char KB_ROW2_UPPER[] = "ZXCVBNM.,!";

static const char KB_ROW0_SYM[]   = "1234567890";
static const char KB_ROW1_SYM[]   = "!@#$%^&*()";
static const char KB_ROW2_SYM[]   = "-_=+[];'\"\\";

// Her satırda 10 karakter
static constexpr uint8_t KB_COLS = 10;
static constexpr uint8_t KB_ROWS = 3;

// Klavye çizimi için sabitler
// OLED: 128x64
// Input bar: y=0..12 (status bar + metin)
// Mod bar:   y=13..20
// Grid:      y=22..63  (3 satır × ~14px)
static constexpr uint8_t KB_INPUT_Y   = 0;
static constexpr uint8_t KB_MOD_Y     = 14;
static constexpr uint8_t KB_GRID_Y    = 25;  // grid başlangıcı
static constexpr uint8_t KB_ROW_H     = 13;  // satır yüksekliği
static constexpr uint8_t KB_COL_W     = 12;  // sütun genişliği (128/10 = 12.8 → 12)
static constexpr uint8_t KB_SEL_W     = 10;  // seçili kutu genişliği
static constexpr uint8_t KB_SEL_H     = 11;  // seçili kutu yüksekliği

static void kbDrawInputBar(const char* buf, uint8_t maxLen) {
    // Üst solid beyaz şerit — Flipper status bar stili
    display.fillRect(0, 0, OLED_W, 13, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setTextSize(1);

    // Metin — sağa hizalı (son karakterler görünür)
    uint8_t len = strlen(buf);
    // Max sığan karakter: (128 - 4) / 6 = 20
    const char* src = buf;
    if (len > 20) src = buf + (len - 20);
    display.setCursor(2, 3);
    display.print(src);

    // İmleç: son karakterin sağında yanıp söner (her zaman göster)
    uint8_t curX = 2 + (len > 20 ? 20 : len) * 6;
    if (curX < OLED_W - 2) {
        display.fillRect(curX, 3, 2, 8, SSD1306_BLACK);
    }
    display.setTextColor(SSD1306_WHITE);
}

static void kbDrawModBar(uint8_t mode) {
    // y=14..23 — mod göstergesi
    // 3 kutu yan yana: [abc]  [ABC]  [123]
    static const char* labels[] = {"abc", "ABC", "123"};
    uint8_t boxW = 30, gap = 4;
    uint8_t totalW = 3 * boxW + 2 * gap;
    uint8_t startX = (OLED_W - totalW) / 2;

    for (uint8_t m = 0; m < 3; m++) {
        uint8_t x = startX + m * (boxW + gap);
        if (m == mode) {
            // Seçili mod: dolu beyaz kutu, siyah metin
            display.fillRoundRect(x, KB_MOD_Y, boxW, 9, 2, SSD1306_WHITE);
            display.setTextColor(SSD1306_BLACK);
        } else {
            // Pasif mod: çerçeve
            display.drawRoundRect(x, KB_MOD_Y, boxW, 9, 2, SSD1306_WHITE);
            display.setTextColor(SSD1306_WHITE);
        }
        display.setTextSize(1);
        display.setCursor(x + 7, KB_MOD_Y + 1);
        display.print(labels[m]);
    }
    display.setTextColor(SSD1306_WHITE);
}

static const char* kbGetRow(uint8_t mode, uint8_t row) {
    if (mode == 0) {
        if (row == 0) return KB_ROW0_LOWER;
        if (row == 1) return KB_ROW1_LOWER;
        return KB_ROW2_LOWER;
    } else if (mode == 1) {
        if (row == 0) return KB_ROW0_UPPER;
        if (row == 1) return KB_ROW1_UPPER;
        return KB_ROW2_UPPER;
    } else {
        if (row == 0) return KB_ROW0_SYM;
        if (row == 1) return KB_ROW1_SYM;
        return KB_ROW2_SYM;
    }
}

static void kbDrawGrid(uint8_t mode, uint8_t selRow, uint8_t selCol) {
    // 3 satır × 10 sütun grid
    // Sol kenar özel: ilk sütun kolonu backspace ikonu için ayrılabilir
    // Şimdilik normal — tüm sütunlar eşit

    for (uint8_t row = 0; row < KB_ROWS; row++) {
        const char* rowStr = kbGetRow(mode, row);
        uint8_t y = KB_GRID_Y + row * KB_ROW_H;

        for (uint8_t col = 0; col < KB_COLS; col++) {
            uint8_t x = col * KB_COL_W + 4;
            char c = rowStr[col];

            bool selected = (row == selRow && col == selCol);

            if (selected) {
                // Seçili karakter: dolu beyaz kutu — Flipper highlight stili
                display.fillRoundRect(x - 1, y - 1, KB_SEL_W + 2, KB_SEL_H, 2, SSD1306_WHITE);
                display.setTextColor(SSD1306_BLACK);
                display.setTextSize(1);
                // Space karakterini '_' ile göster
                display.setCursor(x + 1, y + 1);
                display.print(c == ' ' ? '_' : c);
                display.setTextColor(SSD1306_WHITE);
            } else {
                // Normal karakter: sadece metin
                display.setTextColor(SSD1306_WHITE);
                display.setTextSize(1);
                display.setCursor(x + 1, y + 1);
                display.print(c == ' ' ? '_' : c);
            }
        }

        // Satır ayırıcı çizgi (son satırdan sonra değil)
        if (row < KB_ROWS - 1) {
            display.drawFastHLine(4, y + KB_ROW_H - 1, OLED_W - 8, SSD1306_WHITE);
            // Noktalı çizgi gibi: her 4px'te bir pixel sil
            for (uint8_t px = 4; px < OLED_W - 8; px += 4) {
                display.drawPixel(px + 2, y + KB_ROW_H - 1, SSD1306_BLACK);
            }
        }
    }

    // Sağ kenarda özel tuşlar (y konumları satır hizasında):
    // [<] = Backspace  — satır 0 sağı, x=120
    // [OK] = Onayla    — satır 1 sağı
    // SPACE önceki satır 2, col 9 zaten '_' ile gösterildi

    // DEL etiketi — sağ üst
    display.setTextSize(1); display.setTextColor(SSD1306_WHITE);
    // Sağ kenarda küçük ikon çiz: ok sola + X
    uint8_t bsy = KB_GRID_Y - 1;
    // Backspace ikonu (sol ok + küçük x): x=117
    display.drawLine(117, bsy+4, 120, bsy+4, SSD1306_WHITE);  // gövde
    display.drawLine(117, bsy+4, 119, bsy+2, SSD1306_WHITE);  // üst kanat
    display.drawLine(117, bsy+4, 119, bsy+6, SSD1306_WHITE);  // alt kanat
    display.drawLine(121, bsy+2, 124, bsy+6, SSD1306_WHITE);  // X sol
    display.drawLine(121, bsy+6, 124, bsy+2, SSD1306_WHITE);  // X sağ

    // OK etiketi — alt sağ
    display.setCursor(115, KB_GRID_Y + 2*KB_ROW_H + 2);
    display.print("OK");
}

// ── Ana charPicker — Flipper Zero grid klavye ───────────────
bool charPicker(char* buf, uint8_t maxLen, const String& title) {
    uint8_t len    = (uint8_t)strlen(buf);
    if (len >= maxLen - 1) len = maxLen - 1;
    buf[len] = '\0';

    uint8_t mode   = 0;   // 0=lower 1=upper 2=sym
    uint8_t selRow = 0;
    uint8_t selCol = 0;

    uint32_t lastJoyMs = 0;
    const uint32_t JOY_REPEAT_FIRST = 300;  // ms — ilk tekrar gecikmesi
    const uint32_t JOY_REPEAT_CONT  = 120;  // ms — sürekli tekrar
    JoyDir lastDir = JoyDir::NONE;
    uint32_t holdStart = 0;
    bool holdFired = false;

    // PIN_BTN_A / B / D durumları
    bool btnA_prev = false, btnB_prev = false, btnD_prev = false;

    while (true) {
        // ── Ekran çiz ─────────────────────────────────────
        dispClear();
        kbDrawInputBar(buf, maxLen);
        kbDrawModBar(mode);
        kbDrawGrid(mode, selRow, selCol);
        dispCommit();

        // ── Joystick girişi — hız kontrolü ────────────────
        JoyDir d = JoyDir::NONE;
        {
            uint16_t x = analogRead(PIN_JOY_X);
            uint16_t y = analogRead(PIN_JOY_Y);
            JoyDir raw = JoyDir::NONE;
            constexpr uint16_t KB_JOY_HI = 2800;
            constexpr uint16_t KB_JOY_LO = 1300;
            if      (y > KB_JOY_HI) raw = JoyDir::UP;
            else if (y < KB_JOY_LO) raw = JoyDir::DOWN;
            else if (x < KB_JOY_LO) raw = JoyDir::LEFT;
            else if (x > KB_JOY_HI) raw = JoyDir::RIGHT;

            if (raw != JoyDir::NONE) {
                uint32_t now = millis();
                if (raw != lastDir) {
                    // Yeni yön
                    lastDir   = raw;
                    holdStart = now;
                    holdFired = false;
                    d         = raw;
                } else {
                    // Aynı yön — tekrar mantığı
                    uint32_t held = now - holdStart;
                    if (!holdFired && held >= JOY_REPEAT_FIRST) {
                        holdFired = true;
                        lastJoyMs = now;
                        d = raw;
                    } else if (holdFired && (now - lastJoyMs) >= JOY_REPEAT_CONT) {
                        lastJoyMs = now;
                        d = raw;
                    }
                }
            } else {
                lastDir   = JoyDir::NONE;
                holdFired = false;
            }
        }

        if (d == JoyDir::LEFT) {
            if (selCol > 0) {
                selCol--;
                buzzNav();
            } else {
                // En sol kenarda LEFT = Backspace
                if (len > 0) { len--; buf[len] = '\0'; buzzNav(); }
            }
        }
        if (d == JoyDir::RIGHT) {
            if (selCol < KB_COLS - 1) { selCol++; buzzNav(); }
        }
        if (d == JoyDir::UP) {
            selRow = (selRow + KB_ROWS - 1) % KB_ROWS; buzzNav();
        }
        if (d == JoyDir::DOWN) {
            selRow = (selRow + 1) % KB_ROWS; buzzNav();
        }

        // ── Joystick butonu ────────────────────────────────
        // Kısa basış = karakter ekle
        // Uzun basış = onayla
        if (readButton()) {
            const char* row = kbGetRow(mode, selRow);
            char c = row[selCol];
            if (len < maxLen - 1) {
                buf[len++] = c;
                buf[len]   = '\0';
                buzzSelect();
                // Otomatik mod geçişi: büyük yazdıktan sonra küçüğe dön
                if (mode == 1) mode = 0;
            }
        }
        if (readButtonLong()) {
            buzzOK();
            return true;
        }

        // ── Fiziksel butonlar ──────────────────────────────
        // BTN_A: mod döngüsü (lower→upper→sym→lower)
        bool btnA = (digitalRead(PIN_BTN_A) == LOW);
        if (btnA && !btnA_prev) {
            mode = (mode + 1) % 3;
            buzzNav();
        }
        btnA_prev = btnA;

        // BTN_B: Backspace
        bool btnB = (digitalRead(PIN_BTN_B) == LOW);
        if (btnB && !btnB_prev) {
            if (len > 0) { len--; buf[len] = '\0'; buzzNav(); }
        }
        btnB_prev = btnB;

        // BTN_D: İptal
        bool btnD = (digitalRead(PIN_BTN_D) == LOW);
        if (btnD && !btnD_prev) {
            buf[0] = '\0';
            buzzNav();
            return false;
        }
        btnD_prev = btnD;

        delay(10);
    }
}

