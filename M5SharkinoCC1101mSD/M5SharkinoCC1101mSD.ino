        g_mqttClient.publish(topic.c_str(), jsonBuf);
    }
}


// ─── 6. OTA SERIAL ─────────────────────────────────────────────────
void ota_serial(uint32_t size) {
    if (size == 0) {
        Serial.println("OTA_ERR");
        return;
    }

    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(10, 20);
    display.println("OTA Firmware Update");
    display.setCursor(10, 35);
    display.println("Receiving flash binary...");
    display.display();

    if (!Update.begin(size)) {
        Serial.println("OTA_ERR");
        return;
    }

    uint8_t buffer[256];
    uint32_t written = 0;
    uint32_t startTime = millis();

    while (written < size && (millis() - startTime < 30000)) {
        if (Serial.available() > 0) {
            size_t toRead = min((uint32_t)sizeof(buffer), size - written);
            size_t readBytes = Serial.readBytes(buffer, toRead);
            if (Update.write(buffer, readBytes) != readBytes) {
                Serial.println("OTA_ERR");
                Update.abort();
                return;
            }
            written += readBytes;
            startTime = millis();
            
            display.fillRect(10, 50, 108, 8, SSD1306_BLACK);
            display.drawRect(10, 50, 108, 8, SSD1306_WHITE);
            int barWidth = (written * 106) / size;
            display.fillRect(11, 51, barWidth, 6, SSD1306_WHITE);
            display.display();
        }
        yield();
    }

    if (written == size && Update.end(true)) {
        Serial.println("OTA_OK");
        display.clearDisplay();
        display.setCursor(10, 25);
        display.println("OTA Successful!");
        display.println("Rebooting device...");
        display.display();
        delay(2000);
        ESP.restart();
    } else {
        Serial.println("OTA_ERR");
        display.clearDisplay();
        display.setCursor(10, 25);
        display.println("OTA Flash Error!");
        display.display();
        delay(2000);
    }
}

// ─── 7. SUITE SERIAL & BLE TASK (Core 0 / FreeRTOS) ───────────────────
void suite_serial_task(void* pvParameters) {
    Serial.println("[PC SUITE/BLE] Background command service active.");
    
    while (true) {
        String line = "";
        bool isBle = false;

        if (Serial.available() > 0) {
            line = Serial.readStringUntil('\n');
            line.trim();
        } else if (g_nusRxReady) {
            line = g_nusRxBuffer;
            line.trim();
            g_nusRxReady = false;
            g_nusRxBuffer = "";
            isBle = true;
        }

        if (line.isEmpty()) {
            vTaskDelay(pdMS_TO_TICKS(10));
            continue;
        }

        auto reply = [isBle](const String& msg) {
            Serial.println(msg);
            if (isBle) {
                ble_uart_send(msg + "\n");
            }
        };

        if (line == "PAIR_REQUEST") {
            pair_menu_run();
        }
        else if (line == "DEVICE_INFO") {
            uint32_t freeHeap = ESP.getFreeHeap();
            uint32_t totalHeap = ESP.getHeapSize();
            uint32_t uptimeSec = millis() / 1000;
            String mac = WiFi.macAddress();

            char jsonBuf[256];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"fw_ver\":\"2.0\",\"chip\":\"ESP32-S3\",\"mac\":\"%s\",\"free_heap\":%u,\"total_heap\":%u,\"sd_status\":\"%s\",\"sd_size\":0,\"sd_free\":0,\"uptime\":%u,\"battery\":100,\"charging\":1}",
                mac.c_str(), freeHeap, totalHeap, g_sdInited ? "Mounted" : "Not Mounted", uptimeSec
            );
            reply("DEVICE_INFO:" + String(jsonBuf));
        }
        else if (line == "XP_INFO") {
            char jsonBuf[256];
            snprintf(jsonBuf, sizeof(jsonBuf),
                "{\"xp\":%lu,\"level\":%u,\"rank\":\"%s\",\"rfidCnt\":%lu,\"wifiCnt\":%lu,\"bleCnt\":%lu,\"rfCnt\":%lu,\"irCnt\":%lu}",
                (unsigned long)g_xp, g_level, xpRankName(g_level),
                (unsigned long)g_xpRfidCnt, (unsigned long)g_xpWifiCnt, (unsigned long)g_xpBleCnt, (unsigned long)g_xpRfCnt, (unsigned long)g_xpIrCnt
            );
            reply("XP_INFO:" + String(jsonBuf));
        }
        else if (line == "APP_LIST") {
            if (!g_sdInited) {
                reply("APP_LIST_ERR:SD Not Mounted");
            } else {
                File root = SD.open("/flipper/apps");
                if (!root) {
                    reply("APP_LIST_ERR:No Apps Dir");
                } else {
                    reply("APP_LIST_START");
                    File file = root.openNextFile();
                    while (file) {
                        String name = String(file.name());
                        if (name.endsWith(".fap")) {
                            reply("APP_ENTRY:" + name + ":" + String(file.size()));
                        }
                        file = root.openNextFile();
                    }
                    reply("APP_LIST_END");
                    root.close();
                }
            }
        }
        else if (line.startsWith("APP_RUN:")) {
            String appName = line.substring(8);
            String path = String("/flipper/apps/") + appName;
            auto script = fap_parse(path);
            if (!script.empty()) {
                reply("APP_RUN_OK");
                fap_run(script, appName);
            } else {
                reply("APP_RUN_ERR:Parse failed");
            }
        }
        else if (line.startsWith("RF_SCAN_START")) {
            reply("RF_OK:Scan Started");
        }
        else if (line == "RF_SCAN_STOP") {
            reply("RF_OK:Scan Stopped");
        }
        else if (line.startsWith("IR_SEND:")) {
            reply("IR_OK:Sending Signal");
        }
        else if (line.startsWith("MACRO_RUN:")) {
            reply("MACRO_OK:Injecting Payload");
        }
        else if (line == "SCREEN_START") {
            g_screenStreamActive = true;
        }
        else if (line == "SCREEN_STOP") {
            g_screenStreamActive = false;
        }
        else if (line.startsWith("BTN:")) {
            btn_inject(line);
        }
        else if (line.startsWith("SD_")) {
            sd_serial_bridge(line);
        }
        else if (line.startsWith("OTA_START:")) {
            uint32_t otaSize = line.substring(10).toInt();
            ota_serial(otaSize);
        }
        else if (line == "PING") {
            reply("PONG");
        }

        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

// ─── 8. MQTT CALLBACK ──────────────────────────────────────────────
void mqtt_callback(char* topic, byte* payload, unsigned int length) {
    String msg = "";
    for (unsigned int i = 0; i < length; i++) msg += (char)payload[i];
    String topicStr = String(topic);

    String pfx = String(MQTT_PREFIX) + "/" + g_mqttDeviceId + "/";

    if (topicStr == pfx + "btn") {
        btn_inject(msg);
    } else if (topicStr == pfx + "cmd") {
        if (msg == "SCREEN_START")        g_screenStreamActive = true;
        else if (msg == "SCREEN_STOP")    g_screenStreamActive = false;
        else if (msg == "DEVICE_INFO")    device_info_serial();
        else if (msg == "PING") {
            String pongTopic = pfx + "pong";
            g_mqttClient.publish(pongTopic.c_str(), "PONG");
        }
    } else if (topicStr == pfx + "sd_cmd") {
        sd_serial_bridge(msg);
    } else if (topicStr == pfx + "pair") {
        if (msg == "PAIR_REQUEST") pair_menu_run();
    }
}

// ─── 9. MQTT RECONNECT TASK (Core 0) ──────────────────────────────
void mqtt_task(void* pvParameters) {
    g_mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
    g_mqttClient.setCallback(mqtt_callback);
    g_mqttClient.setBufferSize(2560);  // large enough for OLED frame

    String pfx = String(MQTT_PREFIX) + "/" + g_mqttDeviceId;
    String willTopic = pfx + "/status";

    while (true) {
        if (WiFi.status() == WL_CONNECTED) {
            if (!g_mqttClient.connected()) {
                g_mqttConnected = false;
                String clientId = "M5Sharkino-" + g_mqttDeviceId;
                bool ok = g_mqttClient.connect(
                    clientId.c_str(),
                    willTopic.c_str(), 0, true, "offline"
                );
                if (ok) {
                    g_mqttClient.publish(willTopic.c_str(), "online", true);
                    g_mqttClient.subscribe((pfx + "/btn").c_str());
                    g_mqttClient.subscribe((pfx + "/cmd").c_str());
                    g_mqttClient.subscribe((pfx + "/sd_cmd").c_str());
                    g_mqttClient.subscribe((pfx + "/pair").c_str());
                    g_mqttConnected = true;
                    logPush("[MQTT] Broker'a bağlandı: " + String(MQTT_BROKER));
                } else {
                    logPush("[MQTT] Bağlantı hatası: " + String(g_mqttClient.state()));
                    vTaskDelay(pdMS_TO_TICKS(5000));
                    continue;
                }
            }
            g_mqttClient.loop();
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

// ─── 10. INITIALIZE PC SUITE SERVICES ─────────────────────────────

// WiFi + MQTT baslat — ayri bir task icinde non-blocking calisir
void wifi_mqtt_init_task(void* pvParameters) {
    g_mqttDeviceId = WiFi.macAddress();
    g_mqttDeviceId.replace(":", "");

    WiFiManager wm;
    wm.setConfigPortalTimeout(60); // 60 sn bekle (eskiden 120 sn - WDT tetikliyordu)

    wm.setAPCallback([](WiFiManager* wm) {
        display.clearDisplay();
        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(0, 0);
        display.println("Wi-Fi Kurulumu:");
        display.println("");
        display.println("Telefon/PC'den");
        display.println("bu aga baglanin:");
        display.println("");
        display.println("M5Sharkino-Setup");
        display.display();
    });

    bool wifiOk = wm.autoConnect("M5Sharkino-Setup");

    if (wifiOk) {
        display.clearDisplay();
        display.setTextSize(1);
        display.setCursor(0, 0);
        display.println("WiFi Baglandi!");
        display.println(WiFi.localIP().toString());
        display.println("ID: " + g_mqttDeviceId);
        display.display();
        delay(1500);
        logPush("[WiFi] Baglandi: " + WiFi.localIP().toString());

        xTaskCreatePinnedToCore(
            mqtt_task,
            "MQTTTask",
            8192,
            NULL,
            1,
            &hMqttTask,
            tskNO_AFFINITY
        );
    } else {
        logPush("[WiFi] Baglanamadi - sadece USB/BLE modu aktif");
    }

    vTaskDelete(NULL); // Bu tek seferlik task kendini sonlandirir
}

void init_pc_suite() {
    // BLE UART servisini ve yayınını cihaz açılır açılmaz başlat
    ble_uart_init("M5Sharkino-UART");

    // nRF24 Slave UART haberleşme başlat
    // TX=GPIO43 → SuperMini RX
    // RX=GPIO44 ← SuperMini TX
    nrf24UartInit();

    // Serial & BLE task hemen baslar — WiFi beklenmez
    xTaskCreatePinnedToCore(
        suite_serial_task,
        "SuiteSerialTask",
        8192,
        NULL,
        1,
        &hSuiteSerialTask,
        tskNO_AFFINITY
    );

    // Ekran stream task hemen baslar
    xTaskCreatePinnedToCore(
        screen_stream_task,
        "ScreenStreamTask",
        4096,
        NULL,
        1,
        &hScreenStreamTask,
        tskNO_AFFINITY
    );

    // WiFi + MQTT arasindan farkli bir task'ta baslatilir
    // Boylece menu bloklanmaz, WDT tetiklenmez
    xTaskCreatePinnedToCore(
        wifi_mqtt_init_task,
        "WiFiInitTask",
        12288,  // WiFiManager icin yuksek stack
        NULL,
        1,
        NULL,   // handle gerekmez, task kendini siliyor
        tskNO_AFFINITY
    );
}

