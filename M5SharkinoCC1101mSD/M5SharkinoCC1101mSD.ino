// ─── Flipper Zero tarzı geliştirilmiş buzzer ses örüntüleri ──
// Aktif buzzer için Flipper Zero'nun karakteristik ritim desenleri
// Flipper Zero'nun orijinal ses geri bildirimleri:
//   - Navigasyon: çok kısa tek click (15ms)
//   - Seçim onayı: kısa + uzun (30+50ms)  
//   - Hata: tek uzun (400ms)
//   - Başarı: iki kısa yüksek (50+50ms)
//   - Boot: artan ritim (C-E-G-C melodi benzeri)
// ─────────────────────────────────────────────────────────────

// Flipper Zero "boot jingle" daha autentik hali
// Orijinal Flipper Zero boot sesi: 3 nota artan + onay
static void buzzBootFlipper() {
    if (g_buzzerMuted) return;
    // Nota 1: Do (kısa)
    buzzPulse(40, 30);
    // Nota 2: Mi (orta)
    buzzPulse(60, 30);
    // Nota 3: Sol (uzun)
    buzzPulse(90, 30);
    // Onay: çift kısa
    buzzPulse(40, 15);
    buzzPulse(40, 0);
}

// Flipper Zero "success" sesi (level-up, OK işlemleri için)
static void buzzFlipperOK() {
    if (g_buzzerMuted) return;
    buzzPulse(40, 20);
    buzzPulse(70, 0);
}

// Flipper Zero "lock/unlock" haptic benzeri
static void buzzFlipperLock() {
    if (g_buzzerMuted) return;
    buzzPulse(80, 10);
    buzzPulse(30, 10);
    buzzPulse(80, 0);
}

static void wifiScanAll(bool showProgress = true) {
    g_scanResults.clear();
    WiFi.mode(WIFI_STA);
    WiFi.disconnect();
    delay(150);
    if (showProgress) {
        animWifiScanning();  // Flipper Zero WiFi animasyonu
    }
    int n = WiFi.scanNetworks(false, true);
    for (int i = 0; i < n; i++) {
        g_scanResults.push_back({
            WiFi.SSID(i),
            WiFi.BSSIDstr(i),
            WiFi.RSSI(i),
            (uint8_t)WiFi.channel(i),
            (uint8_t)WiFi.encryptionType(i)
        });
        logPush("[SCAN] " + WiFi.SSID(i) + " " + WiFi.BSSIDstr(i) +
                " ch" + String(WiFi.channel(i)) +
                " " + String(WiFi.RSSI(i)) + "dBm");
    }
    if (n > 0) {
        g_xpWifiCnt++;
        xpAdd(XP_PER_WIFI_SCAN);
    }
}

