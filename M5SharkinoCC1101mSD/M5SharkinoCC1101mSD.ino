class MainMenuV2 {
public:
    MainMenuV2() {
        // Orijinal menüler — genişletilmiş versiyonlarla çalışacak
        addItem("WiFi",     new WiFiMenu(),     wifi_extended_menu_run);
        addItem("BLE",      new BLEMenu(),      ble_extended_menu_run);
        addItem("nRF24",    new NRF24Menu(),    nrf24_menu_run);
        addItem("CC1101",   new CC1101Menu(),   cc1101_extended_menu_run);
        addItem("IR",       new IRMenu(),        ir_extended_menu_run);
        addItem("RFID",     new RFIDMenu(),     rfid_extended_menu_run);
        addItem("BadUSB",   new BadUSBMenu(),   nullptr);
        addItem("Marauder", new MarauderMenu(), nullptr);
        addItem("Analog",   new AnalogLabMenu(),nullptr);
        addItem("NetAnal",  new NetAnalMenu(),  nullptr);
        addItem("Crypto+",  new CryptoMenu(),   crypto_extended_menu_run);
        addItem("Games+",   new GamesMenu(),    games_extended_menu_run);
        addItem("Tools+",   new ToolsMenu(),    tools_extended_menu_run);
        addItem("GPIO",     new GPIOAppMenu(),  nullptr);

        addItem("Config",   new ConfigMenu(),   nullptr);
        addItem("Info",     new InfoMenu(),      nullptr);
        addItem("OTA",      new OTAMenuItem(),  nullptr);
        addItem("Settings", new SettingsMenu(), nullptr);
        addItem("SD Card",  new SDCardMenuItem(), sd_menu_run);
    addItem("PC Suite", new PCSuiteMenuItem(), pair_menu_run);
    }
    ~MainMenuV2() { for (auto& e : entries) delete e.item; }

    void run() {
        static int  sel      = 0;
        static bool animDone = false;
        int total = (int)entries.size();
        if (!animDone) { animDone = true; slideInAnim(sel); }

        // ── Idle timer ────────────────────────────────────────
        // 30 saniye hareketsizlik → dolphin idle ekranı
        static constexpr uint32_t IDLE_TIMEOUT_MS = 30000UL;
        uint32_t lastActivityMs = millis();

        while (true) {
            render(sel);
            // A/B/C/D buton aksiyonlarını ana menüde de işle
            handleActionButtons();
            JoyDir d = readJoystick();
            int prev = sel;
            if (d == JoyDir::RIGHT) { sel = (sel + 1) % total; lastActivityMs = millis(); }
            if (d == JoyDir::LEFT)  { sel = (sel - 1 + total) % total; lastActivityMs = millis(); }
            if (sel != prev) slideTransition(prev, sel);
            if (readButton()) {
                lastActivityMs = millis();
                if (!pinLockCheck()) continue;
                selectFlash(sel);
                g_returnToMenu = false;
                // Genişletilmiş fonksiyon varsa onu çağır
                if (entries[sel].extFn) entries[sel].extFn();
                else entries[sel].item->runMenu();
                g_returnToMenu = false;
                lastActivityMs = millis();  // menüden dönerken timer sıfırla
                render(sel);
            }

            // ── Idle timeout kontrolü ─────────────────────────
            if (millis() - lastActivityMs >= IDLE_TIMEOUT_MS) {
                showIdleScreen();          // herhangi input ile çıkılır
                lastActivityMs = millis(); // çıkışta timer sıfırla
                render(sel);               // ana menüyü yeniden çiz
            }

            delay(8);
        }
    }

private:
    struct Entry {
        String           name;
        MenuItem*        item;
        void(*extFn)();
    };
    std::vector<Entry> entries;

    void addItem(const String& n, MenuItem* m, void(*fn)()) {
        entries.push_back({n, m, fn});
    }

    void drawStatusBar() {
        // ── Flipper Zero ana menü status bar ─────────────────────────
        // Siyah arka plan, beyaz semboller (ana menü karanlık zemin)
        // Alt ayırıcı çizgi
        display.drawFastHLine(0, 11, OLED_W, SSD1306_WHITE);
        display.setTextSize(1); display.setTextColor(SSD1306_WHITE);

        // ── Sol: GERÇEK Flipper pil bitmap'i (26x8) beyaz ────────────
        display.drawBitmap(1, 1, FZ_Battery_26x8,
                           FZ_Battery_26x8_W, FZ_Battery_26x8_H, SSD1306_WHITE);
        // Doluluk barı — dummy %100 (siyah pikseller pil içinde beyaz olur)
        {
            uint8_t fill = 22; // %100 → max 22px
            display.fillRect(3, 3, fill, 4, SSD1306_WHITE);
        }
        // Level "L<n>"
        display.setCursor(29, 2);
        display.print('L'); display.print(g_level);

        // ── Orta: Saat (HH:MM:SS) ortalı ────────────────────────────
        // Alan [43..95] = 52px → 8 karakter "HH:MM:SS" = 48px → sığar
        String timeStr;
        if (g_ntpSynced) {
            struct tm ti;
            if (getLocalTime(&ti, 0)) {
                char buf[9]; strftime(buf, sizeof(buf), "%H:%M:%S", &ti);
                timeStr = String(buf);
            }
        }
        if (timeStr.isEmpty()) {
            uint32_t sec = millis() / 1000;
            char buf[9];
            snprintf(buf, sizeof(buf), "%02lu:%02lu:%02lu",
                     (unsigned long)(sec / 3600),
                     (unsigned long)((sec % 3600) / 60),
                     (unsigned long)(sec % 60));
            timeStr = String(buf);
        }
        {
            int16_t tw = (int16_t)timeStr.length() * 6;
            display.setCursor(43 + (52 - tw) / 2, 2);
            display.print(timeStr);
        }

        // ── Sağ: GERÇEK Flipper BT + SD ikonları ─────────────────────
        // BT ikonu (5x8) @ x=97  — bağlı: Connected(16px), bekleme: Idle(5px)
        if (g_cfg.bleEnabled) {
            display.drawBitmap(97, 1, FZ_Bluetooth_Idle_5x8,
                               FZ_Bluetooth_Idle_5x8_W, FZ_Bluetooth_Idle_5x8_H, SSD1306_WHITE);
        }
        // SD kart ikonu (11x8) @ x=104
        if (g_sdInited) {
            display.drawBitmap(104, 1, FZ_SDcardMounted_11x8,
                               FZ_SDcardMounted_11x8_W, FZ_SDcardMounted_11x8_H, SSD1306_WHITE);
        } else {
            display.drawBitmap(104, 1, FZ_SDcardFail_11x8,
                               FZ_SDcardFail_11x8_W, FZ_SDcardFail_11x8_H, SSD1306_WHITE);
        }
        // WiFi yay @ x=117 — elle (bitmap yok ama küçük ve temiz)
        if (g_cfg.wifiEnabled && g_staConnected) {
            display.fillCircle(121, 9, 1, SSD1306_WHITE);
            display.drawCircleHelper(121, 9, 3, 0b0001|0b0010, SSD1306_WHITE);
            display.drawCircleHelper(121, 9, 5, 0b0001|0b0010, SSD1306_WHITE);
        } else if (g_cfg.wifiEnabled) {
            // WiFi açık ama bağlı değil: sadece alt nokta
            display.fillCircle(121, 9, 1, SSD1306_WHITE);
            display.drawCircleHelper(121, 9, 3, 0b0001|0b0010, SSD1306_WHITE);
        } else {
            // Kapalı: küçük X
            display.drawLine(118, 3, 124, 9, SSD1306_WHITE);
            display.drawLine(124, 3, 118, 9, SSD1306_WHITE);
        }
    }

    void drawIconArea(int sel) {
        int total = (int)entries.size();
        int leftIdx  = (sel - 1 + total) % total;
        int rightIdx = (sel + 1) % total;

        // ── Sol komşu: 18×18 yuvarlak kutu, y=20 ─────────────────
        if (leftIdx != sel) {
            // Kutu + ikon
            display.drawRoundRect(2, 20, 18, 18, 2, SSD1306_WHITE);
            entries[leftIdx].item->drawIconSmall(2, 20, SSD1306_WHITE);
            // Sol ok: dolu üçgen
            display.fillTriangle(1, 28, 1, 32, -1, 30, SSD1306_WHITE);
            // Flipper tarzı çift çizgi ok
            display.drawLine(0, 28, 0, 32, SSD1306_WHITE);
        }

        // ── Sağ komşu: 18×18 yuvarlak kutu, y=20 ─────────────────
        if (rightIdx != sel) {
            int rx = OLED_W - 20;
            display.drawRoundRect(rx, 20, 18, 18, 2, SSD1306_WHITE);
            entries[rightIdx].item->drawIconSmall(rx, 20, SSD1306_WHITE);
            // Sağ ok: dolu üçgen
            int arx = OLED_W - 1;
            display.fillTriangle(arx, 28, arx, 32, arx+2, 30, SSD1306_WHITE);
            display.drawLine(arx, 28, arx, 32, SSD1306_WHITE);
        }

        // ── Merkez seçili: 36×34 beyaz kutu, ikon siyah ──────────
        int sx = (OLED_W - 32) / 2, sy = 13;
        display.fillRoundRect(sx - 2, sy - 1, 36, 34, 4, SSD1306_WHITE);
        // Flipper tarzı ince çerçeve (seçim belirginleştirme)
        display.drawRoundRect(sx - 3, sy - 2, 38, 36, 5, SSD1306_WHITE);
        entries[sel].item->drawIconInv(sx, sy);
    }

    void drawBottomBar(int sel) {
        int total = (int)entries.size();
        // ── Üst ayırıcı çizgi ──────────────────────────────────────
        display.drawFastHLine(0, 47, OLED_W, SSD1306_WHITE);

        // -- Sol ok -----------------------------------------------
        display.setTextSize(1); display.setTextColor(SSD1306_WHITE);
        // Dolu sol üçgen ok
        display.fillTriangle(3, 53, 3, 57, 1, 55, SSD1306_WHITE);

        // ── Orta: seçili modül adı ortalı, büyük font ───────────────
        // Modül adı maks 8 karakter, size 1 (6px/char) → max 48px
        String nm = entries[sel].name;
        if ((int)nm.length() > 10) nm = nm.substring(0, 9) + "~";
        int16_t nw = nm.length() * 6;
        // Orta bölge: [38..90] = 52px
        display.setCursor(38 + (52 - nw) / 2, 51);
        display.print(nm);

        // -- Sag ok -----------------------------------------------
        // Dolu sağ üçgen ok
        display.fillTriangle(OLED_W-4, 53, OLED_W-4, 57, OLED_W-2, 55, SSD1306_WHITE);

        // ── Nokta indikatörleri — alt satır (y=60) ─────────────────
        // Flipper tarzı: seçili = dolu dikdörtgen (6x3), diğer = boş (4x3)
        int dotTotal = min(total, 13), dotStep = 8;
        int dotStart = max(0, min(sel - 6, total - dotTotal));
        int totalW   = dotTotal * dotStep - 2;
        int dotX     = (OLED_W - totalW) / 2, dotY = 61;
        for (int i = 0; i < dotTotal; i++) {
            int realIdx = dotStart + i, dx = dotX + i * dotStep;
            if (realIdx == sel) display.fillRect(dx, dotY, 6, 3, SSD1306_WHITE);
            else                display.drawRect(dx, dotY, 4, 3, SSD1306_WHITE);
        }
    }

    void render(int sel) {
        potApplyBrightness(); dispClear();
        drawStatusBar(); drawIconArea(sel); drawBottomBar(sel);
        dispCommit();
    }

    void slideTransition(int from, int to) {
        int total = (int)entries.size();
        bool goRight = ((to - from + total) % total == 1);
        for (int step = 1; step <= 3; step++) {
            potApplyBrightness(); dispClear();
            drawStatusBar(); drawBottomBar(to);
            int sx = (OLED_W-32)/2, sy = 13;
            int offset = goRight ? (3-step)*14 : -(3-step)*14;
            display.fillRoundRect(sx-2+offset, sy-1, 36, 34, 3, SSD1306_WHITE);
            entries[to].item->drawIconInv(sx+offset, sy);
            dispCommit(); delay(20);
        }
        render(to);
    }

    void selectFlash(int sel) {
        for (int i = 0; i < 2; i++) {
            dispClear();
            int sx = (OLED_W-32)/2, sy = 13;
            display.fillRoundRect(sx-4, sy-3, 40, 38, 4, SSD1306_WHITE);
            entries[sel].item->drawIconInv(sx, sy);
            dispCommit(); delay(45); render(sel); delay(30);
        }
    }

    void slideInAnim(int sel) {
        for (int y = -40; y <= 0; y += 8) {
            dispClear(); drawStatusBar();
            int sx = (OLED_W-32)/2;
            display.fillRoundRect(sx-2, 13+y, 36, 34, 3, SSD1306_WHITE);
            entries[sel].item->drawIconInv(sx, 13+y);
            drawBottomBar(sel); dispCommit(); delay(18);
        }
    }
};

static MainMenuV2* g_menuV2 = nullptr;

// ═══════════════════════════════════════════════════════════
//  MODULE: SD KART
//  Micro SD SPI modülü — SCK/MISO/MOSI paylaşımlı, CS=PIN_SD_CS
//
//  Özellikler:
//    • Log kaydetme  → /log/esphacker.log
//    • RFID dump/tag → /rfid/
//    • CC1101 RF cap → /rf_captures/
//    • WiFi scan log → /log/wifi.log
//    • BLE scan log  → /log/ble.log
//    • BadUSB log    → /log/badusb.log
//    • Dosya Yöneticisi (içerik görüntüleme)
// ═══════════════════════════════════════════════════════════

SPIClass sdSPI(HSPI); // ESP32-S3'ün bağımsız HSPI (SPI3) donanımını SD kart için ayırıyoruz

// ─── SD başlatma ──────────────────────────────────────────
static bool sdInit() {
    static bool sdSpiInited = false;
    if (!sdSpiInited) {
        // SD kart için tamamen izole donanımsal SPI hattını başlatıyoruz
        // SCK = GPIO 38, MISO = GPIO 40, MOSI = GPIO 39, SS = -1
        sdSPI.begin(38, 40, 39, -1);
        sdSpiInited = true;
        delay(10);
    }

    pinMode(PIN_SD_CS, OUTPUT);
    digitalWrite(PIN_SD_CS, HIGH);

    // Gürültü ve voltaj toleransı için SD kart hızını 1MHz (1000000UL) yapıyoruz
    if (SD.begin(PIN_SD_CS, sdSPI, 1000000UL)) {
        g_sdInited = true;
        logPush("[SD] Mounted OK (SPI3) CS=GPIO" + String(PIN_SD_CS));
    } else {
        // SD kart standart pinde (6) algılanmadıysa sadece 15'te fallback yapıyoruz.
        pinMode(15, OUTPUT);
        digitalWrite(15, HIGH);
        if (SD.begin(15, sdSPI, 1000000UL)) {
            g_sdInited = true;
            logPush("[SD] Mounted OK (SPI3) CS=GPIO15");
        }
    }

    if (g_sdInited) {
        if (!SD.exists("/log"))          SD.mkdir("/log");
        if (!SD.exists("/rfid"))         SD.mkdir("/rfid");
        if (!SD.exists("/rf_captures"))  SD.mkdir("/rf_captures");
        if (!SD.exists("/badusb"))       SD.mkdir("/badusb");
        if (!SD.exists("/scripts"))      SD.mkdir("/scripts");
        if (!SD.exists("/flipper"))      SD.mkdir("/flipper");
        if (!SD.exists("/flipper/apps")) SD.mkdir("/flipper/apps");
        return true;
    }

    g_sdInited = false;
    logPush("[SD] Mount failed");
    return false;
}

// ─── SD genel yazma yardımcısı ────────────────────────────
static bool sdAppend(const char* path, const String& line) {
    if (!g_sdInited) return false;
    File f = SD.open(path, FILE_APPEND);
    if (!f) return false;
    f.println(line);
    f.close();
    return true;
}

static bool sdWrite(const char* path, const String& content) {
    if (!g_sdInited) return false;
    File f = SD.open(path, FILE_WRITE);
    if (!f) return false;
    f.print(content);
    f.close();
    return true;
}

// ─── SD Log: genel log satırı ekle ───────────────────────
static void sdLog(const String& line) {
    if (!g_sdInited) return;
    String entry = "[" + getTimestamp() + "] " + line;
    sdAppend("/log/esphacker.log", entry);
}

// ─── SD WiFi scan kaydet ─────────────────────────────────
static void sdSaveWifiScan() {
    if (!g_sdInited || g_scanResults.empty()) return;
    String out = "=== WiFi Scan " + getTimestamp() + " ===\n";
    for (auto& ap : g_scanResults) {
        char buf[80];
        snprintf(buf, sizeof(buf), "SSID:%-32s BSSID:%s ch:%d rssi:%d enc:%s",
            ap.ssid.c_str(), ap.bssid.c_str(), ap.channel, ap.rssi,
            encTypeName(ap.encType));
        out += String(buf) + "\n";
    }
    sdAppend("/log/wifi.log", out);
    logPush("[SD] WiFi scan saved (" + String(g_scanResults.size()) + " AP)");
}

// ─── SD BLE scan kaydet ──────────────────────────────────
static void sdSaveBLEScan(const std::vector<BLEDevInfo>& results) {
    if (!g_sdInited || results.empty()) return;
    String out = "=== BLE Scan " + getTimestamp() + " ===\n";
    for (auto& d : results) {
        String line = "ADDR:" + d.addr +
                      " NAME:" + (d.hasName ? d.name : "[none]") +
                      " RSSI:" + String(d.rssi);
        if (d.hasManuf) line += " MANUF:" + String(bleManufName(d.manufId[0], d.manufId[1]));
        out += line + "\n";
    }
    sdAppend("/log/ble.log", out);
    logPush("[SD] BLE scan saved (" + String(results.size()) + " dev)");
}

// ─── SD RFID tag kaydet ───────────────────────────────────
static void sdSaveRFIDTag(const String& uid, const String& tagType, const String& extra = "") {
    if (!g_sdInited) return;
    String fname = "/rfid/" + uid + ".txt";
    String content = "UID: " + uid + "\nType: " + tagType + "\nTime: " + getTimestamp();
    if (extra.length()) content += "\n" + extra;
    sdWrite(fname.c_str(), content);
    sdLog("[RFID] TAG uid=" + uid + " type=" + tagType);
    logPush("[SD] RFID tag saved: " + fname);
}

// ─── SD CC1101 RF capture kaydet ─────────────────────────
static void sdSaveRFCapture(const String& filename, const std::vector<RFPulse>& pulses, float freqMhz) {
    if (!g_sdInited || pulses.empty()) return;
    String path = "/rf_captures/" + filename;
    File f = SD.open(path.c_str(), FILE_WRITE);
    if (!f) { logPush("[SD] RF cap open fail: " + path); return; }
    f.println("# M5Sharkino RF Capture");
    f.println("# Freq: " + String(freqMhz, 3) + " MHz");
    f.println("# Pulses: " + String(pulses.size()));
    f.println("# Format: dur_us level");
    for (auto& p : pulses) {
        f.print(p.dur); f.print(" "); f.println(p.level ? "1" : "0");
    }
    f.close();
    sdLog("[CC1101] cap=" + path + " freq=" + String(freqMhz, 3));
    logPush("[SD] RF cap saved: " + path);
}

// ─── SD BadUSB log kaydet ────────────────────────────────
static void sdSaveBadUSB(const String& payloadName, const String& detail) {
    if (!g_sdInited) return;
    String line = "PAYLOAD:" + payloadName + " DETAIL:" + detail + " TIME:" + String(millis());
    sdAppend("/log/badusb.log", line);
    logPush("[SD] BadUSB log saved");
}

// ─── SD Dosya Yöneticisi ─────────────────────────────────
// ─── Dosya işlemleri: içerik görüntüleme, hex dump, silme, mkdir ──
static void sd_browse_dir(const String& dirPath);

// ─── Hex Viewer: binary dosyaları hex+ASCII dump olarak göster ────
static void sd_hex_view(const String& path, uint32_t fileSize) {
    File f = SD.open(path.c_str(), FILE_READ);
    if (!f) { dispBannerErr("Open failed"); return; }

    // 4 satır x 8 byte/satır = 32 byte görünür pencere
    // Toplam pencere sayısı: fileSize / 8 satır
    static constexpr uint8_t BYTES_PER_ROW = 8;
    static constexpr uint8_t VISIBLE_ROWS  = 4;

    uint32_t totalRows = (fileSize + BYTES_PER_ROW - 1) / BYTES_PER_ROW;
    uint32_t scrollRow = 0;

    // Tüm dosyayı oku (maks 2 KB — hex viewer için yeterli)
    uint32_t readSize = min(fileSize, (uint32_t)2048);
    uint8_t* buf = (uint8_t*)malloc(readSize);
    if (!buf) { f.close(); dispBannerErr("No heap"); return; }
    f.read(buf, readSize);
    f.close();

    String title = path.substring(path.lastIndexOf('/') + 1);
    if (title.length() > 12) title = title.substring(0, 11) + "~";

    while (true) {
        dispClear();
        dispStatusBar("HEX:" + title);
        for (uint8_t row = 0; row < VISIBLE_ROWS; row++) {
            uint32_t byteIdx = (scrollRow + row) * BYTES_PER_ROW;
            if (byteIdx >= readSize) break;
            // Offset (3 hex chars)
            char lineBuf[22];
            snprintf(lineBuf, sizeof(lineBuf), "%03lX ", (unsigned long)byteIdx);
            String line = lineBuf;
            // Hex bytes
            for (uint8_t b = 0; b < BYTES_PER_ROW; b++) {
                if (byteIdx + b < readSize) {
                    snprintf(lineBuf, sizeof(lineBuf), "%02X", buf[byteIdx + b]);
                    line += lineBuf;
                } else {
                    line += "  ";
                }
                if (b == 3) line += " ";
            }
            // ASCII
            line += " ";
            for (uint8_t b = 0; b < BYTES_PER_ROW && (byteIdx + b) < readSize; b++) {
                char c = (char)buf[byteIdx + b];
                line += (c >= 32 && c < 127) ? c : '.';
            }
            dispText(0, 13 + row * 13, line.substring(0, 21));
        }
        char hint[22];
        snprintf(hint, sizeof(hint), "row%lu/%lu [LONG]back", (unsigned long)(scrollRow+1), (unsigned long)totalRows);
        dispText(0, 57, hint);
        dispCommit();

        JoyDir d = readJoystick();
        if (d == JoyDir::UP   && scrollRow > 0)               scrollRow--;
        if (d == JoyDir::DOWN && scrollRow < totalRows - VISIBLE_ROWS) scrollRow++;
        if (readButtonLong()) break;
        delay(30);
    }
    free(buf);
}

// ─── Text Viewer: dosyayı satır satır görüntüle ───────────────────
static void sd_view_file(const String& path) {
    File f = SD.open(path.c_str(), FILE_READ);
    if (!f) { dispBannerErr("Open failed"); return; }

    // Dosyayı satır satır hafızaya al (maks 64 satır)
    std::vector<String> lines;
    while (f.available() && lines.size() < 64) {
        String l = f.readStringUntil('\n');
        l.trim();
        lines.push_back(l);
    }
    f.close();

    int scroll = 0;
    int totalLines = (int)lines.size();
    String title = path.substring(path.lastIndexOf('/') + 1);
    if (title.length() > 15) title = title.substring(0, 14) + "~";

    while (true) {
        dispClear();
        dispStatusBar(title);
        // 4 satır görünür (y=13,24,35,46)
        for (int i = 0; i < 4 && (scroll + i) < totalLines; i++) {
            String ln = lines[scroll + i];
            if (ln.length() > 21) ln = ln.substring(0, 20) + "~";
            dispText(0, 13 + i * 11, ln);
        }
        dispText(0, 57, String(scroll + 1) + "/" + String(totalLines) + " [LONG]back");
        dispCommit();

        JoyDir d = readJoystick();
        if (d == JoyDir::UP   && scroll > 0)                   scroll--;
        if (d == JoyDir::DOWN && scroll < totalLines - 4)      scroll++;
        if (readButtonLong()) return;
        delay(30);
    }
}

// ─── Basit isim giriş yardımcısı (joystick + karakter döngüsü) ────
// Hedef: en fazla maxLen karakterlik alfanümerik isim girer.
// UP/DOWN = karakter seç, RIGHT = sonraki konum, LEFT = geri al, BTN = onayla
static String sd_input_name(const String& prompt, uint8_t maxLen = 16) {
    static const char CHARS[] = "abcdefghijklmnopqrstuvwxyz0123456789_-";
    static constexpr uint8_t NUM_CHARS = sizeof(CHARS) - 1;
    String name = "";
    uint8_t charIdx = 0;
    bool done = false;

    while (!done) {
        dispClear(); dispStatusBar(prompt);
        dispText(0, 14, name + (char)CHARS[charIdx]);
        dispText(0, 30, "UP/DWN:char  R:add");
        dispText(0, 42, "L:del  BTN:confirm");
        dispText(0, 57, String(name.length()) + "/" + String(maxLen) + " chars");
        dispCommit();

        JoyDir d = readJoystick();
        delay(120);
        if (d == JoyDir::UP) {
            charIdx = (charIdx + 1) % NUM_CHARS;
        } else if (d == JoyDir::DOWN) {
            charIdx = (charIdx == 0) ? NUM_CHARS - 1 : charIdx - 1;
        } else if (d == JoyDir::RIGHT && name.length() < maxLen) {
            name += (char)CHARS[charIdx];
        } else if (d == JoyDir::LEFT && name.length() > 0) {
            name.remove(name.length() - 1);
        } else if (readButton()) {
            done = true;
        }
    }
    return name;
}

// ─── Klasör oluştur (Mkdir) ────────────────────────────────────────
static void sd_mkdir_in(const String& parentPath) {
    String folderName = sd_input_name("New Folder Name");
    if (folderName.length() == 0) { dispBannerWarn("Cancelled"); return; }
    String newPath = parentPath;
    if (!newPath.endsWith("/")) newPath += "/";
    newPath += folderName;
    if (SD.mkdir(newPath.c_str())) {
        dispBannerOK("Created: " + folderName);
    } else {
        dispBannerErr("Mkdir failed");
    }
}

// ─── Dizin istatistiklerini topla (dosya sayısı + doluluk) ────────
static void sd_count_dir(const String& path, uint32_t& fileCount, uint32_t& dirCount) {
    File d = SD.open(path.c_str());
    if (!d || !d.isDirectory()) return;
    File e = d.openNextFile();
    while (e) {
        if (e.isDirectory()) {
            dirCount++;
            String sub = path;
            if (!sub.endsWith("/")) sub += "/";
            sub += String(e.name()).substring(String(e.name()).lastIndexOf('/') + 1);
            sd_count_dir(sub, fileCount, dirCount);
        } else {
            fileCount++;
        }
        e = d.openNextFile();
    }
    d.close();
}

static void sd_browse_dir(const String& dirPath) {
    File root = SD.open(dirPath.c_str());
    if (!root || !root.isDirectory()) { dispBannerErr("Dir fail"); return; }

    std::vector<String> names;
    std::vector<bool>   isDir;
    std::vector<uint32_t> sizes;

    File entry = root.openNextFile();
    while (entry) {
        String n = String(entry.name());
        int sl = n.lastIndexOf('/');
        if (sl >= 0) n = n.substring(sl + 1);
        names.push_back(n);
        isDir.push_back(entry.isDirectory());
        sizes.push_back(entry.isDirectory() ? 0 : entry.size());
        entry = root.openNextFile();
    }
    root.close();

    // Refresh flag: içerik değişirse yeniden listele
    bool needRefresh = false;

    auto buildOpts = [&]() -> OptionList {
        OptionList opts;
        for (int i = 0; i < (int)names.size(); i++) {
            String label = (isDir[i] ? "[D] " : "    ") + names[i];
            if (label.length() > 20) label = label.substring(0, 19) + "~";
            opts.push_back({label, [](){}});
        }
        opts.push_back({"[+] New Folder", [](){}});
        opts.push_back({"Back",           [](){}});
        return opts;
    };

    while (true) {
        if (needRefresh) {
            // Dizini yeniden tara
            names.clear(); isDir.clear(); sizes.clear();
            File r2 = SD.open(dirPath.c_str());
            if (r2 && r2.isDirectory()) {
                File e2 = r2.openNextFile();
                while (e2) {
                    String n = String(e2.name());
                    int sl = n.lastIndexOf('/');
                    if (sl >= 0) n = n.substring(sl + 1);
                    names.push_back(n);
                    isDir.push_back(e2.isDirectory());
                    sizes.push_back(e2.isDirectory() ? 0 : e2.size());
                    e2 = r2.openNextFile();
                }
                r2.close();
            }
            needRefresh = false;
        }

        OptionList opts = buildOpts();
        int backIdx   = (int)opts.size() - 1;
        int mkdirIdx  = backIdx - 1;

        String dirLabel = dirPath.length() > 12
            ? dirPath.substring(dirPath.length() - 12)
            : dirPath;

        if (names.empty()) {
            // Boş dizin: sadece mkdir ve back göster
            OptionList emptyOpts = {
                {"[+] New Folder", [](){}},
                {"Back",           [](){}},
            };
            int sel2 = loopOptions(emptyOpts, dirLabel + " (empty)");
            if (sel2 == 0) { sd_mkdir_in(dirPath); needRefresh = true; continue; }
            return;
        }

        int sel = loopOptions(opts, dirLabel);
        if (sel < 0 || sel == backIdx) return;

        if (sel == mkdirIdx) {
            sd_mkdir_in(dirPath);
            needRefresh = true;
            continue;
        }

        String fullPath = dirPath;
        if (!fullPath.endsWith("/")) fullPath += "/";
        fullPath += names[sel];

        if (isDir[sel]) {
            sd_browse_dir(fullPath);
        } else {
            // ─── Dosya işlemleri menüsü ──────────────────────
            uint32_t sz = sizes[sel];
            String fname = names[sel];
            String shortName = fname.length() > 14 ? fname.substring(0, 13) + "~" : fname;

            // Dosyanın text mi binary mi olduğunu uzantıdan tahmin et
            String ext = "";
            int dotPos = fname.lastIndexOf('.');
            if (dotPos >= 0) ext = fname.substring(dotPos + 1);
            ext.toLowerCase();
            bool isBinary = !(ext == "txt" || ext == "log" || ext == "csv"
                              || ext == "json" || ext == "ini" || ext == "cfg"
                              || ext == "raw" || ext == "sub" || ext == "");

            // Boyut formatla
            String szStr;
            if (sz < 1024)       szStr = String(sz) + "B";
            else if (sz < 1024*1024) szStr = String(sz/1024) + "KB";
            else                 szStr = String(sz/1024/1024) + "MB";

            OptionList acts = {
                {"View text",    [](){}},
                {"Hex viewer",   [](){}},
                {"File info",    [](){}},
                {"Delete file",  [](){}},
                {"Back",         [](){}},
            };
            int act = loopOptions(acts, shortName + " " + szStr);
            if (act == 0) {
                sd_view_file(fullPath);
            } else if (act == 1) {
                sd_hex_view(fullPath, sz);
            } else if (act == 2) {
                // Dosya bilgisi detayı
                dispClear(); dispStatusBar("File Info");
                dispText(0, 13, fname.substring(0, 21));
                dispText(0, 25, "Size: " + szStr + " (" + String(sz) + "B)");
                dispText(0, 37, "Ext:  " + (ext.length() ? ext : "none"));
                dispText(0, 49, "Path: " + fullPath.substring(0, 18));
                dispText(0, 57, "[BTN] back");
                dispCommit();
                while (!readButton()) { potApplyBrightness(); delay(50); }
            } else if (act == 3) {
                // Silme onayı
                OptionList confirm = {
                    {"YES - Delete!", [](){}},
                    {"No, Cancel",    [](){}},
                };
                dispBannerWarn("Delete: " + shortName, 800);
                int cf = loopOptions(confirm, "Confirm Delete?");
                if (cf == 0) {
                    if (SD.remove(fullPath.c_str())) {
                        dispBannerOK("Deleted!");
                        needRefresh = true;
                    } else {
                        dispBannerErr("Delete failed");
                    }
                }
            }
        }
    }
}

// ─── SD istatistikleri: dosya sayısı + doluluk % ─────────────────
static void sd_show_stats() {
    if (!g_sdInited) { dispBannerErr("SD not mounted!"); return; }

    dispClear(); dispStatusBar("SD Stats");
    dispText(0, 14, "Counting files...");
    dispCommit();

    uint32_t fileCount = 0, dirCount = 0;
    sd_count_dir("/", fileCount, dirCount);

    uint64_t total = SD.totalBytes();
    uint64_t used  = SD.usedBytes();
    uint8_t  pct   = (uint8_t)((used * 100ULL) / (total ? total : 1));

    // Doluluk bar (128 px genişliğinde)
    uint8_t barW = (uint8_t)((pct * 100) / 100); // 100 px maks bar

    dispClear(); dispStatusBar("SD Stats");
    String totStr  = String((uint32_t)(total / 1024)) + "KB";
    String usedStr = String((uint32_t)(used  / 1024)) + "KB";
    String freeStr = String((uint32_t)((total - used) / 1024)) + "KB";
    dispText(0, 13, "Files: " + String(fileCount) + "  Dirs: " + String(dirCount));
    dispText(0, 25, "Total:" + totStr + " Used:" + usedStr);
    dispText(0, 37, "Free: " + freeStr + " (" + String(100 - pct) + "% free)");
    // Doluluk barı
    display.drawRect(0, 48, 100, 8, SSD1306_WHITE);
    if (barW > 0) display.fillRect(1, 49, barW - 1, 6, SSD1306_WHITE);
    dispText(102, 48, String(pct) + "%");
    dispText(0, 57, "Type:" + String(SD.cardType() == CARD_SDHC ? "SDHC" :
                                      SD.cardType() == CARD_SD   ? "SD"   : "UNK") +
                    " [BTN]back");
    dispCommit();
    while (!readButton()) { potApplyBrightness(); delay(50); }
}

static void sd_file_manager_run() {
    if (!g_sdInited) {
        dispBannerErr("SD not mounted!");
        return;
    }

    OptionList roots = {
        {"/log",         [](){}},
        {"/rfid",        [](){}},
        {"/rf_captures", [](){}},
        {"/badusb",      [](){}},
        {"/scripts",     [](){}},
        {"/",            [](){}},
        {"SD Stats",     [](){}},
        {"Back",         [](){}},
    };

    while (true) {
        int sel = loopOptions(roots, "File Manager");
        if (sel < 0 || sel == 7) return;
        if (sel == 6) {
