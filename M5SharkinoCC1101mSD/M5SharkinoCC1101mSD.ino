};

static uint8_t aes_xtime(uint8_t x) { return (x << 1) ^ ((x & 0x80) ? 0x1b : 0); }
static uint8_t aes_mul(uint8_t a, uint8_t b) {
    uint8_t r = 0, aa = a;
    for (int i = 0; i < 8; i++) {
        if (b & 1) r ^= aa;
        aa = aes_xtime(aa);
        b >>= 1;
    }
    return r;
}

// Basit AES-128 tek blok şifreleme (key schedule dahil, sadece ECB)
static void aes128_encrypt_block(const uint8_t* key, const uint8_t* in, uint8_t* out) {
    uint8_t state[16], w[176];
    memcpy(state, in, 16);

    // Key expansion (basit RC tablosu ile)
    memcpy(w, key, 16);
    uint8_t rcon = 1;
    for (int i = 16; i < 176; i += 4) {
        uint8_t t[4];
        memcpy(t, w+i-4, 4);
        if (i % 16 == 0) {
            uint8_t tmp = t[0];
            t[0] = AES_SBOX[t[1]] ^ rcon;
            t[1] = AES_SBOX[t[2]];
            t[2] = AES_SBOX[t[3]];
            t[3] = AES_SBOX[tmp];
            rcon = aes_xtime(rcon);
        }
        for (int j = 0; j < 4; j++) w[i+j] = w[i-16+j] ^ t[j];
    }

    // AddRoundKey (initial)
    for (int i = 0; i < 16; i++) state[i] ^= w[i];

    // 10 rounds
    for (int round = 1; round <= 10; round++) {
        // SubBytes
        for (int i = 0; i < 16; i++) state[i] = AES_SBOX[state[i]];
        // ShiftRows
        uint8_t tmp;
        tmp=state[1]; state[1]=state[5]; state[5]=state[9]; state[9]=state[13]; state[13]=tmp;
        tmp=state[2]; state[2]=state[10]; state[10]=tmp; tmp=state[6]; state[6]=state[14]; state[14]=tmp;
        tmp=state[15]; state[15]=state[11]; state[11]=state[7]; state[7]=state[3]; state[3]=tmp;
        // MixColumns (skip in last round)
        if (round < 10) {
            for (int c = 0; c < 4; c++) {
                uint8_t* col = state + c*4;
                uint8_t s0=col[0],s1=col[1],s2=col[2],s3=col[3];
                col[0]=aes_mul(2,s0)^aes_mul(3,s1)^s2^s3;
                col[1]=s0^aes_mul(2,s1)^aes_mul(3,s2)^s3;
                col[2]=s0^s1^aes_mul(2,s2)^aes_mul(3,s3);
                col[3]=aes_mul(3,s0)^s1^s2^aes_mul(2,s3);
            }
        }
        // AddRoundKey
        for (int i = 0; i < 16; i++) state[i] ^= w[round*16+i];
    }
    memcpy(out, state, 16);
}

static void crypto_aes_run() {
    static char plainHex[33] = "48656C6C6F455350486163";
    static char keyHex[33]   = "000102030405060708090A0B0C0D0E0F";

    OptionList opts = {
        {"Edit Plaintext", [](){}},
        {"Edit Key",       [](){}},
        {"Encrypt!",       [](){}},
        {"Back",           [](){}},
    };

    while (true) {
        opts[0].label = "Plain: " + String(plainHex).substring(0,16) + "~";
        opts[1].label = "Key:   " + String(keyHex).substring(0,16) + "~";

        int sel = loopOptions(opts, "AES-128 ECB");
        if (sel < 0 || sel == 3) return;
        if (sel == 0) charPicker(plainHex, 32, "Plaintext (hex)");
        else if (sel == 1) charPicker(keyHex, 32, "Key (hex 32ch)");
        else {
            // Hex → bytes
            auto hexToByte = [](char h) -> uint8_t {
                if (h >= '0' && h <= '9') return h - '0';
                if (h >= 'A' && h <= 'F') return h - 'A' + 10;
                if (h >= 'a' && h <= 'f') return h - 'a' + 10;
                return 0;
            };
            uint8_t plain[16] = {0}, key[16] = {0}, cipher[16];
            for (int i = 0; i < 16; i++) {
                if (2*i+1 < (int)strlen(plainHex))
                    plain[i] = (hexToByte(plainHex[2*i]) << 4) | hexToByte(plainHex[2*i+1]);
                if (2*i+1 < (int)strlen(keyHex))
                    key[i]   = (hexToByte(keyHex[2*i]) << 4) | hexToByte(keyHex[2*i+1]);
            }
            aes128_encrypt_block(key, plain, cipher);
            char cipherHex[33];
            for (int i = 0; i < 16; i++) sprintf(cipherHex+i*2, "%02X", cipher[i]);
            cipherHex[32] = 0;

            dispClear(); dispStatusBar("AES-128 Result");
            dispText(0, 12, "Plain:  " + String(plainHex).substring(0,16));
            dispText(0, 22, "Key:    " + String(keyHex).substring(0,16));
            dispText(0, 34, "Cipher:");
            dispText(0, 44, String(cipherHex).substring(0,16));
            dispText(0, 54, String(cipherHex).substring(16));
            dispCommit();
            logPush("[AES] cipher=" + String(cipherHex));
            Serial.println("[AES] plain=" + String(plainHex) + " key=" + String(keyHex) + " cipher=" + cipherHex);
            while (!readButton()) { potApplyBrightness(); delay(50); }
        }
    }
}

// ─── İÇ MENÜ: Network - IP Calculator ────────────────────

static void netanal_ip_calc_run() {
    // Pot → son oktet (192.168.1.X), Joy X → subnet
    while (!readButton()) {
        potApplyBrightness();
        uint16_t potRaw = analogRead(PIN_POT);
        uint8_t  host   = map(potRaw, 0, 4095, 1, 254);
        uint16_t jxRaw  = analogRead(PIN_JOY_X);
        uint8_t  prefix = map(jxRaw, 0, 4095, 16, 30);

        // Calculate network/broadcast
        uint32_t ip   = (192u << 24) | (168u << 16) | (1u << 8) | host;
        uint32_t mask = prefix == 32 ? 0xFFFFFFFF : ~((1u << (32 - prefix)) - 1);
        uint32_t net  = ip & mask;
        uint32_t bcast= net | ~mask;
        uint8_t hosts = (prefix >= 30) ? (prefix == 30 ? 2 : 0) : (uint8_t)((~mask) - 1);

        char netStr[16], bcStr[16];
        snprintf(netStr, 16, "%lu.%lu.%lu.%lu", (net>>24)&0xFF,(net>>16)&0xFF,(net>>8)&0xFF,net&0xFF);
        snprintf(bcStr,  16, "%lu.%lu.%lu.%lu", (bcast>>24)&0xFF,(bcast>>16)&0xFF,(bcast>>8)&0xFF,bcast&0xFF);

        dispClear(); dispStatusBar("IP Calculator");
        char ipStr[24]; snprintf(ipStr, 24, "192.168.1.%d/%d", host, prefix);
        dispText(0, 12, ipStr);
        dispText(0, 22, "Net:   " + String(netStr));
        dispText(0, 32, "Bcast: " + String(bcStr));
        dispText(0, 42, "Hosts: " + String(hosts));
        dispText(0, 52, "Pot:host JoyX:pfx");
        dispCommit();
        delay(80);
    }
}

// ═══════════════════════════════════════════════════════════
//  MODULE: GPIO App — Flipper Zero GPIO tarzı pin kontrol
//  Özellikler:
//    • Pin listesi (INPUT/OUTPUT/PWM/ADC seç)
//    • Digital okuma / yazma (HIGH/LOW toggle)
//    • ADC okuma (12-bit, volt cinsinden)
//    • PWM duty cycle ayarla (LEDC kanal 0)
//    • Pin durum monitörü (canlı grafik)
// ═══════════════════════════════════════════════════════════

struct GPIOPinState {
    uint8_t  pin;
    uint8_t  mode;   // 0=INPUT 1=OUTPUT 2=ADC 3=PWM
    bool     level;
    uint16_t adcVal;
    uint8_t  pwmDuty;
};

static constexpr uint8_t GPIO_APP_PINS[]  = {4, 5, 6, 7, 15, 16, 17, 18, 19, 20, 21};
static constexpr uint8_t GPIO_APP_PIN_CNT = 11;
static GPIOPinState g_gpioPinStates[GPIO_APP_PIN_CNT];

static void gpio_app_init_states() {
    for (uint8_t i = 0; i < GPIO_APP_PIN_CNT; i++) {
        g_gpioPinStates[i].pin      = GPIO_APP_PINS[i];
        g_gpioPinStates[i].mode     = 0; // INPUT
        g_gpioPinStates[i].level    = false;
        g_gpioPinStates[i].adcVal   = 0;
        g_gpioPinStates[i].pwmDuty  = 128;
        pinMode(GPIO_APP_PINS[i], INPUT);
    }
}

static const char* gpio_mode_name(uint8_t m) {
    switch (m) {
        case 0: return "IN ";
        case 1: return "OUT";
        case 2: return "ADC";
        case 3: return "PWM";
        default: return "???";
    }
}

// Flipper Zero tarzı GPIO pin listesi ekranı
static void gpio_app_render_list(int sel, int scroll) {
    dispClear();
    // Flipper tarzı başlık: beyaz bar
    display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setTextSize(1);
    display.setCursor(1, 2);
    display.print("\x18"); // geri ok
    display.setCursor(12, 2);
    display.print("GPIO App");
    display.setCursor(80, 2);
    display.print("M5Sharkino");
    display.setTextColor(SSD1306_WHITE);

    // Pin listesi — Flipper tarzı her pin bir satır
    for (int i = 0; i < 4 && (scroll + i) < GPIO_APP_PIN_CNT; i++) {
        int idx = scroll + i;
        int y   = 13 + i * 12;
        GPIOPinState& s = g_gpioPinStates[idx];

        if (idx == sel) {
            // Seçili satır: tam genişlik dolu
            display.fillRoundRect(0, y - 1, OLED_W - 4, 12, 2, SSD1306_WHITE);
            display.setTextColor(SSD1306_BLACK);
        } else {
            display.setTextColor(SSD1306_WHITE);
        }
        display.setTextSize(1);

        // "P04 [OUT] HI" veya "P04 [ADC] 2047"
        char buf[24];
        if (s.mode == 2) {
            snprintf(buf, sizeof(buf), "P%02d [ADC] %4d", s.pin, s.adcVal);
        } else if (s.mode == 3) {
            snprintf(buf, sizeof(buf), "P%02d [PWM] %3d%%", s.pin, s.pwmDuty * 100 / 255);
        } else {
            bool lv = (s.mode == 0) ? (digitalRead(s.pin) == HIGH) : s.level;
            snprintf(buf, sizeof(buf), "P%02d [%s] %s", s.pin, gpio_mode_name(s.mode), lv ? "HI" : "LO");
        }
        display.setCursor(4, y);
        display.print(buf);

        // Sağda durum LED: dolu=HIGH, boş=LOW
        if (s.mode == 0 || s.mode == 1) {
            bool lv = (s.mode == 0) ? (digitalRead(s.pin) == HIGH) : s.level;
            if (lv) display.fillCircle(OLED_W - 6, y + 4, 3, idx == sel ? SSD1306_BLACK : SSD1306_WHITE);
            else    display.drawCircle(OLED_W - 6, y + 4, 3, idx == sel ? SSD1306_BLACK : SSD1306_WHITE);
        }
        display.setTextColor(SSD1306_WHITE);
    }

    // Scrollbar
    if (GPIO_APP_PIN_CNT > 4) {
        int sbH = max(4, 51 * 4 / GPIO_APP_PIN_CNT);
        int sbY = 13 + (51 - sbH) * scroll / max(1, GPIO_APP_PIN_CNT - 4);
        display.drawRect(OLED_W - 3, 13, 2, 51, SSD1306_WHITE);
        display.fillRect(OLED_W - 3, sbY, 2, sbH, SSD1306_WHITE);
    }

    // Alt bar: yardım
    display.drawFastHLine(0, 55, OLED_W, SSD1306_WHITE);
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0, 57);
    display.print("OK:edit  LONG:back");
    dispCommit();
}

// Pin düzenleme ekranı — Flipper Zero tarzı side-scroll mode seçimi
static void gpio_app_edit_pin(int idx) {
    GPIOPinState& s = g_gpioPinStates[idx];
    int modeEdit = s.mode;
    bool exitEdit = false;

    while (!exitEdit) {
        dispClear();
        display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        display.setCursor(1, 2);
        display.print("\x18");
        char hdr[20]; snprintf(hdr, sizeof(hdr), "GPIO P%02d", s.pin);
        display.setCursor(14, 2); display.print(hdr);
        display.setTextColor(SSD1306_WHITE);

        // Mode seçici — Flipper tarzı ok ile kaydır
        const char* modes[] = {"INPUT","OUTPUT","ADC","PWM"};
        int prevM = (modeEdit + 3) % 4;
        int nextM = (modeEdit + 1) % 4;
        // Sol: dim
        display.setTextSize(1); display.setTextColor(SSD1306_WHITE);
        display.setCursor(2, 16); display.print(modes[prevM]);
        // Center: seçili — büyük kutu
        display.fillRoundRect(36, 13, 56, 14, 3, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK); display.setTextSize(1);
        int cx = 36 + (56 - strlen(modes[modeEdit]) * 6) / 2;
        display.setCursor(cx, 17); display.print(modes[modeEdit]);
        display.setTextColor(SSD1306_WHITE);
        // Sağ: dim
        display.setCursor(96, 16); display.print(modes[nextM]);
        // Oklar
        display.setCursor(26, 16); display.print("<");
        display.setCursor(94, 16); display.print(">");

        // Değer alanı
        display.drawFastHLine(0, 30, OLED_W, SSD1306_WHITE);
        display.setCursor(2, 33);
        if (modeEdit == 0) { // INPUT
            bool lv = digitalRead(s.pin) == HIGH;
            display.print("Level: "); display.print(lv ? "HIGH" : "LOW ");
            // Canlı bar
            display.fillRect(2, 42, lv ? 124 : 4, 8, SSD1306_WHITE);
            display.drawRect(0, 41, OLED_W, 10, SSD1306_WHITE);
        } else if (modeEdit == 1) { // OUTPUT
            display.print("Level: "); display.print(s.level ? "HIGH" : "LOW ");
            display.fillRect(2, 42, s.level ? 124 : 4, 8, SSD1306_WHITE);
            display.drawRect(0, 41, OLED_W, 10, SSD1306_WHITE);
            display.setCursor(2, 54); display.print("BTN:toggle");
        } else if (modeEdit == 2) { // ADC
            s.adcVal = analogRead(s.pin);
            float volt = s.adcVal * 3.3f / 4095.0f;
            char abuf[24]; snprintf(abuf, sizeof(abuf), "ADC:%4d  %.2fV", s.adcVal, volt);
            display.print(abuf);
            // Bargraph
            int bw = (int)(s.adcVal * 124 / 4095);
            display.fillRect(2, 42, bw, 8, SSD1306_WHITE);
            display.drawRect(0, 41, OLED_W, 10, SSD1306_WHITE);
        } else { // PWM
            char pbuf[24]; snprintf(pbuf, sizeof(pbuf), "Duty: %3d%%  (%d/255)", s.pwmDuty*100/255, s.pwmDuty);
            display.print(pbuf);
            int bw = (int)(s.pwmDuty * 124 / 255);
            display.fillRect(2, 42, bw, 8, SSD1306_WHITE);
            display.drawRect(0, 41, OLED_W, 10, SSD1306_WHITE);
            display.setCursor(2, 54); display.print("U/D:duty  BTN:apply");
        }

        dispCommit();

        // Input
        JoyDir d = readJoystick();
        if (d == JoyDir::LEFT)  { modeEdit = (modeEdit + 3) % 4; buzzNav(); delay(150); }
        if (d == JoyDir::RIGHT) { modeEdit = (modeEdit + 1) % 4; buzzNav(); delay(150); }

        if (modeEdit == 1) { // OUTPUT kontrolü
            if (d == JoyDir::UP || d == JoyDir::DOWN) {
                s.level = !s.level;
                digitalWrite(s.pin, s.level ? HIGH : LOW);
                buzzNav();
            }
        }
        if (modeEdit == 3) { // PWM duty
            if (d == JoyDir::UP && s.pwmDuty < 255)   s.pwmDuty += 5;
            if (d == JoyDir::DOWN && s.pwmDuty > 0)   s.pwmDuty -= 5;
        }

        if (readButton()) {
            // Mod uygula
            s.mode = modeEdit;
            if (modeEdit == 0) {
                pinMode(s.pin, INPUT);
            } else if (modeEdit == 1) {
                pinMode(s.pin, OUTPUT);
                digitalWrite(s.pin, s.level ? HIGH : LOW);
                buzzOK();
            } else if (modeEdit == 2) {
                pinMode(s.pin, INPUT);
                s.adcVal = analogRead(s.pin);
            } else { // PWM
                // LEDC: kanal pin'e bağlı
                ledcAttach(s.pin, 1000, 8);
                ledcWrite(s.pin, s.pwmDuty);
                buzzOK();
            }
        }
        if (readButtonLong()) { exitEdit = true; }
        delay(30);
    }
    s.mode = modeEdit;
}

// GPIO App monitör — tüm pinlerin canlı durumu, Flipper tarzı grid
static void gpio_app_monitor_run() {
    while (!readButtonLong()) {
        potApplyBrightness();
        dispClear();
        display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        display.setCursor(14, 2); display.print("GPIO Monitor");
        display.setTextColor(SSD1306_WHITE);

        // Grid: 4 sütun
        for (uint8_t i = 0; i < GPIO_APP_PIN_CNT; i++) {
            GPIOPinState& s = g_gpioPinStates[i];
            uint8_t col = i % 4;
            uint8_t row = i / 4;
            int x = col * 32 + 1;
            int y = 13 + row * 16;

            // Pin box
            bool lv = false;
            if (s.mode == 2) {
                s.adcVal = analogRead(s.pin);
                lv = s.adcVal > 2000;
            } else {
                lv = (s.mode == 0) ? (digitalRead(s.pin) == HIGH) : s.level;
            }
            if (lv) display.fillRoundRect(x, y, 28, 12, 2, SSD1306_WHITE);
            else    display.drawRoundRect(x, y, 28, 12, 2, SSD1306_WHITE);

            display.setTextColor(lv ? SSD1306_BLACK : SSD1306_WHITE);
            char buf[8]; snprintf(buf, sizeof(buf), "P%02d", s.pin);
            display.setCursor(x + 4, y + 2);
            display.print(buf);
            display.setTextColor(SSD1306_WHITE);
        }
        display.drawFastHLine(0, 61, OLED_W, SSD1306_WHITE);
        display.setCursor(2, 57); display.print("[LONG]:back");
        dispCommit();
        delay(120);
    }
}

// Ana GPIO App giriş fonksiyonu
