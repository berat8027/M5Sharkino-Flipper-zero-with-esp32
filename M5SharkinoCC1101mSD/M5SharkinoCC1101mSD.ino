// ─── POST /badusb — SD'den payload seç + çalıştır ────────
static void bruceHandleBadUSB() {
    if (g_bruceServer->method() == HTTP_GET) {
        // Payload listesi göster
        g_bruceServer->setContentLength(CONTENT_LENGTH_UNKNOWN);
        g_bruceServer->send(200, "text/html", "");
        bruceHtmlHeader();

        String content = "<div class='card'><h2>&#128123; BadUSB Payloads</h2>";
        if (!g_sdInited) {
            content += "<p style='color:#e94560'>SD not mounted.</p>";
        } else {
            content += "<form method='POST' action='/badusb'>"
                       "<select name='payload'>";
            File dir = SD.open("/badusb");
            if (dir && dir.isDirectory()) {
                File f = dir.openNextFile();
                while (f) {
                    String n = String(f.name());
                    int sl = n.lastIndexOf('/'); if (sl >= 0) n = n.substring(sl+1);
                    if (n.endsWith(".txt") || n.endsWith(".duck") || n.endsWith(".bb")) {
                        content += "<option value='" + n + "'>" + n + "</option>";
                    }
                    f = dir.openNextFile();
                }
                dir.close();
            }
            content += "</select><br><button class='btn' type='submit'>&#9654; Execute</button></form>";
        }
        content += "</div>";
        g_bruceServer->sendContent(content);
        bruceHtmlFooter();
        return;
    }
    // POST — execute
    if (!g_bruceServer->hasArg("payload")) {
        g_bruceServer->send(400, "application/json", "{\"error\":\"missing payload arg\"}");
        return;
    }
    String payloadName = g_bruceServer->arg("payload");
    String payloadPath = "/badusb/" + payloadName;
    if (!g_sdInited || !SD.exists(payloadPath.c_str())) {
        g_bruceServer->send(404, "application/json", "{\"error\":\"file not found\"}");
        return;
    }
    // Log ve yanıt gönder (gerçek çalıştırma loop'ta tetiklenir)
    logPush("[WEBUI] BadUSB payload queued: " + payloadName);
    g_bruceServer->send(200, "application/json",
        "{\"status\":\"queued\",\"payload\":\"" + payloadName + "\"}");
}

// ─── GET /logs — Log dosyasını göster ────────────────────
static void bruceHandleLogs() {
    g_bruceServer->setContentLength(CONTENT_LENGTH_UNKNOWN);
    g_bruceServer->send(200, "text/html", "");
    bruceHtmlHeader();

    String content = "<div class='card'><h2>&#128220; System Log</h2>";
    g_bruceServer->sendContent(content);

    // İlk RAM log buffer'ını göster
    content = "<h3 style='color:#a7a9be;font-size:11px;margin-bottom:4px'>RAM Log (last " + String(g_logCount) + " entries)</h3><pre>";
    g_bruceServer->sendContent(content);
    for (uint16_t i = 0; i < g_logCount; i++) {
        uint16_t idx = (g_logHead - g_logCount + i + LOG_MAX_LINES) % LOG_MAX_LINES;
        g_bruceServer->sendContent(g_log[idx] + "\n");
    }
    g_bruceServer->sendContent("</pre>");

    // SD log dosyası
    if (g_sdInited && SD.exists("/log/esphacker.log")) {
        g_bruceServer->sendContent("<h3 style='color:#a7a9be;font-size:11px;margin:8px 0 4px'>SD Log (/log/esphacker.log)</h3><pre>");
        File lf = SD.open("/log/esphacker.log", FILE_READ);
        if (lf) {
            uint32_t lineCount = 0;
            // Son 100 satırı göster (büyük dosyalar için)
            while (lf.available() && lineCount < 100) {
                String line = lf.readStringUntil('\n');
                g_bruceServer->sendContent(line + "\n");
                lineCount++;
            }
            lf.close();
        }
        g_bruceServer->sendContent("</pre>");
    }
    g_bruceServer->sendContent("</div>");
    bruceHtmlFooter();
}

// ─── POST /cmd — JSON body ile uzaktan komut ─────────────
static void bruceHandleCmd() {
    String cmd = "";
    // Form POST veya JSON body
    if (g_bruceServer->hasArg("cmd")) {
        cmd = g_bruceServer->arg("cmd");
    } else if (g_bruceServer->hasHeader("Content-Type")) {
        // Minimal JSON parse: {"cmd":"xxx"}
        String body = g_bruceServer->arg("plain");
        int ci = body.indexOf("\"cmd\"");
        if (ci >= 0) {
            int q1 = body.indexOf('"', ci + 6);
            int q2 = body.indexOf('"', q1 + 1);
            if (q1 >= 0 && q2 > q1) cmd = body.substring(q1 + 1, q2);
        }
    }
    if (cmd.isEmpty()) {
        g_bruceServer->send(400, "application/json", "{\"error\":\"missing cmd\"}");
        return;
    }
    logPush("[WEBUI] Remote cmd: " + cmd);

    String result = "ok";
    if (cmd == "wifi_scan") {
        // Tarama komutu — yanıt gönder, loop'ta çalışır
        result = "wifi_scan queued";
        logPush("[WEBUI] wifi_scan requested via WebUI");
    } else if (cmd == "ble_scan") {
        result = "ble_scan queued";
        logPush("[WEBUI] ble_scan requested via WebUI");
    } else if (cmd == "sd_info") {
        if (g_sdInited) {
            uint64_t tot = SD.totalBytes(), used = SD.usedBytes();
            result = "total=" + String((uint32_t)(tot/1024)) + "KB used=" + String((uint32_t)(used/1024)) + "KB";
        } else {
            result = "SD not mounted";
        }
    } else if (cmd == "xp_profile") {
        result = "Lv=" + String(g_level) + " XP=" + String(g_xp) + " rank=" + xpRankName(g_level);
    } else if (cmd == "reboot") {
        g_bruceServer->send(200, "application/json", "{\"status\":\"rebooting\"}");
        delay(200);
        ESP.restart();
        return;
    } else {
        result = "unknown cmd: " + cmd;
    }

    // Redirect back to dashboard if form submit, else JSON
    if (g_bruceServer->hasArg("cmd")) {
        // Form submit — redirect to dashboard with result
        String redirect = "/"
            "?msg=" + result;
        g_bruceServer->sendHeader("Location", "/");
        g_bruceServer->send(302, "text/plain", "");
    } else {
        g_bruceServer->send(200, "application/json",
            "{\"status\":\"ok\",\"cmd\":\"" + cmd + "\",\"result\":\"" + result + "\"}");
    }
}

