)rawhtml";

static void ota_server_setup() {
    g_otaServer->on("/", HTTP_GET, []() {
        g_otaServer->send_P(200, "text/html", OTA_HTML);
    });

    g_otaServer->on("/upload", HTTP_POST,
        // completion handler
        []() {
            if (g_otaPending) {
                g_otaServer->send_P(200, "text/html", OTA_OK_HTML);
            } else {
                g_otaServer->send_P(500, "text/html", OTA_FAIL_HTML);
            }
        },
        // upload handler (chunk by chunk)
        []() {
            HTTPUpload& upload = g_otaServer->upload();
            if (upload.status == UPLOAD_FILE_START) {
                logPush("[OTA] Upload start: " + upload.filename);
                g_otaPending = false;
                g_otaSize    = 0;
                if (g_otaBuf) { free(g_otaBuf); g_otaBuf = nullptr; }
                // Allocate in PSRAM if available
                size_t avail = ESP.getPsramSize() > 0 ? ESP.getFreePsram() : ESP.getFreeHeap();
                if (avail < 64 * 1024) {
                    logPush("[OTA] Not enough RAM");
                    return;
                }
                g_otaBuf = (uint8_t*)ps_malloc(avail > 4*1024*1024 ? 4*1024*1024 : avail);
                if (!g_otaBuf) {
                    logPush("[OTA] malloc failed");
                }
            } else if (upload.status == UPLOAD_FILE_WRITE) {
                if (g_otaBuf && (g_otaSize + upload.currentSize) < 4*1024*1024) {
                    memcpy(g_otaBuf + g_otaSize, upload.buf, upload.currentSize);
                    g_otaSize += upload.currentSize;
                }
            } else if (upload.status == UPLOAD_FILE_END) {
                if (g_otaBuf && g_otaSize > 0) {
                    logPush("[OTA] Received " + String(g_otaSize) + " bytes");
                    g_otaPending = true;
                } else {
                    logPush("[OTA] Upload failed");
                    if (g_otaBuf) { free(g_otaBuf); g_otaBuf = nullptr; }
                }
            }
        }
    );

    g_otaServer->onNotFound([]() {
        g_otaServer->sendHeader("Location", "/");
        g_otaServer->send(302, "text/plain", "");
    });

    g_otaServer->begin();
}

// Returns true if OTA was applied (device will restart)
static bool ota_check_and_apply() {
    if (!g_otaPending || !g_otaBuf || g_otaSize == 0) return false;

    // Ask user on OLED
    dispClear();
    dispStatusBar("OTA Guncelleme");
    dispText(0, 14, "OTA guncellemesi");
    dispText(0, 24, "yapilsin mi?");
    dispText(0, 36, String(g_otaSize / 1024) + " KB alindi");
    dispText(0, 48, "[BTN]=EVET");
    dispText(0, 56, "[LONG]=HAYIR");
    dispCommit();

    // Wait for user decision
    uint32_t t0 = millis();
    while (millis() - t0 < 30000) {  // 30s timeout -> cancel
        if (g_otaServer) g_otaServer->handleClient();
        if (readButton()) {
            // EVET - flash it
            dispBanner("Yukleniyor...", 200);
            dispProgress("OTA", "Yaziliyor...", 0);

            if (!Update.begin(g_otaSize)) {
                logPush("[OTA] Update.begin failed: " + String(Update.errorString()));
                free(g_otaBuf); g_otaBuf = nullptr;
                g_otaPending = false;
                g_otaSize    = 0;
                dispBanner("OTA HATA!", 2000);
                return false;
            }

            size_t written = Update.write(g_otaBuf, g_otaSize);
            free(g_otaBuf); g_otaBuf = nullptr;
            g_otaPending = false;

            if (written != g_otaSize) {
                logPush("[OTA] Write mismatch written=" + String(written) + " expected=" + String(g_otaSize));
                Update.abort();
                g_otaSize = 0;
                dispBanner("OTA HATA!", 2000);
                return false;
            }

            if (!Update.end(true)) {
                logPush("[OTA] Update.end failed: " + String(Update.errorString()));
                dispBanner("OTA HATA!", 2000);
                g_otaSize = 0;
                return false;
            }

            logPush("[OTA] Success! Rebooting...");
            xpAdd(XP_PER_OTA);
            dispBanner("OTA OK! Yeniden baslatiliyor...", 1500);
            delay(500);
            ESP.restart();
            return true;  // never reached
        }
        if (readButtonLong()) {
            // HAYIR
            free(g_otaBuf); g_otaBuf = nullptr;
            g_otaPending = false;
            g_otaSize    = 0;
            dispBanner("OTA iptal edildi", 1200);
            return false;
        }
        delay(20);
    }
    // Timeout
    free(g_otaBuf); g_otaBuf = nullptr;
    g_otaPending = false;
    g_otaSize    = 0;
    dispBanner("OTA zaman asimi", 1200);
    return false;
}

static void ota_run() {
    // Stop any existing WiFi
    WiFi.disconnect(true);
    delay(200);

    dispProgress("OTA", "AP baslatiliyor...", 10);

    WiFi.mode(WIFI_AP);
    WiFi.softAP(OTA_SSID, OTA_PASS);
    delay(300);

    dispClear();
    dispStatusBar("OTA Update");
    dispText(0, 12, "SSID:");
    dispText(0, 22, OTA_SSID);
    dispText(0, 32, "Sifre:");
    dispText(0, 42, OTA_PASS);
    dispText(0, 52, "IP: " + String(OTA_IP));
    dispCommit();

    if (g_otaServer) { delete g_otaServer; g_otaServer = nullptr; }
    g_otaServer = new WebServer(80);
    ota_server_setup();

    logPush("[OTA] AP up, waiting for upload");

    // Main OTA loop
    while (true) {
        g_otaServer->handleClient();

        if (g_otaPending) {
            ota_check_and_apply();
            // If we get here, user cancelled – loop back
        }

        // Check for exit (long press)
        if (readButtonLong()) {
            logPush("[OTA] Exiting OTA mode");
            break;
        }
        delay(10);
    }

    // Cleanup
    if (g_otaServer) { g_otaServer->stop(); delete g_otaServer; g_otaServer = nullptr; }
    if (g_otaBuf)    { free(g_otaBuf); g_otaBuf = nullptr; }
    g_otaPending = false;
    g_otaSize    = 0;
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_OFF);
    dispBanner("OTA modu kapatildi");
}

// ═══════════════════════════════════════════════════════════
//  MODULE: BadUSB Output Capture Server
//  BadUSB payload çıktılarını ESP32'ye HTTP POST ile gönderir.
//  ESP32, port 8080'de bir WebServer dinler.
//  Hedef bilgisayar PowerShell/bash ile çıktıyı POST eder,
//  ESP32 bu çıktıyı OLED ekranda ve log'da gösterir.
//
//  Kullanım:
//    1. BadUSB menüsünde "Output Capture" aktif edilir.
//    2. ESP32 WiFi AP olarak başlar (mevcut AP kullanılır
//       veya yeni bir SoftAP açılır: "Sharkino_Out" / port 8080).
//    3. Payload çalıştırıldığında hedef bilgisayar çıktıyı
//       http://192.168.4.1:8080/out adresine POST eder.
//    4. Çıktı OLED'de sayfalı gösterilir + log'a yazılır.
//
//  NOT: g_usbHIDInited ile USB HID aynı anda çalışabilir;
//  USB CDC (Serial) devre dışıysa output server WiFi üzerinden
//  tek iletişim kanalıdır.
// ═══════════════════════════════════════════════════════════

static WebServer*  g_outServer   = nullptr;
static bool        g_outCapture  = false;   // Output Capture aktif mi?
static String      g_outBuf      = "";      // Son alınan çıktı
static bool        g_outReceived = false;   // Yeni çıktı geldi mi?

// ─── Output Server HTTP handler ───────────────────────────

// POST /out  →  hedef bilgisayardan çıktı alır
static void outHandlePost() {
    if (g_outServer->hasArg("plain")) {
        g_outBuf = g_outServer->arg("plain");
        g_outBuf.trim();
        if (g_outBuf.length() > 2048) g_outBuf = g_outBuf.substring(0, 2048);
        g_outReceived = true;
        logPush("[OUT] " + g_outBuf.substring(0, 60));
        g_outServer->send(200, "text/plain", "OK");
    } else {
        g_outServer->send(400, "text/plain", "No body");
    }
}

// GET /  →  basit durum sayfası (debug amaçlı)
static void outHandleRoot() {
    String html = "<html><body><h2>M5Sharkino Output Capture</h2>";
    html += "<p>Son cikti:</p><pre>";
    html += g_outBuf;
    html += "</pre></body></html>";
    g_outServer->send(200, "text/html", html);
}

// ─── Output Server Başlat/Durdur ──────────────────────────

static void badusb_start_output_server() {
    if (g_outServer) return;  // zaten çalışıyor

    // SoftAP yoksa başlat
    if (WiFi.getMode() == WIFI_OFF || WiFi.getMode() == WIFI_STA) {
        WiFi.mode(WIFI_AP);
        WiFi.softAP("Sharkino_Out", "sharkino123", 6, 0, 4);
        delay(400);
    }

    g_outServer = new WebServer(8080);
    g_outServer->on("/out", HTTP_POST, outHandlePost);
    g_outServer->on("/",    HTTP_GET,  outHandleRoot);
    g_outServer->begin();
    g_outBuf      = "";
    g_outReceived = false;

    logPush("[OUT] Output server baslatildi: " + WiFi.softAPIP().toString() + ":8080");
}

static void badusb_stop_output_server() {
    if (!g_outServer) return;
    g_outServer->stop();
    delete g_outServer;
    g_outServer = nullptr;
    logPush("[OUT] Output server durduruldu");
}

// ─── OLED'de çıktı görüntüleyici ─────────────────────────
// g_outBuf içeriğini 18-char genişlikte satırlara bölerek
// sayfa sayfa gösterir (joystick ile kaydırma).

static void badusb_show_output() {
    if (g_outBuf.isEmpty()) {
        dispBanner("Cikti bos!", 1500, BannerType::WARN);
        return;
    }

    // Satırlara böl (hem '\n' hem 18-char wrap)
    std::vector<String> lines;
    String cur = g_outBuf;
    cur.replace("\r\n", "\n");
    cur.replace("\r", "\n");

    int idx = 0;
    while (idx < (int)cur.length()) {
        int nl = cur.indexOf('\n', idx);
        String segment = (nl < 0) ? cur.substring(idx) : cur.substring(idx, nl);
        idx = (nl < 0) ? cur.length() : nl + 1;
        // 18-karakter wrap
        while (segment.length() > 18) {
            lines.push_back(segment.substring(0, 18));
            segment = segment.substring(18);
        }
        lines.push_back(segment);
    }

    if (lines.empty()) { dispBanner("Cikti bos!", 1500, BannerType::WARN); return; }

    // Sayfa başına 4 satır göster
    const int LINES_PER_PAGE = 4;
    int totalPages = ((int)lines.size() + LINES_PER_PAGE - 1) / LINES_PER_PAGE;
    int page = 0;

    for (;;) {
        dispClear();
        dispStatusBar("Cikti " + String(page + 1) + "/" + String(totalPages));
        for (int i = 0; i < LINES_PER_PAGE; i++) {
            int lineIdx = page * LINES_PER_PAGE + i;
            if (lineIdx < (int)lines.size()) {
                dispText(0, 12 + i * 12, lines[lineIdx]);
            }
        }
        dispText(0, 56, "U/D:sayfa BTN:cik");
        dispCommit();

        JoyDir d = readJoystick();
        if (d == JoyDir::UP   && page > 0)               page--;
        else if (d == JoyDir::DOWN && page < totalPages - 1) page++;
        else if (readButton() || d == JoyDir::NONE) {
            // Kısa bekleme ile buton kontrolü
            delay(50);
            if (readButton()) break;
        }
        delay(120);
    }
}

// ─── Output sunucusunu handleClient döngüsüyle güncelle ──
// Bu fonksiyon BadUSB payload'ları beklerken çağrılır.
static void badusb_out_tick() {
    if (g_outServer) g_outServer->handleClient();
}

// ─── WiFi bağlantı bilgisini ekranda göster ───────────────
static void badusb_show_server_info() {
    dispClear();
    dispStatusBar("Output Capture");
    dispText(0, 12, "SSID: Sharkino_Out");
    dispText(0, 22, "Pass: sharkino123");
    dispText(0, 32, "IP:   192.168.4.1");
    dispText(0, 42, "Port: 8080");
    dispText(0, 52, "POST /out  (text)");
    dispCommit();
    delay(3000);
}

// ─── Capture bekle ekranı ─────────────────────────────────
// Payload gönderildikten sonra çıktı gelene kadar beklenir.
// Buton ile iptal edilebilir. Çıktı gelince otomatik gösterir.
static void badusb_wait_output(uint32_t timeoutMs = 30000) {
    if (!g_outCapture || !g_outServer) return;

    g_outReceived = false;
    uint32_t start = millis();

    dispClear();
    dispStatusBar("Cikti Bekleniyor");
    dispText(0, 18, "Hedef bilgisayar");
    dispText(0, 28, "ciktiyi gondermeli.");
    dispText(0, 40, "192.168.4.1:8080");
    dispText(0, 52, "[BTN] atla");
    dispCommit();

    while (!g_outReceived && (millis() - start) < timeoutMs) {
        badusb_out_tick();
        uint32_t elapsed = (millis() - start) / 1000;
        uint32_t remaining = (timeoutMs / 1000) - elapsed;
        // Her saniye sayacı güncelle
        static uint32_t lastSec = 0;
        if (elapsed != lastSec) {
            lastSec = elapsed;
            dispClear();
            dispStatusBar("Cikti Bekleniyor");
            dispText(0, 18, "Hedef bilgisayar");
            dispText(0, 28, "ciktiyi gondermeli.");
            dispText(0, 40, "192.168.4.1:8080");
            dispText(0, 50, "Kalan: " + String(remaining) + "s  [BTN] atla");
            dispCommit();
        }
        if (readButton()) break;
        delay(50);
    }

    if (g_outReceived) {
        dispBannerOK("Cikti alindi!", 800);
