            {"Read Tag",       []() { rfid_read_run(); }},
            {"Monitor",        []() { rfid_monitor_run(); }},
            {"Dump Tag",       []() { rfid_dump_run(); }},
            {"Clone UID",      []() { rfid_clone_run(); }},
            {"Full Clone",     []() { rfid_clone_full_run(); }},
            {"Write Block",    []() { rfid_write_block_run(); }},
            {"Write NDEF",     []() { rfid_write_ndef_run(); }},
            {"Parse NDEF",     []() { rfid_parse_ndef_run(); }},
            {"Erase Tag",      []() { rfid_erase_run(); }},
            {"Bruteforce",     []() { rfid_bruteforce_run(); }},
            {"Save Tag",       []() { rfid_save_tag_run(); }},
            {"Saved Tags",     []() { rfid_load_tags_run(); }},
            {"Back",           []() { backToMenu(); }},
