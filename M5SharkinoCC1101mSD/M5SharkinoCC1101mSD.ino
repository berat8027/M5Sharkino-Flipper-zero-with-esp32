// ─── GET / — Ana Dashboard ───────────────────────────────
static void bruceHandleRoot() {
    g_bruceServer->setContentLength(CONTENT_LENGTH_UNKNOWN);
    g_bruceServer->send(200, "text/html", "");

    bruceHtmlHeader();

    // Cihaz Bilgileri kartı
    uint32_t upSec = (millis() - g_bruceStartMs) / 1000;
    char upBuf[16];
    snprintf(upBuf, sizeof(upBuf), "%02lu:%02lu:%02lu",
             (unsigned long)(upSec/3600),
             (unsigned long)((upSec%3600)/60),
             (unsigned long)(upSec%60));

    String ip = WiFi.softAPIP().toString();
    String card = "<div class='card'><h2>&#128268; Device Info</h2>"
        "<div class='row'><span class='label'>Hostname</span><span class='val'>M5Sharkino</span></div>"
        "<div class='row'><span class='label'>AP IP</span><span class='val'>" + ip + "</span></div>"
        "<div class='row'><span class='label'>Uptime</span><span class='val'>" + String(upBuf) + "</span></div>"
        "<div class='row'><span class='label'>Heap Free</span><span class='val'>" + String(ESP.getFreeHeap()/1024) + " KB</span></div>"
        "<div class='row'><span class='label'>PSRAM Free</span><span class='val'>" + String(ESP.getFreePsram()/1024) + " KB</span></div>"
        "<div class='row'><span class='label'>AP Clients</span><span class='val'>" + String(WiFi.softAPgetStationNum()) + "</span></div>"
        "<div class='row'><span class='label'>SD Card</span><span class='val'><span class='badge " + String(g_sdInited ? "badge-ok'>OK" : "badge-err'>FAIL") + "</span></span></div>"
        "<div class='row'><span class='label'>SPIFFS</span><span class='val'><span class='badge " + String(g_spiffsInited ? "badge-ok'>OK" : "badge-warn'>N/A") + "</span></span></div>"
        "</div>";
    g_bruceServer->sendContent(card);

    // XP / Level kartı
    uint8_t xpPct = (g_level < XP_MAX_LEVEL)
        ? (uint8_t)((float)(g_xp - xpForLevel(g_level))
          / (float)(xpForLevel(g_level+1) - xpForLevel(g_level)) * 100)
