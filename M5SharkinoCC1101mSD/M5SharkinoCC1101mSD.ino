// ─── loopOptions ──────────────────────────────────────────

// ── Flipper Zero submenu pixel-perfect renderer ────────────
// renderOptionList → renderFlipperMenu'ya yönlendirildi.
// loopOptions() zaten renderFlipperMenu'yu direkt çağırır;
// bu wrapper tutarlılık ve geriye dönük uyumluluk içindir.

static int s_menuAnimSel    = -1;  // last rendered sel (animation tracking)
static int s_menuAnimOffset =  0;  // pixel offset for slide animation

void renderOptionList(const OptionList& opts, const String& title, int sel) {
    // Tüm submenu render'ı tek noktada: renderFlipperMenu
    int total  = (int)opts.size();
    int scroll = sel - 2;
    if (scroll < 0)           scroll = 0;
    if (scroll > total - 4)   scroll = total - 4;
    if (scroll < 0)           scroll = 0;
    renderFlipperMenu(opts, sel, scroll, title);
}

// Animasyonlu loopOptions: Flipper Zero UI kullanır
// Idle timeout: 30 saniye hareketsizlik → dolphin idle ekranı
int loopOptions(const OptionList& opts, const String& title) {
    static constexpr int      LIST_TOP       = 13;
    static constexpr int      ITEM_H         = 10;
    static constexpr int      VIS            = 4;
    static constexpr uint32_t IDLE_TIMEOUT_MS = 30000UL;  // 30s — ana menü ile aynı

    int sel     = 0;
    int prevSel = -1;
    uint32_t lastActivityMs = millis();  // submenu kendi timer'ını yönetir

    // Scroll hesapla
    auto calcScroll = [&](int s) -> int {
        int sc = s - VIS / 2;
        int total = (int)opts.size();
        if (sc < 0) sc = 0;
        if (sc > total - VIS) sc = total - VIS;
        if (sc < 0) sc = 0;
        return sc;
    };

    // İlk çizim — Flipper menü renderer
    renderFlipperMenu(opts, sel, calcScroll(sel), title);

    while (true) {
        potApplyBrightness();
        JoyDir d = readJoystick();
        bool changed = false;

        if (d == JoyDir::UP && sel > 0) {
            prevSel = sel;
            sel--;
            buzzNav();
            changed = true;
            lastActivityMs = millis();  // joystick hareketi → timer sıfırla
        }
        if (d == JoyDir::DOWN && sel < (int)opts.size() - 1) {
            prevSel = sel;
            sel++;
            buzzNav();
            changed = true;
            lastActivityMs = millis();  // joystick hareketi → timer sıfırla
        }

        if (changed) {
            int scroll = calcScroll(sel);
            renderFlipperMenu(opts, sel, scroll, title);
        }

        if (readButton()) {
            lastActivityMs = millis();  // buton → timer sıfırla
            buzzSelect();
            return sel;
        }
        if (readButtonLong()) {
            lastActivityMs = millis();  // uzun basış → timer sıfırla
            return -1;
        }

        // ── Idle timeout — submenu içinde de dolphin ekranı ──
        if (millis() - lastActivityMs >= IDLE_TIMEOUT_MS) {
            showIdleScreen();                          // herhangi input ile çıkılır
            lastActivityMs = millis();                 // çıkışta timer sıfırla
            renderFlipperMenu(opts, sel, calcScroll(sel), title);  // menüyü yeniden çiz
        }

        delay(8);
    }
}

