// ─────────────────────────────────────────────────────────
//  OS SEÇİM + PAYLOAD MENÜSÜ
// ─────────────────────────────────────────────────────────

static void badusb_run() {
    // USB HID bilgi ekranı (henüz başlatılmadıysa göster)
    if (!g_usbHIDInited) {
        dispClear(); dispStatusBar("BadUSB Init");
        dispText(0, 12, "USB HID hazirlanacak");
        dispText(0, 22, "Board: USB-OTG mode");
        dispText(0, 32, "Once layout secin...");
        dispCommit();
        delay(1200);
    }

    // Klavye layout seçimi
    OptionList layoutOpts = {
        {"en_US (Ingilizce)", [](){}},
        {"TR-Q (Turkce Q)",   [](){}},
        {"Back",              [](){}},
    };
    int layoutSel = loopOptions(layoutOpts, "BadUSB: Layout");
    if (layoutSel < 0 || layoutSel == 2) return;

    BadUSBLayout chosenLayout = (layoutSel == 1) ? BadUSBLayout::tr_Q : BadUSBLayout::en_US;

    // Layout değiştiyse veya henüz başlatılmadıysa (re)init
    if (!g_usbHIDInited || chosenLayout != g_usbLayout) {
        animBadUSBInit();  // Flipper Zero USB animasyonu
        badusb_ensure_init(chosenLayout);
        dispBannerOK(layoutSel == 1 ? "TR-Q hazir!" : "en_US hazir!");
    }

    // ─── Output Capture modu seçimi ───────────────────────
    // "Output Capture" aktifse payload çıktısı ESP32 ekranında görünür.
    // Hedef bilgisayar WiFi'ye bağlanıp http://192.168.4.1:8080/out
    // adresine POST yapar; payload'lar bunu otomatik yapar.
    OptionList capOpts = {
        {g_outCapture ? "Output Capture: ACIK" : "Output Capture: KAPALI", [](){}},
        {"OS + Payload Sec",  [](){}},
        {"Son Ciktiyi Goster",[](){}},
        {"Back",              [](){}},
    };
    int capSel = loopOptions(capOpts, "BadUSB Modu");
    if (capSel < 0 || capSel == 3) return;

    if (capSel == 0) {
        // Output Capture toggle
        g_outCapture = !g_outCapture;
        if (g_outCapture) {
            badusb_start_output_server();
            badusb_show_server_info();
            dispBannerOK("Output Capture ACIK");
        } else {
            badusb_stop_output_server();
            dispBannerWarn("Output Capture KAPALI");
        }
        return;
    }

    if (capSel == 2) {
        // Son çıktıyü göster
        if (g_outBuf.isEmpty()) {
            dispBanner("Hic cikti yok!", 1500, BannerType::WARN);
        } else {
            badusb_show_output();
        }
        return;
    }

    // capSel == 1: OS + Payload seçimi
    // OS seçimi
    OptionList osOpts = {
        {"Windows",  [](){}},
        {"Linux",    [](){}},
        {"Mac",      [](){}},
        {"Custom",   [](){}},
        {"Back",     [](){}},
    };
    int osSel = loopOptions(osOpts, "BadUSB: OS Sec");
    if (osSel < 0 || osSel == 4) return;

    if (osSel == 3) {
        // Özel payload
        payload_custom_run();
        return;
    }

    // ─── Geri sayım yardımcı lambdası ─────────────────────
    auto countdown = [&](const String& label) -> bool {
        for (int8_t i = 3; i > 0; i--) {
            dispClear(); dispStatusBar("BadUSB");
            dispText(0, 10, label.substring(0, 20));
            if (g_outCapture) dispText(0, 20, "[OUT] Aktif");
            dispCenter(32, String(i) + "...", 2);
            dispText(0, 54, "[LONG] iptal");
            dispCommit();
            delay(1000);
            if (readButtonLong()) { dispBannerWarn("Iptal edildi"); return false; }
        }
        return true;
    };

    // ─── OS'a göre payload listesi ────────────────────────
    if (osSel == 0) {
        // Windows — Output Capture modu aktifse _out varyantları göster
        if (g_outCapture) {
            OptionList payloads = {
                {"SysInfo > ESP32",   []() { payload_win_sysinfo_out(); }},
                {"WhoAmI > ESP32",    []() { payload_win_whoami_out(); }},
                {"WiFi Pwds > ESP32", []() { payload_win_wifi_dump_out(); }},
                {"ProcList > ESP32",  []() { payload_win_proclist_out(); }},
                {"Env Vars > ESP32",  []() { payload_win_env_out(); }},
                {"Custom > ESP32",    []() { payload_win_custom_out(); }},
                {"Back",              [](){}},
            };
            int sel = loopOptions(payloads, "Win Out Payloads");
            if (sel >= 0 && sel < 6) {
                if (countdown(payloads[sel].label)) payloads[sel].action();
            }
        } else {
            OptionList payloads = {
                {"SysInfo Popup",   []() { payload_win_sysinfo(); }},
                {"Add Admin User",  []() { payload_win_add_admin(); }},
                {"Reverse Shell",   []() { payload_win_rev_shell(); }},
                {"WiFi Passwords",  []() { payload_win_wifi_dump(); }},
                {"Defender OFF",    []() { payload_win_defender_off(); }},
                {"Lock Screen",     []() { payload_win_lock(); }},
                {"Message Box",     []() { payload_win_msgbox(); }},
                {"Back",            [](){}},
            };
            int sel = loopOptions(payloads, "Win Payloads");
            if (sel >= 0 && sel < 7) {
                if (countdown(payloads[sel].label)) payloads[sel].action();
            }
        }

    } else if (osSel == 1) {
        // Linux
        if (g_outCapture) {
            OptionList payloads = {
                {"SysInfo > ESP32",  []() { payload_linux_sysinfo_out(); }},
                {"passwd > ESP32",   []() { payload_linux_passwd_out(); }},
                {"Custom > ESP32",   []() { payload_linux_custom_out(); }},
                {"Back",             [](){}},
            };
            int sel = loopOptions(payloads, "Linux Out Payloads");
            if (sel >= 0 && sel < 3) {
                if (countdown(payloads[sel].label)) payloads[sel].action();
            }
        } else {
            OptionList payloads = {
                {"SysInfo",         []() { payload_linux_sysinfo(); }},
                {"Reverse Shell",   []() { payload_linux_rev_shell(); }},
                {"Add Sudo User",   []() { payload_linux_add_sudo(); }},
                {"Crontab Persist", []() { payload_linux_crontab(); }},
                {"Exfil SSH+Hist",  []() { payload_linux_exfil(); }},
                {"Back",            [](){}},
            };
            int sel = loopOptions(payloads, "Linux Payloads");
            if (sel >= 0 && sel < 5) {
                if (countdown(payloads[sel].label)) payloads[sel].action();
            }
        }

    } else if (osSel == 2) {
        // Mac
        if (g_outCapture) {
            OptionList payloads = {
                {"SysInfo > ESP32",  []() { payload_mac_sysinfo_out(); }},
                {"Custom > ESP32",   []() { payload_mac_custom_out(); }},
                {"Back",             [](){}},
            };
            int sel = loopOptions(payloads, "Mac Out Payloads");
            if (sel >= 0 && sel < 2) {
                if (countdown(payloads[sel].label)) payloads[sel].action();
            }
        } else {
            OptionList payloads = {
                {"SysInfo",         []() { payload_mac_sysinfo(); }},
                {"Reverse Shell",   []() { payload_mac_rev_shell(); }},
                {"Add Admin User",  []() { payload_mac_add_user(); }},
                {"WiFi Passwords",  []() { payload_mac_wifi_dump(); }},
                {"Back",            [](){}},
            };
            int sel = loopOptions(payloads, "Mac Payloads");
            if (sel >= 0 && sel < 4) {
                if (countdown(payloads[sel].label)) payloads[sel].action();
            }
        }
    }
}

// ─────────────────────────────────────────────────────────
//  BadUSBMenu — MenuItem subclass (ana menü ikonlu öğesi)
// ─────────────────────────────────────────────────────────

class BadUSBMenu : public MenuItem {
public:
    String getName() override { return "BadUSB"; }

    void drawShape(int x, int y, uint16_t col) {
        // USB fiş simgesi: dikdörtgen gövde + 2 pin + kablo
        // USB tip-A gövdesi
        display.drawRoundRect(x+6, y+8, 20, 14, 2, col);
        // USB D+/D- pinleri (iç çizgiler)
        display.drawLine(x+10, y+12, x+10, y+18, col);
        display.drawLine(x+15, y+12, x+15, y+18, col);
        display.drawLine(x+20, y+12, x+20, y+18, col);
        // USB sembolü (üçgen + daireler)
        // Dikey çizgi (ana hat)
        display.drawLine(x+16, y+2, x+16, y+8, col);
        // Sol dal
        display.drawLine(x+16, y+4, x+10, y+4, col);
        display.fillCircle(x+10, y+4, 2, col);
        // Sağ dal
        display.drawLine(x+16, y+6, x+22, y+6, col);
        display.drawRect(x+20, y+4, 4, 4, col);
        // Kablo (alt)
        display.drawLine(x+16, y+22, x+16, y+28, col);
        display.drawLine(x+12, y+28, x+20, y+28, col);
        display.drawLine(x+12, y+28, x+12, y+30, col);
        display.drawLine(x+20, y+28, x+20, y+30, col);
        // "HID" yazısı
        display.setTextSize(1);
        display.setTextColor(col);
        display.setCursor(x+4, y+22);
        display.print("HID");
    }

    void drawIcon(int x, int y) override    { drawShape(x, y, SSD1306_WHITE); }
    void drawIconInv(int x, int y) override { drawShape(x, y, SSD1306_BLACK); }
    void drawIconSmall(int x, int y, uint16_t col) override {
        // USB fişi + HID sembolü, 16x16
        display.drawRoundRect(x+3, y+4, 10, 7, 1, col);
        display.drawLine(x+5,  y+6,  x+5,  y+9,  col);
        display.drawLine(x+8,  y+6,  x+8,  y+9,  col);
        display.drawLine(x+8,  y+1,  x+8,  y+4,  col);
        display.drawLine(x+8,  y+2,  x+5,  y+2,  col);
        display.fillCircle(x+5, y+2, 1, col);
        display.drawLine(x+8,  y+2,  x+11, y+2,  col);
        display.drawRect(x+10, y+1,  2,    2,     col);
        display.drawLine(x+8,  y+11, x+8,  y+14, col);
        display.drawFastHLine(x+6, y+14, 4, col);
    }

    void runMenu() override {
        while (!g_returnToMenu) {
            OptionList opts = {
                {"Run Payload",   []() { badusb_run(); }},
                {"USB Status",    []() {
                    dispClear(); dispStatusBar("USB HID Status");
                    dispText(0, 12, g_usbHIDInited ? "USB HID: AKTIF" : "USB HID: Baslatilmadi");
                    dispText(0, 21, g_usbLayout == BadUSBLayout::tr_Q ? "Layout: TR-Q" : "Layout: en_US");
                    dispText(0, 30, g_outCapture ? "OutCapture: ACIK" : "OutCapture: KAPALI");
                    if (g_outCapture && g_outServer) {
                        dispText(0, 39, "Srv: " + WiFi.softAPIP().toString() + ":8080");
                    } else {
                        dispText(0, 39, "Cihaz: HID Keyboard");
                    }
                    dispText(0, 48, g_outBuf.isEmpty() ? "Cikti: -" : "Cikti: VAR");
                    dispText(0, 57, "[BTN] back");
                    dispCommit();
                    while (!readButton()) delay(50);
                }},
                {"Output Capture", []() {
                    // Output Capture toggle + durum ekranı
                    g_outCapture = !g_outCapture;
                    if (g_outCapture) {
                        badusb_start_output_server();
                        badusb_show_server_info();
                        dispBannerOK("OutCapture ACIK");
                    } else {
                        badusb_stop_output_server();
                        dispBannerWarn("OutCapture KAPALI");
                    }
                }},
                {"Son Cikti",     []() {
                    if (g_outBuf.isEmpty()) {
                        dispBanner("Hic cikti yok!", 1500, BannerType::WARN);
                    } else {
                        badusb_show_output();
                    }
                }},
                {"Custom Payload", []() {
                    // Layout henüz seçilmemişse sor
                    if (!g_usbHIDInited) {
                        OptionList lOpts = {
                            {"en_US (Ingilizce)", [](){}},
                            {"TR-Q (Turkce Q)",   [](){}},
                            {"Back",              [](){}},
                        };
                        int lSel = loopOptions(lOpts, "Layout Sec");
                        if (lSel < 0 || lSel == 2) return;
                        BadUSBLayout lay = (lSel == 1) ? BadUSBLayout::tr_Q : BadUSBLayout::en_US;
                        badusb_ensure_init(lay);
                    }
                    payload_custom_run();
                }},
                {"Back",          []() { backToMenu(); }},
            };
            int sel = loopOptions(opts, "BadUSB");
            if (sel < 0) { backToMenu(); break; }
            if (sel >= 0 && sel < (int)opts.size()) opts[sel].action();
        }
    }
};

