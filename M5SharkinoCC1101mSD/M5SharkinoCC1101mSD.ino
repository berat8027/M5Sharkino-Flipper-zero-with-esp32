//  MODULE: BadUSB  (USB HID Keyboard via ESP32-S3 Native USB)
//  ESP32-S3'ün dahili USB OTG donanımı kullanılır.
//  Kütüphane: arduino-esp32 USB.h + USBHIDKeyboard.h
//  Eklenmesi gereken board config:
//    Tools → USB Mode → "USB-OTG (TinyUSB)"
// ═══════════════════════════════════════════════════════════

#include "USB.h"
#include "USBHIDKeyboard.h"

static USBHIDKeyboard g_usbKbd;
static bool           g_usbHIDInited = false;

// Klavye layout seçimi: en_US (varsayılan, ASCII uyumlu) veya tr_Q (Türkçe Q)
enum class BadUSBLayout { en_US, tr_Q };
static BadUSBLayout   g_usbLayout    = BadUSBLayout::en_US;

// ─── Türkçe Q (TR-Q) asciimap — begin(KeyboardLayout_tr_Q) ile yüklenir ───
// Format: asciimap[ascii_code] = HID_keycode | SHIFT(0x80) | ALTGR(0x40)
// Kaynak: Windows TR-Q layout (LCID 041Fh) + HID Usage Table 1.12
// Fiziksel tuş → HID keycode tablosu (TR-Q 102-tuş ISO klavye, Windows):
//
// Numrow (shift'li karakterler):   ! ' ^ + % & / ( ) =
//   Yani Shift+1=! Shift+2=' Shift+3=^ Shift+4=+ Shift+5=% Shift+6=& Shift+7=/ Shift+8=( Shift+9=) Shift+0==
//
// Özel tuşlar (fiziksel HID keycode):
//   ğ = 0x2F   ü = 0x30   ş = 0x33   ı = 0x0C   ö = 0x12   ç = 0x36 (ISO)
//   , = 0x10 (m'nin yanı)  hayır — TR-Q ISO: , = 0x36 değil, virgül farklı
//
// TR-Q'da gerçek fiziksel pozisyonlar (Windows HID scan → keycode):
//   0x2D tuşu fiziksel → TR-Q'da '*' (Shift ile '=')
//   0x2E tuşu fiziksel → TR-Q'da '-' (Shift ile '_')
//   0x2C tuşu → Space
//   0x33 tuşu → ş (Shift ile 'Ş'), AltGr+ş = ';'... hayır
//   TR-Q'da ':' = Shift+ş(0x33), ';' = Shift+ç
//   TR-Q'da '-' = 0x38 tuşu (US'de '/?' tuşu)
//   TR-Q'da '_' = Shift+0x38
//   TR-Q'da '/' = Shift+0x24(7 tuşu)
//   TR-Q'da '\' = AltGr+0x2D (fiziksel * tuşu)
//   TR-Q'da '|' = AltGr+0x64 (102. tuş)
//   TR-Q'da '[' = AltGr+0x25(8), ']' = AltGr+0x26(9)
//   TR-Q'da '{' = AltGr+Shift+0x25, '}' = AltGr+Shift+0x26
//   TR-Q'da '@' = AltGr+0x14(q), '#' = AltGr+0x20(3)
//   TR-Q'da '$' = AltGr+0x21(4)
//   TR-Q'da '`' = AltGr+0x2C(,) veya yok
//   TR-Q'da '~' = AltGr+0x18(u) veya AltGr+Shift+ü
//   TR-Q'da ''' (tek tırnak) = Shift+2 (0x1F|SHIFT)... HAYIR
//       Shift+2 = ' (apostrof), normal 2 = '2'
//       Yani ' = 0x1F|SHIFT — DOĞRU (numrow Shift+2 = apostrof TR-Q'da)
//   TR-Q'da '"' = Shift+' (apostrophe tuşu)... 
//       ' tuşu TR-Q'da = 0x31 (US'de `'/~` tuşu)
//       Shift+0x31 = '"'
//
// NOT: Windows payloadları (PowerShell) için badusb_type_us() kullan!
// badusb_type_us(), layout bağımsız US-raw keycode ile gönderir.
// Bu tablo sadece Türkçe karakter gerektiren durumlarda kullanılır.

#define KBD_SHIFT  0x80
#define KBD_ALTGR  0x40

static const uint8_t KeyboardLayout_tr_Q[128] = {
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // 0x00-0x07
    0x2A, 0x2B, 0x28, 0x00, 0x00, 0x00, 0x00, 0x00,  // BS TAB LF ...
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // 0x10-0x17
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // 0x18-0x1F
    // 0x20 (32) = SPACE..0x7E (126) = ~
    0x2C,               // ' ' space
    0x1E|KBD_SHIFT,     // '!' Shift+1
    0x31|KBD_SHIFT,     // '"' Shift+apostrof tuşu (0x31)
    0x20|KBD_ALTGR,     // '#' AltGr+3
    0x21|KBD_ALTGR,     // '$' AltGr+4 (TR-Q: 4'ün AltGr'si $)
    0x22|KBD_SHIFT,     // '%' Shift+5
    0x23|KBD_SHIFT,     // '&' Shift+6
    0x1F|KBD_SHIFT,     // '\'' tek tırnak — Shift+2 (TR-Q numrow: Shift+2=')
    0x25|KBD_SHIFT,     // '(' Shift+8
    0x26|KBD_SHIFT,     // ')' Shift+9
    0x2D|KBD_SHIFT,     // '*' Shift+* tuşu (0x2D = fiziksel * tuşu TR-Q'da)
    0x21|KBD_SHIFT,     // '+' Shift+4 (TR-Q: Shift+4=+)
    0x36,               // ',' virgül (0x36)
    0x38,               // '-' eksi — TR-Q'da 0x38 fiziksel tuş
    0x37,               // '.' nokta
    0x24|KBD_SHIFT,     // '/' Shift+7 (TR-Q: Shift+7=/)
    0x27,               // '0'
    0x1E,               // '1'
    0x1F,               // '2'
    0x20,               // '3'
    0x21,               // '4'
    0x22,               // '5'
    0x23,               // '6'
    0x24,               // '7'
    0x25,               // '8'
    0x26,               // '9'
    0x33|KBD_SHIFT,     // ':' Shift+ş (0x33)
    0x36|KBD_SHIFT,     // ';' Shift+ç (0x36) — TR-Q'da ç=virgül pozisyonu
    0x64,               // '<' 102. tuş (ISO non-US)
    0x27|KBD_SHIFT,     // '=' Shift+0
    0x64|KBD_SHIFT,     // '>' Shift+<
    0x2F|KBD_SHIFT,     // '?' Shift+ğ (0x2F)
    0x14|KBD_ALTGR,     // '@' AltGr+Q (0x14)
    0x04|KBD_SHIFT,     // 'A'
    0x05|KBD_SHIFT,     // 'B'
    0x06|KBD_SHIFT,     // 'C'
    0x07|KBD_SHIFT,     // 'D'
    0x08|KBD_SHIFT,     // 'E'
    0x09|KBD_SHIFT,     // 'F'
    0x0A|KBD_SHIFT,     // 'G'
    0x0B|KBD_SHIFT,     // 'H'
    0x0C|KBD_SHIFT,     // 'I'
    0x0D|KBD_SHIFT,     // 'J'
    0x0E|KBD_SHIFT,     // 'K'
    0x0F|KBD_SHIFT,     // 'L'
    0x10|KBD_SHIFT,     // 'M'
    0x11|KBD_SHIFT,     // 'N'
    0x12|KBD_SHIFT,     // 'O'
    0x13|KBD_SHIFT,     // 'P'
    0x14|KBD_SHIFT,     // 'Q'
    0x15|KBD_SHIFT,     // 'R'
    0x16|KBD_SHIFT,     // 'S'
    0x17|KBD_SHIFT,     // 'T'
    0x18|KBD_SHIFT,     // 'U'
    0x19|KBD_SHIFT,     // 'V'
    0x1A|KBD_SHIFT,     // 'W'
    0x1B|KBD_SHIFT,     // 'X'
    0x1C|KBD_SHIFT,     // 'Y'
    0x1D|KBD_SHIFT,     // 'Z'
    0x25|KBD_ALTGR,     // '[' AltGr+8
    0x2D|KBD_ALTGR,     // '\' AltGr+* tuşu (TR-Q'da * = 0x2D)
    0x26|KBD_ALTGR,     // ']' AltGr+9
    0x20|KBD_SHIFT,     // '^' Shift+3
    0x38|KBD_SHIFT,     // '_' Shift+- (0x38)
    0x00,               // '`' — TR-Q'da standart yok
    0x04,               // 'a'
    0x05,               // 'b'
    0x06,               // 'c'
    0x07,               // 'd'
    0x08,               // 'e'
    0x09,               // 'f'
    0x0A,               // 'g'
    0x0B,               // 'h'
    0x0C,               // 'i'
    0x0D,               // 'j'
    0x0E,               // 'k'
    0x0F,               // 'l'
    0x10,               // 'm'
    0x11,               // 'n'
    0x12,               // 'o'
    0x13,               // 'p'
    0x14,               // 'q'
    0x15,               // 'r'
    0x16,               // 's'
    0x17,               // 't'
    0x18,               // 'u'
    0x19,               // 'v'
    0x1A,               // 'w'
    0x1B,               // 'x'
    0x1C,               // 'y'
    0x1D,               // 'z'
    0x00,               // '{' AltGr+Shift+8 — pressRaw ile (badusb_send_char)
    0x64|KBD_ALTGR,     // '|' AltGr+< (0x64)
    0x00,               // '}' AltGr+Shift+9 — pressRaw ile (badusb_send_char)
    0x00,               // '~' — TR-Q'da yok
    0x00,               // DEL
};

// USB HID klavyeyi seçilen layout ile başlat.
// layout değişirse klavye yeniden başlatılır (USB.begin() sadece bir kez çağrılır).
static void badusb_ensure_init(BadUSBLayout layout = BadUSBLayout::en_US) {
    if (!g_usbHIDInited) {
        // İlk başlatma
        if (layout == BadUSBLayout::tr_Q) {
            g_usbKbd.begin(KeyboardLayout_tr_Q);
        } else {
            g_usbKbd.begin(); // en_US (varsayılan US layout)
        }
        USB.begin();
        delay(1500);
        g_usbHIDInited = true;
        g_usbLayout    = layout;
    }
    // NOT: Zaten başlatılmışsa layout'u DEĞİŞTİRME.
    // Payload fonksiyonları bu fonksiyonu argümansız (default=en_US) çağırır.
    // Kullanıcı menüde TR-Q seçtiyse g_usbLayout=tr_Q olmuştur — bunu koruyoruz.
    // Layout değişikliği sadece menüden badusb_run() içinde g_usbHIDInited=false
    // yapılarak yapılmalıdır.
}

// { } ve ~ için ALTGR+SHIFT combo — asciimap desteklemediğinden pressRaw ile gönderilir.
// TR-Q layout'ta özel combo gerekir; en_US'de doğrudan print() yeterlidir.
// Tek tus - pressRaw ile layout bagimsiz (ve Ctrl+Alt destegi)
static void badusb_key(uint8_t modifier, uint8_t keycode) {
    if (modifier & 0x01) g_usbKbd.pressRaw(0xE0); // L-Ctrl
    if (modifier & 0x02) g_usbKbd.pressRaw(0xE1); // L-Shift
    if (modifier & 0x04) g_usbKbd.pressRaw(0xE2); // L-Alt
    if (modifier & 0x08) g_usbKbd.pressRaw(0xE3); // L-GUI
    if (modifier & 0x40) g_usbKbd.pressRaw(0xE6); // R-Alt (AltGr)
    g_usbKbd.pressRaw(keycode);
    delay(15);
    g_usbKbd.releaseAll();
    delay(15);
}

// Karakter gonderici - TR_Q icin ozel ASCII_HID haritasini kullanir
static void badusb_send_char(char c) {
    if (g_usbLayout == BadUSBLayout::tr_Q) {
        if ((uint8_t)c < 128) {
            badusb_key(ASCII_HID[(uint8_t)c][0], ASCII_HID[(uint8_t)c][1]);
        }
    } else {
        // en_US layout: tum ASCII karakterler dogrudan print ile calisir
        g_usbKbd.print(c);
        delay(8);
    }
}

// String gonder
static void badusb_type(const char* str) {
    while (*str) { badusb_send_char(*str++); }
    delay(20);
}

static void badusb_type_ln(const char* str) {
    badusb_type(str);
    badusb_send_char('\n');
    delay(200);
}


