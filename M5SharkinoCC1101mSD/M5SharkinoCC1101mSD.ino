}

// ─── SD Menü: log menüsü ─────────────────────────────────
// ─── BadUSB SD Script: /scripts/*.txt dosyasını satır satır çalıştır ─
static void sd_badusb_script_run() {
    if (!g_sdInited) { dispBannerErr("SD not mounted!"); return; }

    // /scripts klasöründeki .txt dosyalarını listele
    File sdir = SD.open("/scripts");
    if (!sdir || !sdir.isDirectory()) { dispBannerErr("/scripts missing"); return; }

    std::vector<String> scripts;
    File se = sdir.openNextFile();
    while (se) {
        String n = String(se.name());
        int sl = n.lastIndexOf('/');
        if (sl >= 0) n = n.substring(sl + 1);
        String ext = "";
        int dp = n.lastIndexOf('.');
        if (dp >= 0) { ext = n.substring(dp + 1); ext.toLowerCase(); }
        if (ext == "txt") scripts.push_back(n);
        se = sdir.openNextFile();
    }
    sdir.close();

    if (scripts.empty()) {
        dispBannerWarn("No .txt in /scripts");
        return;
    }

    // Script seç
    OptionList sopts;
    for (auto& s : scripts) sopts.push_back({s.substring(0, 20), [](){}});
    sopts.push_back({"Back", [](){}});
    int ssel = loopOptions(sopts, "SD Scripts");
    if (ssel < 0 || ssel == (int)sopts.size() - 1) return;

    String scriptPath = "/scripts/" + scripts[ssel];

    // Layout seçimi
    OptionList lOpts = {
        {"en_US", [](){}},
        {"TR-Q",  [](){}},
        {"Back",  [](){}},
    };
    int lSel = loopOptions(lOpts, "Script Layout");
    if (lSel < 0 || lSel == 2) return;
    BadUSBLayout layout = (lSel == 1) ? BadUSBLayout::tr_Q : BadUSBLayout::en_US;
    badusb_ensure_init(layout);

    // Geri sayım
    for (int8_t i = 3; i > 0; i--) {
        dispClear(); dispStatusBar("SD Script");
        dispText(0, 14, scripts[ssel].substring(0, 20));
        dispCenter(30, String(i) + "...", 2);
        dispText(0, 54, "[LONG] cancel");
        dispCommit();
        delay(1000);
        if (readButtonLong()) { dispBannerWarn("Cancelled"); return; }
    }

    // Script dosyasını satır satır oku ve çalıştır
    File sf = SD.open(scriptPath.c_str(), FILE_READ);
    if (!sf) { dispBannerErr("Script open fail"); return; }

    uint32_t lineNum = 0;
    while (sf.available()) {
        String line = sf.readStringUntil('\n');
        line.trim();
        lineNum++;

        if (line.length() == 0) continue;           // Boş satır atla
        if (line.startsWith("//")) continue;         // Yorum satırı atla
        if (line.startsWith("#"))  continue;         // Hash yorum

        // Komut ayrıştır: DELAY, STRING, ENTER, SPECIAL
        if (line.startsWith("DELAY ")) {
            uint32_t ms = line.substring(6).toInt();
            delay(ms);
        } else if (line.startsWith("STRING ")) {
            String txt = line.substring(7);
            badusb_type(txt.c_str());
        } else if (line == "ENTER") {
            badusb_enter();
        } else if (line == "GUI" || line == "WINDOWS") {
            badusb_gui();
        } else if (line == "ESC") {
            badusb_esc();
        } else if (line.startsWith("GUI ")) {
            // GUI + tek karakter (örn: GUI r)
            char c = line.charAt(4);
            g_usbKbd.press(KEY_LEFT_GUI);
            g_usbKbd.press(c);
            delay(80);
            g_usbKbd.releaseAll();
        } else if (line.startsWith("CTRL_ALT ")) {
            char c = line.charAt(9);
            g_usbKbd.press(KEY_LEFT_CTRL);
            g_usbKbd.press(KEY_LEFT_ALT);
            g_usbKbd.press(c);
            delay(80);
            g_usbKbd.releaseAll();
        } else if (line.startsWith("CTRL ")) {
            char c = line.charAt(5);
            g_usbKbd.press(KEY_LEFT_CTRL);
            g_usbKbd.press(c);
            delay(80);
            g_usbKbd.releaseAll();
        } else if (line.startsWith("ALT ")) {
            char c = line.charAt(4);
            g_usbKbd.press(KEY_LEFT_ALT);
            g_usbKbd.press(c);
            delay(80);
            g_usbKbd.releaseAll();
        } else {
            // Tanınmayan komut: STRING olarak gönder
            badusb_type(line.c_str());
        }

        // İlerleme göster (her 5 satırda bir)
        if (lineNum % 5 == 0) {
            dispClear(); dispStatusBar("SD Script");
            dispText(0, 14, scripts[ssel].substring(0, 20));
            dispText(0, 28, "Line: " + String(lineNum));
            dispText(0, 42, "Last: " + line.substring(0, 18));
            dispCommit();
        }
        if (readButtonLong()) { sf.close(); dispBannerWarn("Aborted L:" + String(lineNum)); return; }
    }
    sf.close();
    sdSaveBadUSB("SD_Script:" + scripts[ssel], "lines=" + String(lineNum));
    dispBannerOK("Done! " + String(lineNum) + " lines");
}

static void sd_menu_run() {
    if (!g_sdInited) {
        dispBannerErr("SD Mount failed!");
        return;
    }
    OptionList opts = {
        {"File Manager",  []() { sd_file_manager_run(); }},
        {"SD Stats",      []() { sd_show_stats(); }},
        {"BadUSB Script", []() { sd_badusb_script_run(); }},
        {"SD Info",       []() {
            uint64_t tot = SD.totalBytes(), used = SD.usedBytes();
            uint8_t pct = (uint8_t)((used * 100ULL) / (tot ? tot : 1));
            dispClear(); dispStatusBar("SD Card Info");
            dispText(0, 13, "Total: " + String((uint32_t)(tot / 1024)) + " KB");
            dispText(0, 23, "Used:  " + String((uint32_t)(used / 1024)) + " KB");
            dispText(0, 33, "Free:  " + String((uint32_t)((tot - used) / 1024)) + " KB");
            dispText(0, 43, "Fill:  " + String(pct) + "%");
            dispText(0, 53, "CS=GPIO" + String(PIN_SD_CS));
            dispCommit();
            while (!readButton()) { potApplyBrightness(); delay(50); }
        }},
        {"Back",          []() { backToMenu(); }},
    };
    while (!g_returnToMenu) {
