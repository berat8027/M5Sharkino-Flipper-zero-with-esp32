// ─── Sub-GHz (CC1101) animasyonu: Flipper SubGhz dalgalanma ──
// Flipper: assets/icons/SubGhz/Scanning animasyonları
// Yayılan radyo dalgaları + frekans görüntüsü
static void animDrawSubGHzFrame(uint8_t frame, int16_t cx, int16_t cy) {
    // Anten gövdesi
    display.drawFastVLine(cx, cy - 10, 12, SSD1306_WHITE);
    display.drawFastHLine(cx - 4, cy + 2, 9, SSD1306_WHITE);
    display.drawFastVLine(cx - 4, cy + 2, 4, SSD1306_WHITE);
    display.drawFastVLine(cx + 4, cy + 2, 4, SSD1306_WHITE);

    // Yayılan dalgalar (frame bazlı genişleme)
    uint8_t wavePhase = frame % 6;
    for (int8_t w = 0; w < 3; w++) {
        int8_t wf = (wavePhase + w * 2) % 6;
        uint8_t r = 8 + wf * 3;
        // Sol yarı yay (dalgalanma)
        for (int a = 100; a <= 260; a += 5) {
            float rad = a * 3.14159f / 180.0f;
            int px = cx + (int)(r * cosf(rad));
            int py = cy - 4 + (int)(r * sinf(rad));
            if (px >= 0 && px < OLED_W && py >= 0 && py < OLED_H)
                display.drawPixel(px, py, SSD1306_WHITE);
        }
    }
}

