            display.drawLine(x+3,y+12,x+7,y+6,SSD1306_BLACK);
            display.drawLine(x+7,y+6,x+11,y+12,SSD1306_BLACK);
            display.fillCircle(x+7,y+13,2,SSD1306_BLACK);
            break;
        case BannerType::BLE:
            display.drawLine(x+7,y+1, x+7,y+13,SSD1306_BLACK);
            display.drawLine(x+7,y+1, x+12,y+5,SSD1306_BLACK);
