// ─── Flipper font karakter çizici ────────────────────────
// x,y: sol üst köşe (piksel).  col: SSD1306_WHITE/BLACK.
// Her karakter 5 piksel geniş, 7 piksel yüksek + 1 piksel sağ boşluk.
static void drawFlipperChar(int16_t x, int16_t y, char c, uint16_t col) {
    if (c < 0x20 || c > 0x7E) c = 0x20;
    const uint8_t* glyph = FLIPPER_FONT5x7[c - 0x20];
    for (uint8_t col_i = 0; col_i < 5; col_i++) {
        uint8_t line = pgm_read_byte(glyph + col_i);
        for (uint8_t row = 0; row < 7; row++) {
            if (line & (1 << row))
                display.drawPixel(x + col_i, y + row, col);
        }
    }
}

// ─── Flipper font string çizici ──────────────────────────
// wrap: false=kesmez, true=bir sonraki satıra geçer (sınır: OLED_W)
static void drawFlipperStr(int16_t x, int16_t y, const String& s,
                            uint16_t col = SSD1306_WHITE, bool wrap = false) {
    int16_t cx = x;
    for (uint16_t i = 0; i < s.length(); i++) {
        if (wrap && cx + 6 > OLED_W) { cx = x; y += 9; }
        drawFlipperChar(cx, y, s[i], col);
        cx += 6;  // 5px glyph + 1px boşluk
    }
}

// ─── Flipper font string genişliği (piksel) ──────────────
static int16_t flipperStrWidth(const String& s) {
    return (int16_t)(s.length() * 6);
}

