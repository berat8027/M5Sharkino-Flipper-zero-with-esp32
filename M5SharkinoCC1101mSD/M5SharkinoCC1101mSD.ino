// BLEDevInfo struct dosya başında (forward declarations bölümünde) tanımlandı.
static std::vector<BLEDevInfo> g_bleResults;

class BLEScanCB : public BLEAdvertisedDeviceCallbacks {
public:
    void onResult(BLEAdvertisedDevice dev) override {
        BLEDevInfo info;
        info.addr    = dev.getAddress().toString().c_str();
        info.rssi    = dev.getRSSI();
        info.hasName = dev.haveName();
        info.name    = info.hasName ? dev.getName().c_str() : "";
        info.hasManuf = dev.haveManufacturerData();
        if (info.hasManuf && dev.getManufacturerData().length() >= 2) {
            info.manufId[0] = (uint8_t)dev.getManufacturerData()[0];
            info.manufId[1] = (uint8_t)dev.getManufacturerData()[1];
        }
        if (dev.haveServiceUUID()) {
            info.serviceUUIDs = dev.getServiceUUID().toString().c_str();
        }
        g_bleResults.push_back(info);
    }
};

static const char* bleManufName(uint8_t id0, uint8_t id1) {
    uint16_t id = ((uint16_t)id1 << 8) | id0;
    switch (id) {
        case 0x004C: return "Apple";
        case 0x0075: return "Samsung";
        case 0x00E0: return "Google";
        case 0x0059: return "Nordic";
        case 0x0006: return "Microsoft";
        case 0x000F: return "Broadcom";
        default:     return "Unknown";
    }
}

static void ble_scan_run() {
    showOpScreen(FzOpIcon::BLEPairing, "BLE Scanning...", 1200);
    g_bleResults.clear();
    // Önceki oturum temizle
    bleAdvDeinit();
    animBLEScanning();  // Flipper Zero BLE animasyonu

    BLEDevice::init("M5Sharkino");
    BLEScan* pScan = BLEDevice::getScan();
    BLEScanCB* cb = new BLEScanCB();
    pScan->setAdvertisedDeviceCallbacks(cb, false);
    pScan->setActiveScan(true);
    pScan->setInterval(100);
    pScan->setWindow(99);
    pScan->start(BLE_SCAN_SEC, false);

    for (auto& d : g_bleResults)
        logPush("[BLE] " + (d.hasName ? d.name : "[noname]") + " " + d.addr + " " + String(d.rssi) + "dB");

    if (g_bleResults.empty()) {
        dispBanner("No BLE devices");
        delete cb;
        BLEDevice::deinit(true); delay(300);
        return;
    }
    g_xpBleCnt++;
    xpAdd(XP_PER_BLE_SCAN);

    while (true) {
        OptionList devs;
        for (auto& d : g_bleResults) {
            String label = (d.hasName ? d.name : d.addr.substring(12)) + " " + String(d.rssi) + "dB";
            devs.push_back({label, [](){}});
        }
        devs.push_back({"Back", [](){}});

        int sel = loopOptions(devs, "BLE (" + String(g_bleResults.size()) + ")");
        if (sel < 0 || sel >= (int)g_bleResults.size()) break;

        auto& d = g_bleResults[sel];
        dispClear();
        dispStatusBar("BLE Device");
        dispText(0, 12, "Name: " + (d.hasName ? d.name : "[none]"));
        dispText(0, 22, "Addr: " + d.addr);
        dispText(0, 32, "RSSI: " + String(d.rssi) + " dBm");
        if (d.hasManuf)
            dispText(0, 42, "Mfr: " + String(bleManufName(d.manufId[0], d.manufId[1])));
        if (!d.serviceUUIDs.isEmpty())
            dispText(0, 52, "SVC: " + d.serviceUUIDs.substring(0,18));
        else
            dispText(0, 52, "[BTN] back");
        dispCommit();
        while (!readButton()) delay(50);
    }
    pScan->clearResults();
    delete cb;
    BLEDevice::deinit(true); delay(300);
}

// ─── BLE Advertising helpers ──────────────────────────────

static bool         g_bleAdvInited = false;
static BLEAdvertising* g_pAdvHandle = nullptr;

static void bleAdvEnsureInit() {
    if (!g_bleAdvInited) {
        BLEDevice::init("M5Sharkino");
        g_pAdvHandle   = BLEDevice::getAdvertising();
        g_bleAdvInited = true;
    }
}

static void bleAdvDeinit() {
    if (g_bleAdvInited) {
        if (g_pAdvHandle) g_pAdvHandle->stop();
        BLEDevice::deinit(true); delay(300);
        g_bleAdvInited = false;
        g_pAdvHandle   = nullptr;
    }
}

