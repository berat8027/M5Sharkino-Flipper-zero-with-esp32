// ─── Flipper tarzı gelişmiş splash animasyonu ────────────
// Aşama 1: köşeden genişleyen çerçeve (flipperCornerFrame zaten var)
// Aşama 2: ortada ikon belirme (fade-in simülasyonu — blink ile)
// Aşama 3: cihaz adı Flipper font ile ortada yazılır
// Bu fonksiyon showSplash() yerine veya ek olarak çağrılabilir.
static void flipperSplashFull() {
    // ── Aşama 1: köşe çerçeve animasyonu (4 adım) ─────
    for (int i = 0; i <= 4; i++) {
        int margin = (4 - i) * 14;
        dispClear();
        display.drawRoundRect(margin, margin,
                              OLED_W - 2*margin,
                              OLED_H - 2*margin, 3, SSD1306_WHITE);
        dispCommit();
        delay(45);
    }

    // ── Aşama 2: 16×16 Sub-GHz ikonu ortada beliriyor ─
    int iconX = (OLED_W - 16) / 2;
    int iconY = 14;
    for (int blink = 0; blink < 3; blink++) {
        dispClear();
        display.drawRoundRect(0, 0, OLED_W, OLED_H, 3, SSD1306_WHITE);
        if (blink % 2 == 0) {
            drawBitmap16(iconX, iconY, FLIPPER_ICO16_SUBGHZ, SSD1306_WHITE);
        }
        dispCommit();
        delay(120);
    }

    // ── Aşama 3: ikon sabit + cihaz adı Flipper font ile ─
    dispClear();
    display.drawRoundRect(0, 0, OLED_W, OLED_H, 3, SSD1306_WHITE);
    drawBitmap16(iconX, iconY, FLIPPER_ICO16_SUBGHZ, SSD1306_WHITE);
    // "M5SHARKINO" Flipper font ile ortalı
    String title = "M5SHARKINO";
    int16_t tw = flipperStrWidth(title);
    drawFlipperStr((OLED_W - tw) / 2, 38, title, SSD1306_WHITE);
    // "by Beroxx" küçük, Adafruit font ile
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(34, 49);
    display.print("by Beroxx");
    dispCommit();
    delay(800);

    // ── Aşama 4: çerçeve içe kapanıyor (ters animasyon) ─
    for (int i = 0; i <= 3; i++) {
        int margin = i * 8;
        dispClear();
        display.drawRoundRect(0, 0, OLED_W, OLED_H, 3, SSD1306_WHITE);
        display.fillRect(margin, margin,
                         OLED_W - 2*margin,
                         OLED_H - 2*margin, SSD1306_BLACK);
        dispCommit();
        delay(35);
    }
    dispClear();
    dispCommit();
}

// ─── Flipper menü: scrollbar çizici ─────────────────────
// Sağ kenarda ince Flipper tarzı scroll indicator.
// visStart: görünen ilk item index, total: toplam item sayısı,
// visible: ekranda görünen item sayısı.
static void flipperDrawScrollbar(uint8_t visStart, uint8_t total, uint8_t visible) {
    if (total <= visible) return;
    uint8_t sbH = OLED_H - 12;  // status bar altında kalan alan
    uint8_t trackH = sbH;
    uint8_t thumbH = max((uint8_t)4, (uint8_t)(trackH * visible / total));
    uint8_t thumbY = 11 + (trackH - thumbH) * visStart / (total - visible);
    // Track
    display.drawFastVLine(OLED_W - 2, 11, trackH, SSD1306_WHITE);
    // Thumb
    display.fillRect(OLED_W - 3, thumbY, 3, thumbH, SSD1306_WHITE);
}

// ─── Flipper tarzı tam menü çizici ───────────────────────
// loopOptions()'daki renderOptionList'in üstüne bindirilen katman;
// mevcut loopOptions() mimarisini kırmadan, sadece görsel zenginleştirme.
// Kullanım: renderFlipperMenu(opts, selIdx, visStart, title) çağır.
static void renderFlipperMenu(const OptionList& opts, int selIdx,
                               int visStart, const String& title) {
    dispClear();
    dispFlipperStatusBar(title);

    // Item sayacı — status bar sağına siyah yazı
    display.setTextColor(SSD1306_BLACK);
    display.setTextSize(1);
    String pg = String(selIdx + 1) + "/" + String((int)opts.size());
    display.setCursor(OLED_W - (int)pg.length() * 6 - 2, 2);
    display.print(pg);
    display.setTextColor(SSD1306_WHITE);

    static constexpr int LIST_TOP = 12;
    static constexpr int ITEM_H   = 10;
    static constexpr int VISIBLE  = 4;
    static constexpr int LIST_BOT = LIST_TOP + VISIBLE * ITEM_H; // 52
    static constexpr int TEXT_X   = 4;

    for (int i = 0; i < VISIBLE && (visStart + i) < (int)opts.size(); i++) {
        int idx   = visStart + i;
        int y     = LIST_TOP + i * ITEM_H;
        bool isSel = (idx == selIdx);

        String lbl = opts[idx].label;

        if (isSel) {
            // Seçili: tam genişlik beyaz yuvarlak pill
            display.fillRoundRect(0, y, OLED_W - 4, ITEM_H, 2, SSD1306_WHITE);
            display.setTextColor(SSD1306_BLACK);
            display.setTextSize(1);
            if ((int)lbl.length() > 17) lbl = lbl.substring(0, 16) + "~";
            display.setCursor(TEXT_X, y + 1);
            display.print(lbl);
            // Dolu üçgen ok (Flipper sürümü)
            display.fillTriangle(OLED_W - 6, y + 2,
                                 OLED_W - 6, y + 7,
                                 OLED_W - 3, y + 4,
                                 SSD1306_BLACK);
            display.setTextColor(SSD1306_WHITE);
        } else {
            display.setTextColor(SSD1306_WHITE);
            display.setTextSize(1);
            if ((int)lbl.length() > 18) lbl = lbl.substring(0, 17) + "~";
            display.setCursor(TEXT_X, y + 1);
            display.print(lbl);
        }
    }

    // Scrollbar
    if ((int)opts.size() > VISIBLE) {
        int trackH = LIST_BOT - LIST_TOP;
        int sbH    = max(4, trackH * VISIBLE / (int)opts.size());
        int sbY    = LIST_TOP + (trackH - sbH) * visStart / max(1, (int)opts.size() - VISIBLE);
        display.drawFastVLine(OLED_W - 2, LIST_TOP, trackH, SSD1306_WHITE);
        display.fillRect(OLED_W - 3, sbY, 3, sbH, SSD1306_WHITE);
    }

    // Alt hint bar: solid beyaz şerit — Flipper Zero
    display.fillRect(0, 54, OLED_W, 10, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setTextSize(1);
    display.fillTriangle(3, 56, 3, 62, 1, 59, SSD1306_BLACK);
    display.setCursor(6,  56); display.print("Back");
    display.setCursor(88, 56); display.print("OK");
    display.fillTriangle(OLED_W-4, 56, OLED_W-4, 62, OLED_W-2, 59, SSD1306_BLACK);
    display.setTextColor(SSD1306_WHITE);

    dispCommit();
}

