static void ir_tv_library_run() {
    ir_init();
    OptionList brandOpts;
    for (uint8_t i = 0; i < IR_TV_LIB_COUNT; i++) {
        uint8_t idx = i;
        brandOpts.push_back({String(IR_TV_LIBRARY[i].brand), [idx]() {
            const IRLibEntry& e = IR_TV_LIBRARY[idx];
            OptionList cmdOpts = {
                {"Guc (Power)", [&e]() { ir_send_lib_cmd(e, e.powerCmd);  buzzOK(); dispBannerOK("Power TX!"); }},
                {"Vol+",        [&e]() { ir_send_lib_cmd(e, e.volUpCmd);  buzzOK(); dispBannerOK("Vol+ TX!"); }},
                {"Vol-",        [&e]() { ir_send_lib_cmd(e, e.volDnCmd);  buzzOK(); dispBannerOK("Vol- TX!"); }},
                {"Kanal+",      [&e]() { ir_send_lib_cmd(e, e.chanUpCmd); buzzOK(); dispBannerOK("CH+ TX!"); }},
                {"Kanal-",      [&e]() { ir_send_lib_cmd(e, e.chanDnCmd); buzzOK(); dispBannerOK("CH- TX!"); }},
                {"Mute",        [&e]() { ir_send_lib_cmd(e, e.muteCmd);   buzzOK(); dispBannerOK("Mute TX!"); }},
                {"Back",        [](){}},
            };
            int cs = loopOptions(cmdOpts, String(e.brand));
            if (cs >= 0 && cs < (int)cmdOpts.size()) cmdOpts[cs].action();
        }});
    }
    brandOpts.push_back({"Back", [](){}});
    int bsel = loopOptions(brandOpts, "TV Kutuphanesi");
    if (bsel >= 0 && bsel < (int)brandOpts.size()) brandOpts[bsel].action();
}

