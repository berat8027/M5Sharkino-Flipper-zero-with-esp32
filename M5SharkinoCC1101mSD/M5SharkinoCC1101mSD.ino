static void wifi_channel_hopper_run() {
    wifiInitForRawTx();
    esp_wifi_set_promiscuous_rx_cb(promiscCallback);

    uint32_t chPkts[14] = {0};
    uint32_t chBeacon[14] = {0};
    uint32_t prevTotal = 0;
    uint8_t  curCh = 1;

    while (!readButtonLong()) {
        for (uint8_t ch = 1; ch <= 13; ch++) {
            g_sniffPkts   = 0;
            g_sniffBeacon = 0;
            esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);
            delay(g_cfg.scanDwellMs);
            chPkts[ch]   += g_sniffPkts;
            chBeacon[ch] += g_sniffBeacon;
            curCh = ch;

            dispClear();
            dispStatusBar("Ch Hopper");
            // Simple bar chart
            for (uint8_t c = 1; c <= 13; c++) {
                uint8_t barH = min((uint32_t)20, chPkts[c] / 5);
                uint8_t bx   = (c - 1) * 9 + 2;
                display.fillRect(bx, 54 - barH, 7, barH, SSD1306_WHITE);
                if (c == ch) display.drawRect(bx - 1, 53 - barH, 9, barH + 2, SSD1306_WHITE);
            }
            dispText(0, 56, "Ch:" + String(ch) + " [LONG]done");
            dispCommit();
        }
    }
    esp_wifi_set_promiscuous(false);
    esp_wifi_set_promiscuous_rx_cb(nullptr);
    // Find busiest channel
    uint8_t bestCh = 1; uint32_t bestPkts = 0;
    for (uint8_t c = 1; c <= 13; c++) {
        if (chPkts[c] > bestPkts) { bestPkts = chPkts[c]; bestCh = c; }
    }
    WiFi.mode(WIFI_OFF);
    logPush("[CHOP] busiest ch=" + String(bestCh) + " pkts=" + String(bestPkts));
    dispBanner("Busiest: Ch " + String(bestCh));
}

// ─── WPS IE sniffer state ────────────────────────────────

struct WPSResult {
    String  ssid;
    String  bssid;
    int32_t rssi;
    uint8_t channel;
    bool    wpsFound;
    uint8_t wpsVersion;    // 0x10=1.0, 0x20=2.0
    uint8_t wpsState;      // 0x01=unconfigured, 0x02=configured
    bool    wpsLocked;     // AP Setup Locked
    String  wpsDeviceName;
    String  wpsManufacturer;
};

static std::vector<WPSResult> g_wpsResults;

static void wpsBeaconCallback(void* buf, wifi_promiscuous_pkt_type_t type) {
    if (type != WIFI_PKT_MGMT) return;
    wifi_promiscuous_pkt_t* pkt = (wifi_promiscuous_pkt_t*)buf;
    if (!pkt || pkt->rx_ctrl.sig_len < 36) return;
    uint8_t* payload = pkt->payload;

    // Sadece Beacon frame (fc=0x80) ve Probe Response (fc=0x50)
    if (payload[0] != 0x80 && payload[0] != 0x50) return;

    // BSSID = addr3 (offset 16)
    char bssid[18];
    snprintf(bssid, sizeof(bssid), "%02X:%02X:%02X:%02X:%02X:%02X",
             payload[16],payload[17],payload[18],payload[19],payload[20],payload[21]);

    // Beacon body: 24 byte hdr + 12 byte fixed params = offset 36
    int off = 36;
    int end = (int)pkt->rx_ctrl.sig_len;
    String ssid = "";

    // Parse IEs
    bool    wpsFound    = false;
    uint8_t wpsVersion  = 0;
    uint8_t wpsState    = 0;
    bool    wpsLocked   = false;
    String  devName     = "";
    String  manuf       = "";

    while (off + 2 <= end) {
        uint8_t tagId  = payload[off];
        uint8_t tagLen = payload[off+1];
        if (off + 2 + tagLen > end) break;

        if (tagId == 0 && tagLen > 0 && tagLen <= 32) {
            // SSID
            for (uint8_t i = 0; i < tagLen; i++) ssid += (char)payload[off+2+i];
        }
        else if (tagId == 221 && tagLen >= 4) {
            // Vendor Specific IE
            // WPS OUI: 00:50:F2:04
            if (payload[off+2] == 0x00 && payload[off+3] == 0x50 &&
                payload[off+4] == 0xF2 && payload[off+5] == 0x04) {
                wpsFound = true;
                // Parse WPS attributes (TLV)
                int woff = off + 6;
                int wend = off + 2 + tagLen;
                while (woff + 4 <= wend) {
                    uint16_t attrType = ((uint16_t)payload[woff] << 8) | payload[woff+1];
                    uint16_t attrLen  = ((uint16_t)payload[woff+2] << 8) | payload[woff+3];
                    woff += 4;
                    if (woff + attrLen > wend) break;
                    switch (attrType) {
                        case 0x104A: // Version
                            if (attrLen >= 1) wpsVersion = payload[woff];
                            break;
                        case 0x1044: // WiFi Protected Setup State
                            if (attrLen >= 1) wpsState = payload[woff];
                            break;
                        case 0x1057: // AP Setup Locked
                            if (attrLen >= 1) wpsLocked = (payload[woff] != 0);
                            break;
                        case 0x1011: // Device Name (max 32 chars)
                            devName = "";
                            for (uint16_t i = 0; i < attrLen && i < 20; i++)
                                if (payload[woff+i] >= 0x20) devName += (char)payload[woff+i];
                            break;
                        case 0x1021: // Manufacturer
                            manuf = "";
                            for (uint16_t i = 0; i < attrLen && i < 16; i++)
                                if (payload[woff+i] >= 0x20) manuf += (char)payload[woff+i];
                            break;
                    }
                    woff += attrLen;
                }
            }
        }
        off += 2 + tagLen;
    }

    if (!wpsFound) return;

    // Deduplicate by BSSID
    for (auto& r : g_wpsResults)
        if (r.bssid == String(bssid)) return;

    if (g_wpsResults.size() >= 40) return;
    g_wpsResults.push_back({ssid, String(bssid),
                             (int32_t)pkt->rx_ctrl.rssi,
                             (uint8_t)pkt->rx_ctrl.channel,
                             true, wpsVersion, wpsState,
                             wpsLocked, devName, manuf});
}

static void wifi_wps_scan_run() {
    g_wpsResults.clear();

    wifiInitForRawTx();
    esp_wifi_set_promiscuous_rx_cb(wpsBeaconCallback);

    dispClear(); dispStatusBar("WPS Scan (IE)");
    dispText(0, 18, "Sniffing beacons...");
    dispText(0, 30, "Parsing WPS IEs");
    dispText(0, 42, "All 13 channels");
    dispText(0, 54, "[LONG] stop");
    dispCommit();

    uint8_t ch = 1;
    uint32_t lastSwitch = millis();
    uint32_t lastDraw   = millis();
    uint32_t scanStart  = millis();

    // 15 saniye tara veya LONG basılana kadar
    while (!readButtonLong() && (millis() - scanStart < 15000)) {
        if (millis() - lastSwitch > 600) {
            ch = (ch % 13) + 1;
            esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);
            lastSwitch = millis();
        }
        if (millis() - lastDraw > 300) {
            lastDraw = millis();
            dispClear(); dispStatusBar("WPS Scan");
            dispText(0, 14, "Ch: " + String(ch) + "/13");
            dispText(0, 26, "WPS APs: " + String(g_wpsResults.size()));
            uint32_t elapsed = (millis() - scanStart) / 1000;
            dispText(0, 38, "Time: " + String(elapsed) + "s / 15s");
            if (!g_wpsResults.empty())
                dispText(0, 50, ">" + g_wpsResults.back().ssid.substring(0,18));
            dispCommit();
        }
        delay(20);
    }

    esp_wifi_set_promiscuous(false);
    esp_wifi_set_promiscuous_rx_cb(nullptr);
    WiFi.mode(WIFI_OFF);

    if (g_wpsResults.empty()) {
        dispBannerWarn("No WPS APs found");
        return;
    }

    // Liste göster
    while (true) {
        OptionList list;
        for (auto& r : g_wpsResults) {
            String lbl = (r.ssid.isEmpty() ? "[hidden]" : r.ssid);
            String stateStr = (r.wpsState == 0x01) ? "!UNCFG" :
                              (r.wpsState == 0x02) ? "CFG"    : "?";
            lbl += " [" + stateStr + "]";
            list.push_back({lbl, [](){}});
        }
        list.push_back({"Back", [](){}});

        int sel = loopOptions(list, "WPS (" + String(g_wpsResults.size()) + ")");
        if (sel < 0 || sel >= (int)g_wpsResults.size()) break;

        WPSResult& r = g_wpsResults[sel];
        dispClear(); dispStatusBar("WPS Detail");
        dispText(0, 12, (r.ssid.isEmpty() ? "[hidden]" : r.ssid).substring(0,20));
        dispText(0, 22, r.bssid);
        String ver = (r.wpsVersion == 0x20) ? "2.0" :
                     (r.wpsVersion == 0x10) ? "1.0" : "?";
        dispText(0, 32, "WPS v" + ver + " Ch:" + String(r.channel));
        String state = (r.wpsState == 0x01) ? "UNCONFIGURED(!)" :
                       (r.wpsState == 0x02) ? "Configured"       : "Unknown";
        dispText(0, 42, "State: " + state);
        String lockStr = r.wpsLocked ? "LOCKED" : "Open";
        if (!r.wpsDeviceName.isEmpty())
            dispText(0, 52, r.wpsDeviceName + " " + lockStr);
        else
            dispText(0, 52, "Lock: " + lockStr);
        dispCommit();
        logPush("[WPS] " + r.ssid + " v" + ver + " state=" + String(r.wpsState) +
                " locked=" + String(r.wpsLocked));
        while (!readButton()) delay(50);
    }
}

// ─── Evil Portal ──────────────────────────────────────────

static WebServer*   g_webServer = nullptr;
