// ─── IR Brute Force ─────────────────────────────────────────────────
static void ir_brute_force_run() {
    ir_init();
    OptionList protoOpts = {
        {"NEC",     [](){}},
        {"SONY",    [](){}},
        {"SAMSUNG", [](){}},
        {"RC5",     [](){}},
        {"RC6",     [](){}},
        {"JVC",     [](){}},
        {"LG",      [](){}},
        {"Back",    [](){}},
    };
    int psel = loopOptions(protoOpts, "Protokol Sec");
    if (psel < 0 || psel >= 7) return;
    String protocols[] = {"NEC","SONY","SAMSUNG","RC5","RC6","JVC","LG"};
    decode_type_t protoType = ir_proto_from_name(protocols[psel]);

    uint8_t addr = 0x00;
    while (true) {
        dispClear();
        dispStatusBar("IR BruteForce");
        dispText(0, 14, "Protokol: " + protocols[psel]);
        char buf[24]; snprintf(buf, sizeof(buf), "Adres: 0x%02X", addr);
        dispText(0, 26, String(buf));
        dispText(0, 38, "J-UP=+16 DN=-16");
        dispText(0, 50, "[BTN]=BASLA");
        dispCommit();
        JoyDir d = readJoystick();
        if (d == JoyDir::UP)   addr += 16;
        else if (d == JoyDir::DOWN) addr -= 16;
        if (readButton()) break;
        delay(120);
    }

    dispClear();
    dispStatusBar("IR BruteForce");
    dispText(0, 14, "Brute Force aktif");
    dispText(0, 26, protocols[psel] + "  Addr:0x" + String(addr, HEX));
    dispText(0, 50, "[BTN]=dur");
    dispCommit();
    delay(300);

    for (uint16_t cmd = 0; cmd <= 0xFF && !readButton(); cmd++) {
        uint64_t payload = ((uint64_t)addr << 8) | cmd;
        switch (protoType) {
            case decode_type_t::NEC:     g_irSend.sendNEC(payload, 32); break;
            case decode_type_t::SONY:    g_irSend.sendSony(payload, 20, 2); break;
            case decode_type_t::SAMSUNG: g_irSend.sendSAMSUNG(payload, 32); break;
            case decode_type_t::RC5:     g_irSend.sendRC5(payload, 12); break;
            case decode_type_t::RC6:     g_irSend.sendRC6(payload, 20); break;
            case decode_type_t::JVC:     g_irSend.sendJVC(payload, 16); break;
            case decode_type_t::LG:      g_irSend.sendLG(payload, 28); break;
            default:                     g_irSend.sendNEC(payload, 32); break;
        }
        if (cmd % 16 == 0) {
            dispText(0, 38, "Cmd: 0x" + String((uint8_t)cmd, HEX) + "/0xFF");
            dispProgress("IR BF", "Taranıyor...", (cmd * 100) / 255);
            dispCommit();
        }
        delay(100);
    }
    dispBannerOK("Brute Force bitti");
}

// ─── Flipper .ir dosyasını gerçekten TX et ──────────────────────────
static void ir_flipper_file_tx_run() {
    ir_init();
    if (!g_sdInited) { dispBannerErr("SD Kart yok"); return; }
    File dir = SD.open("/flipper/ir");
    if (!dir) { dispBannerErr("/flipper/ir bulunamadi"); return; }

    OptionList fileOpts;
    File entry = dir.openNextFile();
    while (entry) {
        if (!entry.isDirectory()) {
            String fname = String(entry.name());
            if (fname.endsWith(".ir") || fname.endsWith(".IR")) {
                String fullPath = "/flipper/ir/" + fname;
                fileOpts.push_back({fname.substring(0, 17), [fullPath]() {
                    FlipperIRFile irFile = flipper_parse_ir(fullPath);
                    if (!irFile.valid || irFile.signals.empty()) {
                        dispBannerErr("IR parse hata");
                        return;
                    }
                    OptionList sigOpts;
                    for (auto& sig : irFile.signals) {
                        sigOpts.push_back({sig.name.substring(0, 16), [sig]() {
                            ir_init();
                            dispClear();
                            dispStatusBar("IR TX");
                            dispText(0, 14, sig.name.substring(0, 18));
                            dispText(0, 26, "Proto: " + sig.protocol);
                            dispCommit();
                            if (sig.type == "parsed") {
                                decode_type_t pt = ir_proto_from_name(sig.protocol);
                                uint64_t payload = ((uint64_t)sig.address << 16) | sig.command;
                                switch (pt) {
                                    case decode_type_t::NEC:     g_irSend.sendNEC(payload, 32); break;
                                    case decode_type_t::SAMSUNG: g_irSend.sendSAMSUNG(payload, 32); break;
                                    case decode_type_t::SONY:    g_irSend.sendSony(sig.command, 20, 3); break;
                                    case decode_type_t::RC5:     g_irSend.sendRC5(payload, 12); break;
                                    case decode_type_t::RC6:     g_irSend.sendRC6(payload, 20); break;
                                    default:                     g_irSend.sendNEC(payload, 32); break;
                                }
                                g_xpIrSendCnt++;
                                xpAdd(XP_PER_IR_SPAM);
                                buzzOK();
                                dispBannerOK("TX OK!");
                            } else if (sig.type == "raw" && !sig.rawData.empty()) {
                                uint16_t rawArr[sig.rawData.size()];
                                for (size_t i = 0; i < sig.rawData.size(); i++)
                                    rawArr[i] = (uint16_t)sig.rawData[i];
                                g_irSend.sendRaw(rawArr, sig.rawData.size(), 38);
                                g_xpIrSendCnt++;
                                xpAdd(XP_PER_IR_SPAM);
                                buzzOK();
                                dispBannerOK("RAW TX OK!");
                            } else {
                                dispBannerWarn("Bilinmeyen tip");
                            }
                        }});
                    }
                    sigOpts.push_back({"Back", [](){}});
                    int ss = loopOptions(sigOpts, "Sinyal Sec");
                    if (ss >= 0 && ss < (int)sigOpts.size()) sigOpts[ss].action();
                }});
            }
        }
        entry = dir.openNextFile();
    }
    dir.close();
    if (fileOpts.empty()) { dispBannerWarn(".ir dosyasi yok"); return; }
    fileOpts.push_back({"Back", [](){}});
    int sel = loopOptions(fileOpts, "IR Dosyalari");
    if (sel >= 0 && sel < (int)fileOpts.size()) fileOpts[sel].action();
}

// ─── Son yakalananı SD'ye kaydet ─────────────────────────────────────
static void ir_save_to_sd_run() {
    if (g_irLastRaw.empty()) { dispBannerErr("Önce IR yakala"); return; }
    if (!g_sdInited) { dispBannerErr("SD Kart yok"); return; }
    if (!SD.exists("/ir")) SD.mkdir("/ir");
    char fpath[48];
    snprintf(fpath, sizeof(fpath), "/ir/cap_%lu.ir", millis());
    File f = SD.open(fpath, FILE_WRITE);
    if (!f) { dispBannerErr("Dosya acilamadi"); return; }
    f.println("Filetype: IR signals file");
    f.println("Version: 1");
    f.println("#");
    f.println("name: Captured");
    f.println("type: raw");
    f.print("frequency: 38000\n");
    f.print("duty_cycle: 0.330000\n");
    f.print("data:");
    for (size_t i = 0; i < g_irLastRaw.size(); i++) { f.print(" "); f.print(g_irLastRaw[i]); }
    f.println();
    f.close();
    String pname = String(fpath);
    buzzOK();
    g_xpIrCnt++;
    xpAdd(XP_PER_IR_SAVE);
    dispBannerOK("Kaydedildi: " + pname.substring(pname.lastIndexOf('/') + 1));
}

// ─── Sinyal Analiz ekranı ───────────────────────────────────────────
static void ir_analyze_run() {
    ir_recv_start();
    dispClear();
    dispStatusBar("IR Analiz");
    dispText(0, 14, "Sinyal bekleniyor...");
    dispText(0, 26, "RX GPIO" + String(PIN_IR_RX));
    dispText(0, 50, "[BTN]=cik");
    dispCommit();
    decode_results results;
    while (!readButton()) {
        if (g_irRecv.decode(&results)) {
            dispClear();
            dispStatusBar("IR Analiz");
            String proto = ir_proto_name(results.decode_type);
            dispText(0, 12, "Proto: " + proto);
            char buf[32];
            snprintf(buf, sizeof(buf), "Val: 0x%llX", (unsigned long long)results.value);
            dispText(0, 22, String(buf));
            snprintf(buf, sizeof(buf), "Bits: %d", results.bits);
            dispText(0, 32, String(buf));
            dispText(0, 42, "RAW len: " + String(results.rawlen));
            dispText(0, 52, "[BTN]=cik");
            dispCommit();
            buzzOK();
            tone(PIN_BUZZER, 1800 + (results.value & 0xFF) * 4, 60);
            g_irRecv.resume();
            delay(200);
        }
        delay(30);
    }
    ir_recv_stop();
}

