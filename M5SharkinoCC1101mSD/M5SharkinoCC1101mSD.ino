// ─────────────────────────────────────────────────────────────
// Yardımcı: Pil doluluk seviyesi overlay'i çizmek için
// (FZ_Battery_26x8 çerçevesinin içini doldur)
// Kullanım: dispDrawBatteryFill(x, y, pct)  — pct 0..100
// ─────────────────────────────────────────────────────────────
static void dispDrawBatteryFill(Adafruit_SSD1306& disp, int16_t x, int16_t y, uint8_t pct) {
    // Çerçeve içi: x+1..x+22 genişliği=22, y+1..y+6 yüksekliği=6
    uint8_t fill = (uint8_t)((22UL * pct) / 100);
    if (fill > 22) fill = 22;
    if (fill > 0) disp.fillRect(x + 2, y + 2, fill, 4, SSD1306_WHITE);
}

