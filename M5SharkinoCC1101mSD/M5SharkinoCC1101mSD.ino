// ─── İÇ MENÜ: RFID Gelişmiş İşlem Menüsü ─────────────────

// RFID context menü aksiyon işleyici — lambda taşmasını önlemek için ayrı fonksiyon
static void rfid_context_dispatch(int sel, bool isMifare1K, bool isUL, const String& uid) {
    // sel → eylem indeksi:
    // 0: Save Tag
    // 1..4: Mifare1K eylemleri (opsiyonel)
    // UL eylemleri (opsiyonel)
    // sondan-2: Add to Targets
    // sondan-1: Back (çağrılmaz, üstte kontrol edilir)

    int idx = 0;
    if (sel == idx++) { rfid_save_tag_run(); return; }
    if (isMifare1K) {
        if (sel == idx++) { rfid_dump_run(); return; }
        if (sel == idx++) { rfid_bruteforce_run(); return; }
        if (sel == idx++) { rfid_clone_run(); return; }
        if (sel == idx++) { rfid_erase_run(); return; }
    }
    if (isUL) {
        if (sel == idx++) { rfid_write_ndef_run(); return; }
        if (sel == idx++) { rfid_parse_ndef_run(); return; }
    }
    // Add to Targets
    if (sel == idx) {
        if (g_ssidTargetCount < SSID_LIST_MAX) {
            g_ssidTargetList[g_ssidTargetCount++] = uid;
            dispBannerOK("UID added to targets");
        } else {
            dispBannerWarn("Target list full");
        }
    }
}

static void rfid_context_menu_run() {
    // Kartı oku ve bağlama göre işlemler sun
    rfidReinit();
    dispClear(); dispStatusBar("RFID Smart Read");
    dispText(0, 14, "Present any tag...");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    g_lastUID = rfid.uid;
    g_hasUID  = true;
    String uid  = uidToHex(rfid.uid);
    MFRC522::PICC_Type t = rfid.PICC_GetType(rfid.uid.sak);
    String typeName = rfid.PICC_GetTypeName(t);
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();

    // Kart tipine göre aksiyon menüsü
    bool isMifare1K = (t == MFRC522::PICC_TYPE_MIFARE_1K);
    bool isUL = (t == MFRC522::PICC_TYPE_MIFARE_UL);

    while (true) {
        dispClear(); dispStatusBar("Tag Detected");
        dispText(0, 12, "UID: " + uid);
        dispText(0, 22, "Type: " + typeName);
        dispText(0, 32, "SAK: 0x" + String(rfid.uid.sak, HEX));
        dispCommit();
        delay(300);

        // Lambda yerine dummy no-op fonksiyon pointer kullan → literal pool taşması önlenir
        static const auto noop = [](){};
        OptionList acts;
        acts.push_back({"Save Tag",       noop});
        if (isMifare1K) {
            acts.push_back({"Full Dump",        noop});
            acts.push_back({"Bruteforce Keys",  noop});
            acts.push_back({"Clone UID",        noop});
            acts.push_back({"Erase Tag",        noop});
        }
        if (isUL) {
            acts.push_back({"Write NDEF URL",   noop});
            acts.push_back({"Parse NDEF",       noop});
        }
        acts.push_back({"Add to Targets",   noop});
        acts.push_back({"Back",             noop});

        int sel = loopOptions(acts, "Tag Actions");
        if (sel < 0 || sel == (int)acts.size()-1) return;

        rfid_context_dispatch(sel, isMifare1K, isUL, uid);
        break;
    }
}

