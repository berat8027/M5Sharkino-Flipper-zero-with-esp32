// ─── 8×8 bitmap çizici (PROGMEM'den) ─────────────────────
// x,y: sol üst köşe  col: SSD1306_WHITE veya SSD1306_BLACK
static void drawBitmap8(int x, int y, const uint8_t* bmp, uint16_t col) {
    for (int row = 0; row < 8; row++) {
        uint8_t rowData = pgm_read_byte(bmp + row);
        for (int bit = 0; bit < 8; bit++) {
            if (rowData & (0x80 >> bit))
                display.drawPixel(x + bit, y + row, col);
        }
    }
}

// ─── 16×16 bitmap çizici (PROGMEM'den, 2 byte/satır) ─────
static void drawBitmap16(int x, int y, const uint8_t* bmp, uint16_t col) {
    for (int row = 0; row < 16; row++) {
        uint16_t rowData = ((uint16_t)pgm_read_byte(bmp + row*2) << 8)
                         |  (uint16_t)pgm_read_byte(bmp + row*2 + 1);
        for (int bit = 0; bit < 16; bit++) {
            if (rowData & (0x8000 >> bit))
                display.drawPixel(x + bit, y + row, col);
        }
    }
}

// ─── Flipper tarzı status bar (pil + saat + başlık) ──────
// Bu fonksiyon mevcut dispStatusBar()'ın yerini almaz;
// Ana menü (MainMenuV2::drawStatusBar) tarafından kullanılmak
// üzere ek bir Flipper stil helper olarak sunulur.
// Solda pil ikonu (dummy %100), ortada title, sağda saat/uptime.
static void dispFlipperStatusBar(const String& title) {
    // ── Flipper Zero tam solid-white status bar ───────────────────
    display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setTextSize(1);

    // ── Sol: GERÇEK Flipper pil bitmap'i (26x8) + doluluk + Level ─
    display.drawBitmap(1, 1, FZ_Battery_26x8,
                       FZ_Battery_26x8_W, FZ_Battery_26x8_H, SSD1306_BLACK);
    dispDrawBatteryFill(display, 1, 1, 100);  // dummy %100
    display.setCursor(29, 2);
    display.print('L'); display.print(g_level);

    // ── Orta: başlık ortalı (alan [43..88] = 45px, sağda ikonlar) ─
    String t = title;
    if ((int)t.length() > 7) t = t.substring(0, 6) + "~";
    int16_t tw = (int16_t)t.length() * 6;
    int16_t tx = 43 + (45 - tw) / 2;
    if (tx < 43) tx = 43;
    display.setCursor(tx, 2);
    display.print(t);

    // ── Sağ: BT + SD ikonları + saat ────────────────────────────
    // SD kart ikonu (11x8) @ x=89
    if (g_sdInited) {
        display.drawBitmap(89, 1, FZ_SDcardMounted_11x8,
                           FZ_SDcardMounted_11x8_W, FZ_SDcardMounted_11x8_H, SSD1306_BLACK);
    } else {
        display.drawBitmap(89, 1, FZ_SDcardFail_11x8,
                           FZ_SDcardFail_11x8_W, FZ_SDcardFail_11x8_H, SSD1306_BLACK);
    }
    // BT ikonu (5x8) @ x=102
    if (g_cfg.bleEnabled) {
        display.drawBitmap(102, 1, FZ_Bluetooth_Idle_5x8,
                           FZ_Bluetooth_Idle_5x8_W, FZ_Bluetooth_Idle_5x8_H, SSD1306_BLACK);
    }
    // Saat (HH:MM) @ x=109
    String timeStr;
    if (g_ntpSynced) {
        struct tm ti;
        if (getLocalTime(&ti, 0)) {
            char buf[6]; strftime(buf, sizeof(buf), "%H:%M", &ti);
            timeStr = String(buf);
        }
    }
    if (timeStr.isEmpty()) {
        // NTP yokken uptime HH:MM olarak göster
        uint32_t sec = millis() / 1000;
        char buf[6];
        snprintf(buf, sizeof(buf), "%02lu:%02lu",
                 (unsigned long)(sec / 3600),
                 (unsigned long)((sec % 3600) / 60));
        timeStr = String(buf);
    }
    // Saat: her zaman sağ kenardan 31px içeride (5 char × 6px + 1)
    display.setCursor(OLED_W - 31, 2);
    display.print(timeStr);

    display.setTextColor(SSD1306_WHITE);
}

// ─── Flipper menü highlight bar animasyonu ────────────────
// loopOptions'ta selected item için kayan highlight bar.
// Mevcut renderOptionList içindeki statik fillRoundRect zaten
// Flipper stilini karşılar; bu helper ekstra "slide-in" efekt
// için çağrılabilir. Doğrudan renderOptionList'i yazmak yerine
// üzerine ek animasyon katmanı olarak kullanılır.
static void flipperHighlightSlide(int yStart, int yEnd, int itemH, const String& label) {
    // Highlight bar yFrom'dan yTo'ya 4 adımda kayar
    for (int step = 0; step <= 4; step++) {
        int y = yStart + (yEnd - yStart) * step / 4;
        display.fillRoundRect(0, y, OLED_W - 4, itemH, 2, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        String lbl = label;
        if ((int)lbl.length() > 17) lbl = lbl.substring(0, 16) + "~";
        display.setCursor(5, y + 1);
        display.print(lbl);
        display.setCursor(OLED_W - 11, y + 1);
        display.print(">");
        display.setTextColor(SSD1306_WHITE);
        dispCommit();
        delay(6);
    }
}

// ─── Flipper tarzı boot splash animasyonu (köşeden çerçeve) ──
// Orijinal showSplash() bu fonksiyonun yerine geçer; bu helper
// sadece köşe-çerçeve kısmını eklemek isteyenler için sunulur.
// Ana kod splashPhase1/2/3 üçlüsünü korur.
static void flipperCornerFrame(int iterations = 4) {
    // Köşelerden başlayarak ekranı saran çerçeve animasyonu
    for (int i = 0; i <= iterations; i++) {
        int margin = (iterations - i) * (OLED_W / (2 * iterations));
        dispClear();
        display.drawRoundRect(margin, margin,
                              OLED_W - 2*margin,
                              OLED_H - 2*margin, 3, SSD1306_WHITE);
        dispCommit();
        delay(40);
    }
}

// ─── Flipper-style icon category selector (8×8, 6 across) ──
// Alt menülerde kategori ikonlarını yatay göstermek için.
// items: ikon bitmap listesi, labels: kısa etiketler, count: eleman sayısı
// Döner: seçili index (0..count-1) veya -1 (geri)
static int flipperIconPicker(const uint8_t* const* icons,
                              const char* const* labels,
                              int count,
                              const String& title) {
    int sel = 0;
    while (true) {
        dispClear();
        dispFlipperStatusBar(title);
        // 6 ikon yatay (128/6 ≈ 21px arası)
        int visStart = (sel / 6) * 6;
        for (int i = 0; i < 6 && (visStart + i) < count; i++) {
            int idx = visStart + i;
            int x   = i * 21 + 1;
            int y   = 15;
            if (idx == sel) {
                display.fillRoundRect(x - 1, y - 1, 18, 18, 2, SSD1306_WHITE);
                drawBitmap8(x, y, icons[idx], SSD1306_BLACK);
            } else {
                drawBitmap8(x, y, icons[idx], SSD1306_WHITE);
            }
            // Etiket
            display.setTextSize(1);
            display.setTextColor(SSD1306_WHITE);
            display.setCursor(x, y + 11);
            display.print(String(labels[idx]).substring(0, 3));
        }
        // Alt sayfa indikatörleri
        if (count > 6) {
            int pages = (count + 5) / 6;
            int curPage = sel / 6;
            for (int p = 0; p < pages; p++) {
                int dx = OLED_W/2 - pages*4 + p*8;
                if (p == curPage) display.fillRect(dx, 57, 6, 3, SSD1306_WHITE);
                else              display.drawRect(dx, 57, 4, 3, SSD1306_WHITE);
            }
        }
        dispCommit();

        JoyDir d = readJoystick();
        if (d == JoyDir::RIGHT && sel < count - 1) { sel++; buzzNav(); }
        if (d == JoyDir::LEFT  && sel > 0)         { sel--; buzzNav(); }
        if (d == JoyDir::DOWN  && sel + 6 < count) { sel += 6; buzzNav(); }
        if (d == JoyDir::UP    && sel - 6 >= 0)    { sel -= 6; buzzNav(); }
        if (readButton())     { buzzSelect(); return sel; }
        if (readButtonLong()) return -1;
        delay(8);
    }
}

