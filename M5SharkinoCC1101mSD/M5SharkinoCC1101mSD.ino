static String uidToHex(MFRC522::Uid& uid) {
    String s;
    for (uint8_t i = 0; i < uid.size; i++) {
        if (uid.uidByte[i] < 0x10) s += "0";
        s += String(uid.uidByte[i], HEX);
        if (i < uid.size - 1) s += ":";
    }
    s.toUpperCase();
    return s;
}

// g_lastUID, g_hasUID, g_sectorDump, g_hasDump — dosya başında tanımlandı (satır ~445-448)

static bool rfidWait(uint32_t ms = 15000) {
    uint32_t t = millis();
    while (millis() - t < ms) {
        if (readButton()) return false;
        rfid.PCD_StopCrypto1();  // önceki crypto oturumunu temizle
        if (rfid.PICC_IsNewCardPresent() && rfid.PICC_ReadCardSerial()) return true;
        delay(RFID_POLL_MS);
    }
    return false;
}

static bool rfidAuth(uint8_t block, MFRC522::MIFARE_Key& key) {
    return rfid.PCD_Authenticate(
        MFRC522::PICC_CMD_MF_AUTH_KEY_A, block, &key, &rfid.uid
    ) == MFRC522::STATUS_OK;
}

static bool rfidAuthB(uint8_t block, MFRC522::MIFARE_Key& key) {
    return rfid.PCD_Authenticate(
        MFRC522::PICC_CMD_MF_AUTH_KEY_B, block, &key, &rfid.uid
    ) == MFRC522::STATUS_OK;
}

static bool g_spiInited = false;

static void rfidReinit() {
    // SPI sadece bir kez başlatılır; tekrar çağrısı bus'ı bozar
    if (!g_spiInited) {
        // SPI.begin() is now handled globally in setup() // CS'i manuel yönet
        g_spiInited      = true;
        g_cc1101SpiInited = true;  // CC1101 da aynı bus'ı kullanır
        delay(10);
    }
    rfid.PCD_Reset();
    delay(50);
    rfid.PCD_Init();
    delay(10);
    rfid.PCD_SetAntennaGain(rfid.RxGain_max);
    delay(10);
}

static void rfid_read_run() {
    rfidReinit();
    // Flipper Zero RFID bekleme ekrani — RFIDDolphinReceive ikonu
    showRFIDWaitScreen("RFID Read", "[BTN] cancel");
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    buzzRFID();  // Kart okundu — cift bip
    g_lastUID  = rfid.uid;
    g_hasUID   = true;
    g_xpRfidCnt++;
    xpAdd(XP_PER_RFID);
    String uid  = uidToHex(rfid.uid);
    MFRC522::PICC_Type t = rfid.PICC_GetType(rfid.uid.sak);
    String type = rfid.PICC_GetTypeName(t);

    // Flipper Zero: okuma basarili -> DolphinReadingSuccess ikonu (1.2sn)
    showOpScreen(FzOpIcon::DolphinReadOK, "Tag Found!", 1200);

    dispClear(); dispStatusBar("Tag Found");
    dispText(0, 12, "UID:  " + uid);
    dispText(0, 22, "Type: " + type);
    dispText(0, 32, "SAK:  0x" + String(rfid.uid.sak, HEX));
    dispText(0, 42, "Size: " + String(rfid.uid.size) + "B UID");
    dispText(0, 54, "[BTN] back");
    dispCommit();
    logPush("[RFID] uid=" + uid + " type=" + type);
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    while (!readButton()) delay(50);
}

static void rfid_monitor_run() {
    rfidReinit();
    uint32_t seen = 0;
    String lastUID;
    while (!readButtonLong()) {
        delay(RFID_POLL_MS);
        if (!rfid.PICC_IsNewCardPresent() || !rfid.PICC_ReadCardSerial()) continue;
        String uid = uidToHex(rfid.uid);
        if (uid != lastUID) {
            lastUID = uid; seen++;
            buzzRFID();  // Yeni kart -- cift bip
            showOpScreen(FzOpIcon::DolphinReadOK, uid.c_str(), 800);
            g_xpRfidCnt++;
            xpAdd(XP_PER_RFID);
            logPush("[RFID_MON] " + uid);
        }
        dispClear(); dispStatusBar("RFID Monitor");
        dispText(0, 12, "Count: " + String(seen));
        dispText(0, 22, "Last:");
        dispText(0, 32, uid);
        dispText(0, 42, rfid.PICC_GetTypeName(rfid.PICC_GetType(rfid.uid.sak)));
        dispText(0, 54, "[LONG] stop");
        dispCommit();
        rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    }
}

static void rfid_dump_run() {
    rfidReinit();
    dispClear(); dispStatusBar("RFID Dump");
    dispText(0, 14, "Present Mifare 1K");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    MFRC522::MIFARE_Key keyFF;
    for (uint8_t i = 0; i < 6; i++) keyFF.keyByte[i] = 0xFF;

    memset(g_sectorDump, 0, sizeof(g_sectorDump));
    uint8_t ok = 0, fail = 0;

    for (uint8_t blk = 0; blk < MIFARE_1K_BLOCKS; blk++) {
        // Her sektörün ilk bloğunda yeniden auth yap
        if (blk % 4 == 0) {
            rfid.PCD_StopCrypto1();
            // Auth başarısız olunca kartı PICC_WakeupA ile tekrar aktive et
            bool authOk = rfidAuth(blk, keyFF);
            if (!authOk) {
                // KeyA başarısız → PICC_WakeupA + KeyB dene
                rfid.PICC_HaltA();
                delay(5);
                MFRC522::MIFARE_Key keyB;
                memcpy(keyB.keyByte, keyFF.keyByte, 6);
                // Re-select card before retrying
                byte bufATQA[2]; byte bufSize = sizeof(bufATQA);
                rfid.PICC_WakeupA(bufATQA, &bufSize);
                rfid.PICC_ReadCardSerial();
                rfidAuthB(blk, keyB);
            }
        }
        uint8_t buf[18]; uint8_t blen = 18;
        if (rfid.MIFARE_Read(blk, buf, &blen) == MFRC522::STATUS_OK) {
            memcpy(g_sectorDump[blk], buf, 16); ok++;
        } else {
            fail++;
            // Read başarısız: crypto'yu sıfırla, kartı yeniden seç
            rfid.PCD_StopCrypto1();
            rfid.PICC_HaltA();
            delay(5);
            byte bufATQA[2]; byte bufSize = sizeof(bufATQA);
            rfid.PICC_WakeupA(bufATQA, &bufSize);
            rfid.PICC_ReadCardSerial();
        }
        if (blk % 8 == 0)
            dispProgress("Dumping", "Blk " + String(blk), (blk*100)/MIFARE_1K_BLOCKS);
    }
    g_hasDump = (ok > 0);
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    logPush("[DUMP] ok=" + String(ok) + " fail=" + String(fail));

    // Print dump to serial
    for (uint8_t b = 0; b < MIFARE_1K_BLOCKS && g_cfg.serialLog; b++) {
        Serial.printf("Blk%02d: ", b);
        for (uint8_t i = 0; i < 16; i++) Serial.printf("%02X ", g_sectorDump[b][i]);
        Serial.println();
    }

    // Flipper Zero: dump basarili -> DolphinDone ikonu
    if (ok > 0) showOpScreen(FzOpIcon::DolphinDone, "Dump Complete!", 1200);
    // Browse on display
    dispBanner("Dump: " + String(ok) + " OK", 600);
    int page = 0;
    while (true) {
        dispClear();
        dispStatusBar("Blk " + String(page) + "/63");
        for (uint8_t row = 0; row < 4; row++) {
            String ln;
            for (uint8_t col = 0; col < 4; col++) {
                char h[3]; sprintf(h, "%02X", g_sectorDump[page][row*4+col]);
                ln += h;
                if (col < 3) ln += " ";
            }
            dispText(0, 12 + row*12, ln);
        }
        // ASCII view bottom
        String asc;
        for (uint8_t i = 0; i < 16; i++) {
            char c = g_sectorDump[page][i];
            asc += (c >= 0x20 && c < 0x7F) ? c : '.';
        }
        dispText(0, 56, asc);
        dispCommit();
        JoyDir d = readJoystick();
        if (d == JoyDir::RIGHT && page < MIFARE_1K_BLOCKS-1) { page++; continue; }
        if (d == JoyDir::LEFT  && page > 0)                   { page--; continue; }
        if (readButton()) break;
        delay(50);
    }
}

static void rfid_clone_run() {
    rfidReinit();
    dispClear(); dispStatusBar("Clone: Src");
    dispText(0, 18, "Present SOURCE tag");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    g_lastUID = rfid.uid;
    g_hasUID  = true;
    String uid = uidToHex(rfid.uid);
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    dispBanner("Src: " + uid, 900);

    dispClear(); dispStatusBar("Clone: Dst");
    dispText(0, 14, "Present WRITABLE");
    dispText(0, 24, "(Magic) blank tag");
    dispText(0, 34, uid);
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    // MIFARE_SetUid returns bool in MFRC522 v1.4.x (true = success)
    bool cloneOk = rfid.MIFARE_SetUid(g_lastUID.uidByte, g_lastUID.size, true);
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    logPush("[CLONE] uid=" + uid + " result=" + String(cloneOk ? "OK" : "FAIL"));
    if (cloneOk) dispBannerOK("Clone OK!");
    else         dispBannerErr("Clone FAIL");
}

static void rfid_clone_full_run() {
    rfidReinit();
    if (!g_hasDump) { dispBanner("Dump a tag first"); return; }

    dispClear(); dispStatusBar("Full Clone: Dst");
    dispText(0, 14, "Present writable");
    dispText(0, 24, "Magic blank tag");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    MFRC522::MIFARE_Key keyFF;
    for (uint8_t i = 0; i < 6; i++) keyFF.keyByte[i] = 0xFF;

    uint8_t ok = 0, fail = 0;
    for (uint8_t blk = 0; blk < MIFARE_1K_BLOCKS; blk++) {
        if (blk % 4 == 3) continue; // sector trailer'ları atla
        if (blk % 4 == 0) {
            rfid.PCD_StopCrypto1();
            rfidAuth(blk, keyFF);
        }
        if (rfid.MIFARE_Write(blk, g_sectorDump[blk], 16) == MFRC522::STATUS_OK) ok++;
        else fail++;
        if (blk % 8 == 0)
            dispProgress("Writing", "Blk " + String(blk), (blk*100)/MIFARE_1K_BLOCKS);
    }
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    logPush("[FULL_CLONE] ok=" + String(ok) + " fail=" + String(fail));
    dispBanner("Written: " + String(ok) + " OK");
}

