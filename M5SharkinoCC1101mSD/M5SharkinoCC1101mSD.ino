static const uint8_t IR_TV_LIB_COUNT = sizeof(IR_TV_LIBRARY) / sizeof(IR_TV_LIBRARY[0]);

static void ir_send_lib_cmd(const IRLibEntry& e, uint8_t cmdCode) {
    ir_init();
    switch ((decode_type_t)e.proto) {
        case decode_type_t::NEC:
            g_irSend.sendNEC(((uint64_t)e.addr << 8) | cmdCode, 32); break;
        case decode_type_t::SAMSUNG:
            g_irSend.sendSAMSUNG(((uint64_t)e.addr << 8) | cmdCode, 32); break;
        case decode_type_t::SONY:
            g_irSend.sendSony(((uint64_t)e.addr << 5) | cmdCode, 20, 3); break;
        case decode_type_t::RC5:
            g_irSend.sendRC5(((uint64_t)e.addr << 6) | cmdCode, 12); break;
        case decode_type_t::RC6:
            g_irSend.sendRC6(((uint64_t)e.addr << 6) | cmdCode, 20); break;
        case decode_type_t::JVC:
            g_irSend.sendJVC(((uint64_t)e.addr << 8) | cmdCode, 16); break;
        case decode_type_t::PANASONIC:
            g_irSend.sendPanasonic(e.addr, cmdCode); break;
        case decode_type_t::SHARP:
            g_irSend.sendSharpRaw(((uint64_t)e.addr << 7) | cmdCode, 15); break;
        default:
            g_irSend.sendNEC(((uint64_t)e.addr << 8) | cmdCode, 32); break;
    }
}

static void ir_tv_spam_cmd(const char* cmdName, uint8_t IRLibEntry::*cmdField) {
    ir_init();
    dispClear();
    dispStatusBar("IR Spam");
    dispText(0, 14, String("Cmd: ") + cmdName);
    dispText(0, 26, String(IR_TV_LIB_COUNT) + " marka taranıyor");
    dispText(0, 38, "TX GPIO" + String(PIN_IR_TX));
    dispText(0, 50, "[BTN]=dur");
    dispCommit();
    delay(500);
    int round = 0;
    while (!readButton()) {
        for (uint8_t i = 0; i < IR_TV_LIB_COUNT && !readButton(); i++) {
            ir_send_lib_cmd(IR_TV_LIBRARY[i], IR_TV_LIBRARY[i].*cmdField);
            delay(180);
            dispClear();
            dispStatusBar("IR Spam");
            dispText(0, 14, String("Rnd ") + String(round+1) + "  " + cmdName);
            dispText(0, 26, String(IR_TV_LIBRARY[i].brand));
            dispText(0, 38, ir_proto_name((decode_type_t)IR_TV_LIBRARY[i].proto));
            char buf[24];
            snprintf(buf, sizeof(buf), "Addr:0x%04X", IR_TV_LIBRARY[i].addr);
            dispText(0, 50, String(buf));
            dispCommit();
        }
        round++;
        delay(300);
    }
    dispBannerOK("IR Spam durduruldu");
}

