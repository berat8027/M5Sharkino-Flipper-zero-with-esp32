// ================================================================
// FZ OPERASYON EKRANI YARDIMCILARI
// showOpScreen()    -- tek bitmap ikonu ortala + mesaj + bekleme
// showOpScreenAnim() -- cok-frame animasyon oyna
// playLevelUpAnim() -- Flipper Zero Levelup1/2 animasyonu
// ================================================================

// Merkez-X hesabi (ekran ortasina hizalama)
static int16_t fzCenterX(uint8_t w) { return (OLED_W - w) / 2; }
static int16_t fzCenterY(uint8_t h, bool withBar=false) {
    int16_t top = withBar ? 12 : 0;
    return top + ((OLED_H - top - h) / 2);
}

// Tek bitmap ikonu gosteren operasyon ekrani
// icon  : FzOpIcon enum degeri
// msg   : alt mesaj (nullptr = yok)
// ms    : ms bekleme (0 = bekleme yok, hemen don)
void showOpScreen(FzOpIcon icon, const char* msg, uint32_t ms) {
    uint8_t idx = (uint8_t)icon;
    if (idx >= FZ_ICON_COUNT) return;
    FzIconInfo info;
    memcpy_P(&info, &FZ_ICON_TABLE[idx], sizeof(FzIconInfo));
    dispClear();
    int16_t x = fzCenterX(info.w);
    int16_t y = fzCenterY(info.h, msg != nullptr);
    if (x < 0) x = 0;
    if (y < 0) y = 0;
    display.drawBitmap(x, y, info.bmp, info.w, info.h, SSD1306_WHITE);
    if (msg) {
        display.setTextColor(SSD1306_WHITE);
        display.setTextSize(1);
        int16_t tw = strlen(msg) * 6;
        display.setCursor((OLED_W - tw) / 2, OLED_H - 10);
        display.print(msg);
    }
    dispCommit();
    if (ms > 0) delay(ms);
}

// Cok-frame animasyon oynatan fonksiyon (PROGMEM pointer dizisi)
void showOpScreenAnim(const uint8_t* const* frames, uint8_t count,
                       uint8_t w, uint8_t h, uint32_t total_ms) {
    uint32_t frame_ms = count > 0 ? (total_ms / count) : 100;
    if (frame_ms < 40) frame_ms = 40;
    for (uint8_t i = 0; i < count; i++) {
        const uint8_t* bmp = (const uint8_t*)pgm_read_ptr(&frames[i]);
        dispClear();
        int16_t x = fzCenterX(w);
        int16_t y = fzCenterY(h);
        if (x < 0) x = 0;
        if (y < 0) y = 0;
        display.drawBitmap(x, y, bmp, w, h, SSD1306_WHITE);
        dispCommit();
        delay(frame_ms);
    }
}

// Flipper Zero Level-Up animasyonu (Levelup1 veya Levelup2)
void playLevelUpAnim(uint8_t which) {
    const uint8_t* const* frames;
    uint8_t count;
    if (which == 2) {
        frames = FZI_Levelup2_FRAMES;
        count  = FZI_Levelup2_FRAMES_COUNT;
    } else {
        frames = FZI_Levelup1_FRAMES;
        count  = FZI_Levelup1_FRAMES_COUNT;
    }
    // 2 kez oyna (toplam ~1.4 sn)
    showOpScreenAnim(frames, count, FZI_Levelup1_W, FZI_Levelup1_H, 700);
    showOpScreenAnim(frames, count, FZI_Levelup1_W, FZI_Levelup1_H, 700);
}

