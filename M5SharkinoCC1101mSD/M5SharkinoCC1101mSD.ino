    // ── Apple Continuity payload'ları ─────────────────────
    struct ApplePkt { uint8_t data[31]; uint8_t len; };
    static const ApplePkt APPLE[] = {
        {{0x1E,0xFF,0x4C,0x00,0x05,0x12,0x00,0x00,0x00,0x00,
          0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00}, 20},
