static bool initDisplay() {
    Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);
    if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) return false;
    display.clearDisplay();
    display.display();
    return true;
}

static void initInput() {
    // GPIO0 ESP32-S3'te strapping pinidir; boot sonrası normal GPIO olarak kullanılabilir.
    // INPUT_PULLUP: buton GND'ye bağlı, basılınca LOW okur.
    pinMode(PIN_JOY_BTN, INPUT_PULLUP);
    delay(10);  // Strapping geçiş stabilizasyonu için kısa bekleme
    // 4 özel aksiyon butonları kaldırıldı
    analogReadResolution(12);
    analogSetAttenuation(ADC_11db);
}

// ─── 4 Buton okuma (basit debounce) ──────────────────────

// ─── A/B/C/D Buton sistemi ───────────────────────────────
// Mimari:
//   - FreeRTOS task (core 0) sadece pin okur ve flag set eder
//   - Ana loop (core 1) flagleri kontrol edip ağır işleri yapar
//   - Debounce: 5 ardışık LOW okuma gerekli (100ms @ 20ms interval)
//   - Floating pin koruması: bağlı olmayan pin gürültüsü tetiklemiyor

// ESP32 çift çekirdek güvenli flag erişimi için portMUX kullanılır.
// volatile tek başına ESP32'de farklı core'lar arası senkronizasyon sağlamaz.
static portMUX_TYPE g_btnMux = portMUX_INITIALIZER_UNLOCKED;
static volatile bool g_btnAFlag = false;
static volatile bool g_btnBFlag = false;
static volatile bool g_btnCFlag = false;
static volatile bool g_btnDFlag = false;

// Kaç ardışık HIGH (bırakılmış) okuma gerekli önce, sonra LOW sayılmaya başlar
// Önce pinlerin HIGH olduğu teyit edilir, sonra LOW sayımı başlar.
// Bu boot sırasında flash/strapping geçiş gürültüsünü tamamen önler.
static constexpr uint8_t BTN_CONFIRM_COUNT  = 5;   // 5 × 20ms = 100ms LOW gerekli
static constexpr uint8_t BTN_IDLE_COUNT     = 3;   // önce 3 × HIGH teyit

static uint8_t s_btnACnt=0, s_btnBCnt=0, s_btnCCnt=0, s_btnDCnt=0;
static uint8_t s_btnAidl=0, s_btnBidl=0, s_btnCidl=0, s_btnDidl=0;
static bool    s_btnAarm=false, s_btnBarm=false, s_btnCarm=false, s_btnDarm=false;

// btnSample: önce BTN_IDLE_COUNT kez HIGH görünce armed=true yapılır,
// sonra BTN_CONFIRM_COUNT kez LOW görünce tetiklenir.
// Bu iki aşamalı filtre boot gürültüsü ve floating pin sorununu önler.
static void btnSample(uint8_t pin, uint8_t& cnt, uint8_t& idl, bool& armed, volatile bool& flag) {
    if (digitalRead(pin) == HIGH) {
        cnt = 0;                            // LOW sayacını sıfırla
        if (idl < BTN_IDLE_COUNT) idl++;    // HIGH teyit sayacı artır
        if (idl >= BTN_IDLE_COUNT) armed = true;  // yeterince HIGH → artık basışa hazır
    } else {
        // Pin LOW
        idl = 0;                            // HIGH teyit sayacını sıfırla
        if (!armed) return;                 // henüz HIGH teyidi yok — yoksay
        if (cnt < BTN_CONFIRM_COUNT) cnt++;
        if (cnt == BTN_CONFIRM_COUNT) {
            portENTER_CRITICAL(&g_btnMux);
            flag  = true;
            portEXIT_CRITICAL(&g_btnMux);
            armed = false;  // bırakılana kadar tekrar tetikleme
            cnt   = 0;
        }
    }
}

