// ─── 1. PAIR MENU RUN ──────────────────────────────────────────────
void pair_menu_run() {
    uint32_t code = esp_random() % 900000 + 100000; // 6-digit code
    
    display.clearDisplay();
    display.setTextSize(2);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(10, 10);
    display.println("PAIRING CODE");
    display.setCursor(20, 35);
    display.println(code);
    display.display();

    // Broadcast pairing code via Serial (USB mode)
    Serial.printf("PAIR_CONFIRM:%u\n", code);
    
    // Also publish via MQTT (wireless mode)
    if (g_mqttConnected) {
        String topic = String(MQTT_PREFIX) + "/" + g_mqttDeviceId + "/pair_code";
        g_mqttClient.publish(topic.c_str(), String(code).c_str());
    }
    
    uint32_t startTime = millis();
    bool paired = false;

    while (millis() - startTime < 60000) {
        uint16_t btn = digitalRead(PIN_JOY_BTN);
        if (btn == LOW) {
            display.clearDisplay();
            display.setTextSize(1);
            display.setCursor(10, 25);
            display.println("Pairing Cancelled");
            display.display();
            delay(1000);
            break;
        }

        if (Serial.available()) {
            String line = Serial.readStringUntil('\n');
            line.trim();
            if (line == "PAIR_OK" || line == "SD_OK") {
                paired = true;
                break;
            }
        }
        delay(100);
    }

    if (paired) {
        Preferences prefs;
        prefs.begin("sharkino", false);
        prefs.putBool("paired", true);
        prefs.end();

        display.clearDisplay();
        display.setTextSize(1);
        display.setCursor(10, 20);
        display.println("PAIRING SUCCESSFUL");
        display.setCursor(10, 35);
        display.println("PC Suite Linked!");
        display.display();
        delay(1500);
    } else {
        display.clearDisplay();
        display.setTextSize(1);
        display.setCursor(10, 25);
        display.println("Pairing Failed/Timeout");
        display.display();
        delay(1500);
    }
}

// ─── 2. SCREEN STREAM TASK (Core 0) ────────────────────────────────
void screen_stream_task(void* pvParameters) {
    while (true) {
        if (g_screenStreamActive) {
            uint8_t* buffer = display.getBuffer();
            if (buffer != NULL) {
                // Build hex string
                String hexStr = "";
                hexStr.reserve(2048);
                for (int i = 0; i < 1024; i++) {
                    if (buffer[i] < 0x10) hexStr += '0';
                    char buf[3];
                    snprintf(buf, sizeof(buf), "%X", buffer[i]);
                    hexStr += buf;
                }

                // USB Serial (always)
                Serial.print("SCREEN:");
                Serial.println(hexStr);

                // MQTT (wireless)
                if (g_mqttConnected) {
                    String topic = String(MQTT_PREFIX) + "/" + g_mqttDeviceId + "/screen";
                    g_mqttClient.publish(topic.c_str(), hexStr.c_str());
                }
            }
        }
        vTaskDelay(pdMS_TO_TICKS(66)); // ~15 FPS
    }

}

