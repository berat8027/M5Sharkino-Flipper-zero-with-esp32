// Burada sadece global değişkenler tanımlanır.

// ─── Global STA bağlantı durumu ──────────────────────────
static bool     g_staConnected = false;   // STA bağlı mı?
static String   g_staIP        = "";      // Bağlı IP adresi
bool     g_ntpSynced    = false;   // NTP sync yapıldı mı? (extern forward declarations'ta)
static time_t   g_bootEpoch    = 0;       // Boot zamanı (NTP'den)

// NTP'den veya millis() ile zaman damgası üret
static String getTimestamp() {
    if (g_ntpSynced) {
        struct tm ti;
        if (getLocalTime(&ti, 0)) {
            char buf[20];
            strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &ti);
            return String(buf);
        }
    }
    // NTP yoksa millis tabanlı
    uint32_t ms = millis();
    char buf[16];
    snprintf(buf, sizeof(buf), "+%lus", (unsigned long)(ms/1000));
    return String(buf);
}

DeviceConfig g_cfg;  // extern forward declaration dosya başında

// Global log buffer
static String g_log[LOG_MAX_LINES];
static uint16_t g_logHead = 0;
static uint8_t  g_logCount = 0;

static void logPush(const String& line) {
    g_log[g_logHead % LOG_MAX_LINES] = line;
    g_logHead++;
    if (g_logCount < LOG_MAX_LINES) g_logCount++;
    if (g_cfg.serialLog) {
        Serial.println(line);
        Serial0.println(line);
    }
}

// STA bağlantısı kur (en fazla timeoutMs bekle)
// Dönüş: true=bağlandı, false=başarısız
static bool wifiSTAConnect(uint32_t timeoutMs = 10000) {
    if (strlen(g_cfg.staSSID) == 0) return false;
    WiFi.disconnect(true);
    delay(100);
    WiFi.mode(WIFI_STA);
    WiFi.begin(g_cfg.staSSID, strlen(g_cfg.staPass) > 0 ? g_cfg.staPass : nullptr);

    uint32_t t0 = millis();
    uint8_t dots = 0;
    while (WiFi.status() != WL_CONNECTED && millis() - t0 < timeoutMs) {
        potApplyBrightness();
        if (readButtonLong()) { WiFi.disconnect(true); WiFi.mode(WIFI_OFF); return false; }
        if (millis() % 400 < 200) {
            dispClear(); dispStatusBar("WiFi STA");
            dispText(0, 14, "SSID: " + String(g_cfg.staSSID).substring(0,18));
            String dotStr = "Connecting";
            for (uint8_t i = 0; i < (dots % 4); i++) dotStr += ".";
            dispText(0, 28, dotStr);
            dispText(0, 40, "Ch: " + String(WiFi.channel()));
            uint32_t elapsed = millis() - t0;
            uint8_t pct = (uint8_t)min(99UL, elapsed * 99 / timeoutMs);
            display.drawRect(0, 52, 128, 8, SSD1306_WHITE);
            display.fillRect(1, 53, pct * 126 / 100, 6, SSD1306_WHITE);
            dispCommit();
            dots++;
        }
        delay(50);
    }

    if (WiFi.status() == WL_CONNECTED) {
        g_staConnected = true;
        g_staIP = WiFi.localIP().toString();
        logPush("[STA] Connected SSID=" + String(g_cfg.staSSID) + " IP=" + g_staIP);
        buzzWiFiConnect();
        showBlockingAnim(4);  // L0_NewMail — WiFi bağlantı bildirimi
        // NTP senkronizasyonu
        if (g_cfg.ntpEnabled) {
            configTime(3 * 3600, 0, "pool.ntp.org", "time.nist.gov");
            struct tm ti;
            if (getLocalTime(&ti, 5000)) {
                g_ntpSynced = true;
                char buf[32];
                strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &ti);
                logPush("[NTP] Synced: " + String(buf));
                showBlockingAnim(3);  // L0_Url — NTP/Update URL bildirimi
            } else {
                logPush("[NTP] Sync failed");
            }
        }
        return true;
    } else {
        g_staConnected = false;
        g_staIP = "";
        WiFi.disconnect(true);
        WiFi.mode(WIFI_OFF);
        logPush("[STA] Connect failed SSID=" + String(g_cfg.staSSID));
        return false;
    }
}

// STA bağlantısını kes
static void wifiSTADisconnect() {
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    g_staConnected = false;
    g_staIP = "";
    logPush("[STA] Disconnected");
}

// ═══════════════════════════════════════════════════════════
//  MENU INFRASTRUCTURE
// ═══════════════════════════════════════════════════════════

// ─── Input ────────────────────────────────────────────────

static uint32_t s_lastJoyMs = 0xFFFFFFFF;  // ilk okumada hemen geçsin diye değil, gecikme ile başlasın
static uint32_t s_lastBtnMs    = 0;        // son bırakılma zamanı
static bool     s_btnHeld      = false;    // şu an basılı mı (debounce sonrası)
static bool     s_btnReleased  = true;     // son bırakılma gerçekleşti mi (yeni basışa hazır)

volatile JoyDir g_injected_joy = JoyDir::NONE;
volatile bool g_injected_btn = false;
volatile bool g_injected_btn_long = false;

JoyDir readJoystick() {
    if (g_injected_joy != JoyDir::NONE) {
        JoyDir d = g_injected_joy;
        g_injected_joy = JoyDir::NONE; // consume
        return d;
    }
    if (millis() - s_lastJoyMs < JOY_DEBOUNCE_MS) return JoyDir::NONE;
    uint16_t x = analogRead(PIN_JOY_X);
    uint16_t y = analogRead(PIN_JOY_Y);
    JoyDir d = JoyDir::NONE;
    if      (y > JOY_HI) d = JoyDir::UP;
    else if (y < JOY_LO) d = JoyDir::DOWN;
    else if (x < JOY_LO) d = JoyDir::LEFT;
    else if (x > JOY_HI) d = JoyDir::RIGHT;
    if (d != JoyDir::NONE) s_lastJoyMs = millis();
    return d;
}

bool readButton() {
    if (g_injected_btn) {
        g_injected_btn = false; // consume
        return true;
    }
    bool raw = (digitalRead(PIN_JOY_BTN) == LOW);
    if (!raw) {
        // Buton bırakıldı
        if (s_btnHeld) {
            s_btnHeld     = false;
            s_btnReleased = true;
            s_lastBtnMs   = millis();
        }
        return false;
    }
    // raw == true (basılı)
    if (s_btnReleased && !s_btnHeld) {
        // Debounce: bırakıldıktan sonra yeterli süre geçti mi?
        if (millis() - s_lastBtnMs >= BTN_DEBOUNCE_MS) {
            s_btnHeld     = true;
            s_btnReleased = false;
            return true;
        }
    }
    return false;
}

bool readButtonLong() {
    if (g_injected_btn_long) {
        g_injected_btn_long = false; // consume
        return true;
    }
    if (digitalRead(PIN_JOY_BTN) != LOW) return false;
    uint32_t t = millis();
    while (digitalRead(PIN_JOY_BTN) == LOW) {
        if (millis() - t > BTN_LONG_MS) {
            // Uzun basış tespit edildi — bırakılmasını bekle
            while (digitalRead(PIN_JOY_BTN) == LOW) delay(10);
            s_btnHeld     = false;
            s_btnReleased = true;
            s_lastBtnMs   = millis();
            return true;
        }
        delay(10);
    }
    // Kısa basış — state'i temizle ama false dön
    s_btnHeld     = false;
    s_btnReleased = true;
    s_lastBtnMs   = millis();
    return false;
}

void waitButton(uint32_t timeout_ms) {
    uint32_t t0 = millis();
    while (!readButton() && (millis() - t0 < timeout_ms)) {
        delay(10);
    }
}

