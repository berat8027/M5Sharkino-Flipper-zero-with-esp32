void dispStatusBar(const String& title) {
    // ── Flipper Zero tam solid-white status bar (128x11) ────────
    display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setTextSize(1);

    // ── Sol: GERÇEK Flipper pil bitmap'i (26x8) + doluluk ───────
    // y=1 → ikonu üstten 1px boşlukla çiz (siyah çerçeve, beyaz zemine)
    display.drawBitmap(1, 1, FZ_Battery_26x8,
                       FZ_Battery_26x8_W, FZ_Battery_26x8_H, SSD1306_BLACK);
    // %100 dummy dolu doluluk (gerçek ADC voltaj ölçümü eklenene kadar)
    dispDrawBatteryFill(display, 1, 1, 100);
    // Level badge "L<n>" — pilin hemen sağında (x≈29)
    display.setCursor(29, 2);
    display.print('L'); display.print(g_level);

    // ── Orta: başlık ortalı (alan [43..116] = 73px) ─────────────
    String t = title;
    if ((int)t.length() > 10) t = t.substring(0, 9) + "~";
    int16_t tw = (int16_t)t.length() * 6;
    int16_t tx = 43 + (73 - tw) / 2;
    if (tx < 43) tx = 43;
    display.setCursor(tx, 2);
    display.print(t);

    // ── Sağ: saat (HH:MM) her zaman göster ──────────────────
    {
        String timeStr;
        if (g_ntpSynced) {
            struct tm ti;
            if (getLocalTime(&ti, 0)) {
                char buf[6]; strftime(buf, sizeof(buf), "%H:%M", &ti);
                timeStr = String(buf);
            }
        }
        if (timeStr.isEmpty()) {
            // NTP yokken uptime HH:MM olarak göster
            uint32_t sec = millis() / 1000;
            char buf[6];
            snprintf(buf, sizeof(buf), "%02lu:%02lu",
                     (unsigned long)(sec / 3600),
                     (unsigned long)((sec % 3600) / 60));
            timeStr = String(buf);
        }
        display.setCursor(OLED_W - 31, 2);
        display.print(timeStr);
    }

    display.setTextColor(SSD1306_WHITE);
}

// BannerType defined in forward-declarations block above.
static BannerType s_lastBannerType = BannerType::INFO;

// Potansiyometre → brightness gerçek zamanlı uygula
static void potApplyBrightness() {
    uint16_t raw = analogRead(PIN_POT);
    uint8_t  bri = map(raw, 0, 4095, 5, 255);
    display.ssd1306_command(SSD1306_SETCONTRAST);
    display.ssd1306_command(bri);
}

// Small icon draws (14x14 area) for banner
static void bannerDrawIcon(BannerType t, int x, int y) {
    switch (t) {
        case BannerType::OK:
            // Checkmark
            display.drawLine(x+1, y+7,  x+5,  y+11, SSD1306_BLACK);
            display.drawLine(x+2, y+7,  x+5,  y+10, SSD1306_BLACK);
            display.drawLine(x+5, y+11, x+13, y+3,  SSD1306_BLACK);
            display.drawLine(x+5, y+10, x+13, y+2,  SSD1306_BLACK);
            break;
        case BannerType::WARN:
            // Exclamation triangle
            display.drawTriangle(x+7,y+1, x+1,y+13, x+13,y+13, SSD1306_BLACK);
            display.fillRect(x+6, y+5, 2, 5, SSD1306_BLACK);
            display.fillRect(x+6, y+11,2, 2, SSD1306_BLACK);
            break;
        case BannerType::ERROR:
            // X mark
            display.drawLine(x+2, y+2,  x+12, y+12, SSD1306_BLACK);
            display.drawLine(x+3, y+2,  x+13, y+12, SSD1306_BLACK);
            display.drawLine(x+12,y+2,  x+2,  y+12, SSD1306_BLACK);
            display.drawLine(x+13,y+2,  x+3,  y+12, SSD1306_BLACK);
            break;
        case BannerType::RFID:
            display.drawRoundRect(x+1,y+3,12,8,2,SSD1306_BLACK);
            display.drawLine(x+3,y+6,x+11,y+6,SSD1306_BLACK);
            break;
