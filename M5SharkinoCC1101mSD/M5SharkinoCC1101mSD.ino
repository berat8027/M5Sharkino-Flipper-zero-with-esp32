        if (sel < 0) { backToMenu(); break; }
        if (sel >= 0 && sel < (int)opts.size()) opts[sel].action();
    }
}

void setup() {
    Serial.begin(SERIAL_BAUD);
    Serial0.begin(SERIAL_BAUD);
    
    // USB CDC enumerasyonu için bekle, böylece bilgisayar boot loglarını kaçırmaz
    for (int i = 0; i < 20; i++) {
        if (Serial) break;
        delay(100);
    }
    
    Serial.println("\n[ESPHacker M5Sharkino] Booting...");
    Serial0.println("\n[ESPHacker M5Sharkino] Booting...");

    // ─── MASTER SPI INITIALIZATION ───
    // SPI bus üzerindeki tüm CS pinleri OUTPUT ve HIGH yapılmalı.
    // Aksi takdirde modüller aynı anda hatta konuşup SPI bus'ı kilitler.
    pinMode(PIN_SD_CS, OUTPUT);     digitalWrite(PIN_SD_CS, HIGH);
    pinMode(PIN_CC1101_SS, OUTPUT); digitalWrite(PIN_CC1101_SS, HIGH);
    pinMode(PIN_RFID_SS, OUTPUT);   digitalWrite(PIN_RFID_SS, HIGH);
    delay(10); // Donanımların susması için bekle

    // SPI'ı tek seferlik başlat ve tüm global bayrakları ayarla
    SPI.begin(PIN_SPI_SCK, PIN_SPI_MISO, PIN_SPI_MOSI, -1);
    g_spiInited = true;
    g_cc1101SpiInited = true;
    delay(10);
    // ────────────────────────────────

    // Buzzer GPIO'yu ilk başta başlat (boot melodisi splash'te çalar)
    buzzerInit();

    buildAsciiHid();
    cfg_load();

    if (!initDisplay()) {
        pinMode(LED_BUILTIN, OUTPUT);
        while (true) { digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN)); delay(200); }
    }

    // Apply saved display settings
    display.invertDisplay(g_cfg.displayInvert);
    display.ssd1306_command(SSD1306_SETCONTRAST);
    display.ssd1306_command(map(g_cfg.brightness, 0, 100, 5, 255));

    initInput();

    if (g_cfg.rfidEnabled) {
        bool rfidOk = initRFID();
        if (!rfidOk) logPush("[RFID] Init failed - check wiring");
        else         logPush("[RFID] Init OK");
    }

    // RFID kayıtlı etiketleri yükle
    rfidTagsLoad();
    logPush("[RFID] Loaded " + String(g_savedTags.size()) + " saved tags");

    // XP/Level sistemi yükle
    xpLoad();
    g_xpSessionCnt++;
    xpAddSilent(XP_PER_SESSION);
    // Level-up kontrolü sessiz (boot sırasında animasyon yok)
    while (g_level < XP_MAX_LEVEL && g_xp >= xpForLevel(g_level + 1)) g_level++;
    xpSave();
    logPush("[XP] Loaded Lv=" + String(g_level) + " XP=" + String(g_xp));

    showSplash();
    logPush("[ESPHacker] Boot OK  heap=" + String(ESP.getFreeHeap()/1024) + "KB");

    // SPIFFS başlat (RF capture için)
    if (SPIFFS.begin(true)) {
        g_spiffsInited = true;
        logPush("[SPIFFS] Mounted OK  free=" +
                String((SPIFFS.totalBytes()-SPIFFS.usedBytes())/1024) + "KB");
    } else {
        logPush("[SPIFFS] Mount failed — RF capture devre disi");
        showBlockingAnim(0);  // L0_NoDb — veritabanı/dosya sistemi yok
    }

    // SD Kart başlat
    if (sdInit()) {
        logPush("[SD] Mounted OK  total=" +
                String((uint32_t)(SD.totalBytes()/1024)) + "KB free=" +
                String((uint32_t)((SD.totalBytes()-SD.usedBytes())/1024)) + "KB");
        sdLog("[ESPHacker] Boot OK heap=" + String(ESP.getFreeHeap()/1024) + "KB");
        showBlockingAnim(2);  // L0_SdOk — SD kart başarıyla mount edildi
    } else {
        logPush("[SD] Mount failed — CS=GPIO" + String(PIN_SD_CS));
        showBlockingAnim(1);  // L0_SdBad — SD kart hatalı / takılı değil
    }

    // MainMenuV2 — Marauder + gelişmiş iç menüler
    init_pc_suite();
  g_menuV2 = new MainMenuV2();
}

void loop() {
    // MainMenuV2 kullan (Marauder + gelişmiş iç menüler)
    if (g_menuV2) g_menuV2->run();
}
