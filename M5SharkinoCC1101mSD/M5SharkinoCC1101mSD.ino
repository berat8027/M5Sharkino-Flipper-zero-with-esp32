static void sd_send_resp(String line) {
    Serial.println(line);
    if (g_mqttConnected) {
        String topic = String(MQTT_PREFIX) + "/" + g_mqttDeviceId + "/sd_resp";
        g_mqttClient.publish(topic.c_str(), line.c_str());
    }
}

// ─── 4. SD CARD SERIAL BRIDGE ──────────────────────────────────────
void sd_serial_bridge(String cmd) {
    if (cmd.startsWith("SD_LIST:")) {
        String path = cmd.substring(8);
        File root = SD.open(path.c_str());
        if (!root || !root.isDirectory()) {
            sd_send_resp("SD_ERR:Cannot open directory");
            return;
        }
        File file = root.openNextFile();
        while (file) {
            String name = String(file.name());
            char entryBuf[256];
            snprintf(entryBuf, sizeof(entryBuf), "SD_ENTRY:%s:%u:%d", name.c_str(), file.size(), file.isDirectory() ? 1 : 0);
            sd_send_resp(entryBuf);
            file = root.openNextFile();
        }
        sd_send_resp("SD_END");
        root.close();
    }
    else if (cmd.startsWith("SD_UPLOAD:")) {
        int colon1 = cmd.indexOf(':', 10);
        if (colon1 < 0) {
            sd_send_resp("SD_ERR:Invalid upload command format");
            return;
        }
        String path = cmd.substring(10, colon1);
        uint32_t size = cmd.substring(colon1 + 1).toInt();

        File f = SD.open(path.c_str(), FILE_WRITE);
        if (!f) {
            sd_send_resp("SD_ERR:Cannot open destination file");
            return;
        }
        
        sd_send_resp("SD_OK");
        
        uint8_t buffer[256];
        uint32_t remaining = size;
        uint32_t startTime = millis();
        
        while (remaining > 0 && (millis() - startTime < 15000)) {
            if (Serial.available() > 0) {
                size_t toRead = min(remaining, (uint32_t)sizeof(buffer));
                size_t readBytes = Serial.readBytes(buffer, toRead);
                f.write(buffer, readBytes);
                remaining -= readBytes;
                startTime = millis();
            }
            yield();
        }
        
        f.close();
        if (remaining == 0) {
            sd_send_resp("SD_OK");
        } else {
            sd_send_resp("SD_ERR:Upload timed out");
        }
    }
    else if (cmd.startsWith("SD_DOWNLOAD:")) {
        String path = cmd.substring(12);
        File f = SD.open(path.c_str(), FILE_READ);
        if (!f || f.isDirectory()) {
            sd_send_resp("SD_ERR:Cannot open target file");
            if (f) f.close();
            return;
        }
        
        uint8_t buffer[256];
        while (f.available()) {
            size_t n = f.read(buffer, sizeof(buffer));
            Serial.write(buffer, n);
        }
        f.close();
    }
    else if (cmd.startsWith("SD_DELETE:")) {
        String path = cmd.substring(10);
        bool success = false;
        if (SD.exists(path.c_str())) {
            File f = SD.open(path.c_str());
            if (f && f.isDirectory()) {
                f.close();
                success = SD.rmdir(path.c_str());
            } else {
                if (f) f.close();
                success = SD.remove(path.c_str());
            }
        }
        if (success) {
            sd_send_resp("SD_OK");
        } else {
            sd_send_resp("SD_ERR:Failed to delete item");
        }
    }
    else if (cmd.startsWith("SD_MKDIR:")) {
        String path = cmd.substring(9);
        if (SD.mkdir(path.c_str())) {
            sd_send_resp("SD_OK");
        } else {
            sd_send_resp("SD_ERR:Failed to create folder");
        }
    }
}


// ─── 5. DEVICE INFO SERIAL ─────────────────────────────────────────
void device_info_serial() {
    uint32_t totalHeap = ESP.getHeapSize();
    uint32_t freeHeap = ESP.getFreeHeap();
    uint32_t uptimeSec = millis() / 1000;
    String mac = WiFi.macAddress();
    
