        display.drawCircle(x+11, y+5, 3, col);
        display.drawLine(x+10, y+2, x+4, y+13, col);
        display.fillTriangle(x+3,y+13,x+6,y+13,x+4,y+15, col);
        display.drawCircle(x+4, y+5, 2, col);
        display.drawLine(x+3, y+5, x+5, y+5, col);
        display.drawLine(x+4, y+4, x+4, y+6, col);
    }
    void runMenu() override {
        OptionList opts = {
            {"SPI/I2C Cihazlar",[]() { tools_spi_devices_run(); }},
            {"Pot Monitor",    []() { tools_pot_run(); }},
            {"Joystick Test",  []() { tools_joy_run(); }},
            {"ADC Waveform",   []() { tools_adc_wave_run(); }},
            {"I2C Scan",       []() { tools_i2c_scan_run(); }},
            {"System Info",    []() { tools_sysinfo_run(); }},
            {"Memory Map",     []() { tools_mem_map_run(); }},
            {"Flash Info",     []() { tools_flash_info_run(); }},
            {"Temp Sensor",    []() { tools_internal_temp_run(); }},
            {"Serial Shell",   []() { tools_serial_shell_run(); }},
            {"Log Viewer",     []() { tools_log_viewer_run(); }},
            {"Dashboard",      []() { tools_stats_dashboard_run(); }},
            {"Back",           []() { backToMenu(); }},
        };
        while (!g_returnToMenu) {
            int sel = loopOptions(opts, "Tools");
            if (sel < 0) { backToMenu(); break; }
            if (sel >= 0 && sel < (int)opts.size()) opts[sel].action();
        }
    }
};

