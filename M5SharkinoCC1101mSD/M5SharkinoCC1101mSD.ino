// ═══════════════════════════════════════════════════════════
//  MODULE: BUZZER
//  Aktif buzzer — GPIO7
//  Aktif buzzer: dahili osilatör var, sadece ON/OFF yeterli.
//  Tüm sesler non-blocking değil (delay tabanlı) ama kısa tutulur.
//
//  Ses olayları:
//    buzzBoot()      — açılışta melodi (C-E-G-C)
//    buzzOK()        — başarı (iki kısa yüksek bip)
//    buzzErr()       — hata (bir uzun alçak bip)
//    buzzWarn()      — uyarı (iki kısa orta bip)
//    buzzNav()       — menü navigasyon tıklama (çok kısa)
//    buzzSelect()    — menü seçim onayı (kısa yüksek)
//    buzzRFID()      — RFID kart okundu (çift bip)
//    buzzRFCapture() — RF sinyal yakalandı (üçlü artan bip)
//    buzzRFReplay()  — RF replay gönderdi (iki bip + uzun)
//    buzzRFScan()    — RF tarama başladı (tek kısa)
//    buzzMute()      — sessiz mod aç/kapat
//
//  NOT: Aktif buzzer PWM frekansına tepki vermez; ses sadece
//  ON/OFF süresine (ritme) göre şekillenir.
// ═══════════════════════════════════════════════════════════

// PIN_BUZZER forward — tam PIN bloğu aşağıda (satır ~258)
static constexpr uint8_t PIN_BUZZER_FWD = 7;
#define PIN_BUZZER PIN_BUZZER_FWD

static bool g_buzzerMuted = false;  // Ayarlardan sessiz mod

// Temel bip: ms boyunca ON, sonra OFF
static inline void buzzRaw(uint32_t onMs) {
    if (g_buzzerMuted) return;
    digitalWrite(PIN_BUZZER, HIGH);
    delay(onMs);
    digitalWrite(PIN_BUZZER, LOW);
}

// Bip + sessizlik çifti
static inline void buzzPulse(uint32_t onMs, uint32_t offMs) {
    if (g_buzzerMuted) return;
    digitalWrite(PIN_BUZZER, HIGH);
    delay(onMs);
    digitalWrite(PIN_BUZZER, LOW);
    if (offMs) delay(offMs);
}

// ─── Boot melodisi: C-E-G-C artan ritim ───────────────────
static void buzzBoot() {
    if (g_buzzerMuted) return;
    // Aktif buzzer frekans duyarsız; süreler melodiyi simüle eder
    // Nota zamanlamaları: kısa=C, biraz uzun=E, uzun=G, çift vuruş=C'
    buzzPulse(60, 40);   // Do
    buzzPulse(80, 40);   // Mi
    buzzPulse(100, 40);  // Sol
    buzzPulse(60, 20);   // Do' (ilk vuruş)
    buzzPulse(60, 0);    // Do' (ikinci vuruş — legato hissi)
}

// ─── Başarı: iki kısa yüksek bip ─────────────────────────
static void buzzOK() {
    if (g_buzzerMuted) return;
    buzzPulse(50, 60);
    buzzPulse(50, 0);
}

// ─── Hata: bir uzun düşük bip ─────────────────────────────
static void buzzErr() {
    if (g_buzzerMuted) return;
    buzzRaw(400);
}

// ─── Uyarı: iki kısa bip ──────────────────────────────────
static void buzzWarn() {
    if (g_buzzerMuted) return;
    buzzPulse(80, 80);
    buzzPulse(80, 0);
}

// ─── Navigasyon tıklama: çok kısa tek bip ─────────────────
static void buzzNav() {
    if (g_buzzerMuted) return;
    buzzRaw(15);
}

// ─── Menü seçim: kısa onay bipi ───────────────────────────
static void buzzSelect() {
    if (g_buzzerMuted) return;
    buzzPulse(30, 20);
    buzzPulse(50, 0);
}

// ─── RFID kart okundu: çift bip ───────────────────────────
static void buzzRFID() {
    if (g_buzzerMuted) return;
    buzzPulse(60, 50);
    buzzPulse(60, 0);
}

// ─── RFID hata / auth fail: uzun + kısa ──────────────────
static void buzzRFIDErr() {
    if (g_buzzerMuted) return;
    buzzPulse(300, 50);
    buzzPulse(80, 0);
}

// ─── RF sinyal yakalandı: üçlü artan bip ─────────────────
static void buzzRFCapture() {
    if (g_buzzerMuted) return;
    buzzPulse(40, 40);   // kısa
    buzzPulse(60, 40);   // orta
    buzzPulse(90, 0);    // uzun — "yakalandı!"
}

// ─── RF replay gönderildi: iki bip + uzun ────────────────
static void buzzRFReplay() {
    if (g_buzzerMuted) return;
    buzzPulse(50, 30);
    buzzPulse(50, 30);
    buzzPulse(150, 0);
}

// ─── RF tarama başladı: tek kısa ─────────────────────────
static void buzzRFScan() {
    if (g_buzzerMuted) return;
    buzzRaw(25);
}

// ─── WiFi bağlandı: üç artan bip ─────────────────────────
static void buzzWiFiConnect() {
    if (g_buzzerMuted) return;
    buzzPulse(40, 30);
    buzzPulse(60, 30);
    buzzPulse(80, 0);
}

// ─── Mute toggle: iki hızlı bip (mute öncesi) ────────────
static void buzzToggleMute() {
    // Bu fonksiyon mute AÇILMADAN önce çağrılır
    if (!g_buzzerMuted) {
        // Sessiz moda geçiyor: son ses olarak iki hızlı bip
        buzzPulse(40, 30);
        buzzPulse(40, 0);
        g_buzzerMuted = true;
    } else {
        // Sessiz mod kapanıyor: önce aç, sonra onay sesi
        g_buzzerMuted = false;
        buzzOK();
    }
}

// ─── Buzzer init ──────────────────────────────────────────
static void buzzerInit() {
    pinMode(PIN_BUZZER, OUTPUT);
    digitalWrite(PIN_BUZZER, LOW);
}

