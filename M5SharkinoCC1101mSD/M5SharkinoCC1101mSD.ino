    snprintf(jsonBuf, sizeof(jsonBuf),
        "{\"fw_ver\":\"2.0\",\"chip\":\"ESP32-S3\",\"mac\":\"%s\",\"free_heap\":%u,\"total_heap\":%u,\"sd_status\":\"%s\",\"sd_size\":%llu,\"sd_free\":%llu,\"uptime\":%u,\"battery\":100,\"charging\":1}",
        mac.c_str(), freeHeap, totalHeap, sdStatus.c_str(), sdTotal, sdFree, uptimeSec
    );

    Serial.print("DEVICE_INFO:");
