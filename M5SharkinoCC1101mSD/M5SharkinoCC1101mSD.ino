            display.drawLine(x+7,y+9, x+12,y+13,SSD1306_BLACK);
            break;
        case BannerType::RF:
            // RF waves — 3 arcs drawn as partial circles using drawCircle workaround
            // Use drawLine segments to approximate arcs
            display.drawLine(x+2, y+8,  x+7, y+5,  SSD1306_BLACK);
            display.drawLine(x+7, y+5,  x+12,y+8,  SSD1306_BLACK);
            display.drawLine(x+1, y+6,  x+7, y+2,  SSD1306_BLACK);
            display.drawLine(x+7, y+2,  x+13,y+6,  SSD1306_BLACK);
            display.drawLine(x+3, y+10, x+7, y+8,  SSD1306_BLACK);
            display.drawLine(x+7, y+8,  x+11,y+10, SSD1306_BLACK);
            display.fillCircle(x+7, y+12, 2, SSD1306_BLACK);
            break;
        default: // INFO — i circle
            display.drawCircle(x+7,y+7,6,SSD1306_BLACK);
            display.fillRect(x+6,y+4,2,2,SSD1306_BLACK);
            display.fillRect(x+6,y+7,2,5,SSD1306_BLACK);
            break;
    }
}

void dispBanner(const String& msg, uint32_t holdMs = STATUS_MS,
                BannerType btype = BannerType::INFO) {
    potApplyBrightness();   // pot brightness uygula

    // Slide-in animasyonu: banner yukarıdan aşağı iner
    int16_t bannerY = OLED_H/2 - 11;
    const int16_t TARGET_Y = OLED_H/2 - 11;
    const int16_t START_Y  = -24;

    for (int16_t y = START_Y; y <= TARGET_Y; y += 5) {
        dispClear();
        // Flipper tarzı köşe aksan çizgileri (4 köşede L-şekli)
        int16_t cL = 0, cR = OLED_W - 1, cT = 0, cB = OLED_H - 1;
        // Çift çizgi köşe aksanları (daha belirgin)
        for (int d = 0; d < 2; d++) {
            display.drawLine(cL+d, cT+d, cL+8+d, cT+d, SSD1306_WHITE);
            display.drawLine(cL+d, cT+d, cL+d, cT+8+d, SSD1306_WHITE);
            display.drawLine(cR-d, cT+d, cR-8-d, cT+d, SSD1306_WHITE);
            display.drawLine(cR-d, cT+d, cR-d, cT+8+d, SSD1306_WHITE);
            display.drawLine(cL+d, cB-d, cL+8+d, cB-d, SSD1306_WHITE);
            display.drawLine(cL+d, cB-d, cL+d, cB-8-d, SSD1306_WHITE);
            display.drawLine(cR-d, cB-d, cR-8-d, cB-d, SSD1306_WHITE);
            display.drawLine(cR-d, cB-d, cR-d, cB-8-d, SSD1306_WHITE);
        }
        // Banner şeridi (Flipper: yuvarlak köşe dikdörtgen, 22px yüksek)
        display.fillRoundRect(4, y, OLED_W - 8, 22, 3, SSD1306_WHITE);
        // İkon (sol taraf, biraz içeride)
        bannerDrawIcon(btype, 8, y + 4);
        // Dikey ayırıcı
        display.drawFastVLine(24, y + 2, 18, SSD1306_BLACK);
        // Mesaj ortalı
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        int16_t x1,y1; uint16_t tw,th;
        display.getTextBounds(msg.c_str(), 0, 0, &x1, &y1, &tw, &th);
        int16_t tx = 26 + max(0, (int)(OLED_W - 30 - tw) / 2);
        display.setCursor(tx, y + 7);
        display.print(msg);
        display.setTextColor(SSD1306_WHITE);
        dispCommit();
        delay(12);
    }
    delay(holdMs);
    // Flipper tarzı fade-out: banner aşağıya kayar
    for (int16_t y = TARGET_Y; y <= OLED_H + 10; y += 7) {
        dispClear();
        display.fillRoundRect(4, y, OLED_W - 8, 22, 3, SSD1306_WHITE);
        bannerDrawIcon(btype, 8, y + 4);
        display.drawFastVLine(24, y + 2, 18, SSD1306_BLACK);
        display.setTextColor(SSD1306_BLACK); display.setTextSize(1);
        int16_t x1,y1; uint16_t tw,th;
        display.getTextBounds(msg.c_str(), 0, 0, &x1, &y1, &tw, &th);
        int16_t tx = 26 + max(0, (int)(OLED_W - 30 - tw) / 2);
        display.setCursor(tx, y + 7);
        display.print(msg);
        display.setTextColor(SSD1306_WHITE);
        dispCommit();
        delay(10);
    }
    dispClear(); dispCommit();
}

