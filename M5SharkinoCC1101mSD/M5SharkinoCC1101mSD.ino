    bruceHtmlFooter();
}

// ─── GET /sd — SD kart dosya gezgini ─────────────────────
static void bruceHandleSD() {
    String path = "/";
    if (g_bruceServer->hasArg("path")) path = g_bruceServer->arg("path");

    // İndirme isteği
    if (g_bruceServer->hasArg("dl")) {
        String dlPath = g_bruceServer->arg("dl");
        if (!g_sdInited) { g_bruceServer->send(500,"text/plain","SD not mounted"); return; }
        File f = SD.open(dlPath.c_str(), FILE_READ);
        if (!f) { g_bruceServer->send(404,"text/plain","File not found"); return; }
        String fname = dlPath.substring(dlPath.lastIndexOf('/') + 1);
        g_bruceServer->sendHeader("Content-Disposition", "attachment; filename=\"" + fname + "\"");
        g_bruceServer->streamFile(f, "application/octet-stream");
        f.close(); return;
    }

    // Silme isteği
    if (g_bruceServer->hasArg("rm")) {
        String rmPath = g_bruceServer->arg("rm");
        if (g_sdInited) {
            SD.remove(rmPath.c_str());
            logPush("[WEBUI] Deleted: " + rmPath);
        }
        g_bruceServer->sendHeader("Location", "/sd?path=" + path);
        g_bruceServer->send(302, "text/plain", "");
        return;
    }

    if (!g_sdInited) {
        g_bruceServer->send(200, "text/html",
            String(FPSTR(WEBUI_HEAD)) + FPSTR(WEBUI_CSS) + FPSTR(WEBUI_HEAD2) +
            "<div class='card'><h2>SD Card</h2><p style='color:#e94560'>SD not mounted.</p></div>"
            "</div></body></html>");
        return;
    }

    g_bruceServer->setContentLength(CONTENT_LENGTH_UNKNOWN);
    g_bruceServer->send(200, "text/html", "");
    bruceHtmlHeader();

    // Dizin listesi
    File root = SD.open(path.c_str());
    String content = "<div class='card'><h2>&#128190; SD Card &mdash; " + path + "</h2>";
    if (path != "/") {
        String parent = path.substring(0, path.lastIndexOf('/'));
        if (parent.isEmpty()) parent = "/";
        content += "<a class='btn btn-sm' href='/sd?path=" + parent + "'>&#8593; Up</a>&nbsp;";
    }
    // SD bilgisi
    uint64_t tot = SD.totalBytes(), used = SD.usedBytes();
    content += "<div class='row' style='margin-top:8px'>"
               "<span class='label'>Used</span><span class='val'>"
               + String((uint32_t)(used/1024)) + " / " + String((uint32_t)(tot/1024)) + " KB</span></div>";
    content += "<table><tr><th>Name</th><th>Size</th><th>Action</th></tr>";
    g_bruceServer->sendContent(content);

    if (root && root.isDirectory()) {
        File entry = root.openNextFile();
        while (entry) {
            String name = String(entry.name());
            int sl = name.lastIndexOf('/');
            if (sl >= 0) name = name.substring(sl + 1);
            String entryPath = path;
            if (!entryPath.endsWith("/")) entryPath += "/";
            entryPath += name;

            String row = "<tr><td>";
            if (entry.isDirectory()) {
                row += "&#128193; <a href='/sd?path=" + entryPath + "'>" + name + "</a>";
            } else {
                row += "&#128196; " + name;
            }
            row += "</td><td>";
            if (!entry.isDirectory()) {
                uint32_t sz = entry.size();
                if (sz < 1024) row += String(sz) + " B";
                else           row += String(sz/1024) + " KB";
            } else {
                row += "&mdash;";
            }
            row += "</td><td>";
            if (!entry.isDirectory()) {
                row += "<a class='btn btn-sm btn-blue' href='/sd?dl=" + entryPath + "'>&#8595;</a> ";
                row += "<a class='btn btn-sm badge-err' href='/sd?rm=" + entryPath + "&path=" + path + "' onclick=\"return confirm('Delete " + name + "?')\">&#10005;</a>";
            }
            row += "</td></tr>";
            g_bruceServer->sendContent(row);
            entry = root.openNextFile();
        }
        root.close();
    }
    g_bruceServer->sendContent("</table></div>");
    bruceHtmlFooter();
}

