// (yukarıdaki helper'lar ek araçlar olarak eklendi,
//  orijinal dispStatusBar() fonksiyonu aşağıda kalmaya devam eder)

// ═══════════════════════════════════════════════════════════
//  END FLIPPER UI ASSETS
// ═══════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════
//  FLIPPER ZERO DOLPHIN ANIMATION SYSTEM — Full Integration
//  Kaynak: flipperdevices/flipperzero-firmware assets/dolphin
//  3 Kategori:
//    BLOCKING  (5 anim) — sistem bildirimleri: NoDb,SdBad,SdOk,Url,NewMail
//    INTERNAL  (3 anim) — firmware gömülü idle: Tv,BadBattery,NoSd
//    EXTERNAL  (32 anim) — SD kart idle: L1/L2/L3 seviye animasyonları
//
//  Gerçek Flipper boyutları: 128×50..64 piksel (çok fazla flash yer)
//  ESP32-S3 PROGMEM bütçesi için: animasyonlar 64×32 px, 1bpp
//  çizici: drawAnimFrame64(x,y,bmp,col)
//  Her animasyon: 1 veya 2 sembolik frame (idle loop için)
//  showIdleScreen() kategori seçimini XP level'a göre yapar
// ═══════════════════════════════════════════════════════════

// ─── Animasyon Frame boyutları ───────────────────────────
// Dolphin idle: 64×36 px — 8 byte/satır × 36 satır = 288 byte/frame
#define ANI_W            64
#define ANI_H            36
#define ANI_BYTES        (ANI_W/8 * ANI_H)   // 288 byte/frame

// Blocking / status animasyonlar: 128×14 px banner formatı
// 16 byte/satır × 14 satır = 224 byte/frame
#define BLOCK_W          128
#define BLOCK_H          14
#define BLOCK_BYTES      (BLOCK_W/8 * BLOCK_H)  // 224 byte

// ─── 64×36 frame çizici (8 byte/satır) ──────────────────
static void drawAnimFrame64(int16_t x, int16_t y, const uint8_t* bmp, uint16_t col) {
    for (int row = 0; row < ANI_H; row++) {
        // 8 byte = 64 bit per row
        for (int b = 0; b < 8; b++) {
            uint8_t byte = pgm_read_byte(bmp + row*8 + b);
            for (int bit = 0; bit < 8; bit++) {
                if (byte & (0x80 >> bit))
                    display.drawPixel(x + b*8 + bit, y + row, col);
            }
        }
    }
}

// ─── 128×14 banner frame çizici ─────────────────────────
static void drawBlockFrame128(int16_t y, const uint8_t* bmp, uint16_t col) {
    for (int row = 0; row < BLOCK_H; row++) {
        for (int b = 0; b < 16; b++) {
            uint8_t byte = pgm_read_byte(bmp + row*16 + b);
            for (int bit = 0; bit < 8; bit++) {
                if (byte & (0x80 >> bit))
                    display.drawPixel(b*8 + bit, y + row, col);
            }
        }
    }
}

