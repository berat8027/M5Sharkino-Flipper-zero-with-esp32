// Pot → PWM simülasyon göstergesi
static void analog_pwm_visualizer_run() {
    dispClear(); dispStatusBar("PWM Visualizer");
    dispText(0, 54, "[BTN] back");
    uint32_t frame = 0;
    while (!readButton()) {
        potApplyBrightness();
        uint16_t raw   = analogRead(PIN_POT);
        uint8_t  duty  = map(raw, 0, 4095, 0, 100);
        uint16_t freq  = map(analogRead(PIN_JOY_X), 0, 4095, 1, 200);

        // PWM dalga çiz
        dispClear(); dispStatusBar("PWM Visualizer");
        dispText(0, 12, "Duty: " + String(duty) + "%");
        dispText(64, 12, "Freq: " + String(freq) + "Hz");
        // Dalga formu: 1 periyot = 64px genişlik
        uint8_t highW = map(duty, 0, 100, 0, 64);
        uint8_t waveY = 28;
        // Periyot 1
        display.drawFastHLine(0,   waveY,    highW,    SSD1306_WHITE);
        display.drawFastVLine(highW, waveY,  8,         SSD1306_WHITE);
        display.drawFastHLine(highW, waveY+8, 64-highW, SSD1306_WHITE);
        display.drawFastVLine(64,  waveY+8, -8,         SSD1306_WHITE);
        // Periyot 2
        display.drawFastHLine(64,    waveY,    highW,    SSD1306_WHITE);
        display.drawFastVLine(64+highW,waveY,  8,        SSD1306_WHITE);
        display.drawFastHLine(64+highW,waveY+8,64-highW, SSD1306_WHITE);
        // Duty bar
        display.drawRect(0, 42, OLED_W-4, 8, SSD1306_WHITE);
        display.fillRect(0, 42, map(duty,0,100,0,OLED_W-4), 8, SSD1306_WHITE);
        dispText(0, 54, "[BTN] back");
        dispCommit();
        frame++;
        delay(20);
    }
}

// Pot → Frekans Analiz (FFT yok, ADC örnekleme hızı analizi)
static void analog_sampling_run() {
    uint8_t  pin = PIN_POT;
    uint32_t sampleCount = 0;
    uint32_t tStart = millis();
    uint16_t minV = 4095, maxV = 0;
    uint32_t sumV = 0;
    static uint16_t hist2[ADC_HISTORY_LEN];
    uint8_t hi2 = 0;

    while (!readButton()) {
        potApplyBrightness();
        uint16_t v = analogRead(pin);
        hist2[hi2 % ADC_HISTORY_LEN] = v;
        hi2++; sampleCount++;
        if (v < minV) minV = v;
        if (v > maxV) maxV = v;
        sumV += v;
        uint32_t elapsed = millis() - tStart;
        uint32_t sps     = elapsed > 0 ? (sampleCount * 1000) / elapsed : 0;
        uint16_t avg     = sampleCount > 0 ? sumV / sampleCount : 0;

        if (sampleCount % 20 == 0) {
            dispClear(); dispStatusBar("ADC Sampling");
            dispText(0, 12, "SPS: " + String(sps));
            dispText(0, 22, "Min:" + String(minV) + " Max:" + String(maxV));
            dispText(0, 32, "Avg:" + String(avg) + " Now:" + String(v));
            // Realtime trace
            display.drawRect(0, 42, OLED_W, 18, SSD1306_WHITE);
            uint16_t mn2 = max((uint16_t)1, minV);
            uint16_t rng = max((uint16_t)1, (uint16_t)(maxV - mn2));
            for (uint8_t i = 1; i < ADC_HISTORY_LEN && i < hi2; i++) {
                uint16_t v0 = hist2[(hi2-i-1+ADC_HISTORY_LEN) % ADC_HISTORY_LEN];
                uint16_t v1 = hist2[(hi2-i  +ADC_HISTORY_LEN) % ADC_HISTORY_LEN];
                uint8_t y0 = 58 - map(v0, mn2, mn2+rng, 0, 14);
                uint8_t y1 = 58 - map(v1, mn2, mn2+rng, 0, 14);
                uint8_t x0 = OLED_W - i;
                if (x0 > 1) display.drawLine(x0, y0, x0+1, y1, SSD1306_WHITE);
            }
            dispText(0, 58, "[BTN]");
            dispCommit();
        }
    }
    dispBannerOK("SPS=" + String(sampleCount > 0 && millis()-tStart > 0 ?
        (sampleCount*1000)/(millis()-tStart) : 0));
}

// Pot → voltaj/akım simülasyon hesaplayıcı
static void analog_voltage_calc_run() {
    while (!readButton()) {
        potApplyBrightness();
        uint16_t raw   = analogRead(PIN_POT);
        float    vIn   = raw * 3.3f / 4095.0f;
        // Assume voltage divider R1=10k R2=10k, display both
        float    vOut  = vIn * 2.0f;  // ÷ divider
        float    curr  = vIn / 10000.0f * 1000.0f; // mA at 10k load

        // Joy X → R1 simülasyonu (1k-100k)
        uint16_t jx = analogRead(PIN_JOY_X);
        float    r1  = map(jx, 0, 4095, 1000, 100000);
        float    vDivOut = vIn * 10000.0f / (r1 + 10000.0f);

        dispClear(); dispStatusBar("Voltage Calc");
        char line[32];
        snprintf(line, sizeof(line), "ADC: %.3fV raw:%d", vIn, raw);
        dispText(0, 12, line);
        snprintf(line, sizeof(line), "VDiv(R2=10k): %.3fV", vDivOut);
        dispText(0, 22, line);
        snprintf(line, sizeof(line), "R1: %.0f ohm", r1);
        dispText(0, 32, line);
        snprintf(line, sizeof(line), "I@10k: %.2f mA", curr);
        dispText(0, 42, line);
        dispText(0, 52, "Pot:Vin JoyX:R1");
        dispCommit();
        delay(80);
    }
}

// Pot → tone generator (PWM buzzer output varsa)
static void analog_tone_gen_run() {
    // Pot → frekans, Joy Y → volume (duty)
    dispClear(); dispStatusBar("Tone Gen");
    dispText(0, 14, "Pot: Frequency");
    dispText(0, 24, "JoyY: Duty (vol)");
    dispText(0, 34, "No buzzer: display");
    dispText(0, 44, "only mode");
    dispText(0, 54, "[BTN] back");
    dispCommit();
    delay(600);

    while (!readButton()) {
        potApplyBrightness();
        uint16_t raw  = analogRead(PIN_POT);
        uint16_t freq = map(raw, 0, 4095, 20, 20000);
        uint16_t jy   = analogRead(PIN_JOY_Y);
        uint8_t  duty = map(jy, 0, 4095, 0, 100);

        // Note name
        const char* notes[] = {"C","C#","D","D#","E","F","F#","G","G#","A","A#","B"};
        int semitone = (int)(12.0f * log2f(freq / 16.35f)) % 12;
        if (semitone < 0) semitone += 12;
        int octave   = (int)(log2f(freq / 16.35f));

        dispClear(); dispStatusBar("Tone Generator");
        dispText(0, 12, "Freq: " + String(freq) + " Hz");
        dispText(0, 22, "Note: " + String(notes[semitone]) + String(octave));
        dispText(0, 32, "Duty: " + String(duty) + "%");
        // Freq bar
        display.drawRect(0, 44, OLED_W, 8, SSD1306_WHITE);
        display.fillRect(0, 44, map(freq,20,20000,0,OLED_W), 8, SSD1306_WHITE);
        dispText(0, 56, "Pot:freq JoyY:vol");
        dispCommit();
        delay(40);
    }
}

// Ohm metre simülasyonu (2 ADC pini gerilim bölücü prensibi)
static void analog_ohmmeter_run() {
    // PIN_JOY_X (R bilinmeyen) ve PIN_POT (Vref):
    // Vref → R_known (10kΩ bilinen) → PIN_JOY_X → GND
    // V_jx = Vref * Runknown / (Rknown + Runknown)
    static constexpr float R_KNOWN   = 10000.0f; // 10kΩ
    static constexpr float VREF      = 3.3f;

    while (!readButton()) {
        potApplyBrightness();
        uint16_t rawX  = analogRead(PIN_JOY_X);
        float    vJX   = rawX * VREF / 4095.0f;
        float    rUnk  = 0.0f;
        if (vJX < VREF - 0.01f) {
            rUnk = R_KNOWN * vJX / (VREF - vJX);
        }
        // Range display
        String rStr;
        if      (rUnk >= 1000000.0f) { char b[12]; dtostrf(rUnk/1000000.0f,5,2,b); rStr=String(b)+"MΩ"; }
        else if (rUnk >= 1000.0f)    { char b[12]; dtostrf(rUnk/1000.0f,5,2,b);    rStr=String(b)+"kΩ"; }
        else                          { char b[12]; dtostrf(rUnk,5,1,b);             rStr=String(b)+"Ω";  }

        dispClear(); dispStatusBar("Ohmmeter");
        dispText(0, 12, "R= " + rStr);
        dispText(0, 24, "Vout= " + String(vJX, 3) + " V");
        dispText(0, 34, "Rknown= 10kΩ");
        // Log scale bar
        display.drawRect(0, 46, OLED_W, 8, SSD1306_WHITE);
        uint8_t barW2 = rUnk > 0 ? map((int)log10f(max(1.0f,rUnk)), 0, 7, 0, OLED_W) : 0;
        display.fillRect(0, 46, barW2, 8, SSD1306_WHITE);
        dispText(0, 58, "JoyX:probe POT:bri");
        dispCommit();
        delay(80);
    }
}

