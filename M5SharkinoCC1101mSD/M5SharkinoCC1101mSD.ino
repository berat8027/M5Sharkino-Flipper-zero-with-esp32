        "<div class='row'><span class='label'>WiFi scans</span><span class='val'>" + String(g_xpWifiCnt) + "</span></div>"
        "<div class='row'><span class='label'>BLE scans</span><span class='val'>" + String(g_xpBleCnt) + "</span></div>"
        "<div class='row'><span class='label'>RF captures</span><span class='val'>" + String(g_xpRfCnt) + "</span></div>"
        "</div>";
    g_bruceServer->sendContent(xpCard);

    // Modül durumu kartı
    String modCard = "<div class='card'><h2>&#128268; Modules</h2><div class='modgrid'>"
        "<div class='modcard " + String(g_cfg.wifiEnabled ? "on" : "") + "'><div class='icon'>&#128251;</div><div class='name'>WiFi</div></div>"
        "<div class='modcard " + String(g_cfg.bleEnabled ? "on" : "") + "'><div class='icon'>&#128225;</div><div class='name'>BLE</div></div>"
        "<div class='modcard " + String(g_cfg.rfidEnabled ? "on" : "") + "'><div class='icon'>&#128276;</div><div class='name'>RFID</div></div>"
        "<div class='modcard " + String(g_sdInited ? "on" : "") + "'><div class='icon'>&#128190;</div><div class='name'>SD</div></div>"
        "<div class='modcard " + String(g_spiffsInited ? "on" : "") + "'><div class='icon'>&#128193;</div><div class='name'>SPIFFS</div></div>"
        "<div class='modcard " + String(g_staConnected ? "on" : "") + "'><div class='icon'>&#127758;</div><div class='name'>STA</div></div>"
        "</div></div>";
    g_bruceServer->sendContent(modCard);

    // Hızlı komut kartı
    String cmdCard = "<div class='card'><h2>&#9881; Remote Command</h2>"
        "<form method='POST' action='/cmd'>"
        "<select name='cmd'>"
