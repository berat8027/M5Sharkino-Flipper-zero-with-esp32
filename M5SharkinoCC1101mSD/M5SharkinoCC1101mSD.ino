// ── Yeni PIN giriş — pinLockCheck ile aynı spinner UI ────
// title: ekran başlığı, outPin: 5 byte buffer (4 rakam + null)
// Dönüş: true=onaylandı, false=iptal
static bool pinEnterNew(const char* title, char* outPin) {
    uint8_t pos = 0;
    static const char DIGITS[] = "0123456789";
    uint8_t digitIdx[4] = {0, 0, 0, 0};

    auto drawScreen = [&]() {
        dispClear();
        display.fillRect(0, 0, OLED_W, 11, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setTextSize(1);
        drawBitmap8(2, 1, FLIPPER_ICO8_LOCK, SSD1306_BLACK);
        uint8_t tx = (OLED_W - strlen(title)*6) / 2;
        display.setCursor(tx, 2);
        display.print(title);
        display.setTextColor(SSD1306_WHITE);

        const int SLOT_W   = 22;
        const int SLOT_GAP = 4;
        const int SLOTS_X  = (OLED_W - (4 * SLOT_W + 3 * SLOT_GAP)) / 2;
        const int SLOTS_Y  = 14;

        for (uint8_t i = 0; i < 4; i++) {
            int sx = SLOTS_X + i * (SLOT_W + SLOT_GAP);
            bool isCurrent = (i == pos);
            bool isFilled  = (i < pos);
            if (isCurrent) {
                display.fillRoundRect(sx, SLOTS_Y, SLOT_W, SLOT_W, 3, SSD1306_WHITE);
                display.setTextColor(SSD1306_BLACK);
                display.setTextSize(2);
                display.setCursor(sx + (SLOT_W - 12) / 2, SLOTS_Y + 3);
                display.print(DIGITS[digitIdx[i]]);
                display.setTextColor(SSD1306_WHITE);
                display.fillTriangle(sx + SLOT_W/2 - 3, SLOTS_Y + SLOT_W + 2,
                                     sx + SLOT_W/2 + 3, SLOTS_Y + SLOT_W + 2,
                                     sx + SLOT_W/2,     SLOTS_Y + SLOT_W + 5,
                                     SSD1306_WHITE);
                display.fillTriangle(sx + SLOT_W/2 - 3, SLOTS_Y - 2,
                                     sx + SLOT_W/2 + 3, SLOTS_Y - 2,
                                     sx + SLOT_W/2,     SLOTS_Y - 6,
                                     SSD1306_WHITE);
            } else if (isFilled) {
                display.drawRoundRect(sx, SLOTS_Y, SLOT_W, SLOT_W, 3, SSD1306_WHITE);
                display.setTextSize(2); display.setTextColor(SSD1306_WHITE);
                display.setCursor(sx + 5, SLOTS_Y + 3);
                display.print("*");
            } else {
                display.drawRoundRect(sx, SLOTS_Y, SLOT_W, SLOT_W, 3, SSD1306_WHITE);
                display.drawFastHLine(sx + 4, SLOTS_Y + SLOT_W - 4, SLOT_W - 8, SSD1306_WHITE);
            }
        }
        display.fillRect(0, 54, OLED_W, 10, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK); display.setTextSize(1);
        display.fillTriangle(2, 56, 2, 62, 0, 59, SSD1306_BLACK);
        display.setCursor(5, 56); display.print("Cancel");
        display.setCursor(88, 56); display.print("OK");
        display.fillTriangle(OLED_W-4, 56, OLED_W-4, 62, OLED_W-2, 59, SSD1306_BLACK);
        display.setTextColor(SSD1306_WHITE);
        dispCommit();
    };

    while (pos < 4) {
        drawScreen();
        JoyDir d = readJoystick();
        if (d == JoyDir::UP)   { digitIdx[pos] = (digitIdx[pos] + 1) % 10; buzzNav(); }
        if (d == JoyDir::DOWN) { digitIdx[pos] = (digitIdx[pos] + 9) % 10; buzzNav(); }
        if (readButton()) {
            outPin[pos] = DIGITS[digitIdx[pos]];
            pos++;
            outPin[pos] = '\0';
            if (pos < 4) buzzNav(); else buzzSelect();
        }
        if (readButtonLong()) { buzzErr(); return false; }
        delay(40);
    }
    return true;
}

static void cfg_pin_setup_run() {
    if (g_cfg.pinLockEnable) {
        // Disable: mevcut PIN'i doğrula
        if (!pinLockCheck()) return;
        g_cfg.pinLockEnable = false;
        cfg_save();
        dispBanner("PIN Lock: OFF");
    } else {
        char buf[8] = "";
        if (pinEnterNew("Set New PIN", buf)) {
            strncpy(g_cfg.pinCode, buf, 7);
            g_cfg.pinLockEnable = true;
            cfg_save();
            dispBannerOK("PIN Lock: ON");
        }
    }
}

static void cfg_toggle_run(bool& flag, const String& name) {
    flag = !flag;
    cfg_save();
    // Devre dışı bırakıldıysa aktif oturumu kapat
    if (!flag) {
        if (name == "WiFi") { WiFi.mode(WIFI_OFF); }
        if (name == "BLE")  { bleAdvDeinit(); }
    }
    dispBanner(name + ": " + (flag ? "ON" : "OFF"));
}

