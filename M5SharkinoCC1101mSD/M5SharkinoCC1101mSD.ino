// ── Flipper Zero birebir level eşikleri ───────────────────
static uint32_t xpForLevel(uint8_t lv) {
    // Flipper Zero: XP = (lv-1)^2 * 100
    static const uint32_t XP_TABLE[31] = {
        0, 0, 100, 400, 900, 1600, 2500, 3600, 4900, 6400, 8100,
        10000, 12100, 14400, 16900, 19600, 22500, 25600, 28900, 32400, 36100,
        40000, 44100, 48400, 52900, 57600, 62500, 67600, 72900, 78400, 84100
    };
    if (lv < 1)  lv = 1;
    if (lv > 30) lv = 30;
    return XP_TABLE[lv];
}

// ── Mevcut level'da ilerleme yüzdesi [0-100] ──────────────
static uint8_t xpLevelPct() {
    if (g_level >= XP_MAX_LEVEL) return 100;
    uint32_t cur  = xpForLevel(g_level);
    uint32_t next = xpForLevel(g_level + 1);
    if (next <= cur) return 100;
    uint32_t span = next - cur;
    uint32_t prog = (g_xp > cur) ? (g_xp - cur) : 0;
    return (uint8_t)min(100UL, prog * 100UL / span);
}

// ── Flipper Zero birebir rank isimleri ────────────────────
static const char* xpRankName(uint8_t lv) {
    if (lv <=  2) return "Newbie";
    if (lv <=  4) return "Script Kid";
    if (lv <=  7) return "Tinkerer";
    if (lv <= 10) return "Hacker";
    if (lv <= 13) return "Pro Hacker";
    if (lv <= 16) return "Expert";
    if (lv <= 19) return "Elite";
    if (lv <= 22) return "Cyber Ninja";
    if (lv <= 25) return "Ghost";
    if (lv <= 27) return "Phantom";
    if (lv <= 29) return "Shadow God";
    return "Zero Cool";
}

