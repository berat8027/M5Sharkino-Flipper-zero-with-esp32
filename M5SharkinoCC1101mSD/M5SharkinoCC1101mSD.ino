                        if (d == JoyDir::DOWN && ms > 50)   ms -= 50;
                        dispClear(); dispStatusBar("RFID Poll");
                        dispText(0,22,"Interval: " + String(ms) + " ms");
                        dispText(0,36,"Lower = faster detect");
                        dispText(0,54,"U/D: adj  BTN:save");
                        dispCommit(); delay(80);
                    }
                    prefs.begin("settings2", false);
                    prefs.putUShort("rfidPoll", ms);
                    prefs.end();
                    dispBannerOK("RFID Poll: " + String(ms) + "ms");
                }},
            // KARMA Auto (probe'lara otomatik yanıt)
            {"KARMA Auto " + String(karmaAuto?"[ON]":"[OFF]"),
                [karmaAuto]() {
                    bool v = !karmaAuto;
                    prefs.begin("settings2", false);
                    prefs.putBool("karmaAuto", v);
                    prefs.end();
                    dispBannerOK(String("KARMA Auto: ") + (v?"ON":"OFF"));
                }},
            // Probe Loglama
            {"Probe Log " + String(probeLog?"[ON]":"[OFF]"),
                [probeLog]() {
                    bool v = !probeLog;
                    prefs.begin("settings2", false);
                    prefs.putBool("probeLog", v);
                    prefs.end();
                    dispBannerOK(String("Probe Log: ") + (v?"ON":"OFF"));
                }},
            // Tüm Radyoları Kapat
            {"All Radios OFF",
                []() {
                    esp_wifi_set_promiscuous(false);
                    esp_wifi_set_promiscuous_rx_cb(nullptr);
                    WiFi.mode(WIFI_OFF);
                    bleAdvDeinit();
                    g_cfg.wifiEnabled = false;
                    g_cfg.bleEnabled  = false;
                    cfg_save();
                    dispBannerOK("All radios OFF");
                }},
            {"Back", [](){}},
        };
        int sel = loopOptions(opts, "Radio");
        if (sel < 0 || sel == (int)opts.size()-1) return;
        opts[sel].action();
    }
}

// ── Ana Settings menüsü (4 kategori) ────────────────────
class SettingsMenu : public MenuItem {
public:
    String getName() override { return "Settings"; }
    void drawShape(int x, int y, uint16_t col) {
        int cx = x+16, cy = y+14;
        for (int t = 0; t < 8; t++) {
            float ang = t * 3.14159f * 2 / 8;
            int x1 = cx + (int)(9  * cos(ang));
            int y1 = cy + (int)(9  * sin(ang));
            int x2 = cx + (int)(12 * cos(ang));
            int y2 = cy + (int)(12 * sin(ang));
            display.drawLine(x1, y1, x2, y2, col);
            display.drawLine(x1+1, y1, x2+1, y2, col);
        }
        display.drawCircle(cx, cy, 9, col);
        display.drawCircle(cx, cy, 4, col);
        display.fillCircle(cx, cy, 3, col);
        int sy = y+27;
        display.drawFastHLine(x+3, sy,   26, col);
        display.drawFastHLine(x+3, sy+4, 26, col);
        display.drawFastHLine(x+3, sy+8, 26, col);
        display.fillRect(x+7,  sy-1, 4, 4, col);
        display.fillRect(x+17, sy+3, 4, 4, col);
        display.fillRect(x+10, sy+7, 4, 4, col);
    }
    void drawIcon(int x, int y) override    { drawShape(x, y, SSD1306_WHITE); }
    void drawIconInv(int x, int y) override { drawShape(x, y, SSD1306_BLACK); }
    void drawIconSmall(int x, int y, uint16_t col) override {
        // Dişli + 3 slider çizgi, 16x16
        int cx = x+8, cy = y+6;
        for (int t = 0; t < 6; t++) {
            float a = t * 3.14159f * 2 / 6;
            display.drawLine(cx+(int)(4*cos(a)), cy+(int)(4*sin(a)),
                             cx+(int)(6*cos(a)), cy+(int)(6*sin(a)), col);
        }
        display.drawCircle(cx, cy, 4, col);
        display.fillCircle(cx, cy, 2, col);
        display.drawFastHLine(x+2, y+13, 12, col);
        display.fillRect(x+3, y+12, 2, 2, col);
        display.fillRect(x+9, y+12, 2, 2, col);
    }
    void runMenu() override {
        while (!g_returnToMenu) {
            String muteLabel = g_buzzerMuted ? "Buzzer: SESSIZ [AC]" : "Buzzer: Acik [KAPAT]";
            OptionList opts = {
                {">> Display",    []() { settings_display_menu(); }},
                {">> Hardware",   []() { settings_hardware_menu(); }},
                {">> Security",   []() { settings_security_menu(); }},
                {">> Radio",      []() { settings_radio_menu(); }},
                {muteLabel,       []() { buzzToggleMute(); }},
                {"Back",          []() { backToMenu(); }},
            };
            int sel = loopOptions(opts, "Settings");
            if (sel < 0) { backToMenu(); break; }
            if (sel >= 0 && sel < (int)opts.size()) opts[sel].action();
        }
    }
};

