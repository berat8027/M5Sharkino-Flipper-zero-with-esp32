    {0xA0,0x47,0x8C,0xC3,0x90,0x91},
    {0x53,0x3C,0xB6,0xC7,0x23,0xF6},
    {0x8F,0xD0,0xA4,0xF2,0x56,0xE9},
    {0x0A,0x14,0x1F,0xA9,0x61,0x5B},
    {0x84,0x96,0xA9,0x82,0x92,0xDB},
    {0xC9,0x84,0x16,0x0D,0x72,0x9A},
    {0x73,0x10,0x64,0xD0,0x32,0x64},
    {0xE0,0x6D,0x4A,0xAE,0xA0,0xE4},
    {0x18,0x00,0x00,0x00,0x00,0x00},
    {0x20,0x00,0x00,0x00,0x00,0x00},
};
static constexpr uint8_t COMMON_KEY_COUNT = 20;

struct SectorKey {
    uint8_t  sector;
    uint8_t  keyType; // 0=A 1=B
    uint8_t  keyIdx;
    bool     found;
};

static std::vector<SectorKey> g_foundKeys;

static void rfid_bruteforce_run() {
    rfidReinit();
    dispClear(); dispStatusBar("Bruteforce");
    dispText(0, 14, "Present Mifare 1K");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    g_foundKeys.clear();
    uint8_t tested = 0;
    uint16_t totalTests = MIFARE_SECTOR_COUNT * COMMON_KEY_COUNT * 2;

    for (uint8_t sector = 0; sector < MIFARE_SECTOR_COUNT && !readButtonLong(); sector++) {
        uint8_t block = sector * 4;
        bool foundA = false, foundB = false;

        for (uint8_t ki = 0; ki < COMMON_KEY_COUNT && !foundA; ki++) {
            MFRC522::MIFARE_Key key;
            memcpy(key.keyByte, COMMON_KEYS[ki], 6);
            if (rfidAuth(block, key)) {
                g_foundKeys.push_back({sector, 0, ki, true});
                foundA = true;
                char kStr[13];
                sprintf(kStr, "%02X%02X%02X%02X%02X%02X",
                        COMMON_KEYS[ki][0], COMMON_KEYS[ki][1], COMMON_KEYS[ki][2],
                        COMMON_KEYS[ki][3], COMMON_KEYS[ki][4], COMMON_KEYS[ki][5]);
                logPush("[BF] S" + String(sector) + " KeyA=" + kStr);
            }
            rfid.PCD_StopCrypto1();
            // Auth başarısız sonrası kartı WakeupA ile yeniden aktive et
            // PICC_IsNewCardPresent değil — kart zaten alanda, sadece uyandır
            if (!foundA) {
                rfid.PICC_HaltA();
                delay(8);
                byte bufATQA[2]; byte bufSize = sizeof(bufATQA);
                rfid.PICC_WakeupA(bufATQA, &bufSize);
                rfid.PICC_ReadCardSerial();
            }
            tested++;
            if (tested % 8 == 0)
                dispProgress("Bruteforce", "S" + String(sector) + " K" + String(ki), (tested*100)/totalTests);
        }

        for (uint8_t ki = 0; ki < COMMON_KEY_COUNT && !foundB; ki++) {
            MFRC522::MIFARE_Key key;
            memcpy(key.keyByte, COMMON_KEYS[ki], 6);
            if (rfidAuthB(block, key)) {
                g_foundKeys.push_back({sector, 1, ki, true});
                foundB = true;
            }
            rfid.PCD_StopCrypto1();
            if (!foundB) {
                rfid.PICC_HaltA();
                delay(8);
                byte bufATQA[2]; byte bufSize = sizeof(bufATQA);
                rfid.PICC_WakeupA(bufATQA, &bufSize);
                rfid.PICC_ReadCardSerial();
            }
            tested++;
        }
    }

    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();

    if (g_foundKeys.empty()) { dispBannerWarn("No keys found"); return; }

    OptionList res;
    for (auto& k : g_foundKeys) {
        char kStr[13];
        memcpy(kStr, COMMON_KEYS[k.keyIdx], 6);
        char label[30];
        sprintf(label, "S%02d Key%c: %02X%02X%02X%02X%02X%02X",
                k.sector, k.keyType ? 'B' : 'A',
                COMMON_KEYS[k.keyIdx][0], COMMON_KEYS[k.keyIdx][1],
                COMMON_KEYS[k.keyIdx][2], COMMON_KEYS[k.keyIdx][3],
                COMMON_KEYS[k.keyIdx][4], COMMON_KEYS[k.keyIdx][5]);
        res.push_back({label, [](){}});
    }
    res.push_back({"Back", [](){}});
    loopOptions(res, "Found Keys (" + String(g_foundKeys.size()) + ")");
}

static void rfid_write_block_run() {
    rfidReinit();
    if (!g_hasDump && !g_hasUID) { dispBanner("Read/dump first"); return; }

    dispClear(); dispStatusBar("Write Block");
    dispText(0, 14, "Pot: block sec");
    dispText(0, 24, "Joy: fine tune");
    dispText(0, 54, "[BTN] confirm");
    dispCommit();

    // Pot → block seçimi (0-63 arası), joystick fine tune
    uint8_t blk = 1;
    while (!readButton()) {
        // Pot ana kontrol
        uint16_t potRaw = analogRead(PIN_POT);
        blk = map(potRaw, 0, 4095, 0, 63);
        // Joystick ince ayar
        JoyDir d = readJoystick();
        if (d == JoyDir::UP   && blk < 63) blk++;
        if (d == JoyDir::DOWN && blk > 0)  blk--;
        dispClear(); dispStatusBar("Write Block");
        dispText(0, 20, "Block: " + String(blk));
        if (g_hasDump) {
            String hex;
            for (uint8_t i = 0; i < 16; i++) {
                char h[3]; sprintf(h, "%02X", g_sectorDump[blk][i]);
                hex += h; if (i < 15) hex += " ";
            }
            dispText(0, 34, hex.substring(0, 23));
            dispText(0, 44, hex.substring(23));
        }
        dispText(0, 56, "[BTN] write this");
        dispCommit();
        delay(50);
    }

    if (blk % 4 == 3) { dispBanner("Sector trailers skip"); return; }

    dispClear(); dispStatusBar("Writing...");
    dispText(0, 20, "Present writable tag");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    MFRC522::MIFARE_Key keyFF;
    for (uint8_t i = 0; i < 6; i++) keyFF.keyByte[i] = 0xFF;
    rfid.PCD_StopCrypto1();  // önceki oturumu temizle
    rfidAuth(blk, keyFF);

    uint8_t data[16];
    if (g_hasDump) memcpy(data, g_sectorDump[blk], 16);
    else memset(data, 0xAA, 16);

    MFRC522::StatusCode st = rfid.MIFARE_Write(blk, data, 16);
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    logPush("[WRITE] blk=" + String(blk) + " " + (st == MFRC522::STATUS_OK ? "OK" : "FAIL"));
    dispBanner(st == MFRC522::STATUS_OK ? "Write OK" : "Write FAIL");
}

static void rfid_write_ndef_run() {
    rfidReinit();
    // Write NDEF URL record to Mifare Ultralight
    static const char NDEF_URL_HOST[] = "github.com/beroxx/m5sharkino";
    static constexpr uint8_t URL_PREFIX = 0x04; // https://

    uint8_t hostLen = strlen(NDEF_URL_HOST);
    uint8_t payloadLen = 1 + hostLen;
    uint8_t recLen = 5 + payloadLen; // header + type + payload
    uint8_t tlvLen = 2 + recLen;     // T + L + V

    uint8_t buf[48] = {0};
    uint8_t idx = 0;
    buf[idx++] = 0x03;         // NDEF TLV tag
    buf[idx++] = recLen;       // length
    buf[idx++] = 0xD1;         // MB|ME|SR|TNF=Well-Known
    buf[idx++] = 0x01;         // type length
    buf[idx++] = payloadLen;   // payload length
    buf[idx++] = 0x55;         // type: U (URL)
    buf[idx++] = URL_PREFIX;
    memcpy(buf + idx, NDEF_URL_HOST, hostLen); idx += hostLen;
    buf[idx++] = 0xFE;         // terminator TLV

    dispClear(); dispStatusBar("NDEF Write");
    dispText(0, 12, "URL: https://");
    dispText(0, 22, NDEF_URL_HOST);
    dispText(0, 36, "Present Ultralight");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    bool ok = true;
    for (uint8_t page = 0; idx > page * 4 && ok; page++) {
        uint8_t pg[4] = {0};
        for (uint8_t b = 0; b < 4 && (page*4+b) < idx; b++)
            pg[b] = buf[page*4+b];
        if (rfid.MIFARE_Ultralight_Write(4 + page, pg, 4) != MFRC522::STATUS_OK)
            ok = false;
    }
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    logPush("[NDEF] write " + String(ok ? "OK" : "FAIL"));
    dispBanner(ok ? "NDEF Written!" : "NDEF FAIL");
}

static void rfid_erase_run() {
    rfidReinit();
    dispClear(); dispStatusBar("Erase Tag");
    dispText(0, 14, "WARNING: zeros");
    dispText(0, 24, "all writable blocks");
    dispText(0, 36, "Present Mifare 1K");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    MFRC522::MIFARE_Key keyFF;
    for (uint8_t i = 0; i < 6; i++) keyFF.keyByte[i] = 0xFF;
    uint8_t zero[16] = {0};
    uint8_t ok = 0, fail = 0;

    for (uint8_t blk = 1; blk < MIFARE_1K_BLOCKS; blk++) {
        if (blk % 4 == 3) continue; // sector trailer
        if (blk % 4 == 0) {
            rfid.PCD_StopCrypto1();
            rfidAuth(blk, keyFF);
        }
        if (rfid.MIFARE_Write(blk, zero, 16) == MFRC522::STATUS_OK) ok++;
        else fail++;
        if (blk % 8 == 0)
            dispProgress("Erasing", "Blk " + String(blk), (blk*100)/64);
    }
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();
    logPush("[ERASE] ok=" + String(ok) + " fail=" + String(fail));
    dispBanner("Erased:" + String(ok));
}

// NDEF parser for display
static void rfid_parse_ndef_run() {
    rfidReinit();
    dispClear(); dispStatusBar("NDEF Parse");
    dispText(0, 14, "Present NDEF tag");
    dispText(0, 54, "[BTN] cancel");
    dispCommit();
    if (!rfidWait()) { dispBanner("Cancelled"); return; }

    // Read pages 4-15 for Ultralight
    uint8_t raw[48] = {0};
    for (uint8_t page = 4; page < 16; page++) {
        uint8_t buf[18]; uint8_t blen = 18;
        if (rfid.MIFARE_Read(page, buf, &blen) != MFRC522::STATUS_OK) break;
        memcpy(raw + (page-4)*4, buf, 4);
    }
    rfid.PICC_HaltA(); rfid.PCD_StopCrypto1();

    // Parse TLV
    if (raw[0] != 0x03) { dispBanner("No NDEF found"); return; }
    uint8_t recLen = raw[1];
    uint8_t tnf    = raw[2] & 0x07;
    uint8_t typeLen = raw[3];
    uint8_t payLen  = raw[4];
    char    type    = raw[5];
    uint8_t prefix  = raw[6];

    const char* prefixes[] = {"http://www.","https://www.","http://","https://","tel:","mailto:","","urn:nfc:ext"};
    String url = (prefix < 8) ? prefixes[prefix] : "";
    for (uint8_t i = 0; i < payLen - 1; i++) url += (char)raw[7+i];

    dispClear(); dispStatusBar("NDEF Content");
    dispText(0, 12, "Type: " + String(type));
    dispText(0, 22, "URL:");
    dispText(0, 32, url.substring(0, 20));
    if (url.length() > 20) dispText(0, 42, url.substring(20, 40));
    dispText(0, 54, "[BTN] back");
    dispCommit();
    logPush("[NDEF_PARSE] " + url);
    while (!readButton()) delay(50);
}

// ─── RFID Save / Load Tags ────────────────────────────────

static void rfid_save_tag_run() {
    if (!g_hasUID) {
        dispBanner("Read a tag first");
        return;
    }
    // Let user name this tag
    char label[20] = "Tag";
    charPicker(label, 19, "Name this tag");

    SavedTag t;
    memset(&t, 0, sizeof(t));
    strncpy(t.label, label, 19);
    memcpy(t.uid, g_lastUID.uidByte, g_lastUID.size);
    t.uidSize = g_lastUID.size;
    g_savedTags.push_back(t);
    rfidTagsSave();
    logPush("[RFID_SAVE] " + String(label) + " uid=" + uidToHex(g_lastUID));
    dispBannerOK("Saved: " + String(label));
}

static void rfid_load_tags_run() {
    rfidTagsLoad();
    if (g_savedTags.empty()) {
        dispBanner("No saved tags");
        return;
    }
    OptionList list;
    for (auto& t : g_savedTags) {
        String uid;
        for (uint8_t i = 0; i < t.uidSize; i++) {
            if (uid.length() > 0) uid += ":";
            char h[3]; sprintf(h, "%02X", t.uid[i]);
            uid += h;
        }
        list.push_back({String(t.label) + " " + uid.substring(0,8), [](){}});
    }
    list.push_back({"Delete All", [](){}});
    list.push_back({"Back", [](){}});

    while (true) {
        int sel = loopOptions(list, "Saved Tags");
        if (sel < 0 || sel == (int)list.size()-1) break;
        if (sel == (int)list.size()-2) {
            // Delete all
            dispClear(); dispStatusBar("Delete All Tags");
            dispText(0, 24, "Are you sure?");
            dispText(0, 40, "[BTN] yes  [LONG] no");
            dispCommit();
            if (readButton()) {
                g_savedTags.clear();
                rfidTagsSave();
                dispBannerOK("All tags deleted");
                return;
            }
            continue;
        }
        // Show tag details and offer to set as active
        auto& t = g_savedTags[sel];
        dispClear(); dispStatusBar("Saved Tag");
        dispText(0, 12, "Name: " + String(t.label));
        String uid;
        for (uint8_t i = 0; i < t.uidSize; i++) {
            if (uid.length()) uid += ":";
            char h[3]; sprintf(h, "%02X", t.uid[i]);
            uid += h;
        }
        dispText(0, 22, "UID: " + uid);
        dispText(0, 34, "[BTN] load as active");
        dispText(0, 44, "[LONG] back");
        dispCommit();
        if (readButton()) {
            // Load into g_lastUID so clone/write can use it
            g_lastUID.size = t.uidSize;
            memcpy(g_lastUID.uidByte, t.uid, t.uidSize);
            g_hasUID = true;
            dispBannerOK("Loaded: " + String(t.label));
            return;
        }
    }
}

