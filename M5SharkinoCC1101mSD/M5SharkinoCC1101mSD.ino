// ─── Yardımcı: RAW_Data satırını pulse vektörüne dönüştür ─────────
static void flipper_parse_raw_data(const String& val, std::vector<RFPulse>& pulses) {
    int start = 0;
    String v = val + " ";
    for (int i = 0; i <= (int)v.length(); i++) {
        if (i == (int)v.length() || v[i] == ' ') {
            if (i > start) {
                String tok = v.substring(start, i);
                tok.trim();
                if (tok.length() > 0) {
                    long lv = tok.toInt();
                    if (lv != 0) {
                        RFPulse p;
                        p.dur   = (uint16_t)min((long)65535, abs(lv));
                        p.level = (lv > 0);
                        pulses.push_back(p);
                    }
                }
            }
            start = i + 1;
        }
    }
}

// ─── .sub Dosya Ayrıştırıcı — Çoklu Sinyal Desteği ──────────────
// Flipper Zero bazı .sub dosyaları #separator satırıyla birden fazla
// sinyal bloğu içerir. Bu fonksiyon tüm blokları ayrıştırır.
static FlipperSubFile flipper_parse_sub(const String& path) {
    FlipperSubFile result;
    result.valid       = false;
    result.multiSignal = false;
    result.freqHz      = 433920000.0f;
    result.preset      = "Ook650Async";
    result.protocol    = "RAW";

    File f = SD.open(path.c_str(), FILE_READ);
    if (!f) { dispBannerErr(".sub ac: " + path); return result; }

    bool isFlipperSub = false;
    // Çoklu sinyal için geçici blok
    FlipperSubSignal currentBlock;
    bool inBlock = false;

    while (f.available()) {
        String line = f.readStringUntil('\n');
        line.trim();
        if (line.isEmpty()) continue;

        // #separator veya --- → yeni sinyal bloğu başlıyor
        if (line == "#" || line == "---" || line.startsWith("#separator")) {
            if (inBlock && !currentBlock.pulses.empty()) {
                result.signals.push_back(currentBlock);
                currentBlock = FlipperSubSignal();
            }
            inBlock = true;
            continue;
        }
        // # ile başlayan yorum satırı ama label olabilir
        if (line.startsWith("# ") && line.length() > 2) {
            currentBlock.name = line.substring(2);
            continue;
        }

        int colon = line.indexOf(':');
        if (colon < 0) continue;
        String key = line.substring(0, colon);
        String val = line.substring(colon + 1);
        key.trim(); val.trim();

        if (key == "Filetype" && val.indexOf("SubGhz") >= 0) {
            isFlipperSub = true;
        } else if (key == "Frequency") {
            result.freqHz = val.toFloat();
        } else if (key == "Preset") {
            result.preset = val;
            if (val.indexOf("Ook") >= 0)      result.protocol = "ASK/OOK";
            else if (val.indexOf("2FSK") >= 0) result.protocol = "2-FSK";
            else if (val.indexOf("GFSK") >= 0) result.protocol = "GFSK";
        } else if (key == "Protocol") {
            result.protocol = val;
        } else if (key == "Name" || key == "name") {
            currentBlock.name = val;
        } else if (key == "RAW_Data") {
            // Blok moda girişten önce de RAW_Data gelebilir
            std::vector<RFPulse> parsedPulses;
            flipper_parse_raw_data(val, parsedPulses);
            if (inBlock) {
                for (auto& p : parsedPulses) currentBlock.pulses.push_back(p);
            } else {
                for (auto& p : parsedPulses) result.pulses.push_back(p);
            }
        }
    }
    f.close();

    // Son bloğu kaydet
    if (inBlock && !currentBlock.pulses.empty()) {
        result.signals.push_back(currentBlock);
    }

    // Çoklu sinyal mı, tekli mi?
    if (!result.signals.empty()) {
        result.multiSignal = true;
        // İlk sinyali de pulses[] içine yansıt (geri uyumluluk)
        if (result.pulses.empty())
            result.pulses = result.signals[0].pulses;
        result.valid = true;
    } else if (!result.pulses.empty() && isFlipperSub) {
        result.valid = true;
    }
    return result;
}

// ─── .rfid Dosya Ayrıştırıcı (LFRFID) ───────────────────────────
// Flipper Zero Low Frequency RFID formatı:
//   Filetype: Flipper RFID key
//   Version: 1
//   Key type: EM4100
//   Data: 01 23 45 67 89
static FlipperRFIDFile flipper_parse_rfid(const String& path) {
    FlipperRFIDFile result;
    memset(&result, 0, sizeof(result));
    result.valid = false;

    File f = SD.open(path.c_str(), FILE_READ);
    if (!f) { dispBannerErr(".rfid ac: " + path); return result; }

    bool isFlipperRFID = false;
    while (f.available()) {
        String line = f.readStringUntil('\n');
        line.trim();
        if (line.isEmpty() || line.startsWith("#")) continue;
        int colon = line.indexOf(':');
        if (colon < 0) continue;
        String key = line.substring(0, colon);
        String val = line.substring(colon + 1);
        key.trim(); val.trim();

        if (key == "Filetype" && val.indexOf("RFID") >= 0) {
            isFlipperRFID = true;
        } else if (key == "Key type" || key == "key type") {
            result.keyType = val;
        } else if (key == "Data" || key == "data") {
            result.dataHex = val;
            // Hex baytları parse et
            result.byteCount = 0;
            int s = 0;
            val += " ";
            for (int i = 0; i <= (int)val.length() && result.byteCount < 8; i++) {
                if (i == (int)val.length() || val[i] == ' ') {
                    if (i > s) {
                        String tok = val.substring(s, i);
                        tok.trim();
                        if (tok.length() > 0)
                            result.rawBytes[result.byteCount++] = (uint8_t)strtoul(tok.c_str(), nullptr, 16);
                    }
                    s = i + 1;
                }
            }
        }
    }
    f.close();
    result.valid = isFlipperRFID && result.byteCount > 0;
    return result;
}

