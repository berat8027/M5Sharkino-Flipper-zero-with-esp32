// Snake oyunu — pot = hız kontrol
static void game_snake_run() {
    static constexpr uint8_t GRID_W = 21;
    static constexpr uint8_t GRID_H = 9;
    static constexpr uint8_t CELL   = 6;

    uint8_t snakeX[GRID_W * GRID_H], snakeY[GRID_W * GRID_H];
    uint8_t snakeLen = 3;
    snakeX[0]=10; snakeY[0]=4;
    snakeX[1]=9;  snakeY[1]=4;
    snakeX[2]=8;  snakeY[2]=4;

    int8_t  dx=1, dy=0;
    uint8_t foodX = 15, foodY = 3;
    uint32_t score = 0;

    // Random food
    auto placeFood = [&]() {
        foodX = random(0, GRID_W);
        foodY = random(0, GRID_H);
    };

    while (true) {
        potApplyBrightness();
        // Pot = speed (delay)
        uint16_t spd = map(analogRead(PIN_POT), 0, 4095, 50, 300);

        JoyDir d = readJoystick();
        if (d == JoyDir::UP    && dy == 0) { dx=0;  dy=-1; }
        if (d == JoyDir::DOWN  && dy == 0) { dx=0;  dy=1;  }
        if (d == JoyDir::LEFT  && dx == 0) { dx=-1; dy=0;  }
        if (d == JoyDir::RIGHT && dx == 0) { dx=1;  dy=0;  }
        if (readButtonLong()) {
            if (score > 0) { g_xpGameCnt++; xpAdd(XP_PER_GAME_WIN); }
            break;
        }

        // Move
        for (int i = snakeLen-1; i > 0; i--) { snakeX[i]=snakeX[i-1]; snakeY[i]=snakeY[i-1]; }
        snakeX[0] = (snakeX[0] + dx + GRID_W) % GRID_W;
        snakeY[0] = (snakeY[0] + dy + GRID_H) % GRID_H;

        // Eat
        if (snakeX[0]==foodX && snakeY[0]==foodY) {
            score += 10;
            if (snakeLen < GRID_W*GRID_H - 1) { snakeX[snakeLen]=snakeX[snakeLen-1]; snakeY[snakeLen]=snakeY[snakeLen-1]; snakeLen++; }
            placeFood();
        }

        // Collision self
        for (uint8_t i = 1; i < snakeLen; i++) {
            if (snakeX[0]==snakeX[i] && snakeY[0]==snakeY[i]) {
                xpAdd(XP_PER_GAME_PLAY);
                dispBannerErr("Game Over! " + String(score));
                return;
            }
        }

        // Draw
        dispClear(); dispStatusBar("Snake Scr:" + String(score));
        // Grid border
        display.drawRect(0, 11, OLED_W, OLED_H-11, SSD1306_WHITE);
        // Snake
        for (uint8_t i = 0; i < snakeLen; i++) {
            uint8_t px = 1 + snakeX[i]*6, py = 12 + snakeY[i]*6;
            display.fillRect(px, py, 5, 5, SSD1306_WHITE);
        }
        // Food (blinking)
        display.fillCircle(1+foodX*6+2, 12+foodY*6+2, 2, SSD1306_WHITE);
        // Speed indicator (pot)
        dispText(90, 1, "Spd:" + String(map(spd,50,300,10,1)));
        dispCommit();
        delay(spd);
    }
}

// Pong oyunu — Sol: pot kontrolü (SEN), Sağ: AI Bot
static void game_pong_run() {
    int16_t ballX=64, ballY=36;
    int8_t  ballDX=2, ballDY=1;
    int16_t paddle1Y=28, paddle2Y=28;  // 1=sol(sen), 2=sağ(AI)
    static constexpr int8_t PADDLE_H = 12;
    static constexpr int8_t PADDLE_W = 3;
    uint8_t score1=0, score2=0;
    uint8_t aiDifficulty = 2; // 1=Kolay 2=Normal 3=Zor (pot ile ayarlanır)
    uint32_t aiLastMoveMs = 0;

    while (!readButtonLong()) {
        potApplyBrightness();
        // Sol paddle (SEN) = Joystick Y
        JoyDir d = readJoystick();
        if (d == JoyDir::UP   && paddle1Y > 12)                  paddle1Y -= 4;
        if (d == JoyDir::DOWN && paddle1Y < OLED_H-PADDLE_H-1)   paddle1Y += 4;

        // AI Bot (sağ paddle) — Pot zorluk seviyesi belirler
        uint16_t potRaw = analogRead(PIN_POT);
        aiDifficulty = map(potRaw, 0, 4095, 1, 4); // 1-3
        uint32_t aiSpeed = (aiDifficulty == 1) ? 120 : (aiDifficulty == 2) ? 50 : 18;
        if (millis() - aiLastMoveMs > aiSpeed) {
            aiLastMoveMs = millis();
            // AI top'un geldiği yönü tahmin et
            int16_t targetY = ballY;
            // Zorluk 1: sadece top kendine yaklaşırken hareket et
            if (aiDifficulty == 1 && ballDX < 0) targetY = paddle2Y + PADDLE_H/2; // yerinde kal
            int16_t aiCenter = paddle2Y + PADDLE_H/2;
            if (aiCenter < targetY - 2 && paddle2Y < OLED_H-PADDLE_H-1) paddle2Y += (aiDifficulty >= 3 ? 4 : 2);
            if (aiCenter > targetY + 2 && paddle2Y > 12)                  paddle2Y -= (aiDifficulty >= 3 ? 4 : 2);
        }

        // Ball move
        ballX += ballDX; ballY += ballDY;

        // Wall bounce (top+bottom)
        if (ballY <= 12 || ballY >= OLED_H-2) ballDY = -ballDY;

        // Paddle 1 (SEN - sol, x=4)
        if (ballX <= 7 && ballY >= paddle1Y && ballY <= paddle1Y+PADDLE_H) {
            ballDX = abs(ballDX);
            int8_t spin = (ballY - (paddle1Y + PADDLE_H/2)) / 3;
            ballDY = constrain(ballDY + spin, -3, 3);
            if (ballDY == 0) ballDY = 1;
        }
        // Paddle 2 (AI - sağ, x=121)
        if (ballX >= 120 && ballY >= paddle2Y && ballY <= paddle2Y+PADDLE_H) {
            ballDX = -abs(ballDX);
        }

        // Score
        if (ballX < 0)         { score2++; ballX=64; ballY=36; ballDX=2;  ballDY=1; }
        if (ballX > OLED_W)    { score1++; ballX=64; ballY=36; ballDX=-2; ballDY=1; }

        if (score1 >= 7 || score2 >= 7) {
            if (score1 >= 7) {
                g_xpGameCnt++; xpAdd(XP_PER_GAME_WIN);
                dispBannerOK("YOU WIN! " + String(score1) + "-" + String(score2));
            } else {
                xpAdd(XP_PER_GAME_PLAY);
                dispBannerErr("AI WINS! " + String(score2) + "-" + String(score1));
            }
            return;
        }

        // Draw
        dispClear();
        display.drawFastHLine(0, 11, OLED_W, SSD1306_WHITE);
        // Score + labels
        display.setTextSize(1); display.setTextColor(SSD1306_WHITE);
        display.setCursor(2,  2); display.print("YOU");
        display.setCursor(54, 2); display.print(String(score1)+"-"+String(score2));
        display.setCursor(96, 2); display.print("AI");
        // Difficulty indicator (dots)
        for (uint8_t i = 0; i < aiDifficulty; i++)
            display.fillRect(80+i*5, 4, 3, 3, SSD1306_WHITE);
        // Center dashed line
        for (uint8_t y = 13; y < OLED_H; y += 5)
            display.drawFastVLine(63, y, 3, SSD1306_WHITE);
        // Paddles
        display.fillRect(4,   paddle1Y, PADDLE_W, PADDLE_H, SSD1306_WHITE);
        display.fillRect(121, paddle2Y, PADDLE_W, PADDLE_H, SSD1306_WHITE);
        // Ball
        display.fillRect(ballX-2, ballY-2, 4, 4, SSD1306_WHITE);
        // Pot hint (zorluk)
        display.setTextSize(1);
        const char* diffName[] = {"","Easy","Mid","Hard"};
        dispText(0, 56, "Pot:diff " + String(diffName[aiDifficulty]) + " Joy:move");
        dispCommit();
        delay(25);
    }
}

// Reaction time game — pot = sensitivity threshold
static void game_reaction_run() {
    dispClear(); dispStatusBar("Reaction Test");
    dispText(0, 20, "Wait for GO!");
    dispText(0, 32, "Pot: sets difficulty");
    dispText(0, 54, "[BTN] ready");
    dispCommit();
    while (!readButton()) { potApplyBrightness(); delay(50); }

    uint16_t waitMs = map(analogRead(PIN_POT), 0, 4095, 1000, 5000);
    // Random delay 1-5 seconds (pot controlled max)
    uint32_t delay2 = random(500, waitMs);

    dispClear(); dispStatusBar("Reaction Test");
    dispText(0, 24, "Get Ready...");
    dispCommit();
    delay(delay2);

    // Flash GO!
    dispClear(); display.fillRect(0,0,OLED_W,OLED_H,SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK); display.setTextSize(2);
    display.setCursor(40,24); display.print("GO!");
    display.setTextColor(SSD1306_WHITE);
    dispCommit();

    uint32_t t = millis();
    while (!readButton()) delay(1);
    uint32_t rtt = millis() - t;

    const char* grade = rtt < 200 ? "AMAZING" : rtt < 350 ? "GOOD" : rtt < 500 ? "OK" : "SLOW";
    dispBannerOK(String(rtt) + "ms - " + grade);
}

