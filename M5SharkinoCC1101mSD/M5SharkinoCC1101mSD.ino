static void netanal_ping_run() {
    // STA bağlantısı yoksa kur
    bool weShouldDisconnect = false;
    if (!g_staConnected) {
        if (strlen(g_cfg.staSSID) == 0) {
            dispBannerErr("Set STA SSID in Config!");
            return;
        }
        dispProgress("Ping", "Connecting WiFi...", 10);
        if (!wifiSTAConnect(12000)) { dispBannerErr("WiFi connect failed"); return; }
        weShouldDisconnect = true;
    }

    // Hedef IP: gateway kullan
    IPAddress gw = WiFi.gatewayIP();
    dispClear(); dispStatusBar("Ping / Reach");
    dispText(0, 12, "Target: " + gw.toString());
    dispText(0, 22, "Via: " + g_staIP.substring(0,18));
    dispText(0, 32, "Port: 80 (TCP check)");
    dispText(0, 44, "Pot: timeout");
    dispText(0, 54, "[BTN] start [LONG] back");
    dispCommit();
    while (!readButton()) {
        potApplyBrightness();
        if (readButtonLong()) { if (weShouldDisconnect) wifiSTADisconnect(); return; }
        delay(50);
    }

    uint16_t timeoutMs = map(analogRead(PIN_POT), 0, 4095, 100, 3000);
    WiFiClient client;
    client.setTimeout(max((uint16_t)1, (uint16_t)(timeoutMs / 1000)));

    uint8_t ok = 0;
    uint32_t totalRtt = 0;
    for (uint8_t i = 0; i < 5; i++) {
        dispProgress("Ping " + gw.toString(), "Attempt " + String(i+1) + "/5", i*20);
        uint32_t t = millis();
        bool conn = client.connect(gw, 80);
        uint32_t rtt = millis() - t;
        if (conn) { ok++; totalRtt += rtt; client.stop(); }
        logPush("[PING] " + String(conn?"OK":"FAIL") + " rtt=" + String(rtt) + "ms");
        delay(200);
    }
    if (weShouldDisconnect) wifiSTADisconnect();
    if (ok > 0) dispBannerOK("OK " + String(ok) + "/5 avg=" + String(totalRtt/ok) + "ms");
    else        dispBannerErr("Unreachable");
}

static void netanal_arp_run() {
    bool weShouldDisconnect = false;
    if (!g_staConnected) {
        if (strlen(g_cfg.staSSID) == 0) { dispBannerErr("Set STA SSID in Config!"); return; }
        dispProgress("ARP Scan", "Connecting WiFi...", 10);
        if (!wifiSTAConnect(12000)) { dispBannerErr("WiFi connect failed"); return; }
        weShouldDisconnect = true;
    }

    // Gerçek subnet: IP & subnet mask
    IPAddress localIP  = WiFi.localIP();
    IPAddress mask     = WiFi.subnetMask();
    IPAddress base     = IPAddress(localIP[0] & mask[0],
                                   localIP[1] & mask[1],
                                   localIP[2] & mask[2],
                                   localIP[3] & mask[3]);

    uint16_t tout = map(analogRead(PIN_POT), 0, 4095, 50, 400);

    dispClear(); dispStatusBar("ARP Scan");
    dispText(0, 12, "Subnet: " + base.toString().substring(0,16));
    dispText(0, 22, "My IP: " + localIP.toString().substring(0,16));
    dispText(0, 32, "Timeout: " + String(tout) + "ms/host");
    dispText(0, 44, "Scan .1-.254 ports:");
    dispText(0, 54, "80,22,443 [BTN]start");
    dispCommit();
    while (!readButton()) {
        potApplyBrightness();
        if (readButtonLong()) { if (weShouldDisconnect) wifiSTADisconnect(); return; }
        delay(50);
    }

    std::vector<String> alive;
    static const uint16_t SCAN_PORTS[] = {80, 22, 443, 21, 23, 8080};
    static constexpr uint8_t SCAN_PORT_COUNT = 6;

    for (uint16_t host = 1; host <= 254; host++) {
        if (readButtonLong()) break;
        IPAddress ip(base[0], base[1], base[2], (uint8_t)host);
        if (ip == localIP) continue;

        dispProgress("ARP Scan " + String(host) + "/254",
                     ip.toString(), (host * 100) / 254);

        WiFiClient c;
        c.setTimeout(max((uint16_t)1, (uint16_t)(tout / 1000)));
        bool found = false;
        for (uint8_t pi = 0; pi < SCAN_PORT_COUNT && !found; pi++) {
            if (c.connect(ip, SCAN_PORTS[pi])) {
                alive.push_back(ip.toString() + ":" + String(SCAN_PORTS[pi]));
                c.stop();
                found = true;
                logPush("[ARP] " + ip.toString() + ":" + String(SCAN_PORTS[pi]) + " ALIVE");
            }
        }
    }

    if (weShouldDisconnect) wifiSTADisconnect();
    if (alive.empty()) { dispBannerWarn("No hosts found"); return; }
    OptionList res;
    for (auto& h : alive) res.push_back({h.substring(0,21), [](){}});
    res.push_back({"Back", [](){}});
    loopOptions(res, "Live Hosts (" + String(alive.size()) + ")");
    if (g_sdInited) {
        String out = "=== ARP Scan " + getTimestamp() + " ===\n";
        for (auto& h : alive) out += h + "\n";
        sdAppend("/log/arp.log", out);
    }
}

static void netanal_http_req_run() {
    bool weShouldDisconnect = false;
    if (!g_staConnected) {
        if (strlen(g_cfg.staSSID) == 0) { dispBannerErr("Set STA SSID in Config!"); return; }
        dispProgress("HTTP GET", "Connecting WiFi...", 10);
        if (!wifiSTAConnect(12000)) { dispBannerErr("WiFi connect failed"); return; }
        weShouldDisconnect = true;
    }

    // Hedef host gir
    char hostBuf[33] = "192.168.1.1";
    IPAddress gw = WiFi.gatewayIP();
    snprintf(hostBuf, sizeof(hostBuf), "%d.%d.%d.%d", gw[0], gw[1], gw[2], gw[3]);

    dispClear(); dispStatusBar("HTTP GET");
    dispText(0, 12, "My IP: " + g_staIP.substring(0,16));
    dispText(0, 22, "Def target: " + String(hostBuf));
    dispText(0, 32, "Pot: port (80-9999)");
    dispText(0, 44, "[LONG]=custom host");
    dispText(0, 54, "[BTN] use default");
    dispCommit();

    if (readButtonLong()) {
        if (!charPicker(hostBuf, 32, "Target host/IP")) {
            if (weShouldDisconnect) wifiSTADisconnect();
            return;
        }
    } else {
        while (!readButton()) { potApplyBrightness(); delay(50); }
    }

    uint16_t port = map(analogRead(PIN_POT), 0, 4095, 80, 9999);
    String host = String(hostBuf);

    dispProgress("HTTP GET", host + ":" + String(port), 30);

    WiFiClient c; c.setTimeout(5);
    bool conn = c.connect(host.c_str(), port);
    if (!conn) {
        if (weShouldDisconnect) wifiSTADisconnect();
        dispBannerErr("Connect failed: " + host);
        return;
    }
    c.printf("GET / HTTP/1.0\r\nHost: %s\r\nUser-Agent: M5Sharkino/2.0\r\nConnection: close\r\n\r\n",
             host.c_str());
    uint32_t t0 = millis();
    while (!c.available() && millis() - t0 < 5000) delay(50);

    String resp = "";
    while (c.available() && resp.length() < 2048) resp += (char)c.read();
    c.stop();

    if (weShouldDisconnect) wifiSTADisconnect();
    logPush("[HTTP] " + host + ":" + String(port) + " len=" + String(resp.length()));
    if (g_sdInited) sdAppend("/log/http.log",
        "=== " + getTimestamp() + " GET " + host + ":" + String(port) + " ===\n" + resp.substring(0,512));

    // İlk satırı (HTTP status) öne çıkar
    OptionList lines;
    int start = 0;
    for (size_t i = 0; i < resp.length() && lines.size() < 32; i++) {
        if (resp[i] == '\n') {
            String ln = resp.substring(start, i);
            ln.trim();
            if (ln.length() > 0) lines.push_back({ln.substring(0,21), [](){}});
            start = (int)i + 1;
        }
    }
    if (lines.empty()) lines.push_back({"(empty response)", [](){}});
    lines.push_back({"Back", [](){}});
    loopOptions(lines, "HTTP " + host.substring(0,10));
}

static void netanal_wifi_analyzer_run() {
    // Channel occupancy görsel analiz
    wifiScanAll(true);
    WiFi.scanDelete();

    if (g_scanResults.empty()) { dispBannerWarn("No APs found"); return; }

    // Ch 1-13 bar chart — bar height = AP count on that channel
    uint8_t chCount[14] = {0};
    int8_t  chMinRSSI[14];
    memset(chMinRSSI, -100, sizeof(chMinRSSI));
    for (auto& ap : g_scanResults) {
        if (ap.channel >= 1 && ap.channel <= 13) {
            chCount[ap.channel]++;
            if (ap.rssi > chMinRSSI[ap.channel]) chMinRSSI[ap.channel] = ap.rssi;
        }
    }
    uint8_t maxCnt = 1;
    for (uint8_t c = 1; c <= 13; c++) if (chCount[c] > maxCnt) maxCnt = chCount[c];

    while (!readButton()) {
        potApplyBrightness();
        dispClear(); dispStatusBar("WiFi Analyzer");
        // Channel bars
        for (uint8_t ch = 1; ch <= 13; ch++) {
            uint8_t barH = chCount[ch] > 0 ? map(chCount[ch], 0, maxCnt, 2, 36) : 0;
            uint8_t bx   = (ch-1)*9 + 2;
            if (barH > 0) display.fillRect(bx, 52-barH, 7, barH, SSD1306_WHITE);
            display.drawRect(bx, 16, 7, 36, SSD1306_WHITE);
            // Channel number (tiny)
            display.setTextSize(1);
            display.setTextColor(SSD1306_WHITE);
            display.setCursor(bx+1, 54);
            if (ch < 10) display.print(ch);
        }
        dispText(0, 8, "APs: " + String(g_scanResults.size()));
        dispText(64,8, "[BTN] back");
        dispCommit();
        delay(100);
    }
    WiFi.mode(WIFI_OFF);
}

static void netanal_mac_lookup_run() {
    // OUI lookup for known vendors
    static const struct { uint8_t oui[3]; const char* name; } OUI_TABLE[] = {
        {{0xAC,0x91,0xA1},"Apple"},   {{0xA4,0xC3,0xF0},"Apple"},
        {{0x8C,0x77,0x12},"Samsung"}, {{0xFC,0x3F,0xDB},"Samsung"},
        {{0x00,0x1A,0x11},"Google"},  {{0x94,0xEB,0xCD},"Google"},
        {{0x00,0x25,0x9C},"Cisco"},   {{0x58,0x6D,0x8F},"Cisco"},
        {{0x00,0x50,0xF2},"Microsoft"},{{0xDC,0x53,0x60},"Huawei"},
        {{0x48,0x02,0x2A},"TP-Link"}, {{0xEC,0x08,0x6B},"TP-Link"},
        {{0xC4,0x04,0x15},"Netgear"}, {{0x20,0x4E,0x7F},"Netgear"},
        {{0xB0,0xA7,0xB9},"Nokia"},   {{0xF8,0xFF,0xC2},"Xiaomi"},
    };
    static constexpr uint8_t OUI_COUNT = 16;

    if (g_scanResults.empty()) { wifiScanAll(true); WiFi.scanDelete(); }
    if (g_scanResults.empty()) { dispBannerWarn("Scan first"); return; }

    OptionList list;
    for (auto& ap : g_scanResults) {
        uint8_t mac[6];
        macFromStr(ap.bssid, mac);
        const char* vendor = "Unknown";
        for (uint8_t i = 0; i < OUI_COUNT; i++) {
            if (mac[0]==OUI_TABLE[i].oui[0] && mac[1]==OUI_TABLE[i].oui[1] && mac[2]==OUI_TABLE[i].oui[2]) {
                vendor = OUI_TABLE[i].name; break;
            }
        }
        list.push_back({ap.ssid.substring(0,10) + " " + String(vendor), [](){}});
    }
    list.push_back({"Back", [](){}});
    loopOptions(list, "OUI Lookup");
    WiFi.mode(WIFI_OFF);
}

