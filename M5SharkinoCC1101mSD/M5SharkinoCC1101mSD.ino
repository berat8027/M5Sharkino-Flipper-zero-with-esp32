    g_cfg.wifiEnabled        = prefs.getBool("wifiEn",   true);
    g_cfg.bleEnabled         = prefs.getBool("bleEn",    true);
    g_cfg.rfidEnabled        = prefs.getBool("rfidEn",   true);
    g_cfg.brightness         = prefs.getUChar("bright",  100);
    g_cfg.serialLog          = prefs.getBool("serLog",   true);
    g_cfg.displayInvert      = prefs.getBool("invert",   false);
    g_cfg.pinLockEnable      = prefs.getBool("pinEn",    false);
    g_cfg.deauthPktsPerBurst = prefs.getUChar("deauthB", 15);
    g_cfg.scanDwellMs        = prefs.getUShort("dwell",  500);
    String ssid              = prefs.getString("apSSID", "M5Sharkino");
    String pass              = prefs.getString("apPass",  "");
    String pin               = prefs.getString("pin",     "1234");
    String staSSID           = prefs.getString("staSSID", "");
